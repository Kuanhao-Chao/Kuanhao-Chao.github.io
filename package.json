{
  "name": "khc-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "yaml": "2.8.3"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run build:site && npm run pdf:posts",
    "build:site": "astro build",
    "pdf:posts": "node scripts/gen-post-pdfs.mjs",
    "audit:indexing": "node scripts/audit-indexing.mjs",
    "audit:links": "node scripts/audit-links.mjs",
    "audit:links:live": "node scripts/audit-links.mjs --live",
    "audit:refs": "node scripts/verify-references.mjs",
    "audit:refs:offline": "node scripts/verify-references.mjs --offline",
    "audit:datasets": "node scripts/verify-datasets.mjs",
    "audit:datasets:offline": "node scripts/verify-datasets.mjs --offline",
    "audit:responsive": "node scripts/audit-responsive-ui.mjs",
    "audit:cnn": "node scripts/test-cnn-lab.mjs",
    "audit:transformer": "node scripts/test-transformer-lab.mjs",
    "audit:mamba": "node scripts/test-mamba-lab.mjs",
    "audit:deep-dives": "node scripts/audit-deep-dive-ui.mjs",
    "audit:deep-dives:ci": "node scripts/audit-deep-dive-ui.mjs --smoke",
    "audit:narrow": "node scripts/audit-narrow.mjs",
    "audit:ml-interview": "node scripts/audit-ml-interview.mjs",
    "audit:games": "node scripts/audit-game-ui.mjs",
    "audit:cells": "node scripts/audit-living-cells-ui.mjs",
    "audit:cells:ci": "node scripts/audit-living-cells-ui.mjs --smoke",
    "audit:posts": "node scripts/audit-post-ui.mjs",
    "audit:playground": "node scripts/audit-playground-ui.mjs",
    "audit:playground:ci": "node scripts/audit-playground-ui.mjs --smoke",
    "audit:playground:full": "node scripts/audit-playground-ui.mjs --full",
    "audit:terminal": "node scripts/audit-terminal-ui.mjs",
    "audit:terminal:ci": "node scripts/audit-terminal-ui.mjs --smoke",
    "audit:security": "node scripts/audit-security.mjs",
    "audit:security:live": "node scripts/audit-security.mjs --live",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.6.0",
    "@types/leaflet": "^1.9.22",
    "astro": "^7.2.9",
    "katex": "^0.16.47",
    "leaflet": "^1.9.4",
    "onnxruntime-web": "^1.29.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@types/google.maps": "^3.66.1",
    "@types/three": "^0.185.4",
    "playwright": "^1.61.1",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "yaml": "2.8.3"
  }
}
