---
import { getCollection, render } from 'astro:content';
import DeepDiveLesson from '../../layouts/DeepDiveLesson.astro';

/**
 * One route for every migrated lesson.
 *
 * Only slugs present in the `deepDives` collection are emitted, so lessons still
 * authored as static `.astro` files in this directory are untouched and keep
 * their URLs. Each is deleted in the same commit its `.mdx` lands — leaving both
 * would put two routes on one URL, which `src/lib/deepDives.test.ts` fails on.
 */
export async function getStaticPaths() {
  const entries = await getCollection('deepDives', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DeepDiveLesson entry={entry} headings={headings}>
  <Content />
</DeepDiveLesson>
