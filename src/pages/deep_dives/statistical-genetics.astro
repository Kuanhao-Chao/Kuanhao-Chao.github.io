            </tr>
            <tr>
              <td><strong>SNP Heritability (Individual)</strong></td>
              <td>GCTA-GREML (Yang 2010)</td>
              <td><Katex tex="\mathbf{V} = \mathbf{A}\sigma_g^2 + \mathbf{I}\sigma_e^2" /></td>
              <td>Individual genotypes + Phenotypes</td>
            </tr>
            <tr>
              <td><strong>SNP Heritability (Summary)</strong></td>
              <td>LDSC (Bulik-Sullivan 2015)</td>
              <td><Katex tex="\mathbb{E}[\chi^2_j] = 1 + \frac{Nh^2}{M}\ell_j + Na" /></td>
              <td>GWAS summary stats + LD panel</td>
            </tr>
            <tr>
              <td><strong>Mixed Model Association</strong></td>
              <td>Regenie / BOLT-LMM</td>
              <td><Katex tex="\mathbf{y} = \mathbf{X}\boldsymbol{\beta} + \mathbf{u} + \boldsymbol{\epsilon}" /></td>
              <td>Biobank genotypes + Phenotypes</td>
            </tr>
            <tr>
              <td><strong>Bayesian Fine-Mapping</strong></td>
              <td>SuSiE (Wang & Stephens 2020)</td>
              <td>Posterior Inclusion Probabilities (PIP)</td>
              <td>Z-scores + In-sample LD matrix <Katex tex="\mathbf{R}" /></td>
            </tr>
            <tr>
              <td><strong>Rare Variant Association</strong></td>
              <td>SKAT-O / DeepRVAT</td>
              <td><Katex tex="\mathcal{Q}_\rho = \rho \mathcal{Q}_{\text{Burden}} + (1-\rho)\mathcal{Q}_{\text{SKAT}}" /></td>
              <td>WES / WGS variant matrices</td>
            </tr>
            <tr>
              <td><strong>Causal Inference</strong></td>
              <td>IVW / MR-Egger / Weighted Median</td>
              <td><Katex tex="\hat{\beta}_{\text{MR}} = \frac{\sum w_j \hat{\beta}_{Xj} \hat{\beta}_{Yj}}{\sum w_j \hat{\beta}_{Xj}^2}" /></td>
              <td>Bivariate GWAS summary statistics</td>
            </tr>
            <tr>
              <td><strong>Sequence-to-Function AI</strong></td>
              <td>Borzoi / AlphaGenome / GPN-Star</td>
              <td><Katex tex="\hat{\mathbf{Y}} = f_\theta(\text{DNA Sequence})" /></td>
              <td>Reference FASTA + Functional tracks</td>
            </tr>
          </tbody>
        </table>
