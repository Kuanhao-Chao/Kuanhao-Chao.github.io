---
import { readFileSync } from 'node:fs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/variantPlayground.css';
import { site } from '../../data/site';
import { buildBreadcrumbLd } from '../../lib/breadcrumbs';
import lociData from '../../data/shorkieLoci.json';

// Every number on this page is read from the shipped tiles at build time rather than typed, so the
// prose cannot drift from the data the way a hand-copied count does.
const index = JSON.parse(readFileSync('public/genome-data/index.json', 'utf8')) as {
  genome: string;
  levels: { level: number; binBp: number; rows: number }[];
  tileBins: number;
  tracks: {
    id: string; label: string; short: string; detail: string; note: string; source: string;
    units: string; axis: [number, number]; prediction: boolean; laneTag?: string;
    docs: { source: string; measures: string; read: string; caveat: string };
  }[];
  comparison?: {
    bases: number; pearson: number; spearman: number; meanIc: number; meanPhastCons: number;
    byClass: Record<string, {
      bases: number; pearson: number; spearman: number; meanIc: number; meanPhastCons: number;
      phastConsSaturated: number; phastConsMedian: number; icMedian: number;
    }>;
  };
  conservationSource?: { track: string; units: string; source: string };
  gcComparison?: {
    bases: number; pearson: number; spearman: number; meanIc: number; meanGc: number;
    byClass: Record<string, { bases: number; pearson: number; meanIc: number; meanGc: number }>;
  };
  window: { seqLen: number; flank: number; core: number; k: number; phase: number; note: string };
  chroms: {
    name: string; length: number; genes: number; shortFlankBases: number;
    tracks: Record<string, { scored: number; mean: number | null }>;
    levels: Record<string, { level: number; bins: number; tiles: number }[]>;
  }[];
};

const totalBp = index.chroms.reduce((s, c) => s + c.length, 0);
const totalGenes = index.chroms.reduce((s, c) => s + c.genes, 0);
const totalTiles = index.chroms.reduce(
  (s, c) => s + Object.values(c.levels).reduce((t, ls) => t + ls.reduce((u, l) => u + l.tiles, 0), 0),
  0,
);
const shortFlank = index.chroms.reduce((s, c) => s + c.shortFlankBases, 0);
const windows = Math.ceil(totalBp / index.window.core) + index.chroms.length;
const nuclear = index.chroms.filter((c) => c.name !== 'chrM');
const trackMean = (id: string, rows: typeof index.chroms) =>
  rows.reduce((s, c) => s + (c.tracks[id]?.mean ?? 0) * c.length, 0)
  / rows.reduce((s, c) => s + c.length, 0);
const meanIc = trackMean('lm-masked', nuclear);
const meanUnmasked = trackMean('lm-unmasked', nuclear);
const meanCons = trackMean('phastcons', nuclear);
const mito = index.chroms.find((c) => c.name === 'chrM');
const mitoIc = mito?.tracks['lm-masked']?.mean ?? null;
const cmp = index.comparison;
const gcCmp = index.gcComparison;
const mitoGc = mito?.tracks['gc']?.mean ?? null;
// phastCons has no value where the alignment has none. Stated, not rounded away.
const consScored = index.chroms.reduce((s, c) => s + (c.tracks['phastcons']?.scored ?? 0), 0);

const levelRows = index.levels.map((l) => ({
  ...l,
  bins: index.chroms.reduce(
    (s, c) => s + ((c.levels['lm-masked'] ?? []).find((x) => x.level === l.level)?.bins ?? 0), 0,
  ),
}));

// Primary regions deep-link by coordinate, derived from the gene model each locus already ships --
// so a region's link and the region itself cannot disagree.
type Feat = { name: string; txStart: number; txEnd: number };
const regions = (lociData.loci as { id: string; gene: string; chrom: string; start: number; features: Feat[] }[])
  .map((l) => {
    const f = l.features.find((x) => x.name === l.id);
    const a = l.start + (f ? f.txStart : 6144);
    const b = l.start + (f ? f.txEnd : 10240);
    return { label: `${l.gene} · ${l.id}`, chrom: l.chrom, gene: l.gene,
             locus: `${l.chrom}:${a - 799}-${b + 800}` };
  })
  .sort((a, b) => a.label.localeCompare(b.label));

const title = 'The yeast genome under Shorkie_LM';
const description =
  'A genome browser over Shorkie_LM constraint: per-base information content for all 12,157,105 '
  + 'bases of the S. cerevisiae R64 reference, precomputed with overlapping windows and browsable '
  + 'from whole chromosomes down to individual letters.';

const webAppLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Shorkie_LM genome browser',
  applicationCategory: 'ScienceApplication',
  operatingSystem: 'Web Browser',
  description,
  url: `${site.url}/shorkie-lab/genome/`,
  author: { '@id': `${site.url}/#person` },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbLd = buildBreadcrumbLd([
  { name: 'Shorkie Lab', path: '/shorkie-lab/' },
  { name: 'Genome browser', path: '/shorkie-lab/genome/' },
]);
---

<BaseLayout title={title} description={description} bare={true}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />

  <div class="vp" data-genome-browser data-gb-default="chrVII:882,012-884,610">
    <header class="vp-top">
      <h1 class="vp-title">Genome browser</h1>
      <span class="vp-sub">
        Shorkie_LM constraint + Shorkie expression · sacCer3 / R64 ·
        {totalBp.toLocaleString()} bp · {index.chroms.length} sequences
      </span>
      <span class="vp-spacer"></span>
      <a class="vp-sub" href="/shorkie-lab/shorkie_lm/">← Language model</a>
      <a class="vp-sub" href="/shorkie-lab/shorkie/">Expression model</a>
      <a class="vp-sub" href="/shorkie-lab/">Lab</a>
      <a class="vp-sub" href="https://doi.org/10.1101/2025.09.19.677475">Paper</a>
    </header>

    <div class="vp-scroll">
      <!-- Sticky bars belong INSIDE .vp-scroll: this is a `bare` page, so html/body are pinned and
           the inner pane is what scrolls. Outside it, `position: sticky` has nothing to stick to. -->
      <nav class="vp-nav" aria-label="Genome navigation">
        <span class="vp-nav__group">
          <label class="vp-nav__label" for="gb-chrom">chromosome</label>
          <select class="vp-select" id="gb-chrom" data-gb-chrom aria-label="Chromosome"></select>
        </span>
        <span class="vp-nav__group">
          <label class="vp-nav__label" for="gb-locus">locus or gene</label>
          <input class="vp-input gb-locus" id="gb-locus" data-gb-locus spellcheck="false"
                 placeholder="TDH3 · YGR192C · chrIV:65,235-65,431"
                 aria-label="Locus or gene name" />
          <button type="button" class="vp-btn" data-gb-go>Go</button>
        </span>
        <span class="vp-nav__group">
          <label class="vp-nav__label" for="gb-region">primary regions</label>
          <select class="vp-select" id="gb-region" data-gb-region aria-label="Jump to a primary region">
            <option value="">jump to…</option>
            {regions.map((r) => <option value={r.locus}>{r.label}</option>)}
          </select>
        </span>
        <span class="vp-spacer"></span>
        <span class="vp-nav__group" role="group" aria-label="History">
          <button type="button" class="vp-btn vp-btn--icon" data-gb-back
                  aria-label="Back ([)" title="Back — [">↶</button>
          <button type="button" class="vp-btn vp-btn--icon" data-gb-fwd
                  aria-label="Forward (])" title="Forward — ]">↷</button>
        </span>
        <span class="vp-nav__group" role="group" aria-label="Pan and zoom">
          <button type="button" class="vp-btn vp-btn--icon" data-gb-pan="-1" aria-label="Pan left">‹</button>
          <button type="button" class="vp-btn vp-btn--icon" data-gb-pan="1" aria-label="Pan right">›</button>
          <button type="button" class="vp-btn vp-btn--icon" data-gb-zoom="0.5" aria-label="Zoom in">+</button>
          <button type="button" class="vp-btn vp-btn--icon" data-gb-zoom="2" aria-label="Zoom out">−</button>
          <button type="button" class="vp-btn" data-gb-whole>whole chr</button>
        </span>
        <span class="vp-nav__group" role="group" aria-label="Region and export">
          <button type="button" class="vp-btn" data-gb-mark
                  title="Keep this region highlighted while you navigate">mark region</button>
          <button type="button" class="vp-btn" data-gb-autoscale aria-pressed="false"
                  title="Scale each lane to the data in view. Off by default: a fixed axis is what
                         makes a quiet window look quiet.">autoscale</button>
          <button type="button" class="vp-btn" data-gb-export
                  title="Save the current view as a PNG">PNG</button>
          <button type="button" class="vp-btn" data-gb-export-csv
                  title="Save the data behind this view as CSV, at the level it is drawn at">CSV</button>
          <!-- Phone only (CSS): the track panel becomes a drawer over the stage rather than a
               column below the fold. -->
          <button type="button" class="vp-btn gb-panel-toggle" data-gb-panel-toggle
                  aria-expanded="false">tracks</button>
        </span>
      </nav>

      <section class="vp-panel">
        <div class="gb-head">
          <strong class="gb-readout" data-gb-readout>—</strong>
          <span class="vp-stat" data-gb-level-out></span>
          <span class="vp-stat gb-roi" data-gb-roi></span>
          <span class="vp-stat gb-corr" data-gb-corr></span>
          <span class="vp-spacer"></span>
          <span class="vp-stat gb-hover" data-gb-hover></span>
        </div>

        <div class="gb-layout">
          <div class="gb-stage">
            <canvas class="vp-canvas gb-mini" data-gb-mini
                    aria-label="Whole-chromosome overview with the current viewport marked"></canvas>
            <canvas class="vp-canvas gb-track" tabindex="0" data-gb-track
                    aria-label="Shorkie_LM constraint, conservation, annotation and gene models"
            ></canvas>
            <div class="gb-tooltip" data-gb-tooltip hidden></div>
            <!-- Opened by clicking a binding-site box: the motif that factor recognises, from
                 JASPAR, over the reference sequence actually at that position. -->
            <aside class="gb-motif" data-gb-motif hidden aria-label="Motif"></aside>
          </div>
          <aside class="gb-panel" aria-label="Tracks">
            <div data-gb-panel></div>
            <p class="gb-panel__note">
              Hover a name for what it is. The visible set is part of the link, so a shared URL
              restores this exact picture.
            </p>
          </aside>
        </div>

        <p class="vp-notes gb-caption">
          <span class="gb-caption__short">
            <strong>Pinch to zoom</strong>, drag to pan, tap the strip to jump, and{' '}
            <strong>tracks</strong> to choose what is drawn. Every score lane keeps a fixed axis at
            every zoom unless you press <strong>autoscale</strong>, and prints its own units.
          </span>
          <span class="gb-caption__full"><strong>Drag the ruler to select a region</strong> (or shift-drag anywhere); drag a track
          to pan, scroll to zoom, click the overview strip to jump. Every score lane keeps a{' '}
          <em>fixed</em> axis at every zoom, so any two positions are read against the same ruler —
          and each lane prints its own range, because {index.tracks[0].units} and a 0–1 posterior
          are not the same units. <strong>autoscale</strong> suspends that rule for the visible
          window; it is off by default and every rescaled lane says so on its own face, because an
          axis that was rescaled without announcing it is the same trick as a bar chart drawn from a
          non-zero baseline. Above a lane's own resolution a pixel column is a summary bin: the
          filled bar is its <strong>mean</strong>, the pale mark its <strong>maximum</strong> and
          the dark tick its <strong>minimum</strong>, so one determined base inside a wide bin stays
          visible. Signed lanes — the attribution — grow both ways from a zero rule instead. At the
          deepest zoom the per-base lanes become a logo, one letter a base; a lane whose data is
          coarser than that stops at its own floor and the readout names it.
          The nuclear genome averages{' '}
          <strong>{meanIc.toFixed(3)} bits</strong> masked against{' '}
          <strong>{meanUnmasked.toFixed(3)}</strong> unmasked
          {mitoIc !== null ? `, and chrM ${mitoIc.toFixed(3)} masked` : ''} — so most of the track
          is genuinely low and the tall columns are the exception.</span>
        </p>

        <section class="gb-stats-box" aria-label="This view, in numbers">
          <h3 class="gb-stats__title">This view, in numbers</h3>
          <div data-gb-stats hidden></div>
          <canvas class="gb-scatter" data-gb-scatter height="170"
                  aria-label="The two enabled score lanes plotted against each other over this view"
                  hidden></canvas>
        </section>

        <p class="vp-stat gb-status" data-gb-status></p>
      </section>

      <section class="vp-panel">
        <h2>How the whole genome was scored</h2>
        <p class="vp-notes vp-lede">
          The model reads a {index.window.seqLen.toLocaleString()} bp window, so a genome-wide track
          has to be assembled from overlapping windows — and a base near a window edge has less
          context than one in the middle, which makes its score a different measurement. Only the
          central {index.window.core.toLocaleString()} bp of each window is kept, with
          {' '}{index.window.flank.toLocaleString()} bp of flank discarded on each side:
          {' '}{windows.toLocaleString()} windows over {index.chroms.length} sequences.
        </p>

        <details class="vp-how">
          <summary>The two passes, and why only one of them is a prediction</summary>
          <div class="vp-how-body">
            <p>
              A masked language model only predicts where it is masked. The browser can draw the
              model two ways, and the difference between them is the paper's Figure 2A point:
            </p>
            <div class="vp-scroll-x"><table class="vp-collapse-table">
              <thead>
                <tr><th>pass</th><th>what it asks</th><th>mean IC, nuclear genome</th></tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>masked</strong></td>
                  <td>positions are split into {index.window.k} disjoint strided sets, each masked
                  in turn, and each position is read back <em>only</em> from the pass that masked
                  it — so the model never sees the base it is scoring</td>
                  <td><strong>{meanIc.toFixed(3)} bits</strong></td>
                </tr>
                <tr>
                  <td><strong>unmasked</strong></td>
                  <td>one forward pass with nothing masked, so the model can see the base it is
                  scoring and is largely reading its own input</td>
                  <td><strong>{meanUnmasked.toFixed(3)} bits</strong></td>
                </tr>
              </tbody>
            </table></div>
            <p>
              <strong>Only the masked pass is a prediction.</strong> The unmasked pass scores
              {' '}{(meanUnmasked / meanIc).toFixed(2)}× higher for that reason alone, not because
              it knows more — and the browser labels its lane <em>not a prediction</em> rather than
              leaving the caveat to a paragraph you might not read. It is nonetheless the quantity
              the paper's Figure 2A logo is built on, which is exactly why it is worth being able
              to draw beside the other.
            </p>
            <p>
              They are not two views of one number. Across the 23 primary regions the two correlate
              at <strong>r ≈ 0.62</strong>, and per chromosome here at 0.59–0.62 — related, and far
              from redundant. Worth noticing too: the unmasked pass picks the right base{' '}
              <strong>97.5%</strong> of the time while averaging only {meanUnmasked.toFixed(2)} of
              a possible 2 bits. It is confident about <em>which</em> base, not sharply peaked.
            </p>
            <p>
              Turn both on in the track panel to see them stacked on the same 0–2 axis.
            </p>
          </div>
        </details>

        <details class="vp-how">
          <summary>Does the model agree with evolution? Partly — and the way it does not is the
            interesting part</summary>
          <div class="vp-how-body">
            <p>
              The model's constraint is <strong>alignment-free</strong>: it comes from pretraining
              on 165 <em>Saccharomycetales</em> genomes and says what the model finds predictable.
              {' '}<strong>phastCons</strong> is <strong>alignment-based</strong> — a phylo-HMM
              posterior over a 7-yeast whole-genome alignment — and says what evolution has held
              still. Two independent measurements of related things, which is what makes laying
              them in adjacent lanes a check rather than a second opinion from the same source.
            </p>
            {cmp && (
              <>
                <div class="vp-scroll-x"><table class="vp-collapse-table">
                  <thead>
                    <tr>
                      <th>over</th><th>bases</th><th>Pearson r</th><th>Spearman ρ</th>
                      <th>mean IC</th><th>mean phastCons</th><th>phastCons ≥ 0.99</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td><strong>whole genome</strong></td>
                      <td>{cmp.bases.toLocaleString()}</td>
                      <td><strong>{cmp.pearson.toFixed(3)}</strong></td>
                      <td>{cmp.spearman.toFixed(3)}</td>
                      <td>{cmp.meanIc.toFixed(3)}</td>
                      <td>{cmp.meanPhastCons.toFixed(3)}</td>
                      <td>—</td>
                    </tr>
                    {Object.entries(cmp.byClass).map(([name, v]) => (
                      <tr>
                        <td>{name === 'cds' ? 'coding sequence' : name}</td>
                        <td>{v.bases.toLocaleString()}</td>
                        <td>{v.pearson.toFixed(3)}</td>
                        <td>{v.spearman.toFixed(3)}</td>
                        <td>{v.meanIc.toFixed(3)}</td>
                        <td>{v.meanPhastCons.toFixed(3)}</td>
                        <td>{(v.phastConsSaturated * 100).toFixed(1)}%</td>
                      </tr>
                    ))}
                  </tbody>
                </table></div>
                <p>
                  <strong>Read the split before the headline.</strong> Both measures rank coding
                  sequence above intergenic — IC {cmp.byClass.cds.meanIc.toFixed(3)} against
                  {' '}{cmp.byClass.intergenic.meanIc.toFixed(3)}, phastCons
                  {' '}{cmp.byClass.cds.meanPhastCons.toFixed(3)} against
                  {' '}{cmp.byClass.intergenic.meanPhastCons.toFixed(3)} — and that shared{' '}
                  <em>regional</em> agreement is most of the overall r = {cmp.pearson.toFixed(3)}.{' '}
                  <em>Within</em> coding sequence they agree far less
                  (r = {cmp.byClass.cds.pearson.toFixed(3)} over
                  {' '}{cmp.byClass.cds.bases.toLocaleString()} bases).
                </p>
                <p>
                  That is partly a real disagreement and partly a property of phastCons:
                  {' '}<strong>{(cmp.byClass.cds.phastConsSaturated * 100).toFixed(1)}%</strong> of
                  coding bases sit at ≥ 0.99, median
                  {' '}{cmp.byClass.cds.phastConsMedian.toFixed(3)}, so inside a gene it is a
                  near-constant 1 and there is very little variation left for the model's per-base
                  signal to track. A correlation is bounded by the range of both variables, and
                  reporting r = {cmp.byClass.cds.pearson.toFixed(3)} without that is a wrong
                  interpretation of a right number.
                </p>
              </>
            )}
            <p>
              phastCons has no value where the alignment has none —
              {' '}<strong>{((1 - consScored / totalBp) * 100).toFixed(2)}%</strong> of the genome,
              concentrated on chrM and at telomeres. Those bases are drawn as a <em>gap</em>, never
              as zero: a zero would read as "completely unconserved" where the truth is
              "not aligned", and the lane says what fraction of the view is missing.
            </p>
          </div>
        </details>

        <details class="vp-how">
          <summary>Why the flank is {index.window.flank.toLocaleString()} bp, and how the first
            answer was wrong</summary>
          <div class="vp-how-body">
            <p>
              How much flank is needed is measurable: score the same 8,192 bases twice, once centred
              in a window and once against its edge, and compare information content per base.{' '}
              <strong>The answer depends entirely on which region you measure.</strong>
            </p>
            <div class="vp-scroll-x"><table class="vp-collapse-table">
              <thead>
                <tr><th>distance from edge</th><th>quiet chrIV:400k</th><th>promoter chrI:76k</th></tr>
              </thead>
              <tbody>
                <tr><td>0–64 bp</td><td>0.0321</td><td>0.1049</td></tr>
                <tr><td>512–1,024</td><td>0.0112</td><td>0.0245</td></tr>
                <tr><td>1,024–2,048</td><td>0.0063</td><td>0.0224</td></tr>
                <tr><td>2,048–3,072</td><td>~0.007</td><td>0.0186</td></tr>
                <tr><td>3,072–4,096</td><td>~0.007</td><td>0.0109</td></tr>
                <tr><td>4,096–6,144</td><td>~0.007</td><td>0.0060</td></tr>
              </tbody>
            </table></div>
            <p>
              On a quiet stretch the effect looks finished inside 1 kb, and a 2,048 bp flank looks
              like a 2× margin — which is what this track first shipped with. On a gene promoter,
              where the model is actually resolving motifs and where anyone will look, it is still
              0.022 bits at 2 kb and only settles around 4 kb. Measure the error on the case that
              matters, not on the first one to hand.
            </p>
          </div>
        </details>

        <details class="vp-how">
          <summary>The pooling-grid phase matters {Math.round(0.0395 / 0.0020)}× more than the
            flank does</summary>
          <div class="vp-how-body">
            <p>
              The encoder pools to {index.window.phase} bp, so a window's start position{' '}
              <em>modulo {index.window.phase}</em> decides which bases share a pooled cell. Scoring
              the same bases from windows at different phases changes information content by{' '}
              <strong>0.0395 bits</strong> on average; from windows at the same phase, by{' '}
              <strong>0.0020</strong>. That is an order of magnitude larger than the edge effect the
              flank was chosen for.
            </p>
            <p>
              Every window in this track therefore starts on a multiple of {index.window.phase},
              so every base in the genome is scored on one grid and any two positions are
              comparable. The 23 primary regions on the
              {' '}<a href="/shorkie-lab/shorkie_lm/">language-model page</a> start at their own
              coordinates and sit on whatever phase that gives, which is why the two agree in shape
              (r = 0.95–0.99) rather than to the last decimal. Neither is more correct; they are two
              phases of the same model.
            </p>
            <p>
              {shortFlank.toLocaleString()} bases — {(shortFlank / totalBp * 100).toFixed(2)}% of the
              genome, all of them within {index.window.flank.toLocaleString()} bp of a chromosome end
              — could not be given a full flank and were scored with the largest one available.
            </p>
          </div>
        </details>

        <details class="vp-how">
          <summary>What the pyramid stores, and why a summary bin keeps its minimum and maximum</summary>
          <div class="vp-how-body">
            <p>
              A summary bin that reports only its average hides exactly what a constraint track
              exists to show: one strongly determined base inside a
              {' '}{index.levels[index.levels.length - 1].binBp.toLocaleString()} bp bin disappears
              into the surrounding noise. Every level above base resolution stores three rows, so the
              drawing can show the envelope and a spike stays visible at genome zoom. A pyramid that
              smooths is a pyramid that lies.
            </p>
            <div class="vp-scroll-x"><table class="vp-collapse-table">
              <thead>
                <tr><th>level</th><th>bp / bin</th><th>bins</th><th>rows</th><th>used at</th></tr>
              </thead>
              <tbody>
                {levelRows.map((l) => (
                  <tr>
                    <td>L{l.level}</td>
                    <td>{l.binBp.toLocaleString()}</td>
                    <td>{l.bins.toLocaleString()}</td>
                    <td>{l.rows === 1 ? 'value' : 'min / max / mean'}</td>
                    <td>{l.binBp === 1 ? 'under 8 bp a pixel' : `${l.binBp.toLocaleString()} bp a pixel and coarser`}</td>
                  </tr>
                ))}
              </tbody>
            </table></div>
            <p>
              {totalTiles.toLocaleString()} tiles of {index.tileBins.toLocaleString()} bins across
              {' '}<strong>{index.tracks.length} score tracks</strong>, as greyscale PNG — the same
              encoding every other pack in this lab uses, because{' '}
              <code>createImageBitmap</code> decodes it natively and no JavaScript inflate has to
              ship. A viewport fetches only the handful of tiles it covers, at only the resolution it
              can draw, and the cache is bounded — and the bound scales with how many score tracks
              are on, or enabling all three would make every pan evict tiles it is about to need
              again. Alongside them: the reference sequence one byte a base for the letter view,
              {' '}{totalGenes.toLocaleString()} gene models, and the annotation layer.
            </p>
            <p>
              <strong>Byte 0 means "no data", in every track.</strong> phastCons has no value where
              the 7-yeast alignment has none, so values occupy 1–255 and 0 is reserved. Quantised
              naively that base would become 0, which draws as <em>completely unconserved</em>
              {' '}exactly where the truth is <em>not aligned</em>. It costs 0.4% of the precision
              and it is the same rule for the model tracks, which need it nowhere — one decode path
              rather than two.
            </p>
            <div class="vp-scroll-x"><table class="vp-collapse-table">
              <thead>
                <tr><th>track</th><th>units</th><th>axis</th><th>what it is</th></tr>
              </thead>
              <tbody>
                {index.tracks.map((tr) => (
                  <tr>
                    <td><strong>{tr.label}</strong></td>
                    <td>{tr.units}</td>
                    <td>{tr.axis[0]}–{tr.axis[1]}</td>
                    <td>{tr.detail}. {tr.note}</td>
                  </tr>
                ))}
              </tbody>
            </table></div>
          </div>
        </details>

        <details class="vp-how">
          <summary>Is the model just reading base composition? No — and here is the number</summary>
          <div class="vp-how-body">
            <p>
              The first objection to any claim that a language model measures <em>constraint</em> is
              that it might only be measuring <strong>composition</strong>: AT-rich sequence is
              easier to predict than GC-balanced sequence for reasons that have nothing to do with
              function. The GC lane exists so that objection has an answer on the page rather than
              in a reader's suspicion.
            </p>
            {gcCmp && (
              <>
                <div class="vp-scroll-x"><table class="vp-collapse-table">
                  <thead>
                    <tr><th>over</th><th>bases</th><th>Pearson r</th><th>mean IC</th><th>mean GC</th></tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td><strong>whole genome</strong></td>
                      <td>{gcCmp.bases.toLocaleString()}</td>
                      <td><strong>{gcCmp.pearson.toFixed(3)}</strong></td>
                      <td>{gcCmp.meanIc.toFixed(3)}</td>
                      <td>{(gcCmp.meanGc * 100).toFixed(1)}%</td>
                    </tr>
                    {Object.entries(gcCmp.byClass).map(([name, v]) => (
                      <tr>
                        <td>{name === 'cds' ? 'coding sequence' : name}</td>
                        <td>{v.bases.toLocaleString()}</td>
                        <td>{v.pearson.toFixed(3)}</td>
                        <td>{v.meanIc.toFixed(3)}</td>
                        <td>{(v.meanGc * 100).toFixed(1)}%</td>
                      </tr>
                    ))}
                  </tbody>
                </table></div>
                <p>
                  <strong>Genome-wide, r = {gcCmp.pearson.toFixed(3)}</strong> — composition
                  explains about {(gcCmp.pearson ** 2 * 100).toFixed(2)}% of the variance in the
                  model's certainty. That is the reassuring answer, and it is the one a control is
                  supposed to give.
                </p>
                <p>
                  <strong>But small overall is not zero everywhere.</strong> Inside coding sequence
                  the correlation is {gcCmp.byClass.cds.pearson.toFixed(3)}; in intergenic sequence
                  it is <strong>{gcCmp.byClass.intergenic.pearson.toFixed(3)}</strong> — AT-rich
                  intergenic sequence really is more predictable to the model. The same effect shows
                  at chromosome scale: chrM is the most AT-rich sequence in the genome at
                  {' '}{mitoGc !== null ? `${(mitoGc * 100).toFixed(1)}%` : '17.1%'} GC and also the
                  most predictable, at {mitoIc !== null ? mitoIc.toFixed(3) : '0.457'} bits against a
                  nuclear {meanIc.toFixed(3)}. Read a peak in an AT-rich region with that in mind.
                </p>
                <p class="vp-notes">
                  The window is <strong>50 bp, centred</strong>. A 5 bp window — UCSC's choice for
                  its own GC track — takes only six values and is not a composition; the model's own
                  128 bp pooling grid would build the thing being controlled for into the control.
                  As a check that the computation is right, the genome-wide figure comes out at
                  38.15% against the published 38.1%.
                </p>
              </>
            )}
          </div>
        </details>

        <details class="vp-how">
          <summary>The annotation layer, and why the binding sites are in three tiers</summary>
          <div class="vp-how-body">
            <p>
              Every feature comes from a flat file rather than a per-window API call: the SGD
              annotation for tRNA, snoRNA, ncRNA, snRNA and rRNA genes, replication origins,
              centromeres, telomeres, LTRs, transposons, pseudogenes and uORFs; the
              Harbison/MacIsaac regulatory code for transcription-factor binding; ORegAnno for
              literature-curated regulatory regions; phastCons element calls; and UCSC's tandem
              repeats.
            </p>
            <p>
              <strong>The binding sites are split three ways and never merged, because they are
              three different claims.</strong> A ChIP-supported call is a measurement that the
              factor binds there. A conserved-only call is an argument that it might. A motif-only
              call says just that the letters look right. The expression playground measures
              attribution enriching <strong>3.26×</strong> on the ChIP tier against 1.25× and 1.49×
              on the other two — and there are 122,225 motif-only calls genome-wide against 15,979
              ChIP-supported ones, so one merged "TFBS" lane would bury the strong result under the
              weak one. Turn the tiers on separately in the track panel and the difference is
              visible directly.
            </p>
            <p>
              <strong>JASPAR is deliberately absent.</strong> Unfiltered it is 16.7 million hits
              genome-wide — 1.4 per base, which is a scan rather than an annotation.
            </p>
            <p>
              Above about {(60000).toLocaleString()} bp a feature lane draws a <em>density</em>
              {' '}profile instead of individual features, and the readout says which it is showing.
              That is what IGV does, and it is the difference between a lane that carries
              information and a solid bar.
            </p>
          </div>
        </details>

        <details class="vp-how">
          <summary>Two models on one axis, and they predict different things</summary>
          <div class="vp-how-body">
            <p>
              The lanes here come from <strong>two different networks</strong> that share an
              encoder and answer opposite questions, and reading one as the other is the mistake
              this page most invites.
            </p>
            <p>
              <strong>Shorkie_LM</strong> ({(index.tracks.filter((x) => x.id.startsWith('lm-')).length)}
              {' '}lanes) predicts <em>the sequence itself</em>: mask a base, ask what belongs
              there, and report how concentrated the answer is. Its units are bits, and a tall
              column means <em>constrained</em> — the surrounding sequence determines what goes here.
            </p>
            <p>
              <strong>Shorkie</strong> ({(index.tracks.filter((x) => x.id.startsWith('sk-')).length)}
              {' '}lanes) predicts <em>what an assay would measure</em> on that sequence — RNA-seq,
              ChIP-exo, ChIP-MNase — plus a signed per-base attribution of its own RNA-seq
              prediction. Its units are arbitrary coverage, and a tall column means{' '}
              <em>expressed</em>, which is a completely different claim. A gene body is high on both
              lanes for unrelated reasons.
            </p>
            <p>
              Both were run over the same {index.window.core.toLocaleString()} bp cores in the same
              {' '}{index.window.seqLen.toLocaleString()} bp windows on the same 128 bp pooling
              phase, so the two are aligned base for base and can be read against each other. Turn
              on exactly two lanes and the header prints their <strong>correlation over the
              visible window</strong>, which is the fastest way to see that a genome-wide number
              and a local one are rarely the same: model constraint against phastCons is 0.121
              genome-wide and about 0.47 over a strongly expressed gene.
            </p>
            <p>
              <strong>The coverage lanes are 16 bp, and no finer level exists.</strong> Shorkie's
              head emits 896 bins of 16 bp; storing a per-base version would be
              {' '}{totalBp.toLocaleString()} numbers carrying {Math.round(totalBp / 16).toLocaleString()}
              {' '}values of real information, drawn as though the model resolved single bases. The
              attribution <em>is</em> per base, because it is a derivative with respect to the
              one-hot input. When a lane is pinned at its own floor the resolution readout names it
              rather than letting the headline speak for every lane.
            </p>
          </div>
        </details>

        <details class="vp-how">
          <summary>What every score track is — source, meaning, and how to read it</summary>
          <div class="vp-how-body">
            <p>
              Four fields per track, and the fourth is the one that matters: every track here
              invites a specific misreading, and naming it is more useful than another sentence
              about what the track shows. These come from the generator's own track table, so a
              track cannot be added to the browser without them.
            </p>
            {index.tracks.map((tr) => (
              <div class="gb-ref">
                <h3>{tr.label} <span class="vp-stat">{tr.units} · {tr.axis[0]}–{tr.axis[1]}</span></h3>
                <p><strong>Source.</strong> {tr.docs.source}</p>
                <p><strong>Measures.</strong> {tr.docs.measures}</p>
                <p><strong>How to read it.</strong> {tr.docs.read}</p>
                <p><strong>What it does not mean.</strong> {tr.docs.caveat}</p>
              </div>
            ))}
            <p class="vp-notes">
              The annotation lanes carry the same four fields; open <em>what this is</em> beside any
              of them in the track panel.
            </p>
          </div>
        </details>

        <details class="vp-how">
          <summary>What the constraint track is not</summary>
          <div class="vp-how-body">
            <p>
              It is one number a base — how concentrated the model's four-way distribution is — and
              not <em>which</em> base the model expects. The full constraint logo, the
              composition-floor comparison and the region statistics need all four probabilities at
              every position, which is {(index.chroms.length && totalBp * 4 / 1e6).toFixed(0)} M
              values genome-wide; those stay on the 23 primary regions, which ship complete packs.
              Use the jump menu above to move between the two.
            </p>
            <p>
              High information content means the model is confident, not that a base is functionally
              important — the two correlate but are not the same claim, and the model was trained on
              165 <em>Saccharomycetales</em> genomes, so a confidently predicted base is one that is
              predictable <em>from that comparative context</em>. Coding sequence comes out more
              constrained than the genome average in 14 of 14 tested windows; LTRs and transposons
              come out less. chrM is far more predictable than any nuclear chromosome because it is
              AT-rich and repetitive, which is a property of the sequence rather than of its
              function — and it is also where phastCons has the least to say, at
              {' '}{((index.chroms.find((c) => c.name === 'chrM')?.tracks['phastcons']?.scored ?? 0)
                / (index.chroms.find((c) => c.name === 'chrM')?.length ?? 1) * 100).toFixed(0)}%
              coverage against over 99% on every nuclear chromosome.
            </p>
          </div>
        </details>
      </section>
    </div>
  </div>

  <script>
    import '../../scripts/genomeBrowser';
  </script>
</BaseLayout>
