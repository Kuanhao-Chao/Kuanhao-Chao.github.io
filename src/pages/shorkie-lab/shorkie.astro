     only the shell: a chip row, a header, and a stage that the two canvases fill. */
  .gw-browser {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
    overflow: hidden;
    background: var(--color-surface);
  }

  .gw-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid var(--color-border);
  }

  .gw-chip {
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
  }

  .gw-chip:hover { border-color: var(--color-accent); }

  .gw-chip.is-active {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-bg);
  }

  .gw-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--color-border);
  }

  .vp-genome-link {
    white-space: nowrap;
    text-decoration: none;
    border-bottom: 1px solid currentcolor;
  }

  .fr-canvas {
    display: block;
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius, 6px);
    background: var(--color-bg);
  }

  .gw-foot {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.5rem 0.6rem;
    border-top: 1px solid var(--color-border);
  }

  .gw-stage { position: relative; background: var(--color-bg); }
  .gw-stage .gb-mini { width: 100%; height: 30px; display: block; cursor: pointer; }

  /* No minimum width. A floor on the backing store makes it wider than its box, `width: 100%`
     scales it back, and every horizontal coordinate is off by that ratio -- ruler, track and gene
     models each by the same amount, so nothing looks broken. */
  .gw-stage .gb-track {
    width: 100%;
    display: block;
    cursor: grab;
    touch-action: none;
  }

  .gw-stage .gb-track:active { cursor: grabbing; }

  @media (max-width: 560px) {
    /* One scrolling row, not four wrapped ones. 23 chips wrap to 112 px of chrome on a 390 px
       phone, which pushes the canvas -- the thing the section exists to show -- below the fold. */
    .gw-chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      padding: 0.4rem;
      gap: 0.2rem;
    }

    .gw-chips::-webkit-scrollbar { display: none; }
    .gw-chip { font-size: 0.7rem; padding: 0.12rem 0.4rem; flex: 0 0 auto; }
    /* The nav buttons wrap under the readout rather than squeezing it to nothing. */
    .gw-head { padding: 0.35rem 0.45rem; }
    .gw-head .vp-spacer { display: none; }
  }
