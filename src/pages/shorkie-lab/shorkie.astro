---
import ShorkiePanelHead from '../../components/ShorkiePanelHead.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/variantPlayground.css';
import { SPEC_NOTES } from '../../lib/shorkieModel';
import { site } from '../../data/site';
import { buildBreadcrumbLd } from '../../lib/breadcrumbs';
import lociData from '../../data/shorkieLoci.json';
import speciesData from '../../data/shorkieSpecies.json';
import epistasisData from '../../data/shorkieEpistasis.json';
import kineticsData from '../../data/shorkieKinetics.json';
import receptiveData from '../../data/shorkieReceptive.json';
import headsData from '../../data/shorkieHeads.json';
import variationData from '../../data/shorkieVariation.json';
import giaData from '../../data/shorkieGia.json';
import spacingData from '../../data/shorkieSpacing.json';
import positionData from '../../data/shorkiePosition.json';
import cfData from '../../data/shorkieCounterfactual.json';
import bioSummary from '../../data/shorkieBiologySummary.json';
import patchingData from '../../data/shorkiePatching.json';
import modiscoData from '../../data/shorkieModisco.json';
import saeData from '../../data/shorkieSae.json';

// Derived, not typed. Four passages here described the enrichment figure and the knockout sweep as
// covering fourteen windows after the set had grown to 23 -- and `shorkieBiologySummary.json`, which
// is what both are computed from, carries 23. The two "fourteen" figures further up are deliberately
// NOT this constant: they describe a timed benchmark run that really did cover fourteen loci.
const nLoci = lociData.loci.length;

// The frontier panels' headline numbers, read from the generated tables rather than typed — the
// same rule the rest of this page follows after "fourteen windows" survived in four places.
const spSummary = speciesData.summary;
const spControl = speciesData.control;
const epi = epistasisData;
const kinData = kineticsData;
const recData = receptiveData;
const varClasses = variationData.classes;
const giaJoin = giaData.necessityJoin;
const SPLICE_IDS = ['donor', 'branch', 'acceptor', 'start', 'stop'];
const giaTfs = Object.entries(giaData.motifs)
  .filter(([id]) => !SPLICE_IDS.includes(id)).map(([, m]) => m);
const giaTop = giaTfs.filter((m) => m.verdict.startsWith('sufficient') && m.marginOverScramble > 0)
  .sort((a, b) => b.marginOverScramble - a.marginOverScramble).slice(0, 3);
const giaBottom = giaTfs.filter((m) => m.verdict.startsWith('sufficient') && m.marginOverScramble < 0)
  .sort((a, b) => a.marginOverScramble - b.marginOverScramble).slice(0, 3);
const giaDonor = giaData.motifs.donor;
const giaBranch = giaData.motifs.branch;
const giaNotSuff = (giaJoin?.rows ?? []).filter((r) => r.quadrant === 'necessary, not sufficient');
const spBest = Object.values(spacingData.pairs).reduce((a, b) => (b.maxInteraction > a.maxInteraction ? b : a));
const spNearHelix = Object.values(spacingData.pairs)[0].harmonicsNearHelix;
const posEntries = Object.values(positionData.motifs);
const posBest = posEntries.reduce((a, b) => (b.upstream500 > a.upstream500 ? b : a));
const posFlat = posEntries.filter((m) => Math.abs(m.upstream500) < 0.03
  && Math.abs(m.inside500) < 0.03).map((m) => m.name);
const patch = patchingData as {
  stages: string[]; bands: number; bandBp: number;
  summary: { loci: number; medianBottleneckMean: number; medianStemMean: number;
             medianPeakRecovery: number; medianSkipBypass: number; peakStages: string[] };
  loci: Record<string, { gene: string; peak: { stage: string; band: number; recovery: number };
                         skipBypass: number; bottleneckMean: number; gap: number }>;
};
const patchLoci = Object.values(patch.loci);
// Where recovery peaks, counted over the loci. The claim is about DEPTH, so the stages are bucketed
// into the three architectural regions rather than listed one by one -- 19 stage names in a
// sentence is a list, not a result.
const patchRegion = (s: string) =>
  (s.startsWith('attn_out') ? 'bottleneck' : s.startsWith('decoder') ? 'decoder' : 'encoder');
const patchPeakRegion = (['encoder', 'bottleneck', 'decoder'] as const).map((r) => ({
  region: r,
  n: patchLoci.filter((l) => patchRegion(l.peak.stage) === r).length,
}));

const sae = saeData as {
  layer: string; dModel: number; positions: number; positionBp: number; kmer: number;
  classes: string[];
  real: { fvu: number; alive: number; dead: number; meanL0: number; vectors: number;
          features: number; k: number; steps: number };
  control: { fvu: number; alive: number; meanL0: number };
  reconstructionGain: number;
  grounding: { matchedCandidates: number; shifts: number; saeMedianBestRatio: number;
               saeMaxBestRatio: number; rawMedianBestRatio: number; rawMaxBestRatio: number;
               dictionaryWins: boolean };
  features: { index: number; cells: number;
              kmers: { kmer: string; enrichment: number; count: number }[];
              best: { cls: string; ratio: number; p: number } | null }[];
};
// The features that ground most strongly, and how many land on a binding-site tier -- the harder
// claim, since a tRNA gene is GC-rich and a feature can find it on composition alone.
const saeTop = [...sae.features].filter((f) => f.best)
  .sort((a, b) => b.best!.ratio - a.best!.ratio).slice(0, 6);
const saeTfbs = sae.features.filter((f) => f.best?.cls.startsWith('tfbs')).length;
// A JSON key is not a label. `trna` and `snrna` are identifiers; tRNA and snRNA are what a reader
// knows them by, and the capitalisation carries the molecule. Same defect as the annotation
// readout printing `tfbs_chip`, fixed the same way.
const CLASS_LABEL: Record<string, string> = {
  trna: 'tRNA gene', snrna: 'snRNA gene', snorna: 'snoRNA gene', rrna: 'rRNA gene',
  ncrna: 'ncRNA', ltr: 'LTR', ars: 'replication origin', ars_consensus: 'ARS consensus',
  uorf: 'uORF', utr_intron: 'UTR intron', centromere: 'centromere', telomere: 'telomere',
  transposon: 'transposon', pseudogene: 'pseudogene', repeat: 'repeat',
  conserved_element: 'conserved element', regulatory: 'regulatory region',
  tfbs_chip: 'binding site · ChIP', tfbs_conserved: 'binding site · conserved',
  tfbs_pwm: 'binding site · PWM', variant_missense: 'missense variant',
  variant_synonymous: 'synonymous variant', variant_noncoding: 'non-coding variant',
};
const classLabel = (c: string) => CLASS_LABEL[c] ?? c.replace(/_/g, ' ');
const saeClasses = new Set(sae.features.filter((f) => f.best).map((f) => f.best!.cls)).size;

const modisco = modiscoData as {
  width: number; widths: number[]; clusterThreshold: number; nullQuantile: number;
  jasparMatrices: number;
  grid: { width: number;
          real: { seqlets: number; clusters: number; matched: number };
          control: { seqlets: number; clusters: number; matched: number; bits: number } }[];
  real: { seqlets: number; clusters: number; matched: number };
  control: { seqlets: number; clusters: number; matched: number; bestR: number; bits: number };
  clusters: { seqlets: number; loci: number; consensus: string; bits: number;
              match: { id: string; name: string; r: number } | null; bestR: number }[];
};

const cf = cfData.summary;

// The genome-wide section's numbers come from the tiles that shipped, not from prose. `nLoci`
// above already exists because four passages here said "fourteen" after the set had grown to 23.

// Each preset locus as a browser coordinate, derived from the gene's own span inside its window --
// never typed, so a locus cannot drift from the window the model actually ran on.

// A `bare` page, so it carries its own header and needs its own <h1> -- audit:indexing asserts a
// visible heading on every sitemap URL. The page is NOT at /shorkie/: that path already serves the
// project documentation site on this domain.
const title = 'The Live Variant Playground — Shorkie, layer by layer';
const description =
  'An in-browser sandbox running the real Shorkie fungal sequence-to-function model: edit DNA and watch the conv-stem neurons fire live, then run the full 14 M-parameter network to predict RNA-seq coverage across a 16,384 bp yeast window.';

const webAppLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'The Live Variant Playground — Shorkie',
  applicationCategory: 'DeveloperApplication, ScienceApplication',
  operatingSystem: 'Web Browser (WebAssembly ONNX Runtime)',
  description,
  url: `${site.url}/shorkie-lab/shorkie/`,
  author: { '@id': `${site.url}/#person` },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbLd = buildBreadcrumbLd([
  { name: 'Shorkie Lab', path: '/shorkie-lab/' },
  { name: 'Shorkie — expression', path: '/shorkie-lab/shorkie/' },
]);
---

<BaseLayout title={title} description={description} bare={true}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
  <div class="vp" data-vp>
    <header class="vp-top">
      <h1 class="vp-title">The Live Variant Playground</h1>
      <span class="vp-sub">Shorkie · Chao et al. 2025 · fold f0, 14,253,567 parameters</span>
      <span class="vp-spacer"></span>
      <a class="vp-sub" href="/shorkie-lab/shorkie_lm/">Language model →</a>
      <a class="vp-sub" href="/shorkie-lab/">Lab</a>
      <a class="vp-sub" href="/posts/shorkie/">Post</a>
    </header>

    <div class="vp-scroll">
      <!-- The one place locus and region are chosen. `position: sticky` resolves against the
           nearest scrolling ancestor, which is .vp-scroll and not the document, so this bar has to
           live inside it. -->
      <nav class="vp-nav" aria-label="Locus and region">
        <span class="vp-nav__group">
          <label class="vp-nav__label" for="vp-locus">locus</label>
          <select class="vp-select" id="vp-locus" data-vp-locus aria-label="Preset locus"></select>
          <!-- The mirror of the browser's "open the full analysis" link, so the two pages point at
               each other from wherever a reader happens to be. -->
          <a class="vp-sub vp-genome-link" data-vp-genome-link href="/shorkie-lab/genome/"
             title="See this window in the genome browser, in the genome around it">in genome ↗</a>
        </span>
        <span class="vp-nav__group">
          <label class="vp-nav__label" for="vp-region">region</label>
          <button type="button" class="vp-btn vp-btn--icon" data-vp-region-prev
                  aria-label="Previous region">‹</button>
          <select class="vp-select" id="vp-region" data-vp-region aria-label="Region to trace"></select>
          <button type="button" class="vp-btn vp-btn--icon" data-vp-region-next
                  aria-label="Next region">›</button>
          <!-- The handler for this existed and the button did not, so there was no way to stop
               tracing once a region was picked -- and every panel below stayed conditioned on a
               region the reader had moved on from. -->
          <button type="button" class="vp-btn" data-vp-trace-clear
                  title="Stop conditioning the panels below on a region">clear</button>
        </span>
        <span class="vp-stat vp-nav__read" data-vp-trace-label></span>
        <span class="vp-spacer"></span>
        <span class="vp-stat" data-vp-region-stat></span>
      </nav>
    <div class="vp-body">
      <!-- ============================== 1 · The system and the question ============================== -->
      <section class="vp-act" id="act-1">
        <h2 class="vp-act__h"><span class="vp-act__n">1</span>The system and the question</h2>
        <p class="vp-act__sub">A 16,384 bp window in; coverage over 896 bins and 5,215 tracks out. Everything below shares one set of coordinates and one scalar — pick a locus and a region in the bar above, then read straight down.</p>
        <section class="vp-panel">
          <h3>The window, and the one number every method differentiates</h3>
        <ShorkiePanelHead
          question="What does the model take in, and what single scalar does every method on this page differentiate?"
          method="A 16,384 bp window centred on one gene. f(x) = log2( Σ over that gene's bins of the mean over the 384 T0 RNA-seq tracks, + 1 ) — the paper's own logSED target, ensemble.py:97-104."
          cost="Free. The sequence and the gene models ship with the page."
          refuted="Nothing here is a claim; it is the definition everything below is measured against." />
          <div class="vp-motifs" data-vp-motifs hidden>
            <p class="vp-notes" style="margin:0 0 0.35rem;">
              <strong>Figure 4 motifs.</strong> Database consensus matches found in this window on
              either strand — not the paper's own annotations, which this scan neither reproduces
              exactly nor claims to. Click one to scramble it and re-run: same length, same base
              composition, only the order destroyed, so any change is attributable to the arrangement
              rather than to GC content. The effect is measured over <em>this window's own gene</em>,
              not the whole window — a 14,336 bp yeast window holds a dozen genes and the tallest is
              usually not the one whose promoter you edited.
            </p>
            <p class="vp-notes" style="margin:0 0 0.35rem;">
              Expect a wide range. Across these six windows the splicing motifs dominate — knocking
              out DTD1's 5′ splice site costs <strong>34%</strong> of its predicted expression and its
              branch point 21% — while transcription-factor sites range from −18.3% (HOP2's TATA box) through
              −10.5% (KRE33's Reb1) and −7.4% (FUN12's RRPE) down to sites that move nothing at all. A near-zero result is a real
              answer about that site, not a broken button.
            </p>
            <div class="vp-motif-row" data-vp-motif-list></div>
            <p class="vp-stat" data-vp-knockout></p>
          </div>
          <p class="vp-notes" style="margin:0.35rem 0 0;">
            Each locus is a <strong>16,384 bp window</strong> — the model's full context — centred on
            the named gene. Six of them are the windows Figure 4 of the paper prints, at the
            published coordinates; the rest are classic high-expressers and the galactose regulon.
            In goes 16,384 × 170 channels — 4 DNA, 1 unused, 165 species — and out come{' '}
            <strong>896 bins of 16 bp</strong> across 5,215 tracks, with 1,024 bp cropped from
            each end.
          </p>
          <p class="vp-notes" style="margin:0.5rem 0 0;">
            <strong>Every method below differentiates the same scalar</strong>, and that is the only
            reason they can share an axis or be compared at all:
          </p>
          <p class="vp-notes vp-target" style="margin:0.4rem 0 0;">
            <code>f(x) = log₂( Σ<sub>gene bins</sub> mean<sub>384 T₀ tracks</sub> coverage + 1 )</code>
          </p>
          <p class="vp-notes" style="margin:0.4rem 0 0;">
            That is the paper's own logSED target (<code>ensemble.py:97-104</code>): the mean is over{' '}
            <em>tracks</em>, the sum is over <em>bins</em>, the pseudocount sits inside the log, and
            the base is 2. The order matters — a mean of logarithms is not the logarithm of a mean.
            Being a log <em>ratio</em> is what makes a silent promoter and a maximal one comparable,
            and it is why “a stronger effect” on this page is meaningless without saying stronger
            relative to what. The 384 <code>_T0_</code> tracks are the uninduced baseline subset the
            paper's Figure 4 uses, not the whole 3,053-track RNA-seq block.
          </p>
        </section>
      </section>

      <!-- ============================== 2 · What can the model see at all? ============================== -->
      <section class="vp-act" id="act-2">
        <h2 class="vp-act__h"><span class="vp-act__n">2</span>What can the model see at all?</h2>
        <p class="vp-act__sub">Before asking which bases drove a prediction, ask how many bases could. The architecture reaches the whole window; "can see" and "depends on" are different claims and only the second is measurable. This scopes every method that follows.</p>
      <section class="vp-panel" data-shorkie-constructive>
        <h3>Before asking which bases drove it — how many bases can?{' '}
          <span class="vp-stat">effective receptive field</span>
        </h3>
        <ShorkiePanelHead
          question="How much of the 16,384 bp of context does the prediction actually depend on?"
          method="Keep a centred core of real sequence, dinucleotide-shuffle everything outside it, and grow the core until the prediction settles inside ±5%."
          cost={`${recData.shuffles} shuffles × ${recData.radii.length} radii = ${recData.shuffles * recData.radii.length} forward passes a locus, ${nLoci} windows.`}
          refuted="Two controls. At the largest radius the window is entirely real, so that point must reproduce the full-context prediction — and convergence requires every larger radius to stay inside the band too." />
        <p class="vp-notes vp-lede" style="margin:0 0 0.7rem;">
          Every attribution method on this page distributes credit across all 16,384 bases, and the architecture really
          can reach all of them — dilated convolutions into full self-attention at the bottleneck.
          But <em>can see</em> and <em>depends on</em> are different claims, and only the second is
          measurable. Keep a centred core of real sequence, replace everything outside it with
          dinucleotide-shuffled DNA, and grow the core until the prediction stops moving.
        </p>
        <canvas class="fr-canvas" data-cn-receptive height="210"
                aria-label="Predicted expression against the radius of real sequence kept, for every window"></canvas>
        <p class="vp-stat" data-cn-receptive-stat></p>
        <p class="vp-notes" style="margin:0.35rem 0 0;">
          <strong>The effective context is a property of the gene, not of the model.</strong> The
          median window is settled by <strong>±{recData.medianConvergenceBp.toLocaleString()} bp</strong>{' '}
          of the ±8,192 available, and the six constitutive glycolytic genes — TDH3, PGK1, ACT1,
          ADH1, FBA1, PDC1 — are all finished by <strong>±1 kb</strong>: a housekeeping promoter
          determines its own gene. <strong>GAL1 needs the entire window</strong>, and GAL3, FUN12 and
          KRE33 need ±4 kb. That is the practical scope of every attribution on this page — outside
          a window's own radius there is little left to attribute.
        </p>
        <details class="vp-how">
          <summary>Why shuffled and not zeroed, and the two controls</summary>
          <div class="vp-how-body">
            <p><strong>Zeroing the DNA channels is what occlusion does</strong>, and it is
            indistinguishable from a run of N — a sequence the model has never seen. The answer
            would then be about out-of-distribution input rather than about context. A{' '}
            <strong>dinucleotide</strong> shuffle is the right null because yeast promoters carry
            strong dinucleotide bias, poly(dA:dT) above all, and a mononucleotide shuffle destroys
            that too. The shuffle is Altschul-Erikson — a random Euler path through the dinucleotide
            graph — and <code>make_receptive.py</code> refuses to run unless all sixteen dinucleotide
            counts survive it exactly on a 4,000 bp probe.</p>
            <p><strong>At the largest radius the window is entirely real</strong>, so that point must
            reproduce the full-context prediction. It does, at every locus, which is the check that
            the splicing and scoring path is not itself perturbing anything. And convergence requires
            every <em>larger</em> radius to stay inside the ±5% band as well, so a curve that crosses
            once and wanders back out is not counted as converged.</p>
            <p>{recData.shuffles} shuffles per radius per locus, {recData.radii.length} radii,{' '}
            {nLoci} windows. The spread across shuffles is stored alongside each point.</p>
          </div>
        </details>
      </section>
      </section>

      <!-- ============================== 3 · What does it predict? ============================== -->
      <section class="vp-act" id="act-3">
        <h2 class="vp-act__h"><span class="vp-act__n">3</span>What does it predict?</h2>
        <p class="vp-act__sub">The prediction itself, on one zoomable axis with everything that
        explains it. Zoom in far enough and the per-base attribution lanes turn into DNA logos in
        place; every lane is the same base pair at the same x.</p>
      <section class="vp-panel">
        <h3>Predicted coverage — the full model{' '}
          <span class="vp-stat">this window, 16,384 bp</span>
        </h3>
        <ShorkiePanelHead
          question="What does the model predict across this window, what drove it, and what is actually annotated there?"
          method="One forward pass for the curve (896 bins × 16 bp); every attribution lane rc-averaged and drawn at its own real step; annotation from SGD, ORegAnno, Harbison/MacIsaac and a JASPAR scan."
          cost="Free. Every locus was run offline and the packs ship with the page."
          refuted="This is a drawing, not a claim. Its correctness condition is that one base pair lands at one x in every lane — which one canvas makes true by construction rather than by assertion." />
        <p class="vp-notes vp-lede" style="margin:0 0 0.7rem;">
          Everything on this page is about ONE window at a time — the locus in the bar above. This
          is what the model predicts across it, what drove that prediction, and what is actually
          annotated there, on one shared axis so a peak can be read against a gene. For the same
          quantities across all 12,157,105 bases, and for the language model beside them, the{' '}
          <a href="/shorkie-lab/genome/">genome browser</a> is the other half of this lab.
        </p>
        <div class="vp-controls" style="margin-bottom:0.5rem;">
          <label class="vp-label" for="vp-group">assay group</label>
          <select class="vp-select" id="vp-group" data-vp-group aria-label="Output track group"></select>
          <button type="button" class="vp-btn" data-vp-run>Load model — live layers &amp; editing</button>
          <span class="vp-status" data-vp-status></span>
        </div>

        <!-- The whole window, with the view as a band. The selection surface, which is where every
             genome browser puts it: dragging selects and zooms, clicking centres. That keeps the
             main canvas free for panning and avoids a mode toggle entirely. -->
        <canvas class="vp-canvas vp-overview" data-vp-overview role="img"
                aria-label="The whole 16,384 bp window, with the current view marked"></canvas>

        <div class="vp-controls vp-zoomctl">
          <button type="button" class="vp-btn vp-btn--icon" data-vp-zoom-out
                  aria-label="Zoom out">−</button>
          <button type="button" class="vp-btn vp-btn--icon" data-vp-zoom-in
                  aria-label="Zoom in">+</button>
          <button type="button" class="vp-btn" data-vp-zoom-reset
                  title="Back to the whole 16,384 bp window">whole window</button>
          <label class="vp-check" title="The mean-centred plane itself, rather than its projection onto the base that is there">
            <input type="checkbox" data-vp-ism-hypothetical /> mutagenesis: all four bases
          </label>
          <!-- Both of these drive the viewport, so they live on it. They sat two acts below in the
               method-comparison panel, which has no plot for them to control -- a leftover of the
               act reorder, and a control whose effect is off screen is worse than no control. -->
          <label class="vp-check"><input type="checkbox" data-vp-logaxis checked /> log axis</label>
          <label class="vp-check"><input type="checkbox" data-vp-generows checked /> one row per gene</label>
          <span class="vp-stat vp-nav__read" data-vp-view-read></span>
        </div>

        <!-- ONE canvas. Four stacked elements used to draw this -- a coverage SVG, an attribution
             canvas, a method strip and an annotation canvas -- each computing its own left inset,
             so the same base pair landed at four different x positions at every container width but
             ~1,043 px. One `laneLayout` and one `xOfBp` makes that disagreement inexpressible. -->
        <canvas class="vp-canvas vp-viewport" data-vp-viewport role="img" tabindex="0"
                aria-label="Predicted coverage, every attribution method — as DNA logos once zoomed in — the sequence and the annotation, on one zoomable axis"></canvas>

        <p class="vp-notes" style="margin:0.35rem 0 0.6rem;">
          <strong>Drag to pan, drag the ruler to select, scroll to zoom — and keep going.</strong>{' '}
          Past about seven pixels a base the three per-base attribution lanes stop being bars and{' '}
          <em>become</em> DNA logos — mutagenesis, gradient × input and integrated gradients, each
          in place, each still the same lane — and the sequence appears beneath them. Nothing new
          pops up: the same three measurements are simply drawn where every base has room for its
          own letter. Occlusion and attention rollout stay as bands, because 64 bp and 128 bp a
          value cannot be letters and stretching them into some would claim a resolution neither
          has. Every lane is the same base pair at the same x, so a peak can be read straight
          down against a motif and a gene. Click anywhere to trace the 16 bp bin under the pointer;
          the shaded band is what every panel below is conditioned on. The flanks are shaded because
          the head crops 1,024 bp from each end — the curve covers 896 bins of 16 bp and the model
          still reads the whole 16,384 bp to produce them.
        </p>
        <p class="vp-notes" style="margin:0.35rem 0 0.6rem;">
          <strong>Every attribution lane is signed, and that is the whole reading.</strong> A bar
          above the rule is a base whose presence RAISES the prediction, below it one that lowers
          it. Each lane is drawn at its <em>own</em> real step and labelled with it: mutagenesis and
          the two gradient methods resolve a single base, occlusion 64 bp, attention rollout 128 bp.
          Nothing is stretched into a resolution it does not have.
        </p>
        <div class="vp-controls vp-annctl">
          <span class="vp-stat">show</span>
          <label class="vp-check"><input type="checkbox" data-vp-lane="gene" checked /> genes</label>
          <label class="vp-check"><input type="checkbox" data-vp-lane="rna" checked /> ncRNA</label>
          <label class="vp-check"><input type="checkbox" data-vp-lane="element" checked /> elements</label>
          <label class="vp-check"><input type="checkbox" data-vp-lane="regulatory" checked /> regulatory</label>
          <span class="vp-stat">binding sites</span>
          <label class="vp-check"><input type="checkbox" data-vp-tier="chip" checked /> ChIP-supported</label>
          <label class="vp-check"><input type="checkbox" data-vp-tier="conserved" /> conserved only</label>
          <label class="vp-check"><input type="checkbox" data-vp-tier="pwm" /> PWM scan</label>
          <span class="vp-stat" data-vp-annstat></span>
        </div>
        <p class="vp-notes" style="margin:0.35rem 0 0;">
          <strong>What is actually there, from the databases.</strong> Genes, CDS, introns, uORFs,
          tRNA and snoRNA genes, replication origins, LTRs and transposons come from <em>SGD</em>;
          regulatory regions from <em>ORegAnno</em>; binding sites from the{' '}
          <em>Harbison 2004 / MacIsaac 2006</em> conserved regulatory code and from a <em>JASPAR</em>{' '}
          PWM scan. Provenance is drawn, not just recorded: a ChIP-supported site is solid, a
          conserved-only call is hollow, a PWM match is a hairline — three different strengths of
          evidence that must not be read as one. A grey cap marks a feature clipped by the window
          edge, so that edge is never mistaken for a real boundary.
        </p>
        <p class="vp-notes" style="margin:0.5rem 0 0;">
          <strong>Nothing here waits on a model.</strong> Every preset locus was run offline at the
          full 16,384 bp context and its predictions ship with the page. Loading the model — a
          28.6 MB download and about 17 s of WebAssembly a run — buys the live layer activations,
          sequence editing and motif knockouts, not a curve that already exists. A dashed line,
          once you edit, is the unedited reference.
        </p>
        <details class="vp-how">
          <summary>Why coverage is drawn at 16 bp, and what the flanks are for</summary>
          <div class="vp-how-body">
            <p><strong>Shorkie's head emits 896 bins of 16 bp</strong>, so 16 bp is the model's own
            resolution and no finer level exists. Drawing it per base would be storing 16 copies of
            one number and claiming a resolution the network does not have.</p>
            <p><strong>The flanks are real.</strong> Every output bin's receptive field is all
            16,384 bases, so the 896-bin curve is drawn where it falls with its cropped flanks
            shaded, rather than stretched to fill the window. How much of that context the
            prediction actually depends on is measured in act 2.</p>
            <p><strong>The curve is a single forward pass, not rc-averaged</strong>, matching
            `make_predictions.py`. Every attribution below it IS rc-averaged, as every published
            Shorkie run is. The model is not rc-equivariant, so the two are deliberately different
            and saying so is better than quietly averaging one to match the other.</p>
          </div>
        </details>
      </section>
      <section class="vp-panel">
        <h3>Every output track <span class="vp-stat" data-vp-heat-stat></span></h3>
        <ShorkiePanelHead
          question="Is the curve above representative, or an artefact of averaging thousands of experiments?"
          method="All 5,215 predicted tracks as one row each, in the released targets sheet's order, with any single one plotted on the shared axis."
          cost="Free. The 5,215 × 896 plane ships per locus, 2.15 MB."
          refuted="If the four assay blocks did not read as bands the track ordering would be wrong — which it was once, and the curve labelled RNA-seq was mostly ChIP-exo." />
