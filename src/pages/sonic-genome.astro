---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Katex from '../components/Katex.astro';
import { SONIC_PRESETS } from '../data/sonicPresets';
import { site } from '../data/site';
import { buildBreadcrumbLd } from '../lib/breadcrumbs';

const title = "Sonic Genome — Real-Time DNA Audio Synthesizer & Acoustic Playground";
const description = "A full-screen interactive biological DNA synthesizer and ambient soundscape playground. Transform raw nucleotides, codons, GC-content filter sweeps, and transcription factor motifs into real-time harmonic music.";

const webAppLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Sonic Genome',
  applicationCategory: 'MultimediaApplication, ScienceApplication',
  operatingSystem: 'Web Browser (Web Audio API)',
  description,
  url: `${site.url}/sonic-genome/`,
  author: { '@id': `${site.url}/#person` },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbLd = buildBreadcrumbLd([
  { name: 'Sonic Genome', path: '/sonic-genome/' },
]);
---

<BaseLayout title={title} description={description} bare={true}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
  <main class="sonic-viewport" id="sonic-root">
    <!-- Fullscreen Audio-Reactive Canvas -->
    <canvas id="sonic-canvas" class="sonic-canvas" role="img" aria-label="Sonic Genome real-time audio visualizer"></canvas>

    <!-- Top Floating Navigation & Telemetry Bar -->
    <header class="sonic-topbar">
      <div class="sonic-brand">
        <span class="sonic-pulse" aria-hidden="true"></span>
        <h1 class="sonic-title">SONIC GENOME 🧬</h1>
        <span class="sonic-badge" id="sonic-badge-status">Web Audio Synth</span>
      </div>

      <!-- Quick Telemetry Strip -->
      <div class="sonic-telemetry-strip" aria-label="Live acoustic DNA telemetry" role="status">
        <span class="t-pill" title="Current nucleotide base">Base: <strong id="t-base">--</strong></span>
        <span class="t-pill" title="Current codon triplet">Codon: <strong id="t-codon">--</strong></span>
        <span class="t-pill" title="Translated amino acid">AA: <strong id="t-aa">--</strong></span>
        <span class="t-pill t-pill--gc" title="Sliding window GC-content (Filter cutoff)">GC%: <strong id="t-gc">--%</strong></span>
        <span class="t-pill" title="Synthesizer fundamental frequency">Freq: <strong id="t-freq">-- Hz</strong></span>
        <span class="t-pill t-pill--motif" title="Active regulatory motif percussion trigger">Motif: <strong id="t-motif">NONE</strong></span>
        <span class="t-pill t-pill--fps" title="Visualizer frame rate"><strong id="t-fps">60</strong> FPS</span>
      </div>

      <!-- Top Actions: Theme Switcher & Sibling Playground Navigation -->
      <div class="sonic-top-actions">
        <!-- Theme Switcher Menu -->
        <div class="sonic-theme-menu">
          <button
            type="button"
            class="sonic-action-btn"
            id="sonic-theme-btn"
            aria-expanded="false"
            aria-haspopup="true"
            title="Switch Visual Theme"
          >
            <span aria-hidden="true">🎨</span>
            <span id="sonic-theme-name">Theme</span>
            <span class="caret" aria-hidden="true">▾</span>
          </button>
          <div class="sonic-theme-popover" id="sonic-theme-popover" role="menu" hidden>
            <button type="button" class="theme-option" data-theme="dark">
              <span class="theme-dot theme-dot--dark"></span> Dark
            </button>
            <button type="button" class="theme-option" data-theme="light">
              <span class="theme-dot theme-dot--light"></span> Light
            </button>
            <button type="button" class="theme-option" data-theme="parchment">
              <span class="theme-dot theme-dot--parchment"></span> Parchment
            </button>
            <button type="button" class="theme-option" data-theme="nord">
              <span class="theme-dot theme-dot--nord"></span> Nord
            </button>
            <button type="button" class="theme-option" data-theme="monokai">
              <span class="theme-dot theme-dot--monokai"></span> Monokai
            </button>
            <button type="button" class="theme-option" data-theme="cyberdeck">
              <span class="theme-dot theme-dot--cyberdeck"></span> Cyberdeck
            </button>
          </div>
        </div>

        <!-- Sibling Playgrounds -->
        <a href="/lab/" data-astro-reload class="sonic-action-btn sonic-action-btn--sibling" title="Cell Lab: Cellular Automata Microscope">
          <span aria-hidden="true">🔬</span>
          <span>Cell Lab</span>
        </a>

        <a href="/chromatin/" data-astro-reload class="sonic-action-btn sonic-action-btn--sibling" title="Chromatin 3D Compaction Playground">
          <span aria-hidden="true">🧬</span>
          <span>Chromatin</span>
        </a>

        <a href="/" data-astro-reload class="sonic-action-btn sonic-action-btn--exit" title="Return to main site">
          <span aria-hidden="true">←</span>
          <span>Exit to Site</span>
        </a>
      </div>
    </header>

    <!-- Floating Bottom Scientific Control Dock -->
    <nav class="sonic-dock" id="sonic-dock" aria-label="Interactive Synthesizer Biological Dock">
      <!-- Main Transport Controls -->
      <div class="dock-section dock-section--transport">
        <button type="button" id="btn-play" class="dock-btn dock-btn--play" title="Play or Pause (Space)">
          <span id="dock-icon-play"><Icon name="play" size={16} /></span>
          <span id="dock-icon-pause" hidden><Icon name="pause" size={16} /></span>
          <span id="dock-play-label">Play</span>
        </button>

        <button type="button" id="btn-reset" class="dock-btn" title="Reset Playhead (R)">
          <Icon name="arrow-left" size={15} />
          <span>Reset</span>
        </button>

        <button type="button" id="btn-loop" class="dock-btn is-active" title="Toggle Looping">
          <Icon name="sparkles" size={14} />
          <span>Loop</span>
        </button>
      </div>

      <div class="dock-divider"></div>

      <!-- Quick Preset Selector Cartridges -->
      <div class="dock-section dock-section--presets" aria-label="Genomic Soundtracks">
        <span class="dock-label">SOUNDTRACK:</span>
        <div class="dock-chips">
          {SONIC_PRESETS.map((p, idx) => (
            <button
              type="button"
              class={`preset-chip ${idx === 0 ? 'is-active' : ''}`}
              data-preset-id={p.id}
              title={`${p.name} — ${p.organism}`}
            >
              {p.name.split('(')[0].trim()}
            </button>
          ))}
        </div>
      </div>

      <div class="dock-divider"></div>

      <!-- Visualizer Mode Buttons -->
      <div class="dock-section dock-section--modes">
        <button type="button" class="mode-btn is-active" data-mode="helix" title="3D Rotating DNA Double Helix">
          <Icon name="sparkles" size={14} /> 3D Helix
        </button>
        <button type="button" class="mode-btn" data-mode="oscilloscope" title="Holographic Oscilloscope">
          <Icon name="activity" size={14} /> Scope
        </button>
        <button type="button" class="mode-btn" data-mode="matrix" title="Genomic Stream Matrix">
          <Icon name="list" size={14} /> Matrix
        </button>
      </div>

      <div class="dock-divider"></div>

      <!-- Drawer Popover Triggers -->
      <div class="dock-section dock-section--drawers">
        <button type="button" id="btn-toggle-tuning" class="dock-btn dock-btn--drawer" title="Tuning & Audio Controls">
          <Icon name="sliders" size={14} />
          <span>Tuning</span>
        </button>

        <button type="button" id="btn-toggle-seq" class="dock-btn dock-btn--drawer" title="Sequence Inspector & Text-to-Codon Encoder">
          <Icon name="code" size={14} />
          <span>Sequence</span>
        </button>

        <button type="button" id="btn-toggle-info" class="dock-btn dock-btn--drawer" title="Scientific Biophysics Guide">
          <Icon name="book" size={14} />
          <span>Science</span>
        </button>
      </div>
    </nav>

    <!-- Drawer 1: Tuning & Synth Parameters Popover -->
    <aside id="drawer-tuning" class="sonic-drawer" hidden aria-label="Synthesizer Tuning Parameters">
      <div class="drawer-header">
        <h3><Icon name="sliders" size={15} /> ACOUSTIC SYNTHESIS TUNING</h3>
        <button type="button" class="drawer-close" data-close="tuning" title="Close">✕</button>
      </div>

      <div class="drawer-body">
        <div class="setting-row">
          <label for="drawer-select-scale">Harmonic Scale:</label>
          <select id="drawer-select-scale" class="drawer-select">
            <option value="aeolian">Aeolian Minor (Dramatic / Cinematic)</option>
            <option value="lydian">Lydian Ambient (Bright / Dreamy)</option>
            <option value="dorian">Dorian Space (Sci-Fi / Melancholic)</option>
            <option value="pentatonic">Major Pentatonic (Euphoric / Consonant)</option>
            <option value="hirajoshi">Hirajoshi (Japanese Zen / Mysterious)</option>
            <option value="wholetone">Whole Tone (Cyberpunk / Floating)</option>
          </select>
        </div>

        <div class="setting-row">
          <label for="drawer-select-timbre">Synth Timbre:</label>
          <select id="drawer-select-timbre" class="drawer-select">
            <option value="ethereal-glass">Ethereal Glass (Sine Harmonics)</option>
            <option value="ambient-pad">Ambient Pad (Detuned Chorus)</option>
            <option value="crystal-chimes">Crystal Chimes (2-Op FM Bell)</option>
            <option value="cyber-saw">Cyberpunk Saw (Analog Lead)</option>
            <option value="chiptune">8-Bit Chiptune (Retro Pulse)</option>
          </select>
        </div>

        <div class="setting-row">
          <label for="drawer-slider-bpm">Tempo (<span id="drawer-val-bpm">105</span> BPM):</label>
          <input type="range" id="drawer-slider-bpm" class="drawer-slider" min="60" max="240" step="2" value="105" />
        </div>

        <div class="setting-row">
          <label for="drawer-slider-vol">Master Volume (<span id="drawer-val-vol">75</span>%):</label>
          <input type="range" id="drawer-slider-vol" class="drawer-slider" min="0" max="100" step="1" value="75" />
        </div>

        <div class="setting-row">
          <label for="drawer-slider-reverb">Reverb Acoustic Space (<span id="drawer-val-reverb">40</span>%):</label>
          <input type="range" id="drawer-slider-reverb" class="drawer-slider" min="0" max="100" step="5" value="40" />
        </div>
      </div>
    </aside>

    <!-- Drawer 2: Sequence Inspector & Text-to-Codon Encoder -->
    <aside id="drawer-seq" class="sonic-drawer sonic-drawer--wide" hidden aria-label="Sequence Inspector and Encoder">
      <div class="drawer-header">
        <h3><Icon name="code" size={15} /> SEQUENCE INSPECTOR & ENCODER</h3>
        <button type="button" class="drawer-close" data-close="seq" title="Close">✕</button>
      </div>

      <div class="drawer-body">
        <!-- Live Scrolling Sequence Ribbon -->
        <div class="stream-wrap">
          <div class="stream-header">
            <span>LIVE BASE-PAIR TRACK</span>
            <span class="stream-stats">
              <strong id="drawer-seq-len">0</strong> bp • GC: <strong id="drawer-seq-gc">0.0</strong>% • Motifs: <strong id="drawer-seq-motifs">0</strong>
            </span>
          </div>
          <div class="stream-scroll-box" id="stream-scroll-box">
            <div class="stream-ribbon" id="stream-ribbon"></div>
          </div>
        </div>

        <!-- Custom FASTA input and Text-to-Codon Tools -->
        <div class="seq-tools-grid">
          <div class="tool-card">
            <h4>Paste Custom DNA / FASTA</h4>
            <textarea id="textarea-custom" class="drawer-textarea" rows="3" placeholder=">custom_locus\nATGCGATCGATC..."></textarea>
            <div class="tool-actions">
              <button type="button" id="btn-load-custom" class="drawer-action-btn">Load Sequence</button>
              <button type="button" id="btn-mutate" class="drawer-action-btn drawer-action-btn--alt">Random Mutation</button>
            </div>
          </div>

          <div class="tool-card">
            <h4>Text-to-Genome Encoder</h4>
            <p class="tool-sub">Type any phrase to encode into biological codons:</p>
            <div class="encoder-row">
              <input type="text" id="input-text-dna" class="drawer-input" value="Kuan-Hao Chao" placeholder="Type text..." />
              <button type="button" id="btn-encode" class="drawer-action-btn">Encode & Play</button>
            </div>
            <div class="encoder-result">
              Encoded: <code id="encoded-dna-preview">ATG...</code>
            </div>
          </div>
        </div>
      </div>
    </aside>

    <!-- Drawer 3: Biophysics & Science Monograph -->
    <aside id="drawer-info" class="sonic-drawer" hidden aria-label="Biophysical Mapping Monograph">
      <div class="drawer-header">
        <h3><Icon name="book" size={15} /> BIOPHYSICAL ACOUSTIC MAPPING</h3>
        <button type="button" class="drawer-close" data-close="info" title="Close">✕</button>
      </div>

      <div class="drawer-body drawer-body--scroll">
        <article class="science-monograph">
          <h4>1. Harmonic Scale Degree Mapping</h4>
          <p>
            Individual nucleotides map to scale intervals: <strong>Adenine (A)</strong> to the root tonic, <strong>Thymine (T)</strong> to the mediant 3rd, <strong>Cytosine (C)</strong> to the dominant 5th, and <strong>Guanine (G)</strong> to the 7th or upper octave. Codon triads (<Katex tex="3\text{ bp}" />) trigger full harmonic chord voicings.
          </p>

          <h4>2. Dynamic GC% Low-Pass Filter Sweeps</h4>
          <p>
            The sliding window GC-content ratio (<Katex tex="GC\%" />) dynamically modulates a <Katex tex="24\text{ dB/octave}" /> low-pass filter: high GC opens cutoff frequencies up to <Katex tex="6,000\text{ Hz}" />, whereas AT-rich regions create dark subterranean resonance.
          </p>

          <h4>3. Regulatory Motif Drum Synthesis</h4>
          <p>
            Genomic regulatory motifs trigger synthesized analog percussion:
          </p>
          <ul>
            <li><strong>TATA Box Promoters (<Katex tex="\text{TATAWAW}" />)</strong>: Sub-bass 808 kick drum</li>
            <li><strong>E-Box Motif (<Katex tex="\text{CACGTG}" />)</strong>: Snare drum</li>
            <li><strong>CTCF Insulators (<Katex tex="\text{CCGCGNGGNGGC}" />)</strong>: Resonant woodblock</li>
            <li><strong>Polyadenylation (<Katex tex="\text{AATAAA}" />)</strong>: Shimmering high arpeggios</li>
          </ul>
        </article>
      </div>
    </aside>
  </main>
</BaseLayout>

<script>
  import { SONIC_PRESETS } from '../data/sonicPresets';
  import {
    cleanDnaSequence,
    textToCodonSequence,
    computeRollingGcContent,
    scanMotifs,
    sequenceToNoteEvents,
    type MusicalScale,
    type SynthPreset,
    type GenomicNoteEvent
  } from '../lib/sonicGenome';
  import { SonicAudioEngine } from '../lib/sonicAudioEngine';
  import { SonicVisualizer, type VisualizerMode } from '../lib/sonicVisualizer';

  let audioEngine: SonicAudioEngine | null = null;
  let visualizer: SonicVisualizer | null = null;

  // Studio State
  let currentPresetId = 'tp53-hotspot';
  let currentScale: MusicalScale = 'aeolian';
  let currentTimbre: SynthPreset = 'ethereal-glass';
  let currentBpm = 105;
  let isPlaying = false;
  let isLooping = true;
  let currentIndex = 0;
  let stepTimer: number | null = null;
  let noteEvents: GenomicNoteEvent[] = [];

  // FPS Telemetry Tracking
  let lastFrameTime = performance.now();
  let frameCount = 0;
  let fps = 60;

  // DOM Elements
  const canvas = document.getElementById('sonic-canvas') as HTMLCanvasElement | null;
  const btnPlay = document.getElementById('btn-play');
  const btnReset = document.getElementById('btn-reset');
  const btnLoop = document.getElementById('btn-loop');
  const dockIconPlay = document.getElementById('dock-icon-play');
  const dockIconPause = document.getElementById('dock-icon-pause');
  const dockPlayLabel = document.getElementById('dock-play-label');

  const presetChips = document.querySelectorAll('.preset-chip');
  const modeButtons = document.querySelectorAll('.mode-btn');

  const tBase = document.getElementById('t-base');
  const tCodon = document.getElementById('t-codon');
  const tAa = document.getElementById('t-aa');
  const tGc = document.getElementById('t-gc');
  const tFreq = document.getElementById('t-freq');
  const tMotif = document.getElementById('t-motif');
  const tFps = document.getElementById('t-fps');

  // Drawers
  const drawerTuning = document.getElementById('drawer-tuning');
  const drawerSeq = document.getElementById('drawer-seq');
  const drawerInfo = document.getElementById('drawer-info');
  const btnToggleTuning = document.getElementById('btn-toggle-tuning');
  const btnToggleSeq = document.getElementById('btn-toggle-seq');
  const btnToggleInfo = document.getElementById('btn-toggle-info');
  const drawerCloseButtons = document.querySelectorAll('.drawer-close');

  const drawerSelectScale = document.getElementById('drawer-select-scale') as HTMLSelectElement | null;
  const drawerSelectTimbre = document.getElementById('drawer-select-timbre') as HTMLSelectElement | null;
  const drawerSliderBpm = document.getElementById('drawer-slider-bpm') as HTMLInputElement | null;
  const drawerValBpm = document.getElementById('drawer-val-bpm');
  const drawerSliderVol = document.getElementById('drawer-slider-vol') as HTMLInputElement | null;
  const drawerValVol = document.getElementById('drawer-val-vol');
  const drawerSliderReverb = document.getElementById('drawer-slider-reverb') as HTMLInputElement | null;
  const drawerValReverb = document.getElementById('drawer-val-reverb');

  const streamRibbon = document.getElementById('stream-ribbon');
  const drawerSeqLen = document.getElementById('drawer-seq-len');
  const drawerSeqGc = document.getElementById('drawer-seq-gc');
  const drawerSeqMotifs = document.getElementById('drawer-seq-motifs');

  const textareaCustom = document.getElementById('textarea-custom') as HTMLTextAreaElement | null;
  const btnLoadCustom = document.getElementById('btn-load-custom');
  const btnMutate = document.getElementById('btn-mutate');
  const inputTextDna = document.getElementById('input-text-dna') as HTMLInputElement | null;
  const btnEncode = document.getElementById('btn-encode');
  const encodedPreview = document.getElementById('encoded-dna-preview');

  // Theme Dropdown
  const themeBtn = document.getElementById('sonic-theme-btn');
  const themePopover = document.getElementById('sonic-theme-popover');
  const themeName = document.getElementById('sonic-theme-name');
  const themeOptions = document.querySelectorAll('.theme-option');

  function initInstrument() {
    audioEngine = new SonicAudioEngine();

    const curTheme = typeof window !== 'undefined' && (window as any).__khcTheme ? (window as any).__khcTheme.get() : (document.documentElement.dataset.theme || 'dark');
    if (themeName && curTheme) {
      themeName.textContent = curTheme.charAt(0).toUpperCase() + curTheme.slice(1);
    }

    if (canvas) {
      visualizer = new SonicVisualizer(canvas, () => {
        return audioEngine ? audioEngine.getAnalyserData() : { timeData: new Uint8Array(0), freqData: new Uint8Array(0) };
      });
      visualizer.start();
    }

    loadPreset(currentPresetId);
    setupEvents();
    startFpsTracker();
  }

  function startFpsTracker() {
    const calcFps = () => {
      const now = performance.now();
      frameCount++;
      if (now - lastFrameTime >= 1000) {
        fps = Math.round((frameCount * 1000) / (now - lastFrameTime));
        if (tFps) tFps.textContent = fps.toString();
        frameCount = 0;
        lastFrameTime = now;
      }
      fpsAnimId = requestAnimationFrame(calcFps);
    };
    fpsAnimId = requestAnimationFrame(calcFps);
  }

  let fpsAnimId: number | null = null;

  function loadPreset(presetId: string) {
    const preset = SONIC_PRESETS.find((p) => p.id === presetId) || SONIC_PRESETS[0];
    currentPresetId = preset.id;
    currentScale = preset.recommendedScale;
    currentTimbre = preset.recommendedPreset;
    currentBpm = preset.recommendedBpm;

    if (drawerSelectScale) drawerSelectScale.value = currentScale;
    if (drawerSelectTimbre) drawerSelectTimbre.value = currentTimbre;
    if (drawerSliderBpm) drawerSliderBpm.value = currentBpm.toString();
    if (drawerValBpm) drawerValBpm.textContent = currentBpm.toString();

    presetChips.forEach((chip) => {
      chip.classList.toggle('is-active', chip.getAttribute('data-preset-id') === preset.id);
    });

    loadSequence(preset.sequence);
  }

  function loadSequence(rawSeq: string) {
    const cleaned = cleanDnaSequence(rawSeq);
    noteEvents = sequenceToNoteEvents(cleaned, currentScale, 4);
    currentIndex = 0;

    // Update stats
    if (drawerSeqLen) drawerSeqLen.textContent = cleaned.length.toLocaleString();
    const gcVals = computeRollingGcContent(cleaned, cleaned.length);
    const overallGc = gcVals.length > 0 ? (gcVals[0] * 100).toFixed(1) : '0.0';
    if (drawerSeqGc) drawerSeqGc.textContent = overallGc;
    const motifs = scanMotifs(cleaned);
    if (drawerSeqMotifs) drawerSeqMotifs.textContent = motifs.length.toString();

    renderStreamRibbon();

    if (visualizer) {
      visualizer.updateState({
        events: noteEvents,
        currentIndex: 0,
        currentEvent: noteEvents[0] || null
      });
    }

    updateTelemetry(noteEvents[0] || null);
  }

  function renderStreamRibbon() {
    if (!streamRibbon) return;
    streamRibbon.replaceChildren();

    const fragment = document.createDocumentFragment();
    noteEvents.forEach((ev, idx) => {
      const node = document.createElement('button');
      node.type = 'button';
      node.className = `ribbon-node ribbon-node--${ev.base.toLowerCase()}${ev.isMotif ? ' is-motif' : ''}`;
      node.dataset.index = idx.toString();
      node.title = `Pos ${idx + 1}: ${ev.base}${ev.codon ? ` (${ev.codon} → ${ev.aminoAcid})` : ''}${ev.motif ? ` [${ev.motif.name}]` : ''}`;

      const letter = document.createElement('span');
      letter.className = 'node-letter';
      letter.textContent = ev.base;
      node.appendChild(letter);

      if (ev.isTriadRoot && ev.aminoAcid) {
        const aaTag = document.createElement('span');
        aaTag.className = 'node-aa';
        aaTag.textContent = ev.aminoAcid;
        node.appendChild(aaTag);
      }

      node.addEventListener('click', () => {
        jumpToPosition(idx);
      });

      fragment.appendChild(node);
    });

    streamRibbon.appendChild(fragment);
  }

  function jumpToPosition(idx: number) {
    if (idx < 0 || idx >= noteEvents.length) return;
    currentIndex = idx;
    const ev = noteEvents[currentIndex];
    updateTelemetry(ev);

    if (visualizer) {
      visualizer.updateState({
        currentIndex,
        currentEvent: ev
      });
    }

    highlightRibbonNode(currentIndex);

    if (audioEngine) {
      audioEngine.playNote(ev, currentTimbre);
    }
  }

  function highlightRibbonNode(idx: number) {
    if (!streamRibbon) return;
    const prev = streamRibbon.querySelector('.is-playing');
    if (prev) prev.classList.remove('is-playing');

    const cur = streamRibbon.querySelector(`[data-index="${idx}"]`) as HTMLElement | null;
    if (cur) {
      cur.classList.add('is-playing');
      cur.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    }
  }

  function updateTelemetry(ev: GenomicNoteEvent | null) {
    if (!ev) return;
    if (tBase) tBase.textContent = ev.base;
    if (tCodon) tCodon.textContent = ev.codon || '--';
    if (tAa) tAa.textContent = ev.aminoAcid ? `${ev.aminoName} (${ev.aminoAcid})` : '--';
    if (tGc) tGc.textContent = `${(ev.gcRatio * 100).toFixed(0)}%`;
    if (tFreq) tFreq.textContent = `${Math.round(ev.frequency)} Hz`;
    if (tMotif) {
      if (ev.motif) {
        tMotif.textContent = ev.motif.name;
        tMotif.classList.add('is-active');
      } else {
        tMotif.textContent = 'NONE';
        tMotif.classList.remove('is-active');
      }
    }
  }

  async function togglePlay() {
    if (!audioEngine) {
      audioEngine = new SonicAudioEngine();
    }
    await audioEngine.init();

    if (isPlaying) {
      pausePlayback();
    } else {
      startPlayback();
    }
  }

  function startPlayback() {
    if (noteEvents.length === 0) return;
    isPlaying = true;
    updatePlayUI(true);

    if (visualizer) {
      visualizer.updateState({ isPlaying: true });
    }

    scheduleStep();
  }

  function pausePlayback() {
    isPlaying = false;
    if (stepTimer !== null) {
      clearTimeout(stepTimer);
      stepTimer = null;
    }
    updatePlayUI(false);

    if (visualizer) {
      visualizer.updateState({ isPlaying: false });
    }
  }

  function resetPlayback() {
    pausePlayback();
    currentIndex = 0;
    highlightRibbonNode(0);
    updateTelemetry(noteEvents[0] || null);
    if (visualizer) {
      visualizer.updateState({ currentIndex: 0, currentEvent: noteEvents[0] || null });
    }
  }

  function scheduleStep() {
    if (!isPlaying || noteEvents.length === 0) return;

    const ev = noteEvents[currentIndex];
    if (audioEngine && ev) {
      audioEngine.playNote(ev, currentTimbre);
    }

    updateTelemetry(ev);
    highlightRibbonNode(currentIndex);

    if (visualizer) {
      visualizer.updateState({
        currentIndex,
        currentEvent: ev
      });
    }

    const stepDurationMs = (60 / currentBpm / 2) * 1000;

    currentIndex++;
    if (currentIndex >= noteEvents.length) {
      if (isLooping) {
        currentIndex = 0;
      } else {
        pausePlayback();
        return;
      }
    }

    stepTimer = window.setTimeout(scheduleStep, stepDurationMs);
  }

  function updatePlayUI(playing: boolean) {
    if (dockIconPlay) dockIconPlay.hidden = playing;
    if (dockIconPause) dockIconPause.hidden = !playing;
    if (dockPlayLabel) dockPlayLabel.textContent = playing ? 'Pause' : 'Play';
    if (btnPlay) btnPlay.classList.toggle('is-playing', playing);
  }

  function toggleDrawer(drawer: HTMLElement | null, btn: HTMLElement | null) {
    if (!drawer) return;
    const isHidden = drawer.hasAttribute('hidden');

    // Close others
    [drawerTuning, drawerSeq, drawerInfo].forEach((d) => {
      if (d && d !== drawer) d.setAttribute('hidden', 'true');
    });
    [btnToggleTuning, btnToggleSeq, btnToggleInfo].forEach((b) => {
      if (b && b !== btn) b.classList.remove('is-active');
    });

    if (isHidden) {
      drawer.removeAttribute('hidden');
      btn?.classList.add('is-active');
    } else {
      drawer.setAttribute('hidden', 'true');
      btn?.classList.remove('is-active');
    }
  }

  function onKeydown(e: KeyboardEvent) {
    if (['INPUT', 'TEXTAREA'].includes((e.target as HTMLElement).tagName)) return;
    if (e.code === 'Space') {
      e.preventDefault();
      togglePlay();
    } else if (e.code === 'KeyR') {
      e.preventDefault();
      resetPlayback();
    } else if (e.code === 'Escape') {
      themePopover?.setAttribute('hidden', '');
      themeBtn?.setAttribute('aria-expanded', 'false');
      [drawerTuning, drawerSeq, drawerInfo].forEach((d) => d?.setAttribute('hidden', 'true'));
      [btnToggleTuning, btnToggleSeq, btnToggleInfo].forEach((b) => b?.classList.remove('is-active'));
    }
  }

  function onDocumentClick(e: MouseEvent) {
    const target = e.target as Node;
    if (themePopover && !themePopover.contains(target) && themeBtn && !themeBtn.contains(target)) {
      themePopover.setAttribute('hidden', '');
      themeBtn.setAttribute('aria-expanded', 'false');
    }
  }

  function setupEvents() {
    btnPlay?.addEventListener('click', togglePlay);
    btnReset?.addEventListener('click', resetPlayback);

    btnLoop?.addEventListener('click', () => {
      isLooping = !isLooping;
      btnLoop.classList.toggle('is-active', isLooping);
    });

    presetChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const pid = chip.getAttribute('data-preset-id');
        if (pid) {
          const wasPlaying = isPlaying;
          if (wasPlaying) pausePlayback();
          loadPreset(pid);
          if (wasPlaying) startPlayback();
        }
      });
    });

    modeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        modeButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const mode = btn.getAttribute('data-mode') as VisualizerMode;
        if (visualizer && mode) {
          visualizer.setMode(mode);
        }
      });
    });

    // Drawer triggers
    btnToggleTuning?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleDrawer(drawerTuning, btnToggleTuning);
    });
    btnToggleSeq?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleDrawer(drawerSeq, btnToggleSeq);
    });
    btnToggleInfo?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleDrawer(drawerInfo, btnToggleInfo);
    });

    drawerCloseButtons.forEach((cb) => {
      cb.addEventListener('click', () => {
        const type = cb.getAttribute('data-close');
        if (type === 'tuning') toggleDrawer(drawerTuning, btnToggleTuning);
        if (type === 'seq') toggleDrawer(drawerSeq, btnToggleSeq);
        if (type === 'info') toggleDrawer(drawerInfo, btnToggleInfo);
      });
    });

    // Tuning inputs
    drawerSelectScale?.addEventListener('change', (e) => {
      currentScale = (e.target as HTMLSelectElement).value as MusicalScale;
      const rawSeq = noteEvents.map((n) => n.base).join('');
      loadSequence(rawSeq);
    });

    drawerSelectTimbre?.addEventListener('change', (e) => {
      currentTimbre = (e.target as HTMLSelectElement).value as SynthPreset;
    });

    drawerSliderBpm?.addEventListener('input', (e) => {
      currentBpm = parseInt((e.target as HTMLInputElement).value, 10);
      if (drawerValBpm) drawerValBpm.textContent = currentBpm.toString();
    });

    drawerSliderVol?.addEventListener('input', (e) => {
      const vol = parseInt((e.target as HTMLInputElement).value, 10);
      if (drawerValVol) drawerValVol.textContent = vol.toString();
      if (audioEngine) audioEngine.setMasterVolume(vol / 100);
    });

    drawerSliderReverb?.addEventListener('input', (e) => {
      const rev = parseInt((e.target as HTMLInputElement).value, 10);
      if (drawerValReverb) drawerValReverb.textContent = rev.toString();
      if (audioEngine) audioEngine.setReverbLevel(rev / 100);
    });

    // Sequence tools
    btnLoadCustom?.addEventListener('click', () => {
      if (!textareaCustom) return;
      const raw = textareaCustom.value.trim();
      if (raw) {
        presetChips.forEach((c) => c.classList.remove('is-active'));
        const wasPlaying = isPlaying;
        if (wasPlaying) pausePlayback();
        loadSequence(raw);
        if (wasPlaying) startPlayback();
      }
    });

    btnMutate?.addEventListener('click', () => {
      if (noteEvents.length === 0) return;
      const seqArray = noteEvents.map((n) => n.base);
      const randIdx = Math.floor(Math.random() * seqArray.length);
      const bases = ['A', 'C', 'G', 'T'];
      const curBase = seqArray[randIdx];
      const otherBases = bases.filter((b) => b !== curBase);
      seqArray[randIdx] = otherBases[Math.floor(Math.random() * otherBases.length)] as 'A' | 'C' | 'G' | 'T';

      loadSequence(seqArray.join(''));
      jumpToPosition(randIdx);
    });

    btnEncode?.addEventListener('click', () => {
      if (!inputTextDna) return;
      const text = inputTextDna.value.trim();
      if (text) {
        const dna = textToCodonSequence(text);
        if (encodedPreview) encodedPreview.textContent = dna.slice(0, 48) + (dna.length > 48 ? '...' : '');
        presetChips.forEach((c) => c.classList.remove('is-active'));
        const wasPlaying = isPlaying;
        if (wasPlaying) pausePlayback();
        loadSequence(dna);
        if (wasPlaying) startPlayback();
      }
    });

    // Theme selector menu toggle & dismiss
    themeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = themeBtn.getAttribute('aria-expanded') === 'true';
      themeBtn.setAttribute('aria-expanded', String(!open));
      if (open) {
        themePopover?.setAttribute('hidden', '');
      } else {
        themePopover?.removeAttribute('hidden');
      }
    });

    document.addEventListener('click', onDocumentClick);

    themeOptions.forEach((opt) => {
      opt.addEventListener('click', () => {
        const targetTheme = opt.getAttribute('data-theme');
        if (targetTheme && typeof window !== 'undefined' && (window as any).__khcTheme) {
          (window as any).__khcTheme.set(targetTheme);
          if (themeName) themeName.textContent = targetTheme.charAt(0).toUpperCase() + targetTheme.slice(1);
        }
        themePopover?.setAttribute('hidden', '');
        themeBtn?.setAttribute('aria-expanded', 'false');
      });
    });

    window.addEventListener('keydown', onKeydown);
  }

  function cleanupSonicGenome() {
    if (stepTimer !== null) {
      clearTimeout(stepTimer);
      stepTimer = null;
    }
    isPlaying = false;
    updatePlayUI(false);

    if (fpsAnimId !== null) {
      cancelAnimationFrame(fpsAnimId);
      fpsAnimId = null;
    }

    if (visualizer) {
      visualizer.destroy();
      visualizer = null;
    }

    if (audioEngine) {
      audioEngine.destroy();
      audioEngine = null;
    }

    window.removeEventListener('keydown', onKeydown);
    document.removeEventListener('click', onDocumentClick);
  }

  function initSonicGenome() {
    const root = document.getElementById('sonic-root');
    if (!root) return;

    cleanupSonicGenome();
    initInstrument();

    document.addEventListener('astro:before-swap', cleanupSonicGenome, { once: true });
    window.addEventListener('pagehide', cleanupSonicGenome, { once: true });
  }

  // Bind on Astro page loads and cold load
  document.addEventListener('astro:page-load', initSonicGenome);
  if (document.readyState !== 'loading') {
    initSonicGenome();
  } else {
    document.addEventListener('DOMContentLoaded', initSonicGenome);
  }
</script>

