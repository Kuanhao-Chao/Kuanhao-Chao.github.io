---
import ArcadeShell from '../../components/games/ArcadeShell.astro';
import JetpackJoyrideLogo from '../../components/games/JetpackJoyrideLogo.astro';
---

<ArcadeShell
  game="jetpack"
  title="Jetpack Joyride"
  lead="An original molecular-themed pixel flight arcade. Master six authored routes, read the warning patterns, and collect bases—or chase an endless personal best."
  controls="Hold Space / ↑ / W, the playfield, or Thrust to rise; release to fall · P pauses. A toggle-thrust option is available in controls."
>
  <JetpackJoyrideLogo slot="logo" size={42} />
  <Fragment slot="hud">
    <div class="arcade-stat"><span>Score</span><strong data-jetpack-score>0</strong></div>
    <div class="arcade-stat"><span>Distance</span><strong data-jetpack-bases>0</strong></div>
    <div class="arcade-stat"><span>Bases</span><strong data-jetpack-coins>0</strong></div>
    <div class="arcade-stat"><span>Gear</span><strong data-jetpack-gear>—</strong></div>
    <div class="arcade-stat"><span>Best</span><strong data-jetpack-best>0</strong></div>
  </Fragment>
  <button
    slot="actions"
    type="button"
    class="arcade-primary"
    data-jetpack-thrust
    aria-label="Thrust — hold to fly"
    aria-pressed="false">↑ Thrust</button
  >
  <Fragment slot="guide">
    <p>
      <strong>Fly deliberately.</strong> Hold to accelerate upward, release to fall. Ceiling and floor
      contact stop vertical motion instead of ending the run. Hazard contact ends a normal run unless
      a shield absorbs it.
    </p>
    <p>
      <strong>Read, then move.</strong> Dashed beam warnings are harmless until they become solid. Missile
      markers track your altitude, then visibly lock before launch; missiles do not secretly retarget
      afterward. Rotor tips show their full collision extent.
    </p>
    <p>
      <strong>Collect and commit.</strong> S pickups grant a one-hit shield; M pickups attract nearby
      base coins for six seconds. Every five consecutive coins raises the collection multiplier, up to
      ×4. Missing a coin resets the chain. A close but clean hazard pass can earn one near-miss bonus.
    </p>
    <p>
      <strong>Scoring.</strong> One point per displayed distance unit, 15 points per coin times its chain
      multiplier, and 25 per near miss. Distance is an arcade scale, not DNA replicated. Campaign medals
      reward reaching the exit, meeting the base quota, and spending no shields.
    </p>
    <p>
      <strong>Practice the route.</strong> Every campaign stage uses authored encounter ordering. Practice
      can rehearse all six, shows a safe-route guide, and turns collisions into feedback rather than death.
      It does not save scores or medals.
    </p>
    <p>
      <strong>A fictional molecular explorer.</strong> The flyer, jetpack, shields, electrical barriers,
      and missiles are arcade inventions. ATP synthase is not a flying engine, these hazards are not a
      model of mutagenesis, and collecting random bases does not synthesize DNA.
    </p>
  </Fragment>
</ArcadeShell>
<script>
  import { initJetpackJoyride, type JetpackJoyrideController } from '../../scripts/jetpackJoyride';
  let controller: JetpackJoyrideController | null = null;
  const mount = () => {
    controller ??= initJetpackJoyride(document);
  };
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', () => {
    controller?.destroy();
    controller = null;
  });
  mount();
</script>
