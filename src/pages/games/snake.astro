---
import ArcadeShell from '../../components/games/ArcadeShell.astro';
import SnakeLogo from '../../components/games/SnakeLogo.astro';
---

<ArcadeShell
  game="snake"
  title="Snake"
  lead="A nucleotide serpent in six pixel-art gardens. Plan your route, leave space for your tail, and chase mastery medals—or try Classic and Motif Hunt."
  controls="Arrows / WASD steer · swipe or use the directional pad · P pauses · Enter starts or resumes. Turns are buffered, one per movement tick."
>
  <SnakeLogo slot="logo" size={42} />
  <Fragment slot="hud">
    <div class="arcade-stat"><span>Bases</span><strong data-snake-score>0</strong></div>
    <div class="arcade-stat"><span>Goal</span><strong data-snake-goal>8</strong></div>
    <div class="arcade-stat"><span>Time</span><strong data-snake-time>0.0</strong></div>
    <div class="arcade-stat"><span>Best</span><strong data-snake-best>0</strong></div>
  </Fragment>
  <div slot="actions" class="arcade-dpad" aria-label="Snake directional controls">
    <button type="button" data-snake-dir="up" aria-label="Steer up">↑</button><button
      type="button"
      data-snake-dir="left"
      aria-label="Steer left">←</button
    ><button type="button" data-snake-dir="down" aria-label="Steer down">↓</button><button
      type="button"
      data-snake-dir="right"
      aria-label="Steer right">→</button
    >
  </div>
  <div slot="readout" class="arcade-ribbon">
    <strong>Collected DNA bases · A/C/G/T</strong><span data-snake-strand>—</span><strong
      >Motif Hunt target</strong
    ><span data-snake-target>Available in Motif Hunt mode</span>
  </div>
  <Fragment slot="guide">
    <p>
      <strong>Keep a return route.</strong> Each base grows your body by one cell. Avoid the walls, terrain,
      and your own body. Moving into the cell your tail vacates on that tick is legal. Marked edge arrows
      mean the arena wraps.
    </p>
    <p>
      <strong>Two turns, no reversals.</strong> You can buffer two perpendicular turns; only one is applied
      each movement tick. Direct reversals, duplicate held keys, and extra inputs beyond the two-turn
      queue are ignored.
    </p>
    <p>
      <strong>Campaign medals.</strong> Reach the base goal, beat the stage’s par time, and collect the
      optional gold bonus chip. The chip does not grow the snake. Every stage has a different arena and
      resets your length.
    </p>
    <p>
      <strong>Motif Hunt.</strong> Three pickups include the next target base. Collect the displayed sequence
      from left to right. A wrong pickup still grows the snake but resets sequence progress; completing
      a motif earns 20 bonus points and introduces a longer target.
    </p>
    <p>
      <strong>Practice.</strong> Rehearse any campaign garden and lower the simulation speed. Practice
      never changes your campaign unlocks or personal records. Standard and Expert have separate records.
    </p>
    <p>
      <strong>Biology versus arcade.</strong> A, C, G, and T are the DNA alphabet. This ribbon is a collection
      history—not a synthesized RNA transcript. Motif Hunt is a string-matching puzzle, not a physical
      model of DNA polymerization or a claim that a particular short sequence has a biological function.
    </p>
  </Fragment>
</ArcadeShell>
<script>
  import { initSnake, type SnakeController } from '../../scripts/snake';
  let controller: SnakeController | null = null;
  const mount = () => {
    controller ??= initSnake(document);
  };
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', () => {
    controller?.destroy();
    controller = null;
  });
  mount();
</script>
