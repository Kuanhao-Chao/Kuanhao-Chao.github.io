---
import PageLayout from '../../layouts/PageLayout.astro';
import SnakeLogo from '../../components/games/SnakeLogo.astro';
import { site } from '../../data/site';

const gameLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Snake',
  description:
    'A classic browser snake game with a genomics twist: guide a nucleotide serpent to consume A · C · G · T bases and grow a sequence strand.',
  url: `${site.url}/games/snake/`,
  author: { '@id': `${site.url}/#person` },
  applicationCategory: 'Game',
  gamePlatform: ['Web browser', 'Mobile web browser'],
  genre: ['Arcade', 'Snake', 'Science Game'],
  inLanguage: 'en',
  isAccessibleForFree: true,
};
---

<PageLayout
  title="Snake"
  eyebrow="Side project"
  lead="A classic browser game with a genomics twist: play with arrow keys, WASD, or swipe. The food items are nucleotide bases (A · C · G · T), and the serpent grows into a living sequence strand."
  description="Snake — a small, mobile-friendly browser game by Kuan-Hao Chao, with a genomic twist: the food is A/C/G/T bases and the snake grows into a sequence."
  width="narrow"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(gameLd)} />

  <section class="snake" data-game-root data-cell-protected aria-label="Snake game">
    <div class="snake-hud">
      <div class="snake-brand">
        <SnakeLogo size={40} />
        <div class="snake-stats">
          <div class="stat">
            <span class="stat-label">Bases</span>
            <span class="stat-value" data-snake-score>0</span>
          </div>
          <div class="stat">
            <span class="stat-label">Best</span>
            <span class="stat-value" data-snake-best>0</span>
          </div>
        </div>
      </div>
      <div class="snake-controls">
        <button type="button" class="snake-btn" data-snake-pause disabled>Pause</button>
        <button type="button" class="snake-btn" data-snake-restart>Restart</button>
      </div>
    </div>

    <div class="snake-board">
      <canvas
        data-snake-canvas
        role="img"
        aria-label="Snake game board — use the arrow keys, WASD, or swipe to steer."
      ></canvas>
    </div>

    <p class="snake-status" data-snake-status role="status" aria-live="polite">
      Press an arrow, Space, or tap to start
    </p>

    <div class="snake-strand-card" aria-label="Synthesized nucleotide sequence">
      <span class="sequence-label">Sequence (5'→3'):</span>
      <div class="sequence-ribbon" data-snake-strand>—</div>
    </div>

    <p class="snake-hint muted">
      Arrow keys / WASD on desktop · swipe on mobile · Space to pause · each base you eat extends the sequence.
    </p>
  </section>
</PageLayout>

<script>
  import { initSnake, type SnakeController } from '../../scripts/snake';

  let controller: SnakeController | null = null;

  function mount() {
    if (controller) return;
    controller = initSnake(document);
  }

  function unmount() {
    controller?.destroy();
    controller = null;
  }

  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', unmount);
  mount();
</script>

<style>
  .snake {
    max-width: 32rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    box-sizing: border-box;
  }

  .snake-hud {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md, 8px);
    box-sizing: border-box;
  }

  .snake-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .snake-stats {
    display: flex;
    gap: 1.25rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 1px;
    line-height: 1;
  }

  .stat-label,
  .sequence-label {
    font-size: var(--fs-meta, 0.72rem);
    letter-spacing: var(--tracking-meta, 0.05em);
    text-transform: uppercase;
    color: var(--color-muted);
    font-weight: 600;
  }

  .stat-value {
    font-family: var(--font-mono, monospace);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .snake-controls {
    display: flex;
    gap: 0.4rem;
  }

  .snake-btn {
    min-height: 44px;
    padding: 0.4em 0.9em;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm, 6px);
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: var(--fs-small, 0.85rem);
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
    box-sizing: border-box;
  }

  .snake-btn:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .snake-btn:active:not(:disabled) {
    transform: translateY(1px);
  }

  .snake-btn:disabled {
    opacity: 0.42;
    cursor: default;
  }

  .snake-board {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    margin-inline: auto;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg, 12px);
    background: var(--color-surface);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    box-sizing: border-box;
  }

  .snake-board canvas {
    width: 100%;
    height: 100%;
    touch-action: none;
    user-select: none;
    display: block;
  }

  .snake-status {
    min-height: 1.3em;
    text-align: center;
    font-size: var(--fs-small, 0.85rem);
    color: var(--color-ink);
    margin: 0;
  }

  .snake-strand-card {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md, 8px);
    box-sizing: border-box;
  }

  .sequence-ribbon {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono, monospace);
    font-size: 0.88rem;
    font-weight: 700;
    min-height: 1.4rem;
    color: var(--color-ink);
  }

  :global(.nucleotide-pill) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 800;
    color: #ffffff;
  }

  :global(.pill-a) { background: #10b981; }
  :global(.pill-c) { background: #0284c7; }
  :global(.pill-g) { background: #f59e0b; }
  :global(.pill-t) { background: #a855f7; }

  .snake-hint {
    font-size: var(--fs-meta, 0.78rem);
    text-align: center;
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .snake-btn {
      transition: none;
    }
  }
</style>
