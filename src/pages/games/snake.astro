---
import PageLayout from '../../layouts/PageLayout.astro';
import SnakeLogo from '../../components/games/SnakeLogo.astro';
import { site } from '../../data/site';

const gameLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Snake',
  description:
    'A classic browser snake game with a genomics twist: guide a nucleotide serpent to consume A · C · G · T bases and grow a sequence strand.',
  url: `${site.url}/games/snake/`,
  author: { '@id': `${site.url}/#person` },
  applicationCategory: 'Game',
  gamePlatform: ['Web browser', 'Mobile web browser'],
  genre: ['Arcade', 'Snake', 'Science Game'],
  inLanguage: 'en',
  isAccessibleForFree: true,
};
---

<PageLayout
  title="Snake"
  eyebrow="Side project"
  lead="A classic browser game with a genomics twist: play with arrow keys, WASD, or swipe. The food items are nucleotide bases (A · C · G · T), and the serpent grows into a living sequence strand."
  description="Snake — a small, mobile-friendly browser game by Kuan-Hao Chao, with a genomic twist: the food is A/C/G/T bases and the snake grows into a sequence."
  width="narrow"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(gameLd)} />

  <section class="snake" aria-label="Snake game">
    <div class="snake-header-card">
      <SnakeLogo size={58} />
      <div class="snake-header-info">
        <h2 class="snake-header-title">Genomic Nucleotide Serpent</h2>
        <p class="snake-header-subtitle">Consume A · C · G · T bases, synthesize sequence chains, and navigate the chromatin grid.</p>
      </div>
    </div>

    <div class="snake-hud">
      <div class="snake-stats">
        <div class="stat">
          <span class="stat-label">Bases</span>
          <span class="stat-value" data-snake-score>0</span>
        </div>
        <div class="stat">
          <span class="stat-label">Best</span>
          <span class="stat-value" data-snake-best>0</span>
        </div>
      </div>
      <div class="snake-controls">
        <button type="button" class="game-btn" data-snake-pause disabled>Pause</button>
        <button type="button" class="game-btn" data-snake-restart>Restart</button>
      </div>
    </div>

    <div class="snake-board">
      <canvas
        data-snake-canvas
        role="img"
        aria-label="Snake game board — use the arrow keys, WASD, or swipe to steer."
      ></canvas>
    </div>

    <p class="snake-status" data-snake-status role="status" aria-live="polite">
      Press an arrow, Space, or tap to start
    </p>

    <div class="snake-strand-card" aria-label="Synthesized nucleotide sequence">
      <span class="sequence-label">Synthesized Sequence (5'→3'):</span>
      <div class="sequence-ribbon" data-snake-strand>—</div>
    </div>

    <details class="snake-help">
      <summary>How to Play & Controls</summary>
      <div class="help-grid muted">
        <p>
          <strong>Steer:</strong> Use <code>Arrow keys</code> or <code>W A S D</code> on desktop; swipe in any direction on mobile.
        </p>
        <p>
          <strong>Pause & Start:</strong> Press <code>Space</code> or <code>P</code> to start / pause the run.
        </p>
        <p>
          <strong>Genomic Growth:</strong> Each nucleotide base (A, C, G, T) consumed extends your sequence strand and accelerates the serpent.
        </p>
        <p>
          <strong>Boundaries:</strong> Avoid colliding with the grid edges or crossing your own elongated transcript body.
        </p>
      </div>
    </details>
  </section>
</PageLayout>

<script>
  import { initSnake, type SnakeController } from '../../scripts/snake';

  let controller: SnakeController | null = null;

  function mount() {
    if (controller) return;
    controller = initSnake(document);
  }

  function unmount() {
    controller?.destroy();
    controller = null;
  }

  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', unmount);
  mount();
</script>

<style>
  .snake {
    max-width: 32rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    box-sizing: border-box;
  }

  .snake-header-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md, 8px);
    box-sizing: border-box;
  }

  .snake-header-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .snake-header-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
  }

  .snake-header-subtitle {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin: 0;
  }

  .snake-hud {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md, 8px);
    box-sizing: border-box;
  }

  .snake-stats {
    display: flex;
    gap: 1.5rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-label,
  .sequence-label {
    font-size: var(--fs-meta, 0.75rem);
    letter-spacing: var(--tracking-meta, 0.05em);
    text-transform: uppercase;
    color: var(--color-muted);
    font-weight: 600;
  }

  .stat-value {
    font-family: var(--font-mono, monospace);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .snake-controls {
    display: flex;
    gap: 0.5rem;
  }

  .game-btn {
    min-height: 44px;
    padding: 0.5em 1em;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm, 6px);
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: var(--fs-small, 0.85rem);
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
    box-sizing: border-box;
  }

  .game-btn:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .game-btn:active:not(:disabled) {
    transform: translateY(1px);
  }

  .game-btn:disabled {
    opacity: 0.42;
    cursor: default;
  }

  .snake-board {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    margin-inline: auto;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg, 12px);
    background: var(--color-surface);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    box-sizing: border-box;
  }

  .snake-board canvas {
    width: 100%;
    height: 100%;
    touch-action: none;
    user-select: none;
    display: block;
  }

  .snake-status {
    min-height: 1.4em;
    text-align: center;
    font-size: var(--fs-small, 0.85rem);
    color: var(--color-ink);
    margin: 0;
  }

  .snake-strand-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md, 8px);
    box-sizing: border-box;
  }

  .sequence-ribbon {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono, monospace);
    font-size: 0.95rem;
    font-weight: 700;
    min-height: 1.6rem;
    color: var(--color-ink);
  }

  :global(.nucleotide-pill) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 800;
    color: #ffffff;
  }

  :global(.pill-a) { background: #10b981; }
  :global(.pill-c) { background: #0284c7; }
  :global(.pill-g) { background: #f59e0b; }
  :global(.pill-t) { background: #a855f7; }

  .snake-help {
    margin-top: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md, 8px);
    box-sizing: border-box;
  }

  .snake-help summary {
    color: var(--color-ink);
    font-size: var(--fs-small, 0.88rem);
    font-weight: 700;
    cursor: pointer;
  }

  .help-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem 1.5rem;
    padding-top: var(--space-3);
    font-size: var(--fs-meta, 0.8rem);
    line-height: 1.5;
  }

  .help-grid strong {
    color: var(--color-ink);
  }

  @media (max-width: 620px) {
    .help-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .game-btn {
      transition: none;
    }
  }
</style>
