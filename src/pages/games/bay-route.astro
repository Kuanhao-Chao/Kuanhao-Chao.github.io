---
import PageLayout from '../../layouts/PageLayout.astro';
import BayRouteLogo from '../../components/games/BayRouteLogo.astro';
import { site } from '../../data/site';
import { PRESET_TRIPS, BAY_NODES } from '../../lib/bayGraph';
import { ALGORITHMS } from '../../lib/pathfinding';

const appLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'BayRoute — Bay Area Pathfinding & Route Search Visualizer',
  description:
    'Interactive educational pathfinding visualizer demonstrating Dijkstra, A*, Bidirectional A*, Greedy Best-First, and BFS algorithms on an authentic San Francisco Bay Area road network graph with step-by-step glowing frontier animations and multi-algorithm race mode.',
  url: `${site.url}/games/bay-route/`,
  author: { '@id': `${site.url}/#person` },
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Any',
  inLanguage: 'en',
  isAccessibleForFree: true,
};
---

<PageLayout
  title="BayRoute — Bay Area Pathfinding Visualizer"
  eyebrow="Interactive Simulation & Algorithm Demo"
  lead="Step-by-step dynamic route planning & graph search visualizer on the San Francisco Bay Area road network — compare Dijkstra, A*, Bidirectional A*, Greedy, and BFS in real time."
  description="Explore how GPS pathfinding algorithms find optimal trips across the San Francisco Bay Area. Watch glowing search frontiers expand across bridges and highways with interactive playback, telemetry, and 5-algorithm race mode."
  width="wide"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(appLd)} />

  <section class="br-container" data-br-root aria-label="BayRoute Visualizer">
    <!-- Header Card -->
    <div class="br-header-card">
      <BayRouteLogo size={70} />
      <div class="br-header-info">
        <h2 class="br-header-title">BayRoute · Bay Area Pathfinding Visualizer</h2>
        <p class="br-header-subtitle">
          5 algorithms. One destination. Explore how graph search frontiers navigate bay bridges,
          peninsula freeways, and coastal mountain passes in real time.
        </p>
      </div>
    </div>

    <!-- Presets & Route Selection Bar -->
    <div class="br-presets-bar">
      <span class="br-bar-label">Curated Trips:</span>
      <div class="br-presets-list" role="radiogroup" aria-label="Curated Bay Area Trips">
        {
          PRESET_TRIPS.map((trip, idx) => (
            <button
              type="button"
              class={`br-preset-btn ${idx === 0 ? 'is-active' : ''}`}
              data-trip-id={trip.id}
              title={trip.description}
            >
              <span aria-hidden="true">{trip.icon}</span>
              <span>{trip.name}</span>
            </button>
          ))
        }
      </div>
    </div>

    <!-- Primary Control Toolbar -->
    <div class="br-toolbar">
      <div class="br-toolbar-row">
        <!-- Algorithm Selector -->
        <div class="br-control-group">
          <label class="br-label" for="br-algo-select">Algorithm:</label>
          <select id="br-algo-select" class="br-select" data-br-algo>
            <option value="dijkstra" selected>Dijkstra (Uniform Cost Search)</option>
            <option value="a_star">A* Search (Haversine Heuristic)</option>
            <option value="bidirectional_a_star">Bidirectional A* (Dual-End Meeting)</option>
            <option value="greedy">Greedy Best-First (Heuristic Only)</option>
            <option value="bfs">BFS (Unweighted Hop Count)</option>
            <option value="dfs">DFS (Exhaustive Depth Exploration)</option>
          </select>
        </div>

        <!-- Mode Toggle (Single vs Race) -->
        <div class="br-control-group">
          <label class="br-label">Mode:</label>
          <div class="br-toggle-group">
            <button type="button" class="br-toggle-btn is-active" data-mode="single">Single View</button>
            <button type="button" class="br-toggle-btn" data-mode="race">5-Algorithm Race 🏁</button>
          </div>
        </div>

        <!-- Start / Destination Pickers -->
        <div class="br-control-group">
          <label class="br-label" for="br-start-select">Start 🚩:</label>
          <select id="br-start-select" class="br-select" data-br-start>
            {
              BAY_NODES.map((n) => (
                <option value={n.id} selected={n.id === 'sf_ferry_bldg'}>
                  {n.city}: {n.name}
                </option>
              ))
            }
          </select>
        </div>

        <div class="br-control-group">
          <label class="br-label" for="br-goal-select">Goal 🏁:</label>
          <select id="br-goal-select" class="br-select" data-br-goal>
            {
              BAY_NODES.map((n) => (
                <option value={n.id} selected={n.id === 'berkeley_campanile'}>
                  {n.city}: {n.name}
                </option>
              ))
            }
          </select>
        </div>
      </div>

      <!-- Playback Controls & Scrubber Row -->
      <div class="br-playback-row">
        <div class="br-play-buttons">
          <button type="button" class="br-btn br-btn--primary" data-br-play aria-label="Play or Pause search animation">
            ⏸ Pause
          </button>
          <button type="button" class="br-btn" data-br-step-back title="Step backward one frame (←)">
            ⏮ Step
          </button>
          <button type="button" class="br-btn" data-br-step-fwd title="Step forward one frame (→)">
            Step ⏭
          </button>
          <button type="button" class="br-btn br-btn--reset" data-br-reset title="Restart search animation">
            🔄 Reset
          </button>
        </div>

        <!-- Timeline Scrubber -->
        <div class="br-scrubber-wrap">
          <input
            type="range"
            class="br-scrubber"
            min="0"
            max="100"
            value="0"
            data-br-scrubber
            aria-label="Algorithm search execution progress timeline"
          />
        </div>

        <!-- Speed Multipliers -->
        <div class="br-speed-group">
          <span class="br-speed-label">Speed:</span>
          <button type="button" class="br-speed-btn" data-speed="0.5">0.5×</button>
          <button type="button" class="br-speed-btn is-active" data-speed="1">1×</button>
          <button type="button" class="br-speed-btn" data-speed="3">3×</button>
          <button type="button" class="br-speed-btn" data-speed="8">8×</button>
          <button type="button" class="br-speed-btn" data-speed="999">Instant ⚡</button>
        </div>
      </div>
    </div>

    <!-- Interactive Canvas Viewport -->
    <div class="br-canvas-wrapper">
      <canvas id="bay-route-canvas" class="br-canvas"></canvas>

      <!-- Floating Map Hint Overlay -->
      <div class="br-map-hint">
        <span>💡 Click any intersection or landmark on the map to set Start 🚩 or Goal 🏁</span>
      </div>

      <!-- Hover Tooltip -->
      <div class="br-tooltip" data-br-tooltip hidden></div>
    </div>

    <!-- Live Telemetry Dashboard -->
    <div class="br-telemetry-grid">
      <div class="br-telemetry-card">
        <span class="br-metric-label">Nodes Explored</span>
        <strong class="br-metric-value br-metric-value--cyan" data-metric-explored>0</strong>
        <span class="br-metric-sub">Closed Set (Settled)</span>
      </div>

      <div class="br-telemetry-card">
        <span class="br-metric-label">Frontier Queue</span>
        <strong class="br-metric-value br-metric-value--amber" data-metric-frontier>0</strong>
        <span class="br-metric-sub">Open Set Memory</span>
      </div>

      <div class="br-telemetry-card">
        <span class="br-metric-label">Trip Distance</span>
        <strong class="br-metric-value br-metric-value--green" data-metric-distance>—</strong>
        <span class="br-metric-sub">Physical Highway Miles</span>
      </div>

      <div class="br-telemetry-card">
        <span class="br-metric-label">Estimated Time</span>
        <strong class="br-metric-value br-metric-value--purple" data-metric-time>—</strong>
        <span class="br-metric-sub">Speed Limits & Toll Spans</span>
      </div>

      <div class="br-telemetry-card">
        <span class="br-metric-label">Optimality</span>
        <strong class="br-metric-value" data-metric-optimality>Evaluating...</strong>
        <span class="br-metric-sub" id="br-complexity-sub">O((V + E) log V)</span>
      </div>
    </div>

    <!-- Race Mode Leaderboard (Visible when Race Mode is active) -->
    <div class="br-race-section" data-br-race-section hidden>
      <div class="br-race-header">
        <h3>🏁 5-Algorithm Race Leaderboard</h3>
        <span class="br-race-subtitle">Live comparison of exploration efficiency and arrival order</span>
      </div>
      <div class="br-scroll">
        <table class="br-race-table">
          <thead>
            <tr>
              <th>Rank</th>
              <th>Algorithm</th>
              <th>Nodes Explored</th>
              <th>Frontier Size</th>
              <th>Distance</th>
              <th>ETA</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody data-br-race-body>
            <!-- Dynamic rows populated by script -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Educational Deep Dive & Theory Section -->
    <section class="br-theory-section">
      <h2>How Pathfinding Algorithms Work in Real Road Networks</h2>
      <p>
        The San Francisco Bay Area provides a classic benchmark for graph search: water bodies act as
        natural topological barriers, forcing paths through narrow chokepoints (the Bay Bridge, Golden Gate Bridge,
        San Mateo Bridge, and Dumbarton Bridge). Explore how each algorithm navigates these spatial constraints:
      </p>

      <div class="br-algo-cards">
        {
          Object.values(ALGORITHMS).map((meta) => (
            <article class="br-algo-card" style={`--accent-border:${meta.color}`}>
              <div class="br-algo-card__head">
                <span class="br-algo-dot" style={`background:${meta.color}`} />
                <h3>{meta.name}</h3>
                <span class="br-algo-cat">{meta.category}</span>
              </div>
              <p class="br-algo-desc">{meta.description}</p>
              <div class="br-algo-specs">
                <div>
                  <span class="spec-label">Time Complexity:</span>
                  <code>{meta.timeComplexity}</code>
                </div>
                <div>
                  <span class="spec-label">Space Complexity:</span>
                  <code>{meta.spaceComplexity}</code>
                </div>
                <div>
                  <span class="spec-label">Optimal:</span>
                  <strong>{meta.isOptimal ? 'Yes (Shortest Path)' : 'No (Suboptimal / Heuristic)'}</strong>
                </div>
              </div>
              <ul class="br-algo-bullets">
                {meta.characteristics.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>
  </section>
</PageLayout>

<script>
  import { initBayRoute } from '../../scripts/bayRoute';

  function setup() {
    const viz = initBayRoute('#bay-route-canvas', '[data-br-root]');
    if (!viz) return;

    // Presets Click
    const presetButtons = document.querySelectorAll<HTMLButtonElement>('.br-preset-btn');
    presetButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        presetButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const tripId = btn.dataset.tripId;
        if (tripId) viz.loadTrip(tripId);

        // Sync dropdowns
        const startSel = document.querySelector<HTMLSelectElement>('[data-br-start]');
        const goalSel = document.querySelector<HTMLSelectElement>('[data-br-goal]');
        if (startSel) startSel.value = viz.currentStartId;
        if (goalSel) goalSel.value = viz.currentGoalId;
      });
    });

    // Algorithm Change
    const algoSel = document.querySelector<HTMLSelectElement>('[data-br-algo]');
    if (algoSel) {
      algoSel.addEventListener('change', () => {
        viz.setAlgorithm(algoSel.value as any);
      });
    }

    // Start / Goal Dropdowns
    const startSel = document.querySelector<HTMLSelectElement>('[data-br-start]');
    if (startSel) {
      startSel.addEventListener('change', () => {
        viz.setStartNode(startSel.value);
      });
    }

    const goalSel = document.querySelector<HTMLSelectElement>('[data-br-goal]');
    if (goalSel) {
      goalSel.addEventListener('change', () => {
        viz.setGoalNode(goalSel.value);
      });
    }

    // Mode Toggle
    const modeButtons = document.querySelectorAll<HTMLButtonElement>('[data-mode]');
    const raceSection = document.querySelector<HTMLElement>('[data-br-race-section]');

    modeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        modeButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const isRace = btn.dataset.mode === 'race';
        viz.setRaceMode(isRace);
        if (raceSection) raceSection.hidden = !isRace;
      });
    });

    // Playback Buttons
    const playBtn = document.querySelector<HTMLButtonElement>('[data-br-play]');
    if (playBtn) {
      playBtn.addEventListener('click', () => {
        if (playBtn.textContent?.includes('Pause')) {
          viz.pause();
        } else {
          viz.play();
        }
      });
    }

    const stepFwdBtn = document.querySelector<HTMLButtonElement>('[data-br-step-fwd]');
    if (stepFwdBtn) {
      stepFwdBtn.addEventListener('click', () => viz.stepForward());
    }

    const stepBackBtn = document.querySelector<HTMLButtonElement>('[data-br-step-back]');
    if (stepBackBtn) {
      stepBackBtn.addEventListener('click', () => viz.stepBackward());
    }

    const resetBtn = document.querySelector<HTMLButtonElement>('[data-br-reset]');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => viz.recalculate());
    }

    // Scrubber
    const scrubber = document.querySelector<HTMLInputElement>('[data-br-scrubber]');
    if (scrubber) {
      scrubber.addEventListener('input', () => {
        const val = parseFloat(scrubber.value) / 100;
        viz.scrubTo(val);
      });
    }

    // Speed Multipliers
    const speedButtons = document.querySelectorAll<HTMLButtonElement>('.br-speed-btn');
    speedButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        speedButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const speed = parseFloat(btn.dataset.speed || '1');
        viz.setSpeed(speed);
      });
    });
  }

  setup();
  document.addEventListener('astro:after-swap', setup);
</script>

<style>
  .br-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin: 1rem 0 3rem;
  }

  .br-header-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 12px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .br-header-title {
    margin: 0 0 0.35rem;
    font-size: 1.45rem;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
  }

  .br-header-subtitle {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-muted);
    line-height: 1.5;
  }

  /* Presets Bar */
  .br-presets-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
    overflow-x: auto;
  }

  .br-bar-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .br-presets-list {
    display: flex;
    gap: 0.5rem;
    flex-wrap: nowrap;
  }

  .br-preset-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-ink) 3%, var(--color-surface));
    color: var(--color-ink);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .br-preset-btn:hover {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface));
  }

  .br-preset-btn.is-active {
    background: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
    font-weight: 650;
  }

  /* Toolbar */
  .br-toolbar {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.15rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
  }

  .br-toolbar-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .br-control-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .br-label {
    font-size: 0.8125rem;
    font-weight: 650;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .br-select {
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-sm, 6px);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-ink);
    font-size: 0.85rem;
    font-family: inherit;
    cursor: pointer;
    outline: none;
    transition: border-color 0.15s ease;
  }

  .br-select:focus {
    border-color: var(--color-accent);
  }

  .br-toggle-group {
    display: inline-flex;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm, 6px);
    overflow: hidden;
  }

  .br-toggle-btn {
    padding: 0.4rem 0.75rem;
    border: none;
    background: var(--color-bg);
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .br-toggle-btn.is-active {
    background: var(--color-accent);
    color: #ffffff;
  }

  /* Playback Controls */
  .br-playback-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
  }

  .br-play-buttons {
    display: flex;
    gap: 0.4rem;
  }

  .br-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-sm, 6px);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-ink);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .br-btn:hover {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface));
  }

  .br-btn--primary {
    background: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
  }

  .br-btn--primary:hover {
    opacity: 0.92;
  }

  .br-scrubber-wrap {
    flex: 1;
    min-width: 140px;
    display: flex;
    align-items: center;
  }

  .br-scrubber {
    width: 100%;
    accent-color: var(--color-accent);
    cursor: pointer;
  }

  .br-speed-group {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .br-speed-label {
    font-size: 0.75rem;
    color: var(--color-muted);
    font-weight: 600;
    margin-right: 0.15rem;
  }

  .br-speed-btn {
    padding: 0.3rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.12s ease;
  }

  .br-speed-btn.is-active {
    background: color-mix(in srgb, var(--color-accent) 15%, var(--color-surface));
    border-color: var(--color-accent);
    color: var(--color-accent);
    font-weight: 700;
  }

  /* Canvas Viewport */
  .br-canvas-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    max-height: 700px;
    border-radius: var(--radius-lg, 12px);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: #020617;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
  }

  .br-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .br-map-hint {
    position: absolute;
    bottom: 12px;
    left: 14px;
    background: rgba(15, 23, 42, 0.85);
    color: #e2e8f0;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    pointer-events: none;
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
  }

  .br-tooltip {
    position: absolute;
    z-index: 10;
    pointer-events: none;
    background: rgba(15, 23, 42, 0.95);
    color: #ffffff;
    padding: 0.45rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8125rem;
    line-height: 1.35;
    border: 1px solid var(--color-accent);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(6px);
  }

  /* Telemetry Grid */
  .br-telemetry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.85rem;
  }

  .br-telemetry-card {
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
  }

  .br-metric-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  .br-metric-value {
    font-size: 1.35rem;
    font-weight: 750;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin: 0.2rem 0;
  }

  .br-metric-value--cyan {
    color: #0284c7;
  }
  :global([data-theme='dark']) .br-metric-value--cyan { color: #38bdf8; }

  .br-metric-value--amber {
    color: #d97706;
  }
  :global([data-theme='dark']) .br-metric-value--amber { color: #fbbf24; }

  .br-metric-value--green {
    color: #059669;
  }
  :global([data-theme='dark']) .br-metric-value--green { color: #34d399; }

  .br-metric-value--purple {
    color: #7c3aed;
  }
  :global([data-theme='dark']) .br-metric-value--purple { color: #a78bfa; }

  .br-metric-sub {
    font-size: 0.72rem;
    color: var(--color-muted);
  }

  /* Race Leaderboard */
  .br-race-section {
    padding: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
