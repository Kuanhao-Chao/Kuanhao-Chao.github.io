---
import PageLayout from '../../layouts/PageLayout.astro';
import BayRouteLogo from '../../components/games/BayRouteLogo.astro';
import { site } from '../../data/site';
import { ALGORITHMS } from '../../lib/pathfinding';

const GLOBAL_PRESET_TRIPS = [
  {
    id: 'trip_sf_to_berkeley',
    name: '🌉 SF to Berkeley',
    icon: '🌉',
    description: 'San Francisco Ferry Building to UC Berkeley via the Bay Bridge',
  },
  {
    id: 'trip_nyc_manhattan',
    name: '🗽 Times Sq to Brooklyn',
    icon: '🗽',
    description: 'Times Square to Brooklyn Bridge across Manhattan and East River',
  },
  {
    id: 'trip_tokyo_shibuya',
    name: '🗼 Shibuya to Tokyo Tower',
    icon: '🗼',
    description: 'Shibuya Crossing to Tokyo Tower through Roppongi, Tokyo',
  },
  {
    id: 'trip_london_thames',
    name: '🇬🇧 Westminster to Tower Bridge',
    icon: '🇬🇧',
    description: 'Westminster Palace / Big Ben to Tower Bridge along the River Thames',
  },
  {
    id: 'trip_taipei_101',
    name: '🇹🇼 Taipei 101 to Shilin',
    icon: '🇹🇼',
    description: 'Taipei 101 to Shilin Night Market through Taipei City',
  },
  {
    id: 'trip_sfo_to_stanford',
    name: '🌲 Silicon Valley Corridor',
    icon: '🌲',
    description: 'SFO Airport to Stanford University along the Peninsula',
  },
];

const appLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'BayRoute — Real-World Road Graph & Global Pathfinding Visualizer',
  description:
    'Dynamic real-world route planning and graph search visualizer on authentic Google Maps roads. Type any two addresses anywhere on Earth or click on the map to explore Dijkstra, A*, Bidirectional A*, Greedy, and BFS algorithms with step-by-step glowing frontier animations on real city streets.',
  url: `${site.url}/games/bay-route/`,
  author: { '@id': `${site.url}/#person` },
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Any',
  inLanguage: 'en',
  isAccessibleForFree: true,
};
---

<PageLayout
  title="BayRoute — Real-World Road Graph & Global Pathfinding Visualizer"
  eyebrow="Interactive Simulation & Algorithm Demo"
  lead="Dynamic real-world route planning and graph search visualizer on authentic Google Maps roads — type any two addresses or click anywhere on Earth to watch Dijkstra, A*, Bidirectional A*, Greedy, and BFS explore physical highways and streets in real time."
  description="Demonstrate GPS pathfinding algorithms on real-world roads anywhere on Earth. Features live Google Directions multi-corridor graphs, step-by-step laser wavefront animations, turn-by-turn schedules, and 5-algorithm race mode."
  width="wide"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(appLd)} />

  <section
    class="br-container"
    data-br-root
    data-gmap-token={import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY || ''}
    aria-label="BayRoute Real-World Visualizer"
  >
    <!-- Header Card -->
    <div class="br-header-card">
      <BayRouteLogo size={70} />
      <div class="br-header-info">
        <div class="br-header-title-row">
          <h2 class="br-header-title">BayRoute · Real-World Road Graph & Global Pathfinding Visualizer</h2>
          <div class="br-header-actions">
            <span class="br-status-pill" data-br-map-badge>🗺️ High-Res GIS Map</span>
            <button type="button" class="br-sound-btn" data-br-sound-toggle title="Toggle procedural sound synthesizer">
              <span data-sound-icon>🔇</span> <span data-sound-label>Sound Off</span>
            </button>
          </div>
        </div>
        <p class="br-header-subtitle">
          Enter any two addresses on Earth or click anywhere on the map. Watch search frontiers navigate
          physical highways, bridges, and city streets step by step with real-time algorithm comparisons.
        </p>
      </div>
    </div>

    <!-- Smart Address Search & Route Bar -->
    <div class="br-address-bar">
      <!-- Start Address Input -->
      <div class="br-address-group">
        <label class="br-address-label" for="br-start-input">
          <span class="br-pin-icon" aria-hidden="true">🚩</span>
          <span>Start Address:</span>
        </label>
        <div class="br-input-wrapper">
          <input
            id="br-start-input"
            type="text"
            class="br-input"
            placeholder="Type start address anywhere in the world (e.g. Times Square, SF Ferry Bldg)..."
            value="San Francisco Ferry Building"
            data-br-input="start"
            autocomplete="off"
          />
          <div class="br-autocomplete-dropdown" data-br-results="start" hidden></div>
        </div>
      </div>

      <!-- Swap Button -->
      <button type="button" class="br-swap-btn" data-br-swap title="Swap Start and Destination">
        ⇄
      </button>

      <!-- Destination Address Input -->
      <div class="br-address-group">
        <label class="br-address-label" for="br-goal-input">
          <span class="br-pin-icon" aria-hidden="true">🏁</span>
          <span>Destination Address:</span>
        </label>
        <div class="br-input-wrapper">
          <input
            id="br-goal-input"
            type="text"
            class="br-input"
            placeholder="Type destination address anywhere (e.g. Brooklyn Bridge, UC Berkeley)..."
            value="UC Berkeley (Sather Tower / Campanile)"
            data-br-input="goal"
            autocomplete="off"
          />
          <div class="br-autocomplete-dropdown" data-br-results="goal" hidden></div>
        </div>
      </div>
    </div>

    <!-- Presets Bar -->
    <div class="br-presets-bar">
      <span class="br-bar-label">Quick Trips:</span>
      <div class="br-presets-list" role="radiogroup" aria-label="Curated Real-World Trips">
        {
          GLOBAL_PRESET_TRIPS.map((trip, idx) => (
            <button
              type="button"
              class={`br-preset-btn ${idx === 0 ? 'is-active' : ''}`}
              data-trip-id={trip.id}
              title={trip.description}
            >
              <span aria-hidden="true">{trip.icon}</span>
              <span>{trip.name}</span>
            </button>
          ))
        }
      </div>
    </div>

    <!-- Primary Control Toolbar -->
    <div class="br-toolbar">
      <div class="br-toolbar-row">
        <!-- Algorithm Selector -->
        <div class="br-control-group">
          <label class="br-label" for="br-algo-select">Algorithm:</label>
          <select id="br-algo-select" class="br-select" data-br-algo>
            <option value="dijkstra" selected>Dijkstra (Uniform Cost Search)</option>
            <option value="a_star">A* Search (Haversine Distance Heuristic)</option>
            <option value="bidirectional_a_star">Bidirectional A* (Dual-End Meeting)</option>
            <option value="greedy">Greedy Best-First (Heuristic Only)</option>
            <option value="bfs">BFS (Unweighted Hop Count)</option>
            <option value="dfs">DFS (Exhaustive Depth Exploration)</option>
          </select>
        </div>

        <!-- Mode Toggle (Single vs Race) -->
        <div class="br-control-group">
          <label class="br-label">Mode:</label>
          <div class="br-toggle-group">
            <button type="button" class="br-toggle-btn is-active" data-mode="single">Single View</button>
            <button type="button" class="br-toggle-btn" data-mode="race">5-Algorithm Race 🏁</button>
          </div>
        </div>

        <!-- Map Layer Switcher -->
        <div class="br-control-group">
          <label class="br-label">Map Style:</label>
          <div class="br-toggle-group">
            <button type="button" class="br-toggle-btn is-active" data-map-style="dark">Dark GIS</button>
            <button type="button" class="br-toggle-btn" data-map-style="streets">Streets</button>
            <button type="button" class="br-toggle-btn" data-map-style="satellite">Satellite</button>
          </div>
        </div>
      </div>

      <!-- Playback Controls & Scrubber Row -->
      <div class="br-playback-row">
        <div class="br-play-buttons">
          <button type="button" class="br-btn br-btn--primary" data-br-play aria-label="Play or Pause search animation">
            ⏸ Pause
          </button>
          <button type="button" class="br-btn" data-br-step-back title="Step backward one frame (←)">
            ⏮ Step
          </button>
          <button type="button" class="br-btn" data-br-step-fwd title="Step forward one frame (→)">
            Step ⏭
          </button>
          <button type="button" class="br-btn br-btn--reset" data-br-reset title="Restart search animation">
            🔄 Reset
          </button>
          <button type="button" class="br-btn" data-br-fit-bounds title="Fit map view to route">
            🔍 Zoom Route
          </button>
        </div>

        <!-- Timeline Scrubber -->
        <div class="br-scrubber-wrap">
          <input
            type="range"
            class="br-scrubber"
            min="0"
            max="100"
            value="0"
            data-br-scrubber
            aria-label="Algorithm search execution progress timeline"
          />
        </div>

        <!-- Speed Multipliers -->
        <div class="br-speed-group">
          <span class="br-speed-label">Speed:</span>
          <button type="button" class="br-speed-btn" data-speed="0.5">0.5×</button>
          <button type="button" class="br-speed-btn is-active" data-speed="1">1×</button>
          <button type="button" class="br-speed-btn" data-speed="3">3×</button>
          <button type="button" class="br-speed-btn" data-speed="8">8×</button>
          <button type="button" class="br-speed-btn" data-speed="999">Instant ⚡</button>
        </div>
      </div>
    </div>

    <!-- Real-World Map & Canvas Container -->
    <div class="br-map-viewport">
      <div id="bay-route-map" class="br-leaflet-map"></div>
      <canvas id="bay-route-canvas" class="br-canvas-layer"></canvas>

      <!-- Cost Inspector HUD Tooltip -->
      <div class="br-inspector-tooltip" data-br-inspector hidden>
        <div class="br-inspector-header">
          <span class="br-inspector-icon">📍</span>
          <strong class="br-inspector-title" data-inspector-title>Intersection</strong>
        </div>
        <div class="br-inspector-metrics">
          <div class="br-inspector-metric">
            <span class="br-k">g(n):</span>
            <span class="br-v" data-inspector-g>—</span>
          </div>
          <div class="br-inspector-metric">
            <span class="br-k">h(n):</span>
            <span class="br-v" data-inspector-h>—</span>
          </div>
          <div class="br-inspector-metric">
            <span class="br-k">f(n):</span>
            <span class="br-v" data-inspector-f>—</span>
          </div>
        </div>
        <div class="br-inspector-edge" data-inspector-edge></div>
      </div>

      <!-- Floating Map Hint Overlay -->
      <div class="br-map-hint">
        <span>💡 Click map to set pins · Hover over explored roads to inspect g(n) & h(n) costs</span>
      </div>
    </div>

    <!-- Live Telemetry Dashboard -->
    <div class="br-telemetry-grid">
      <div class="br-telemetry-card">
        <span class="br-metric-label">Nodes Explored</span>
        <strong class="br-metric-value br-metric-value--cyan" data-metric-explored>0</strong>
        <span class="br-metric-sub">Closed Set (Settled)</span>
      </div>

      <div class="br-telemetry-card">
        <span class="br-metric-label">Frontier Queue</span>
        <strong class="br-metric-value br-metric-value--amber" data-metric-frontier>0</strong>
        <span class="br-metric-sub">Open Set Memory</span>
      </div>

      <div class="br-telemetry-card">
        <span class="br-metric-label">Trip Distance</span>
        <strong class="br-metric-value br-metric-value--green" data-metric-distance>—</strong>
        <span class="br-metric-sub">Actual Highway Miles</span>
      </div>

      <div class="br-telemetry-card">
        <span class="br-metric-label">Estimated Time</span>
        <strong class="br-metric-value br-metric-value--purple" data-metric-time>—</strong>
        <span class="br-metric-sub">Speed Limits & Toll Spans</span>
      </div>

      <div class="br-telemetry-card">
        <span class="br-metric-label">Optimality</span>
        <strong class="br-metric-value" data-metric-optimality>Evaluating...</strong>
        <span class="br-metric-sub" id="br-complexity-sub">O((V + E) log V)</span>
      </div>
    </div>

    <!-- Turn-by-Turn Navigation & Route Schedule Drawer -->
    <details class="br-maneuvers-drawer" data-br-maneuvers-drawer open>
      <summary class="br-maneuvers-summary">
        <div class="br-maneuvers-title-row">
          <span class="br-maneuvers-badge">🛣️ Turn-by-Turn Route Schedule</span>
          <span class="br-maneuvers-summary-text" data-maneuvers-summary>Calculating driving steps on real roads...</span>
        </div>
      </summary>
      <div class="br-maneuvers-list" data-maneuvers-list>
        <!-- Populated dynamically by script -->
      </div>
    </details>

    <!-- Race Mode Leaderboard (Visible when Race Mode is active) -->
    <div class="br-race-section" data-br-race-section hidden>
      <div class="br-race-header">
        <h3>🏁 5-Algorithm Race Leaderboard</h3>
        <span class="br-race-subtitle">Live comparison of exploration efficiency and arrival order on this trip</span>
      </div>
      <div class="br-scroll">
        <table class="br-race-table">
          <thead>
            <tr>
              <th>Rank</th>
              <th>Algorithm</th>
              <th>Nodes Explored</th>
              <th>Frontier Size</th>
              <th>Distance</th>
              <th>ETA</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody data-br-race-body>
            <!-- Dynamic rows populated by script -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Educational Deep Dive & Theory Section -->
    <section class="br-theory-section">
      <h2>How Graph Search Algorithms Power Real GPS Routing</h2>
      <p>
        The San Francisco Bay Area provides a classic benchmark for graph search: water bodies act as
        natural topological barriers, forcing paths through narrow bridge chokepoints (the Bay Bridge, Golden Gate Bridge,
        San Mateo Bridge, and Dumbarton Bridge). Explore how each algorithm navigates these spatial constraints:
      </p>

      <div class="br-algo-cards">
        {
          Object.values(ALGORITHMS).map((meta) => (
            <article class="br-algo-card" style={`--accent-border:${meta.color}`}>
              <div class="br-algo-card__head">
                <span class="br-algo-dot" style={`background:${meta.color}`} />
                <h3>{meta.name}</h3>
                <span class="br-algo-cat">{meta.category}</span>
              </div>
              <p class="br-algo-desc">{meta.description}</p>
              <div class="br-algo-specs">
                <div>
                  <span class="spec-label">Time Complexity:</span>
                  <code>{meta.timeComplexity}</code>
                </div>
                <div>
                  <span class="spec-label">Space Complexity:</span>
                  <code>{meta.spaceComplexity}</code>
                </div>
                <div>
                  <span class="spec-label">Optimal:</span>
                  <strong>{meta.isOptimal ? 'Yes (Shortest Path)' : 'No (Suboptimal / Heuristic)'}</strong>
                </div>
              </div>
              <ul class="br-algo-bullets">
                {meta.characteristics.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>
  </section>
</PageLayout>

<script>
  import { initBayRoute } from '../../scripts/bayRoute';
  import { audioEngine } from '../../lib/audioFeedback';

  function setup() {
    const viz = initBayRoute('#bay-route-map', '#bay-route-canvas', '[data-br-root]');
    if (!viz) return;

    // Sound Synthesizer Toggle
    const soundBtn = document.querySelector<HTMLButtonElement>('[data-br-sound-toggle]');
    const soundIcon = document.querySelector<HTMLElement>('[data-sound-icon]');
    const soundLabel = document.querySelector<HTMLElement>('[data-sound-label]');
    if (soundBtn) {
      const updateSoundUI = () => {
        const enabled = audioEngine.isSoundEnabled();
        if (soundIcon) soundIcon.textContent = enabled ? '🔊' : '🔇';
        if (soundLabel) soundLabel.textContent = enabled ? 'Sound On' : 'Sound Off';
        soundBtn.classList.toggle('is-active', enabled);
      };
      updateSoundUI();
      soundBtn.addEventListener('click', () => {
        audioEngine.toggleSound();
        updateSoundUI();
      });
    }

    // Presets Click
    const presetButtons = document.querySelectorAll<HTMLButtonElement>('.br-preset-btn');
    presetButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        presetButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const tripId = btn.dataset.tripId;
        if (tripId) viz.loadTrip(tripId);
      });
    });

    // Swap Start & Goal
    const swapBtn = document.querySelector<HTMLButtonElement>('[data-br-swap]');
    if (swapBtn) {
      swapBtn.addEventListener('click', () => {
        const temp = { ...viz.currentStartEndpoint };
        viz.currentStartEndpoint = { ...viz.currentGoalEndpoint };
        viz.currentGoalEndpoint = temp;

        const startInput = document.querySelector<HTMLInputElement>('[data-br-input="start"]');
        const goalInput = document.querySelector<HTMLInputElement>('[data-br-input="goal"]');
        if (startInput) startInput.value = viz.currentStartEndpoint.name;
        if (goalInput) goalInput.value = viz.currentGoalEndpoint.name;

        viz.recalculate();
        viz.fitRouteBounds();
      });
    }

    // Algorithm Change
    const algoSel = document.querySelector<HTMLSelectElement>('[data-br-algo]');
    if (algoSel) {
      algoSel.addEventListener('change', () => {
        viz.setAlgorithm(algoSel.value as any);
      });
    }

    // Mode Toggle
    const modeButtons = document.querySelectorAll<HTMLButtonElement>('[data-mode]');
    const raceSection = document.querySelector<HTMLElement>('[data-br-race-section]');

    modeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        modeButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const isRace = btn.dataset.mode === 'race';
        viz.setRaceMode(isRace);
        if (raceSection) raceSection.hidden = !isRace;
      });
    });

    // Map Style Toggle
    const mapStyleButtons = document.querySelectorAll<HTMLButtonElement>('[data-map-style]');
    mapStyleButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        mapStyleButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const style = btn.dataset.mapStyle as any;
        if (style) viz.setTileStyle(style);
      });
    });

    // Playback Buttons
    const playBtn = document.querySelector<HTMLButtonElement>('[data-br-play]');
    if (playBtn) {
      playBtn.addEventListener('click', () => {
        if (playBtn.textContent?.includes('Pause')) {
          viz.pause();
        } else {
          viz.play();
        }
      });
    }

    const stepFwdBtn = document.querySelector<HTMLButtonElement>('[data-br-step-fwd]');
    if (stepFwdBtn) {
      stepFwdBtn.addEventListener('click', () => viz.stepForward());
    }

    const stepBackBtn = document.querySelector<HTMLButtonElement>('[data-br-step-back]');
    if (stepBackBtn) {
      stepBackBtn.addEventListener('click', () => viz.stepBackward());
    }

    const resetBtn = document.querySelector<HTMLButtonElement>('[data-br-reset]');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => viz.recalculate());
    }

    const fitBtn = document.querySelector<HTMLButtonElement>('[data-br-fit-bounds]');
    if (fitBtn) {
      fitBtn.addEventListener('click', () => viz.fitRouteBounds());
    }

    // Scrubber
    const scrubber = document.querySelector<HTMLInputElement>('[data-br-scrubber]');
    if (scrubber) {
      scrubber.addEventListener('input', () => {
        const val = parseFloat(scrubber.value) / 100;
        viz.scrubTo(val);
      });
    }

    // Speed Multipliers
    const speedButtons = document.querySelectorAll<HTMLButtonElement>('.br-speed-btn');
    speedButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        speedButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const speed = parseFloat(btn.dataset.speed || '1');
        viz.setSpeed(speed);
      });
    });
  }

  setup();
  document.addEventListener('astro:after-swap', setup);
</script>

<style>
  /* Embedded Core Leaflet Styles for Instant, Rock-Solid Tile Rendering */
  :global(.leaflet-pane),
  :global(.leaflet-tile),
  :global(.leaflet-marker-icon),
  :global(.leaflet-marker-shadow),
  :global(.leaflet-tile-container),
  :global(.leaflet-pane > svg),
  :global(.leaflet-pane > canvas),
  :global(.leaflet-zoom-box),
  :global(.leaflet-image-layer),
  :global(.leaflet-layer) {
    position: absolute;
    left: 0;
    top: 0;
  }
  :global(.leaflet-container) {
    overflow: hidden;
    position: relative;
    outline: 0;
  }
  :global(.leaflet-tile),
  :global(.leaflet-marker-icon),
  :global(.leaflet-marker-shadow) {
    -webkit-user-select: none;
    -moz-user-select: none;
    user-select: none;
    -webkit-user-drag: none;
  }
  :global(.leaflet-tile-container) {
    pointer-events: none;
  }
  :global(.leaflet-pane) {
    z-index: 400;
  }
  :global(.leaflet-tile-pane) {
    z-index: 200;
  }
  :global(.leaflet-overlay-pane) {
    z-index: 400;
  }
  :global(.leaflet-shadow-pane) {
    z-index: 500;
  }
  :global(.leaflet-marker-pane) {
    z-index: 600;
  }
  :global(.leaflet-tooltip-pane) {
    z-index: 650;
  }
  :global(.leaflet-popup-pane) {
    z-index: 700;
  }
  :global(.leaflet-control) {
    position: relative;
    z-index: 800;
    pointer-events: auto;
  }
  :global(.leaflet-top),
  :global(.leaflet-bottom) {
    position: absolute;
    z-index: 1000;
    pointer-events: none;
  }
  :global(.leaflet-top) {
    top: 0;
  }
  :global(.leaflet-right) {
    right: 0;
  }
  :global(.leaflet-bottom) {
    bottom: 0;
  }
  :global(.leaflet-left) {
    left: 0;
  }

  .br-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin: 1rem 0 3rem;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .br-header-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 12px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .br-header-info {
    flex: 1;
  }

  .br-header-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }

  .br-header-title {
    margin: 0;
    font-size: 1.45rem;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
  }

  .br-header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .br-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface));
    color: var(--color-ink);
    font-size: 0.8125rem;
    font-weight: 650;
  }

  .br-sound-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .br-sound-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-ink);
  }

  .br-sound-btn.is-active {
    background: color-mix(in srgb, #10b981 15%, var(--color-surface));
    border-color: #10b981;
    color: #10b981;
  }

  .br-header-subtitle {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-muted);
    line-height: 1.5;
  }

  /* Address Bar */
  .br-address-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.75rem;
    padding: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
  }

  .br-address-group {
    flex: 1;
    min-width: min(100%, 18rem);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .br-address-label {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-ink);
  }

  .br-pin-icon {
    font-size: 1rem;
    line-height: 1;
  }

  .br-input-wrapper {
    position: relative;
    width: 100%;
  }

  .br-input {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm, 6px);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-ink);
    font-size: 0.9rem;
    font-family: inherit;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .br-input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 15%, transparent);
  }

  .br-autocomplete-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm, 6px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    z-index: 1000;
    max-height: 240px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  .br-autocomplete-dropdown :global(.br-autocomplete-item) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0.55rem 0.85rem;
    border: none;
    background: transparent;
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 40%, transparent);
    color: var(--color-ink);
    cursor: pointer;
    text-align: left;
    width: 100%;
    font-family: inherit;
    transition: background 0.12s ease;
  }

  .br-autocomplete-dropdown :global(.br-autocomplete-item:last-child) {
    border-bottom: none;
  }

  .br-autocomplete-dropdown :global(.br-autocomplete-item:hover) {
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface));
  }

  .br-autocomplete-dropdown :global(.br-autocomplete-item strong) {
    font-size: 0.85rem;
    color: var(--color-ink);
  }

  .br-autocomplete-dropdown :global(.br-autocomplete-item span) {
    font-size: 0.72rem;
    color: var(--color-muted);
    margin-top: 2px;
  }

  .br-swap-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm, 6px);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-ink);
    font-size: 1.25rem;
    cursor: pointer;
    transition: all 0.15s ease;
    margin-bottom: 1px;
  }

  .br-swap-btn:hover {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface));
  }

  /* Presets Bar */
  .br-presets-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
    overflow-x: auto;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .br-bar-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .br-presets-list {
    display: flex;
    gap: 0.5rem;
    flex-wrap: nowrap;
    min-width: 0;
  }

  .br-preset-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-ink) 3%, var(--color-surface));
    color: var(--color-ink);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .br-preset-btn:hover {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface));
  }

  .br-preset-btn.is-active {
    background: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
    font-weight: 650;
  }

  /* Toolbar */
  .br-toolbar {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.15rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
  }

  .br-toolbar-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .br-control-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
  }

  .br-label {
    font-size: 0.8125rem;
    font-weight: 650;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .br-select {
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-sm, 6px);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-ink);
    font-size: 0.85rem;
    font-family: inherit;
    cursor: pointer;
    outline: none;
    transition: border-color 0.15s ease;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .br-select:focus {
    border-color: var(--color-accent);
  }

  .br-toggle-group {
    display: inline-flex;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm, 6px);
    overflow: hidden;
  }

  .br-toggle-btn {
    padding: 0.4rem 0.75rem;
    border: none;
    background: var(--color-bg);
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .br-toggle-btn.is-active {
    background: var(--color-accent);
    color: #ffffff;
  }

  /* Playback Controls */
  .br-playback-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
  }

  .br-play-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .br-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-sm, 6px);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-ink);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .br-btn:hover {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface));
  }

  .br-btn--primary {
    background: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
  }

  .br-btn--primary:hover {
    opacity: 0.92;
  }

  .br-scrubber-wrap {
    flex: 1;
    min-width: 140px;
    display: flex;
    align-items: center;
  }

  .br-scrubber {
    width: 100%;
    accent-color: var(--color-accent);
    cursor: pointer;
  }

  .br-speed-group {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .br-speed-label {
    font-size: 0.75rem;
    color: var(--color-muted);
    font-weight: 600;
    margin-right: 0.15rem;
  }

  .br-speed-btn {
    padding: 0.3rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.12s ease;
  }

  .br-speed-btn.is-active {
    background: color-mix(in srgb, var(--color-accent) 15%, var(--color-surface));
    border-color: var(--color-accent);
    color: var(--color-accent);
    font-weight: 700;
  }

  /* Map Viewport */
  .br-map-viewport {
    position: relative;
    width: 100%;
    height: 560px;
    border-radius: var(--radius-lg, 12px);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
  }

  .br-leaflet-map {
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .br-canvas-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }

  .br-map-hint {
    position: absolute;
    bottom: 12px;
    left: 14px;
    background: rgba(15, 23, 42, 0.85);
    color: #e2e8f0;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    pointer-events: none;
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    z-index: 10;
  }

  .br-inspector-tooltip {
    position: absolute;
    top: 0;
    left: 0;
    background: rgba(15, 23, 42, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(12px);
    border-radius: var(--radius-sm, 8px);
    padding: 0.6rem 0.85rem;
    color: #f8fafc;
    font-size: 0.8rem;
    pointer-events: none;
    z-index: 50;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    min-width: 170px;
    transition: opacity 0.1s ease;
  }

  .br-inspector-header {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding-bottom: 0.3rem;
  }

  .br-inspector-title {
    font-size: 0.82rem;
    font-weight: 700;
    color: #38bdf8;
    white-space: nowrap;
  }

  .br-inspector-metrics {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .br-inspector-metric {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
  }

  .br-inspector-metric .br-k {
    color: #94a3b8;
    font-weight: 600;
  }

  .br-inspector-metric .br-v {
    color: #f1f5f9;
    font-weight: 700;
  }

  .br-inspector-edge {
    margin-top: 0.35rem;
    padding-top: 0.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.72rem;
    color: #cbd5e1;
    font-style: italic;
  }

  :global(.br-marker-pin) {
    font-size: 1.45rem;
    line-height: 1;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.5));
    transition: transform 0.15s ease;
  }

  /* Telemetry Grid */
  .br-telemetry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.85rem;
  }

  .br-telemetry-card {
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
  }

  .br-metric-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  .br-metric-value {
    font-size: 1.35rem;
    font-weight: 750;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin: 0.2rem 0;
  }

  .br-metric-value--cyan { color: #0284c7; }
  :global([data-theme='dark']) .br-metric-value--cyan { color: #38bdf8; }

  .br-metric-value--amber { color: #d97706; }
  :global([data-theme='dark']) .br-metric-value--amber { color: #fbbf24; }

  .br-metric-value--green { color: #059669; }
  :global([data-theme='dark']) .br-metric-value--green { color: #34d399; }

  .br-metric-value--purple { color: #7c3aed; }
  :global([data-theme='dark']) .br-metric-value--purple { color: #a78bfa; }

  .br-metric-sub {
    font-size: 0.72rem;
    color: var(--color-muted);
  }

  /* Turn-by-Turn Navigation & Schedule Drawer */
  .br-maneuvers-drawer {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .br-maneuvers-drawer[open] {
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-border));
  }

  .br-maneuvers-summary {
    padding: 0.85rem 1.15rem;
    cursor: pointer;
    user-select: none;
    background: color-mix(in srgb, var(--color-ink) 2%, var(--color-surface));
    border-bottom: 1px solid transparent;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .br-maneuvers-drawer[open] .br-maneuvers-summary {
    border-bottom-color: var(--color-border);
  }

  .br-maneuvers-title-row {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .br-maneuvers-badge {
    color: var(--color-ink);
    font-weight: 700;
  }

  .br-maneuvers-summary-text {
    font-size: 0.8125rem;
    color: var(--color-muted);
    font-weight: 450;
  }

  .br-maneuvers-list {
    display: flex;
    flex-direction: column;
    max-height: 280px;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .br-maneuver-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 0.65rem 1.15rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 50%, transparent);
    transition: background 0.15s ease;
  }

  .br-maneuver-item:last-child {
    border-bottom: none;
  }

  .br-maneuver-item:hover {
    background: color-mix(in srgb, var(--color-accent) 4%, transparent);
  }

  .br-maneuver-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-accent) 15%, var(--color-surface));
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .br-maneuver-content {
    flex: 1;
    min-width: 0;
  }

  .br-maneuver-text {
    margin: 0;
    font-size: 0.825rem;
    color: var(--color-ink);
    line-height: 1.35;
    font-weight: 550;
  }

  .br-maneuver-meta {
    font-size: 0.72rem;
    color: var(--color-muted);
    margin-top: 0.15rem;
    display: block;
  }

  .br-maneuver-empty {
    padding: 1rem 1.15rem;
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-style: italic;
  }

  /* Race Leaderboard */
  .br-race-section {
    padding: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
  }

  .br-race-header h3 {
    margin: 0 0 0.25rem;
    font-size: 1.15rem;
    color: var(--color-ink);
  }

  .br-race-subtitle {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .br-scroll {
    overflow-x: auto;
    margin-top: 0.85rem;
  }

  .br-race-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    min-width: 32rem;
  }

  .br-race-table th,
  .br-race-table td {
    padding: 0.55rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }

  .br-race-table thead th {
    background: color-mix(in srgb, var(--color-ink) 3%, var(--color-surface));
    color: var(--color-ink);
    font-weight: 700;
  }

  :global(.race-color-dot) {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 6px;
    vertical-align: middle;
  }

  :global(.race-badge) {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
  }

  :global(.race-badge--arrived) {
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
  }

  :global(.race-badge--searching) {
    background: rgba(56, 189, 248, 0.15);
    color: #0284c7;
  }

  /* Educational Theory Section */
  .br-theory-section {
    margin: 2.5rem 0 1rem;
  }

  .br-theory-section h2 {
    margin-bottom: 0.5rem;
    font-size: 1.45rem;
  }

  .br-theory-section > p {
    max-width: 72ch;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .br-algo-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .br-algo-card {
    padding: 1.25rem;
    border-radius: var(--radius-md, 8px);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--accent-border, var(--color-accent));
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
  }

  .br-algo-card__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.65rem;
  }

  .br-algo-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .br-algo-card__head h3 {
    margin: 0;
    font-size: 1.05rem;
    color: var(--color-ink);
  }

  .br-algo-cat {
    margin-left: auto;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 6%, transparent);
    color: var(--color-muted);
  }

  .br-algo-desc {
    margin: 0 0 0.85rem;
    font-size: 0.85rem;
    color: var(--color-muted);
    line-height: 1.5;
  }

  .br-algo-specs {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.65rem;
    background: color-mix(in srgb, var(--color-ink) 3%, var(--color-surface));
    border-radius: 6px;
    font-size: 0.78125rem;
    margin-bottom: 0.85rem;
  }

  .br-algo-specs .spec-label {
    color: var(--color-muted);
    margin-right: 0.35rem;
  }

  .br-algo-bullets {
    list-style: none;
    padding: 0;
    margin: auto 0 0;
    font-size: 0.78125rem;
    color: var(--color-muted);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .br-algo-bullets li {
    position: relative;
    padding-left: 1rem;
  }

  .br-algo-bullets li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--accent-border, var(--color-accent));
    font-weight: bold;
  }

  @media (max-width: 768px) {
    .br-header-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 1rem 1.15rem;
      gap: 0.85rem;
    }
    .br-header-title-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
    .br-address-bar {
      padding: 1rem;
    }
    .br-address-swap-col {
      width: 100%;
      display: flex;
      justify-content: center;
    }
    .br-toolbar {
