---
import PageLayout from '../../layouts/PageLayout.astro';
import BayRouteLogo from '../../components/games/BayRouteLogo.astro';
import GameTools from '../../components/games/GameTools.astro';
import { site } from '../../data/site';
import { ALGORITHMS } from '../../lib/pathfinding';
import { BAYROUTE_EXAMPLES, BAYROUTE_TRIPS } from '../../lib/bayRouteTeaching';
import 'leaflet/dist/leaflet.css';

const appLd = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication',
  name: 'BayRoute — Pathfinding Lab', url: `${site.url}/games/bay-route/`,
  description: 'An offline-capable pathfinding teaching tool with worked examples, six algorithms, five-way comparisons and incomplete curated city road graphs.',
  author: { '@id': `${site.url}/#person` }, applicationCategory: 'EducationalApplication', operatingSystem: 'Any', isAccessibleForFree: true,
};
---
<PageLayout title="BayRoute — Pathfinding Lab" eyebrow="Interactive learning tool" width="wide"
  lead="See why shortest-path algorithms make different decisions. Step through weighted examples, inspect each expansion, then explore curated road graphs in five regions. The learning view works offline; basemaps are optional."
  description="Compare Dijkstra, A*, balanced bidirectional A*, greedy, BFS and DFS through worked examples and curated road networks. Offline, keyboard and mobile friendly.">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(appLd)} />
  <section class="br" data-br-root data-game-root data-gmap-token={import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY || ''} aria-label="BayRoute pathfinding lab">
    <GameTools />
    <div class="br-intro"><BayRouteLogo size={54} /><div><h2>Maps are context. The graph is the model.</h2><p>Read the weights, inspect the frontier, and compare the route—not just the animation.</p></div></div>
    <div class="br-controls">
      <label>Scene
        <select data-br-scene>
          <optgroup label="Worked examples">{BAYROUTE_EXAMPLES.map((example) => <option value={example.id}>{example.title}</option>)}</optgroup>
          <optgroup label="Curated city trips">{BAYROUTE_TRIPS.map((trip) => <option value={trip.id}>{trip.title}</option>)}</optgroup>
          <option value="custom" disabled hidden>Custom represented route</option>
        </select>
      </label>
      <label>Algorithm<select data-br-algo>{Object.values(ALGORITHMS).map((algorithm) => <option value={algorithm.id}>{algorithm.name}</option>)}</select></label>
      <label class="br-check"><input type="checkbox" data-br-race /> Five-algorithm comparison</label>
      <button type="button" class="br-primary" data-br-run>Run search</button>
    </div>
    <p class="br-explanation" data-br-explanation></p>
    <div class="br-endpoints">
      <label>Start junction<select data-br-start-node aria-label="Start represented junction"></select></label>
      <label>Goal junction<select data-br-goal-node aria-label="Goal represented junction"></select></label>
      <label>Map click sets<select data-br-pick-target><option value="start">Start</option><option value="goal">Goal</option></select></label>
    </div>
    <div class="br-stage">
      <div class="br-map" data-br-map>
        <div class="br-basemap" data-br-basemap hidden></div>
        <canvas data-br-canvas role="img" aria-label="Search graph: filled blue nodes are settled, amber outlined nodes are frontier, S is start and T is goal. Junction pickers provide a keyboard alternative to map clicks."></canvas>
      </div>
      <aside class="br-inspector">
        <h3>Expansion inspector</h3>
        <p data-br-inspector>Run a search, then step through its trace.</p>
        <div class="br-legend"><span>● Settled</span><span>◯ Frontier</span><span>S Start / T Goal</span><span>━ Completed route</span></div>
        <p class="br-small" data-br-algorithm-note>{ALGORITHMS.dijkstra.description}</p>
        <p class="br-small">“Settled entries” may count a junction in both directions for bidirectional search. Playback speed is not algorithm compute speed.</p>
      </aside>
    </div>
    <div class="br-playback">
      <button type="button" data-br-play>Play</button><button type="button" data-br-step>Step</button><button type="button" data-br-reset>Reset trace</button><button type="button" data-br-fit>Fit graph</button>
      <label>Playback<select data-br-speed><option value="6">6 events/s</option><option value="20" selected>20 events/s</option><option value="60">60 events/s</option><option value="150">150 events/s</option></select></label>
      <button type="button" data-br-sound aria-pressed="false">Sound off</button>
      <label class="br-scrubber">Trace position<input type="range" data-br-scrubber min="0" max="1" value="0" step="1" /><span data-br-step-count>0 / 0 events</span></label>
    </div>
    <p class="br-status" data-br-status role="status" aria-live="polite">Offline schematic ready.</p>
    <div class="br-table-scroll">
      <table class="br-table"><caption>Search comparison · arbitrary cost units in examples, modeled minutes in city graphs</caption><thead><tr><th scope="col">Algorithm</th><th scope="col">Route cost</th><th scope="col">Settled entries</th><th scope="col">Compute ms</th></tr></thead><tbody data-br-results></tbody></table>
    </div>
    <details class="br-details">
      <summary>Local landmark search & optional basemaps</summary>
      <p>Landmark lookup uses the bundled local list only. Supported road regions: the San Francisco Bay Area, New York, Tokyo, London and Taipei. Endpoints snap at most two miles to represented junctions; unsupported or cross-region requests are rejected. No extra roads are created.</p>
      <div class="br-search">
        <label>Start landmark<input type="text" data-br-start-input list="br-landmarks" maxlength="120" placeholder="Choose a known landmark" /></label>
        <label>Goal landmark<input type="text" data-br-goal-input list="br-landmarks" maxlength="120" placeholder="Choose a known landmark" /></label>
        <datalist id="br-landmarks" data-br-landmarks></datalist>
        <button type="button" data-br-search>Find represented route</button>
      </div>
      <div class="br-search">
        <label>Visual context<select data-br-provider><option value="local">Offline schematic</option><option value="leaflet">OpenStreetMap via Leaflet</option><option value="google">Google Maps · optional key</option></select></label>
        <label>Google browser-restricted key<input type="password" data-br-api-key autocomplete="off" spellcheck="false" placeholder="Optional; never needed for the lab" /></label>
        <button type="button" data-br-apply-map>Apply basemap</button>
      </div>
      <p>External basemaps load only when selected and need network access. Google uses an existing configured or locally stored key if available; this page does not enable services or change billing. Basemap roads are not imported into the search graph, and no live Directions request is made.</p>
    </details>
    <details class="br-details">
      <summary>Understand the algorithms, step by step</summary>
      <div class="br-theory">{Object.values(ALGORITHMS).map((algorithm) => <article><h3>{algorithm.name}</h3><p>{algorithm.description}</p><p><strong>{algorithm.isOptimal ? 'Minimum weighted cost' : algorithm.id === 'bfs' ? 'Minimum hop count, not weighted cost' : 'No minimum weighted-cost guarantee'}</strong></p><p class="br-small">{algorithm.timeComplexity} time · {algorithm.spaceComplexity} space</p></article>)}</div>
      <p>A* uses <code>f(v)=g(v)+h(v)</code>. The geometric lower bound is scaled by the smallest edge-cost/geodesic-distance ratio in the graph, making it consistent with every represented directed edge; zero is the safe fallback. Edge weights remain full precision. “Minimum modeled travel time” is not shortest distance or traffic-aware travel time.</p>
      <p>Balanced bidirectional A* uses <code>p(v)=(h(v,t)−h(s,v))/2</code> and reduced edge costs <code>w(u,v)+p(v)−p(u) ≥ 0</code>. The backward search uses reversed adjacency and potential <code>−p</code>. Stop only when the sum of reduced frontier lower bounds reaches the incumbent's reduced route cost. The first common node is not enough.</p>
      <p>BFS's <code>g</code> counts hops. Dijkstra/A*'s <code>g</code> counts weighted cost. Non-negative finite weights are required. The race compares recorded work; it is not a benchmark of route planning services.</p>
    </details>
  </section>
  <script>
    import { initBayRoute } from '../../scripts/bayRoute';
    let controller: ReturnType<typeof initBayRoute> = null;
    function mount() { if (controller) return; const root = document.querySelector<HTMLElement>('[data-br-root]'); if (root) controller = initBayRoute(root); }
    function unmount() { controller?.destroy(); controller = null; }
    document.addEventListener('astro:page-load', mount);
    document.addEventListener('astro:before-swap', unmount);
    mount();
  </script>
</PageLayout>
<style>
  .br { display: flex; flex-direction: column; gap: 1rem; }
  .br-intro { display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid var(--color-rule); padding-bottom: 1rem; }
  .br-intro h2 { margin: 0 0 .35rem; font-size: 1.15rem; }
  .br-intro p { margin: 0; font-size: .85rem; color: var(--color-muted); }
  .br-controls, .br-endpoints, .br-playback, .br-search { display: flex; flex-wrap: wrap; align-items: end; gap: .65rem; }
  .br label { display: flex; flex: 1 1 180px; flex-direction: column; gap: .4rem; font-size: .78rem; color: var(--color-muted); min-width: 0; }
  .br-controls .br-check { flex-direction: row; align-items: center; min-height: 44px; }
  .br input, .br select, .br button { box-sizing: border-box; min-height: 44px; max-width: 100%; border: 1px solid var(--color-rule); border-radius: .6rem; padding: .55rem .7rem; background: var(--color-surface); color: var(--color-ink); font: inherit; }
  .br button { font-size: .82rem; font-weight: 600; cursor: pointer; }
  .br input[type='checkbox'] { min-height: 24px; width: 24px; }
  .br select, .br input { width: 100%; }
  .br .br-primary { background: var(--color-accent); color: var(--color-on-accent, white); }
  .br-explanation { margin: 0; padding: 1rem; border-left: 3px solid var(--color-accent); background: var(--color-surface); font-size: .9rem; }
  .br-stage { display: grid; grid-template-columns: minmax(0, 2.8fr) minmax(230px, 1fr); gap: 1rem; }
  .br-map { position: relative; height: 480px; border: 1px solid var(--color-rule); border-radius: .9rem; overflow: hidden; }
  .br-map canvas, .br-basemap { width: 100%; height: 100%; position: absolute; inset: 0; }
  .br-map canvas { z-index: 500; touch-action: pan-y; }
  .br-inspector { border: 1px solid var(--color-rule); border-radius: .9rem; padding: 1rem; background: var(--color-surface); overflow-wrap: anywhere; }
  .br-inspector h3 { margin: 0; font-size: .9rem; }
  .br-inspector p { font-size: .85rem; line-height: 1.65; }
  .br-legend { display: grid; grid-template-columns: 1fr 1fr; gap: .65rem; font-size: .76rem; padding: .8rem 0; border-block: 1px solid var(--color-rule); }
  .br-small { font-size: .76rem !important; color: var(--color-muted); }
  .br-playback label { flex: 0 1 150px; }
  .br-playback .br-scrubber { flex: 1 1 100%; }
  .br-scrubber input { padding: 0; }
  .br-status { margin: 0; color: var(--color-accent); font-size: .84rem; overflow-wrap: anywhere; }
  .br-table-scroll { max-width: 100%; overflow-x: auto; }
  .br-table { width: 100%; border-collapse: collapse; font-size: .82rem; }
  .br-table caption { text-align: left; color: var(--color-muted); padding: .7rem 0; }
  .br-table :global(th), .br-table :global(td) { text-align: left; padding: .75rem; border-bottom: 1px solid var(--color-rule); }
  .br-details { border: 1px solid var(--color-rule); border-radius: .75rem; padding: 1rem; }
  .br-details summary { cursor: pointer; font-weight: 600; min-height: 44px; display: flex; align-items: center; }
  .br-details p { font-size: .86rem; line-height: 1.7; }
  .br-theory { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1rem; margin-block: 1rem; }
  .br-theory article { padding: 1rem; border: 1px solid var(--color-rule); border-radius: .7rem; }
  .br-theory h3 { font-size: 1rem; margin: 0; }
  .br.game-focus-view .br-intro, .br.game-focus-view .br-explanation, .br.game-focus-view .br-inspector, .br.game-focus-view .br-details { display: none; }
  .br.game-focus-view .br-stage { grid-template-columns: 1fr; }
  .br.game-focus-view .br-map { height: min(480px, 45dvh); }
  @media (max-width: 700px) { .br-stage { grid-template-columns: 1fr; } .br-map { height: 350px; } .br-controls label, .br-endpoints label { flex-basis: 130px; } .br-table { font-size: .7rem; } }
</style>
