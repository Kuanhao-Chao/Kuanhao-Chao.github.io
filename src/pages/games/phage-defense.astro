---
import PageLayout from '../../layouts/PageLayout.astro';
import PhageDefenseLogo from '../../components/games/PhageDefenseLogo.astro';
import GameTools from '../../components/games/GameTools.astro';
import { site } from '../../data/site';
import '../../styles/phageDefense.css';

const gameLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Phage Defense',
  description:
    'An interactive microbial tower defense game where you deploy restriction enzymes, CRISPR arrays, and RNases to protect a bacterial cell from bacteriophage swarms.',
  url: `${site.url}/games/phage-defense/`,
  author: { '@id': `${site.url}/#person` },
  applicationCategory: 'Game',
  gamePlatform: ['Web browser', 'Mobile web browser'],
  genre: ['Strategy', 'Tower Defense', 'Science Game'],
  inLanguage: 'en',
  isAccessibleForFree: true,
};
---

<PageLayout
  title="Phage Defense"
  eyebrow="Side project"
  lead="A bacterial defense diorama. Place four complementary molecular defenses, manage ATP, and intercept schematic injected phage genomes across fifteen escalating waves."
  description="Phage Defense — an original microbial tower defense web game by Kuan-Hao Chao. Build molecular defenses, manage ATP, and protect the host nucleoid."
  width="wide"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(gameLd)} />

  <section class="defense-game-container" data-game-root data-defense-game aria-label="Phage Defense game">
    <GameTools />
    <div class="defense-header-card">
      <PhageDefenseLogo size={58} />
      <div class="defense-header-info">
        <h2 class="defense-header-title">Host Nucleoid Defense Complex</h2>
        <p class="defense-header-subtitle">EcoRI · direct fire / Cas9 · long range / RNase · area suppression / Ligase · support</p>
      </div>
    </div>

    <div class="defense-hud">
      <div class="defense-stats">
        <div class="defense-stat">
          <span class="defense-stat-label">Score</span>
          <span class="defense-stat-value" data-phage-score>0</span>
        </div>
        <div class="defense-stat">
          <span class="defense-stat-label">Best</span>
          <span class="defense-stat-value" data-phage-best>0</span>
        </div>
        <div class="defense-stat">
          <span class="defense-stat-label">ATP Pool</span>
          <span class="defense-stat-value" data-phage-atp>350 ATP</span>
        </div>
        <div class="defense-stat">
          <span class="defense-stat-label">Wave</span>
          <span class="defense-stat-value" data-phage-wave>Wave 0 / 15</span>
        </div>
        <div class="defense-viability-container">
          <span class="defense-stat-label">Nucleoid Health: <strong data-phage-viability-text>100%</strong></span>
          <div class="defense-viability-bar">
            <div class="defense-viability-fill" data-phage-viability-fill></div>
          </div>
        </div>
      </div>

      <div class="defense-controls">
        <button type="button" class="defense-btn defense-btn--primary" data-phage-next-wave>Start Next Wave</button>
        <button type="button" class="defense-btn" data-phage-pause>Pause</button>
        <button type="button" class="defense-btn" data-phage-restart>Restart</button>
        <button type="button" class="defense-btn" data-phage-speed>1× speed</button>
        <button
          type="button"
          class="defense-btn"
          data-phage-sound
          aria-label="Toggle game sounds"
          aria-pressed="false">Sound off</button
        >
      </div>
    </div>

    <div class="defense-placement">
      <p data-phage-preview>Build your defenses, then start the first wave.</p>
      <button type="button" class="defense-btn" data-phage-confirm hidden>Confirm placement</button>
      <button type="button" class="defense-btn" data-phage-cancel hidden>Cancel</button>
      <select data-phage-tower-select aria-label="Inspect a placed defense">
        <option value="">Inspect a defense…</option>
      </select>
    </div>

    <div class="defense-board">
      <canvas
        data-phage-canvas
        class="defense-canvas"
        role="img"
        aria-label="Phage Defense interactive microbial canvas"
      ></canvas>
    </div>

    <div class="defense-dock">
      <div class="defense-tower-cards">
        <button type="button" class="defense-tower-card" data-tower-type="restriction_enzyme" aria-label="Deploy EcoRI Cleaver (100 ATP)">
          <div class="defense-tower-header">
            <span class="defense-tower-name">EcoRI Cleaver</span>
            <span class="defense-tower-cost">100 ATP</span>
          </div>
          <span class="defense-tower-desc">Rapid restriction endonuclease firing palindromic cleavage bolts.</span>
        </button>

        <button type="button" class="defense-tower-card" data-tower-type="crispr_cas9" aria-label="Deploy CRISPR-Cas9 (175 ATP)">
          <div class="defense-tower-header">
            <span class="defense-tower-name">CRISPR-Cas9</span>
            <span class="defense-tower-cost">175 ATP</span>
          </div>
          <span class="defense-tower-desc">Long-range sniper delivering devastating double-strand break beams.</span>
        </button>

        <button type="button" class="defense-tower-card" data-tower-type="rnase_interceptor" aria-label="Deploy RNase Jammer (125 ATP)">
          <div class="defense-tower-header">
            <span class="defense-tower-name">RNase Jammer</span>
            <span class="defense-tower-cost">125 ATP</span>
          </div>
          <span class="defense-tower-desc">Area-of-effect suppression degrading viral mRNA and slowing phages by 50%.</span>
        </button>

        <button type="button" class="defense-tower-card" data-tower-type="ligase_drone" aria-label="Deploy DNA Ligase (150 ATP)">
          <div class="defense-tower-header">
            <span class="defense-tower-name">DNA Ligase</span>
            <span class="defense-tower-cost">150 ATP</span>
          </div>
          <span class="defense-tower-desc">Support beacon repairing cell health and granting +35% turnover aura.</span>
        </button>
      </div>

      <div class="defense-emergency-deck" aria-label="Tactical Emergency Protocols">
        <span class="defense-emergency-label">Tactical Emergency Protocols:</span>
        <div class="defense-emergency-grid">
          <button type="button" class="defense-emergency-btn" data-emergency-ability="autophagy" aria-label="Trigger fictional Nuclease Surge (150 ATP)">
            Nuclease Surge (150 ATP)
          </button>
          <button type="button" class="defense-emergency-btn" data-emergency-ability="crispri" aria-label="Trigger CRISPRi Stasis (80 ATP)">
            CRISPRi Stasis (80 ATP)
          </button>
          <button type="button" class="defense-emergency-btn" data-emergency-ability="overcharge" aria-label="Trigger Plasmid Overcharge (100 ATP)">
            Plasmid Overcharge (100 ATP)
          </button>
        </div>
      </div>

      <div class="defense-selected-panel" data-selected-tower-panel>
        <div class="defense-selected-content">
          <div>
            <strong data-tower-info-name>EcoRI Cleaver</strong> · <span data-tower-info-lvl>Level 1</span>
            <div class="muted" style="font-size: 0.78rem; margin-top: 2px;" data-tower-info-dps>Damage: 32</div>
          </div>

          <div class="defense-priority-group" aria-label="Targeting Priority Selection">
            <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--color-muted); margin-right: 4px;">Target:</span>
            <button type="button" class="defense-priority-btn active" data-tower-priority="first">First</button>
            <button type="button" class="defense-priority-btn" data-tower-priority="strongest">Strong</button>
            <button type="button" class="defense-priority-btn" data-tower-priority="weakest">Weak</button>
            <button type="button" class="defense-priority-btn" data-tower-priority="closest">Close</button>
          </div>

          <div style="display: flex; gap: 8px;">
            <button type="button" class="defense-btn defense-btn--primary" data-tower-upgrade-btn>Upgrade (85 ATP)</button>
            <button type="button" class="defense-btn defense-btn--danger" data-tower-sell-btn>Recycle (+70 ATP)</button>
          </div>
        </div>
      </div>
    </div>

    <article class="defense-guide">
      <h3>How to Play & Strategic Tactics</h3>
      <ul>
        <li><strong>Select & Deploy:</strong> Click a defense tower card above, then click anywhere on the cytosolic canvas (outside the path) to construct the molecular unit.</li>
        <li><strong>Upgrade & Recycle:</strong> Click an existing tower on the battlefield to inspect its range, switch targeting priorities, upgrade its catalytic turnover rate (k<sub>cat</sub>), or recycle it for 70% ATP refund.</li>
        <li><strong>Touch & keyboard:</strong> Select a defense, tap to preview its range, then Confirm placement. Arrow keys move the preview; Enter on the playfield confirms, Escape cancels. Desktop players can click directly to place.</li>
        <li><strong>Emergency protocols:</strong> Fictional <em>Nuclease Surge</em> clears ordinary genomes and damages bosses. CRISPRi uses catalytically inactive Cas9 to repress transcription in biology; freezing movement here is a game abstraction. Overcharge doubles firing rate.</li>
        <li><strong>Mix your defenses:</strong> Boss anti-Cas9 resistance only absorbs Cas9 shots. EcoRI and RNase bypass it. Damage statistics count landed health damage, not shots that miss or are absorbed.</li>
        <li><strong>Biology versus play:</strong> Phages attach outside a bacterial envelope and inject a genome. The lane represents infection progression, not whole phages walking inside the cell. Bacteria have ribosomes and a nucleoid, not mitochondria or lysosomal autophagy. RNase slowing, ligase healing, towers and projectile ranges are strategic abstractions; real ligase seals DNA nicks.</li>
      </ul>
    </article>
  </section>

  <script>
    import { initPhageDefense } from '../../scripts/phageDefense';

    let cleanup: (() => void) | null = null;

    function mount() {
      if (cleanup) return;
      const container = document.querySelector<HTMLElement>('[data-defense-game]');
      if (container) cleanup = initPhageDefense(container) ?? null;
    }

    function unmount() {
      cleanup?.();
      cleanup = null;
    }

    document.addEventListener('astro:page-load', mount);
    document.addEventListener('astro:before-swap', unmount);
    mount();
  </script>
</PageLayout>
