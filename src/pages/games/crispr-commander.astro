---
import PageLayout from '../../layouts/PageLayout.astro';
import CrisprCommanderLogo from '../../components/games/CrisprCommanderLogo.astro';
import GameTools from '../../components/games/GameTools.astro';
import { site } from '../../data/site';
import '../../styles/crisprCommander.css';

const gameLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'CRISPR Commander',
  description:
    'An interactive molecular biology web game where you command Cas9 and Cas12a enzymes to slice viral DNA at PAM target motifs.',
  url: `${site.url}/games/crispr-commander/`,
  author: { '@id': `${site.url}/#person` },
  applicationCategory: 'Game',
  gamePlatform: ['Web browser', 'Mobile web browser'],
  genre: ['Action', 'Arcade', 'Science Game'],
  inLanguage: 'en',
  isAccessibleForFree: true,
};
---

<PageLayout
  title="CRISPR Commander"
  eyebrow="Side project"
  lead="A molecular precision arcade: match the PAM, switch your nuclease, and protect a bacterial cell. Learn the targeting rules in three short practice rounds, then take on endless mixed DNA."
  description="CRISPR Commander — an original molecular slicing web game by Kuan-Hao Chao. Slice viral DNA with Cas9 and Cas12a enzymes."
  width="wide"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(gameLd)} />

  <section class="crispr" data-game-root data-crispr-game aria-label="CRISPR Commander game">
    <GameTools />
    <div class="crispr-header-card">
      <CrisprCommanderLogo size={58} />
      <div class="crispr-header-info">
        <h2 class="crispr-header-title">Molecular precision arcade</h2>
        <p class="crispr-header-subtitle">Cas9 · guide → NGG &nbsp; / &nbsp; Cas12a · TTTV → guide</p>
      </div>
    </div>

    <div class="crispr-hud">
      <div class="crispr-stats">
        <div class="crispr-stat">
          <span class="crispr-stat-label">Score</span>
          <span class="crispr-stat-value" data-crispr-score>0</span>
        </div>
        <div class="crispr-stat">
          <span class="crispr-stat-label">Best</span>
          <span class="crispr-stat-value" data-crispr-best>0</span>
        </div>
        <div class="crispr-stat">
          <span class="crispr-stat-label">ATP Pool</span>
          <span class="crispr-stat-value" data-crispr-energy>60 ATP</span>
        </div>
        <div class="crispr-stat">
          <span class="crispr-stat-label">Combo Multiplier</span>
          <span class="crispr-combo-badge" data-crispr-combo>1x NORMAL</span>
        </div>
        <div class="crispr-integrity-container">
          <span class="crispr-stat-label">Cell integrity: <strong data-crispr-integrity-text>100%</strong></span>
          <div class="crispr-integrity-bar">
            <div class="crispr-integrity-fill" data-crispr-integrity-fill></div>
          </div>
        </div>
      </div>

      <div class="crispr-controls">
        <select data-crispr-mode aria-label="Play mode">
          <option value="practice">Practice → endless</option>
          <option value="endless">Endless</option>
        </select>
        <button type="button" class="crispr-btn" data-crispr-start>Start</button>
        <button type="button" class="crispr-btn" data-crispr-pause>Pause</button>
        <button type="button" class="crispr-btn" data-crispr-restart>Restart</button>
        <button
          type="button"
          class="crispr-btn"
          data-crispr-sound
          aria-label="Toggle game sounds"
          aria-pressed="false">Sound off</button
        >
      </div>
    </div>

    <div class="crispr-enzyme-bar">
      <div class="crispr-enzyme-group" aria-label="Cas Enzyme Selection">
        <span class="crispr-enzyme-label">Active Nuclease:</span>
        <button type="button" class="crispr-enzyme-btn active" data-enzyme="SpCas9" aria-label="Select SpCas9 nuclease (PAM: NGG, shortcut 1)">
          <span>[1] SpCas9</span>
          <span class="enzyme-pam">PAM: NGG</span>
        </button>
        <button type="button" class="crispr-enzyme-btn" data-enzyme="AsCas12a" aria-label="Select AsCas12a nuclease (PAM: TTTV, shortcut 2)">
          <span>[2] AsCas12a</span>
          <span class="enzyme-pam">PAM: TTTV</span>
        </button>
      </div>

      <div class="crispr-powerups-group" aria-label="Tactical Cellular Power-ups">
        <button type="button" class="crispr-powerup-btn" data-powerup="dcas9_shield" disabled aria-label="Slow targets with a fictional shield (40 ATP)">
          Shield · slow (40 ATP)
        </button>
        <button type="button" class="crispr-powerup-btn" data-powerup="prime_editor" disabled aria-label="Repair 40 integrity (50 ATP)">
          Repair +40 (50 ATP)
        </button>
        <button type="button" class="crispr-powerup-btn" data-powerup="base_editor" disabled aria-label="Enlarge cutting tolerance (35 ATP)">
          Target assist (35 ATP)
        </button>
        <button type="button" class="crispr-powerup-btn" data-powerup="hyper_drive" disabled aria-label="Activate Hyper-Drive (75 ATP)">
          Overdrive (75 ATP)
        </button>
      </div>
    </div>

    <div class="crispr-board">
      <canvas
        data-crispr-canvas
        class="crispr-canvas"
        role="img"
        aria-label="CRISPR Commander interactive molecular canvas. Slice viral DNA strands."
      ></canvas>
    </div>
    <p class="crispr-lesson" data-crispr-lesson role="status" aria-live="polite">Practice 1/3 · Cas9: guide → NGG</p>
    <p class="crispr-legacy" data-crispr-legacy></p>

    <article class="crispr-guide">
      <h3>How to Play & Molecular Mechanics</h3>
      <ul>
        <li><strong>Slice to cleave:</strong> Drag or swipe across a paired DNA ribbon. Lift between hits on armored targets. Cas9 is shown with a qualitative blunt break; Cas12a with a staggered break.</li>
        <li><strong>PAM Specificity:</strong> Match the active Cas enzyme to the target's PAM motif. <strong>SpCas9</strong> cleaves targets with <code>NGG</code>; <strong>AsCas12a</strong> cleaves T-rich <code>TTTV</code> motifs.</li>
        <li><strong>Enzyme Hotkeys:</strong> Press <code>1</code> or <code>2</code> on desktop (or tap the enzyme buttons) to switch Cas complexes in real time.</li>
        <li><strong>Guides are preloaded:</strong> A complementary guide RNA is assumed for every target. A PAM is necessary, but by itself is not sufficient for real CRISPR targeting. Displayed DNA is a schematic, not a structural simulation.</li>
        <li><strong>Practice:</strong> Complete three cuts each with Cas9, Cas12a, then mixed targets. Practice breaches do not cause damage. Score and powers reset before ranked endless play.</li>
        <li><strong>Combos:</strong> Every five uninterrupted cuts adds 0.5× to the multiplier, up to 4×. Breaches cost 10% integrity, or 30% for a boss. AcrIIA4 inhibits Cas9; switch to the boss's Cas12a-compatible DNA target.</li>
        <li><strong>Fictional tactical powers:</strong> Shield slows targets, repair restores 40 integrity, target assist enlarges the cutting tolerance, and overdrive makes periodic compatible cuts. None is a claim about base editing, prime editing, or a universal cellular defense.</li>
      </ul>
    </article>
  </section>

  <script>
    import { initCrisprCommander } from '../../scripts/crisprCommander';

    let cleanup: (() => void) | null = null;

    function mount() {
      if (cleanup) return;
      const container = document.querySelector<HTMLElement>('[data-crispr-game]');
      if (container) cleanup = initCrisprCommander(container) ?? null;
    }

    function unmount() {
      cleanup?.();
      cleanup = null;
    }

    document.addEventListener('astro:page-load', mount);
    document.addEventListener('astro:before-swap', unmount);
    mount();
  </script>
</PageLayout>
