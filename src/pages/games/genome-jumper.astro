---
import PageLayout from '../../layouts/PageLayout.astro';
import GenomeJumperLogo from '../../components/games/GenomeJumperLogo.astro';
import { site } from '../../data/site';

const gameLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Genome Jumper',
  description:
    'An interactive genomics endless jumper where you command an RNA Polymerase II transcription elongation complex climbing chromatin ladders, collecting ribonucleotides, and clearing mutations.',
  url: `${site.url}/games/genome-jumper/`,
  author: { '@id': `${site.url}/#person` },
  applicationCategory: 'Game',
  gamePlatform: ['Web browser', 'Mobile web browser'],
  genre: ['Arcade', 'Endless platformer', 'Science Game'],
  inLanguage: 'en',
  isAccessibleForFree: true,
};
---

<PageLayout
  title="Genome Jumper"
  eyebrow="Side project"
  lead="Climb a living chromatin double helix as an RNA Polymerase II complex. Synthesize nascent mRNA transcripts, unwind supercoils with topoisomerase springs, and blast mutation lesions."
  description="Genome Jumper — an original, mobile-friendly endless jumping web game by Kuan-Hao Chao, with procedural platforms, nucleotide collectibles, boosts, and mutation enemies."
  width="narrow"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(gameLd)} />

  <section class="jumper" aria-label="Genome Jumper game">
    <div class="jumper-header-card">
      <GenomeJumperLogo size={58} />
      <div class="jumper-header-info">
        <h2 class="jumper-header-title">RNA Polymerase II Transcription Engine</h2>
        <p class="jumper-header-subtitle">Climb chromatin rungs, collect ribonucleotides (A · C · G · T), and clear mutation lesions.</p>
      </div>
    </div>

    <div class="jumper-hud">
      <div class="jumper-stats" aria-label="Current run">
        <div class="stat">
          <span class="stat-label">Height</span>
          <span class="stat-value" data-jumper-height>0 m</span>
        </div>
        <div class="stat">
          <span class="stat-label">Score</span>
          <span class="stat-value" data-jumper-score>0</span>
        </div>
        <div class="stat">
          <span class="stat-label">Best</span>
          <span class="stat-value" data-jumper-best>0</span>
        </div>
      </div>

      <div class="jumper-controls" aria-label="Game controls">
        <button type="button" class="game-btn" data-jumper-pause disabled>Pause</button>
        <button type="button" class="game-btn" data-jumper-restart>Restart</button>
        <button
          type="button"
          class="game-btn"
          data-jumper-sound
          aria-label="Mute game sounds"
          aria-pressed="true">Sound on</button
        >
      </div>
    </div>

    <div class="jumper-board">
      <canvas
        data-jumper-canvas
        role="img"
        aria-label="Genome Jumper playfield. Steer with Left and Right or A and D, fire with Space or F, and pause with P or Escape. On touch screens, press or drag on the board and use the Fire button."
      ></canvas>
      <span class="boost-status" data-jumper-boost aria-hidden="true"></span>
    </div>

    <div class="jumper-actions">
      <button type="button" class="action-btn action-btn--fire" data-jumper-fire disabled>
        <span aria-hidden="true">↑</span> Fire Laser
      </button>
      <button type="button" class="action-btn" data-jumper-share disabled>Share result</button>
    </div>

    <p class="jumper-status" data-jumper-status role="status" aria-live="polite">
      Tap the board or press Enter to start
    </p>

    <div class="jumper-sequence-card" aria-label="Collected nucleotide sequence">
      <span class="sequence-label">Synthesized mRNA (5'→3'):</span>
      <div class="sequence-ribbon" data-jumper-sequence>—</div>
    </div>

    <details class="jumper-help">
      <summary>How to Play & Transcription Mechanics</summary>
      <div class="help-grid muted">
        <p>
          <strong>Move & Steer:</strong> Use <code>Left / Right</code> or <code>A / D</code>. On mobile touch screens, press or drag on either side of the board.
        </p>
        <p>
          <strong>Fire Laser:</strong> Press <code>Space / F</code> or tap the <strong>Fire Laser</strong> button to cleave and eliminate mutation obstacles.
        </p>
        <p>
          <strong>Chromatin Climbing:</strong> Bounce on <em>Euchromatin</em> (stable green rungs), <em>Heterochromatin</em> (moving blue rungs), and <em>Topoisomerase Springs</em>. Avoid breaking fragile sites or fading bubbles.
        </p>
        <p>
          <strong>P-TEFb Boosts:</strong> Collect jetpack boosters to trigger high-speed elongation factor thrust with an invulnerability stasis bubble.
        </p>
      </div>
    </details>
  </section>
</PageLayout>

<script>
  import { initGenomeJumper, type GenomeJumperController } from '../../scripts/genomeJumper';

  let controller: GenomeJumperController | null = null;

  function mount() {
    if (controller) return;
    controller = initGenomeJumper(document);
  }

  function unmount() {
    controller?.destroy();
    controller = null;
  }

  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', unmount);
  mount();
</script>

<style>
  .jumper {
    max-width: 36rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    box-sizing: border-box;
  }

  .jumper-header-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md, 8px);
    box-sizing: border-box;
  }

  .jumper-header-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .jumper-header-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
  }

  .jumper-header-subtitle {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin: 0;
  }

  .jumper-hud {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md, 8px);
    box-sizing: border-box;
  }

  .jumper-stats {
    display: flex;
    gap: clamp(1rem, 5vw, 1.8rem);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-label,
  .sequence-label {
    font-size: var(--fs-meta, 0.75rem);
    letter-spacing: var(--tracking-meta, 0.05em);
    text-transform: uppercase;
    color: var(--color-muted);
    font-weight: 600;
  }

  .stat-value {
    font-family: var(--font-mono, monospace);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .jumper-controls,
  .jumper-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .game-btn,
  .action-btn {
    min-height: 44px;
    padding: 0.5em 1em;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm, 6px);
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: var(--fs-small, 0.85rem);
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
    box-sizing: border-box;
  }

  .game-btn:hover:not(:disabled),
  .action-btn:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .game-btn:active:not(:disabled),
  .action-btn:active:not(:disabled) {
    transform: translateY(1px);
  }

  .game-btn:disabled,
  .action-btn:disabled {
    opacity: 0.42;
    cursor: default;
  }

  .jumper-board {
    position: relative;
    width: min(94vw, 30rem, 50.4svh);
    aspect-ratio: 7 / 10;
    margin-inline: auto;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg, 12px);
    background: var(--color-surface);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    box-sizing: border-box;
  }

  .jumper-board canvas {
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: ew-resize;
    user-select: none;
    display: block;
  }

  .boost-status {
    position: absolute;
    top: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    min-height: 1.7rem;
    padding: 0.25rem 0.85rem;
    border-radius: 999px;
    background: #10b981;
    color: #ffffff;
    font-size: 0.8rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    line-height: 1.4;
    pointer-events: none;
    white-space: nowrap;
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.45);
  }

  .boost-status:empty {
    display: none;
  }

  .jumper-actions {
    justify-content: center;
  }

  .action-btn {
    min-width: 8.5rem;
  }

  .action-btn--fire {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent, #ffffff);
  }

  .action-btn--fire:hover:not(:disabled) {
    background: var(--color-accent-dark, #245546);
    border-color: var(--color-accent-dark, #245546);
    color: var(--color-on-accent, #ffffff);
  }

  .jumper-status {
    min-height: 1.4em;
    text-align: center;
    font-size: var(--fs-small, 0.85rem);
    color: var(--color-ink);
    margin: 0;
  }

  .jumper-sequence-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md, 8px);
    box-sizing: border-box;
  }

  .sequence-ribbon {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono, monospace);
    font-size: 0.95rem;
    font-weight: 700;
    min-height: 1.6rem;
    color: var(--color-ink);
  }

  :global(.nucleotide-pill) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 800;
    color: #ffffff;
  }

  :global(.pill-a) {
    background: #10b981;
  }
  :global(.pill-c) {
    background: #0284c7;
  }
  :global(.pill-g) {
    background: #f59e0b;
  }
  :global(.pill-t) {
    background: #a855f7;
  }

  .jumper-help {
    margin-top: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md, 8px);
    box-sizing: border-box;
  }

  .jumper-help summary {
    color: var(--color-ink);
    font-size: var(--fs-small, 0.88rem);
    font-weight: 700;
    cursor: pointer;
  }

  .help-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem 1.5rem;
    padding-top: var(--space-3);
    font-size: var(--fs-meta, 0.8rem);
    line-height: 1.5;
  }

  .help-grid strong {
    color: var(--color-ink);
  }

  @media (max-width: 620px) {
    .jumper-header-card {
      flex-direction: row;
    }

    .jumper-hud {
      align-items: center;
    }

    .stat-value {
      font-size: 1.15rem;
    }

    .jumper-controls {
      width: 100%;
    }

    .game-btn {
      flex: 1;
    }

    .action-btn {
      min-width: 7.8rem;
    }

    .help-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .game-btn,
    .action-btn {
      transition: none;
    }
  }
</style>
