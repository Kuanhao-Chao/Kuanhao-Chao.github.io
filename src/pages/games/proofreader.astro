---
import PageLayout from '../../layouts/PageLayout.astro';
import { site } from '../../data/site';

const gameLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Proofreader',
  description:
    'An original genomics-themed first-person shooter rendered with a Canvas-2D raycaster. Sweep a chromatin maze, clear replication mutations, and collect A · C · G · T nucleotide pickups. Built for keyboard, mouse-look, and touch.',
  url: `${site.url}/games/proofreader/`,
  author: { '@id': `${site.url}/#person` },
  applicationCategory: 'Game',
  gamePlatform: ['Web browser', 'Mobile web browser'],
  genre: ['Shooter', 'Arcade'],
  inLanguage: 'en',
  isAccessibleForFree: true,
};
---

<PageLayout
  title="Proofreader"
  eyebrow="Side project"
  lead="A first-person shooter built the same way as this site — no game engine, no WebGL, just a Canvas-2D raycaster. You are the proofreading domain of DNA polymerase: sweep a chromatin maze, clear replication mutations, and collect A · C · G · T. Plays with keyboard and mouse-look, or entirely by touch."
  description="Proofreader — an original, mobile-friendly first-person shooter web game by Kuan-Hao Chao, rendered with a Canvas-2D raycaster: a chromatin maze, mutation enemies, and nucleotide pickups."
  width="narrow"
>
  <section class="proof" aria-label="Proofreader game">
    <div class="proof-hud">
      <div class="proof-stats" aria-label="Current run">
        <span class="stat">
          <span class="stat-label">Integrity</span>
          <span class="stat-value" data-proof-health>100</span>
        </span>
        <span class="stat">
          <span class="stat-label">Charges</span>
          <span class="stat-value" data-proof-ammo>24 / 40</span>
        </span>
        <span class="stat">
          <span class="stat-label">Wave</span>
          <span class="stat-value" data-proof-wave>0</span>
        </span>
        <span class="stat">
          <span class="stat-label">Score</span>
          <span class="stat-value" data-proof-score>0</span>
        </span>
        <span class="stat">
          <span class="stat-label">Best</span>
          <span class="stat-value" data-proof-best>0</span>
        </span>
      </div>

      <div class="proof-controls" aria-label="Game controls">
        <button type="button" class="game-btn" data-proof-pause disabled>Pause</button>
        <button type="button" class="game-btn" data-proof-restart>Restart</button>
        <button
          type="button"
          class="game-btn"
          data-proof-sound
          aria-label="Mute game sounds"
          aria-pressed="true">Sound on</button
        >
      </div>
    </div>

    <div class="proof-board">
      <canvas
        data-proof-canvas
        role="img"
        aria-label="Proofreader playfield — a first-person view of a genome maze. Move with W A S D or the arrow keys, turn with the mouse after clicking the view (Escape releases it) or with Left and Right, and fire with Space or click. On touch screens, drag the left half of the view to move, the right half to look, and use the Fire button."
      ></canvas>
    </div>

    <div class="proof-actions">
      <button type="button" class="action-btn action-btn--fire" data-proof-fire disabled>
        <span aria-hidden="true">◎</span> Fire
      </button>
      <button type="button" class="action-btn" data-proof-share disabled>Share result</button>
    </div>

    <p class="proof-status" data-proof-status role="status" aria-live="polite">
      Click or tap the view — or press Enter — to start
    </p>

    <p class="proof-sequence" aria-label="Collected nucleotide sequence">
      <span class="sequence-label">Sequence</span>
      <span class="sequence-value" data-proof-sequence>—</span>
    </p>

    <details class="proof-help">
      <summary>How to play</summary>
      <div class="help-grid muted">
        <p>
          <strong>Move</strong> with W A S D or the arrow keys. On touch, drag the left half of the view
          like a thumbstick.
        </p>
        <p>
          <strong>Look</strong> by clicking the view for mouse-look (Escape releases it), turning with
          Left / Right or Q / E, or dragging the right half on touch.
        </p>
        <p>
          <strong>Fire</strong> the proofreading pulse with Space, a click, or the Fire button. Aim assist
          helps on touch.
        </p>
        <p>
          <strong>Survive</strong> escalating waves of mutations. Nucleotide pickups restore charges and
          integrity; the radar shows what is hunting you.
        </p>
      </div>
    </details>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(gameLd)} />
</PageLayout>

<script>
  import { initProofreader, type ProofreaderController } from '../../scripts/proofreader';

  let controller: ProofreaderController | null = null;

  function mount() {
    if (controller) return;
    controller = initProofreader(document);
  }

  function unmount() {
    controller?.destroy();
    controller = null;
  }

  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', unmount);
  mount();
</script>

<style>
  .proof {
    max-width: 44rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .proof-hud {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem 1.25rem;
  }

  .proof-stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.9rem, 4vw, 1.7rem);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    line-height: 1;
  }

  .stat-label,
  .sequence-label {
    font-size: var(--fs-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: var(--fw-semibold);
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .proof-controls,
  .proof-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .game-btn,
  .action-btn {
    min-height: 44px;
    padding: 0.55em 1em;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 78%, transparent);
    color: var(--color-ink);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1;
    cursor: pointer;
    transition:
      border-color var(--transition),
      color var(--transition),
      background var(--transition),
      transform var(--transition);
  }

  .game-btn:hover:not(:disabled),
  .action-btn:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .game-btn:active:not(:disabled),
  .action-btn:active:not(:disabled) {
    transform: translateY(1px);
  }

  .game-btn:disabled,
  .action-btn:disabled {
    opacity: 0.42;
    cursor: default;
  }

  .proof-board {
    position: relative;
    width: min(94vw, 40rem, 128svh);
    aspect-ratio: 16 / 10;
    margin-inline: auto;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
    box-shadow: 0 0.65rem 2rem rgba(0, 0, 0, 0.11);
  }

  .proof-board canvas {
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: crosshair;
    user-select: none;
  }

  .proof-actions {
    justify-content: center;
  }

  .action-btn {
    min-width: 8.5rem;
  }

  .action-btn--fire {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
    touch-action: none;
  }

  .action-btn--fire:hover:not(:disabled) {
    border-color: var(--color-accent-dark);
    background: var(--color-accent-dark);
    color: var(--color-on-accent);
  }

  .proof-status,
  .proof-sequence {
    min-height: 1.4em;
    text-align: center;
    font-size: var(--fs-small);
  }

  .proof-status {
    color: var(--color-ink);
  }

  .proof-sequence {
    color: var(--color-muted);
  }

  .sequence-label {
    margin-right: 0.5rem;
  }

  .sequence-value {
    color: var(--color-accent);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.22em;
    overflow-wrap: anywhere;
  }

  .proof-help {
    margin-top: var(--space-2);
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }

  .proof-help summary {
    padding-block: 0.8rem;
    color: var(--color-ink);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    cursor: pointer;
  }

  .help-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem 1.5rem;
    padding-bottom: var(--space-4);
    font-size: var(--fs-meta);
    line-height: 1.5;
  }

  .help-grid strong {
    color: var(--color-ink);
  }

  /* On touch devices, make the primary Fire control a big, thumb-friendly target. */
  @media (pointer: coarse) {
    .action-btn--fire {
      min-height: 3.25rem;
      min-width: 10rem;
      font-size: var(--fs-body);
    }
  }

  @media (max-width: 620px) {
    .proof-hud {
      align-items: center;
    }

    .stat-value {
      font-size: 1.25rem;
    }

    .proof-controls {
      width: 100%;
    }

    .game-btn {
      flex: 1;
    }

    .action-btn {
      min-width: 7.8rem;
    }

    .help-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .game-btn,
    .action-btn {
      transition: none;
    }
  }
</style>
