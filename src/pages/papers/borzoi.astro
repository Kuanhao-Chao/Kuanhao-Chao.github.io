      <!-- Figure 7 -->
      <div class="paper-fig-card">
        <div class="paper-fig-header">
          <span class="paper-fig-badge">Figure 7</span>
          <span class="paper-fig-title">Classifying Splicing QTLs (sQTLs) & Intronic paQTLs</span>
        </div>
