const title = "Predicting Functional Constraints Across Evolutionary Timescales with Phylogeny-Informed Genomic Language Models";
const description = "Comprehensive technical summary and deep literature deconstruction of GPN-Star (Ye, Benegas, Song Lab, UC Berkeley, bioRxiv 2025): Phylogeny-aware genomic language models leveraging Whole-Genome Alignments, clade pooling, and FIRE species tree distance biases.";
const readingTime = "22 min read";
