---
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/Icon.astro';
import AlgorithmLogo from '../../components/AlgorithmLogo.astro';
import { ALGORITHMS, ALGORITHM_CATEGORIES, type AlgorithmEntry } from '../../data/algorithms';

const categories = ALGORITHM_CATEGORIES;
const algorithms: AlgorithmEntry[] = ALGORITHMS;
---

<PageLayout
  title="Algorithms"
  eyebrow="Interactive Visualizers & Concepts"
  lead="Interactive explorations of fundamental computational biology algorithms — from long-read minimizer chaining and FM-index exact matching to Wheeler graph pangenomics, sequence alignment, and neural in silico mutagenesis."
  description="Interactive computational biology algorithm visualizers by Kuan-Hao Chao: Minimap2 minimizer chaining, FM-Index BWT backward search, Wheeler graphs, sequence alignment, and neural splice models."
  noindex={true}
>
  <section class="algo-section" aria-label="Bioinformatics Algorithm Catalog">
    <div class="algo-tools" data-algo-tools>
      <div class="algo-filters" role="group" aria-label="Filter algorithms by category">
        {
          categories.map((c) => (
            <button
              type="button"
              class="filter-pill"
              data-filter={c.slug}
              aria-pressed={c.slug === 'all' ? 'true' : 'false'}
            >
              {c.label}
            </button>
          ))
        }
      </div>

      <div class="algo-controls">
        <label class="search">
          <Icon name="search" size={18} />
          <input
            type="search"
            placeholder="Search algorithms, complexity, CLI…"
            data-search-input
            aria-label="Search algorithms"
          />
        </label>
        <label class="sort">
          <span class="visually-hidden">Sort algorithms</span>
          <select data-sort>
            <option value="default">Curated order</option>
            <option value="az">A–Z</option>
            <option value="area">Category</option>
          </select>
          <Icon name="chevron-down" size={16} />
        </label>
      </div>
    </div>

    <div class="algo-index" data-algo-list>
      {
        algorithms.map((algo) => {
          const searchTokens = [
            algo.title,
            algo.area,
            algo.tag,
            algo.summary,
            algo.timeComplexity ?? '',
            algo.spaceComplexity ?? '',
            algo.keyMechanism ?? '',
            ...(algo.highlights ?? []),
            algo.cliCommand ?? '',
            algo.category,
          ]
            .join(' ')
            .toLowerCase();

          return (
            <article
              class="algo-card"
              id={algo.id}
              data-category={algo.category}
              data-title={algo.title.toLowerCase()}
              data-area={algo.area.toLowerCase()}
              data-search={searchTokens}
            >
              <div class="algo-card-leading">
                <a href={algo.href} class="algo-logo-link" aria-label={`View ${algo.title}`}>
                  <AlgorithmLogo id={algo.id} size={56} />
                </a>
              </div>

              <div class="algo-card-body">
                <div class="algo-card-meta">
                  <span class="eyebrow">{algo.area}</span>
                  <span class="algo-tag">{algo.tag}</span>
                  {algo.timeComplexity && (
                    <span class="algo-metric-badge" title="Time Complexity">
                      <span class="algo-metric-label">Time:</span>
                      <code>{algo.timeComplexity}</code>
                    </span>
                  )}
                  {algo.spaceComplexity && (
                    <span class="algo-metric-badge" title="Space Complexity">
                      <span class="algo-metric-label">Space:</span>
                      <code>{algo.spaceComplexity}</code>
                    </span>
                  )}
                </div>

                <h3 class="algo-card-title">
                  <a href={algo.href}>{algo.title}</a>
                </h3>

                <p class="algo-card-summary muted">{algo.summary}</p>

                {algo.highlights && algo.highlights.length > 0 && (
                  <ul class="algo-card-highlights">
                    {algo.highlights.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}

                {algo.cliCommand && (
                  <div class="algo-cli-hint">
                    <span>CLI Command:</span>
                    <code>{algo.cliCommand}</code>
                  </div>
                )}
              </div>

              <div class="algo-card-action">
                <a href={algo.href} class="algo-link">
                  <span>{algo.actionText}</span>
                  <Icon name="arrow-right" size={15} />
                </a>
              </div>
            </article>
          );
        })
      }
    </div>

    <p class="algo-empty" data-algo-empty hidden>No algorithms match your filter or search query.</p>
  </section>
</PageLayout>

<style>
  .algo-section {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-8);
  }

  /* Toolbar: Category Pills & Search / Sort Controls */
  .algo-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: var(--space-6);
  }

  .algo-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .filter-pill {
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    padding: 0.4em 0.9em;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition: all var(--transition);
  }

  .filter-pill:hover {
    border-color: var(--color-ink);
    color: var(--color-ink);
  }

  .filter-pill[aria-pressed='true'] {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-bg);
  }

  .algo-controls {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .search {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45em 0.8em;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-muted);
  }

  .search:focus-within {
    border-color: var(--color-accent);
    color: var(--color-ink);
  }

  .search input {
    border: none;
    outline: none;
    background: transparent;
    font-size: var(--fs-small);
    width: min(16rem, 50vw);
  }

  .sort {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .sort select {
    appearance: none;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: 0.5em 2.2em 0.5em 0.8em;
    font-size: var(--fs-small);
    cursor: pointer;
  }

  .sort :global(svg) {
    position: absolute;
    right: 0.6em;
    pointer-events: none;
    color: var(--color-muted);
  }

  .algo-index {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }

  .algo-card {
    display: grid;
    grid-template-columns: 60px 1fr auto;
    align-items: flex-start;
    gap: var(--space-5);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-rule);
    transition: background-color 0.15s ease;
  }

  .algo-card:first-child {
    border-top: 0;
  }

  .algo-card.is-hidden {
    display: none;
  }

  .algo-card-leading {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 0.2rem;
  }

  .algo-logo-link {
    display: inline-flex;
    text-decoration: none;
    transition: transform var(--transition);
  }

  .algo-card:hover .algo-logo-link {
    transform: scale(1.06);
  }

  .algo-empty {
    padding: var(--space-8) 0;
    color: var(--color-muted);
    font-size: var(--fs-body);
  }

  @media (pointer: coarse) {
    .filter-pill,
    .search,
    .sort select {
      padding-block: 0.6em;
    }
  }

  @media (max-width: 860px) {
    .algo-card {
      grid-template-columns: 50px 1fr;
      gap: var(--space-4);
    }
    .algo-card-action {
      grid-column: 1 / -1;
      padding-top: var(--space-2);
    }
  }

  @media (max-width: 640px) {
    .algo-tools {
      align-items: stretch;
    }
    .algo-filters {
      gap: 0.45rem;
    }
    .algo-controls {
      width: 100%;
      flex-direction: column;
      gap: 0.5rem;
    }
    .search,
    .sort,
    .sort select {
      width: 100%;
    }
    .search input {
      width: 100%;
      min-width: 0;
    }
    .algo-card {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .algo-card-leading {
      justify-content: flex-start;
    }
  }

  .algo-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .algo-card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .algo-tag {
    font-size: var(--fs-meta);
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface));
    color: var(--color-accent-dark);
    border-radius: var(--radius);
  }

  .algo-metric-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--fs-meta);
    padding: 0.12rem 0.45rem;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    color: var(--color-ink);
  }

  .algo-metric-label {
    color: var(--color-muted);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  .algo-metric-badge code {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-ink);
    background: transparent;
    padding: 0;
  }

  .algo-card-title {
    font-size: 1.15rem;
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    margin: 0;
  }

  .algo-card-title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .algo-card-title a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .algo-card-summary {
    font-size: var(--fs-small);
    line-height: 1.55;
    margin: 0;
    max-width: 68ch;
  }

  .algo-card-highlights {
    list-style: none;
    margin: 0.35rem 0 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .algo-card-highlights li {
    font-size: var(--fs-small);
    color: var(--color-ink);
    line-height: 1.45;
    position: relative;
    padding-left: 1.1rem;
  }

  .algo-card-highlights li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: bold;
  }

  .algo-cli-hint {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-meta);
    color: var(--color-muted);
    margin-top: 0.35rem;
  }

  .algo-cli-hint code {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    padding: 0.15em 0.45em;
    border-radius: var(--radius);
    color: var(--color-ink);
  }

  .algo-card-action {
    display: flex;
    align-items: center;
    align-self: center;
  }

  .algo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
    padding: 0.45em 0.85em;
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-accent) 6%, transparent);
    transition: all var(--transition);
  }

  .algo-link:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg);
  }
</style>

<script>
  function setupAlgoCatalog() {
    const root = document.querySelector<HTMLElement>('[data-algo-tools]');
    const list = document.querySelector<HTMLElement>('[data-algo-list]');
    const empty = document.querySelector<HTMLElement>('[data-algo-empty]');
    if (!root || !list || !empty) return;

    const filterBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const searchInput = root.querySelector<HTMLInputElement>('[data-search-input]');
    const sortSelect = root.querySelector<HTMLSelectElement>('[data-sort]');
    const cards = Array.from(list.querySelectorAll<HTMLElement>('.algo-card'));

    let activeFilter = 'all';
    let searchQuery = '';
    let sortMode = 'default';

    function applyState() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const category = card.dataset.category || '';
        const search = card.dataset.search || '';

        const matchesFilter = activeFilter === 'all' || category === activeFilter;
        const matchesSearch = !searchQuery || search.includes(searchQuery);
        const visible = matchesFilter && matchesSearch;

        card.classList.toggle('is-hidden', !visible);
        if (visible) visibleCount += 1;
      });

      if (empty) {
        empty.hidden = visibleCount > 0;
      }

      // Sorting
      const sorted = [...cards].sort((a, b) => {
        if (sortMode === 'az') {
          return (a.dataset.title || '').localeCompare(b.dataset.title || '');
        }
        if (sortMode === 'area') {
          return (a.dataset.area || '').localeCompare(b.dataset.area || '');
        }
        return 0; // Default curated order
      });

      if (list) {
        sorted.forEach((c) => list.appendChild(c));
      }
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.setAttribute('aria-pressed', 'false'));
        btn.setAttribute('aria-pressed', 'true');
        activeFilter = btn.dataset.filter || 'all';
        applyState();
      });
    });

    searchInput?.addEventListener('input', () => {
      searchQuery = (searchInput.value || '').trim().toLowerCase();
      applyState();
    });

    sortSelect?.addEventListener('change', () => {
      sortMode = sortSelect.value;
      applyState();
    });
  }

  document.addEventListener('astro:page-load', setupAlgoCatalog);
</script>
