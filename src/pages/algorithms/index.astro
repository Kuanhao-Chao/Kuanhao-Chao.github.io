---
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/Icon.astro';

interface AlgorithmEntry {
  id: string;
  title: string;
  area: string;
  tag: string;
  summary: string;
  href: string;
  badge?: string;
  actionText: string;
  cliCommand?: string;
}

const algorithms: AlgorithmEntry[] = [
  {
    id: 'minimap2',
    title: 'Minimizer Sampling & Collinear DP Chaining',
    area: 'Long-Read Alignment & Indexing',
    tag: 'Minimap2 Core',
    summary:
      'High-throughput long-read alignment indexing using (w, k)-minimizers. Explore sliding hash windows, 2D anchor dot-plot matching, and dynamic programming collinear chaining.',
    href: '/algorithms/minimap2/',
    badge: 'Interactive Visualizer',
    actionText: 'Launch interactive visualizer',
  },
  {
    id: 'fm-index',
    title: 'FM-Index & BWT Backward Search',
    area: 'Indexing & Exact Matching',
    tag: 'Bowtie / BWA Core',
    summary:
      'Burrows-Wheeler Transform with Last-to-First (LF) mapping and occurrence counting for sub-linear query matching across gigabase reference genomes.',
    href: '/algorithms/fm-index/',
    badge: 'Interactive Visualizer',
    actionText: 'Launch interactive visualizer',
  },
  {
    id: 'wgt',
    title: 'Wheeler Graph Ordering & Recognition (Wheelie)',
    area: 'Pangenomics & Graph Indexing',
    tag: 'Graph Indexing',
    summary:
      'Algorithms for recognizing and sorting Wheeler graph topologies, generalizing BWT-style index search to pangenomic reference variation graphs.',
    href: '/posts/wgt/',
    badge: 'Deep Dive & Post',
    actionText: 'Read deep dive & interactive demo',
  },
  {
    id: 'pairwise',
    title: 'Needleman-Wunsch & Smith-Waterman Alignment',
    area: 'Sequence Alignment & Dynamic Programming',
    tag: 'Global & Local DP',
    summary:
      'Exact 2D dynamic programming pairwise sequence alignment supporting global (Needleman-Wunsch), local (Smith-Waterman), and Gotoh affine gap penalties.',
    href: '/algorithms/pairwise/',
    badge: 'Interactive Visualizer',
    actionText: 'Launch interactive visualizer',
    cliCommand: 'align ACGTAGCTA ACGTCGCTA',
  },
  {
    id: 'wfa',
    title: 'Wavefront Alignment Algorithm (WFA)',
    area: 'Ultra-Fast Sequence Alignment',
    tag: 'O(s · d) Exact Alignment',
    summary:
      'Exact gap-affine pairwise alignment running in O(s · d) time. Explore diagonal wavefront frontier expansion, free Longest Common Prefix (LCP) extensions, and matrix pruning.',
    href: '/algorithms/wfa/',
    badge: 'Interactive Visualizer',
    actionText: 'Launch interactive visualizer',
    cliCommand: 'wfa ACGTAGCTA ACGTCGCTA',
  },
  {
    id: 'splice-ai',
    title: 'Deep Learning Splice-Site Recognition (Splam / OpenSpliceAI)',
    area: 'Deep Learning & Genomics',
    tag: 'Neural Sequence Modeling',
    summary:
      'Ultra-fast residual convolutional neural networks scoring donor (GT) and acceptor (AG) pre-mRNA junctions to filter spurious spliced transcript alignments.',
    href: '/software/',
    badge: 'Research Software',
    actionText: 'Explore open-source software',
    cliCommand: 'splam -h',
  },
];
---

<PageLayout
  title="Algorithms"
  eyebrow="Interactive Visualizers & Concepts"
  lead="Interactive explorations of fundamental computational biology algorithms — from long-read minimizer chaining and FM-index exact matching to Wheeler graph pangenomics and sequence alignment."
  description="Interactive computational biology algorithm visualizers by Kuan-Hao Chao: Minimap2 minimizer chaining, FM-Index BWT backward search, Wheeler graphs, and sequence alignment."
>
  <section class="algo-section" aria-label="Bioinformatics Algorithm Catalog">
    <h2 class="algo-list-title">Algorithm Visualizers &amp; Interactive Tools</h2>

    <div class="algo-index">
      {
        algorithms.map((algo) => (
          <article class="algo-card" id={algo.id}>
            <div class="algo-card-body">
              <div class="algo-card-meta">
                <span class="eyebrow">{algo.area}</span>
                <span class="algo-tag">{algo.tag}</span>
              </div>
              <h3 class="algo-card-title">
                <a href={algo.href}>{algo.title}</a>
              </h3>
              <p class="algo-card-summary muted">{algo.summary}</p>
              {algo.cliCommand && (
                <div class="algo-cli-hint">
                  <span>CLI Command:</span>
                  <code>{algo.cliCommand}</code>
                </div>
              )}
            </div>

            <div class="algo-card-action">
              <a href={algo.href} class="algo-link">
                <span>{algo.actionText}</span>
                <Icon name="arrow-right" size={15} />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</PageLayout>

<style>
  .algo-section {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-8);
  }

  .algo-list-title {
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    letter-spacing: 0;
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-rule);
  }

  .algo-index {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--color-rule);
  }

  .algo-card {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-rule);
    transition: background-color 0.15s ease;
  }

  .algo-card:first-child {
    border-top: 0;
  }

  @media (max-width: 768px) {
    .algo-card {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }

  .algo-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .algo-card-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .algo-tag {
    font-size: var(--fs-meta);
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface));
    color: var(--color-accent-dark);
    border-radius: var(--radius);
  }

  .algo-card-title {
    font-size: 1.15rem;
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    margin: 0;
  }

  .algo-card-title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .algo-card-title a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .algo-card-summary {
    font-size: var(--fs-small);
    line-height: 1.55;
    margin: 0;
    max-width: 65ch;
  }

  .algo-cli-hint {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-meta);
    color: var(--color-muted);
    margin-top: 0.25rem;
  }

  .algo-cli-hint code {
    font-family: var(--font-mono);
    padding: 0.15rem 0.4rem;
    background: var(--color-bg);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    color: var(--color-ink);
  }

  .algo-card-action {
    display: flex;
    align-items: center;
  }

  .algo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    background: var(--color-surface);
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .algo-link:hover {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
    color: var(--color-accent-dark);
  }
</style>
