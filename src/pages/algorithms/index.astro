---
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/Icon.astro';

export interface AlgorithmEntry {
  id: string;
  title: string;
  area: string;
  category: 'alignment' | 'assembly' | 'indexing' | 'probabilistic' | 'deep-learning';
  tag: string;
  summary: string;
  href: string;
  badge?: string;
  actionText: string;
  cliCommand?: string;
}

const categories = [
  { slug: 'all', label: 'All' },
  { slug: 'alignment', label: 'Sequence Alignment' },
  { slug: 'assembly', label: 'Genome Assembly' },
  { slug: 'indexing', label: 'Indexing & Matching' },
  { slug: 'probabilistic', label: 'Probabilistic & Gene Finding' },
  { slug: 'deep-learning', label: 'Deep Learning' },
];

const algorithms: AlgorithmEntry[] = [
  {
    id: 'minimap2',
    title: 'Minimizer Sampling & Collinear DP Chaining',
    area: 'Long-Read Alignment & Indexing',
    category: 'indexing',
    tag: 'Minimap2 Core',
    summary:
      'High-throughput long-read alignment indexing using (w, k)-minimizers. Explore sliding hash windows, 2D anchor dot-plot matching, and dynamic programming collinear chaining.',
    href: '/algorithms/minimap2/',
    badge: 'Interactive Visualizer',
    actionText: 'Launch interactive visualizer',
  },
  {
    id: 'fm-index',
    title: 'FM-Index & BWT Backward Search',
    area: 'Indexing & Exact Matching',
    category: 'indexing',
    tag: 'Bowtie / BWA Core',
    summary:
      'Burrows-Wheeler Transform with Last-to-First (LF) mapping and occurrence counting for sub-linear query matching across gigabase reference genomes.',
    href: '/algorithms/fm-index/',
    badge: 'Interactive Visualizer',
    actionText: 'Launch interactive visualizer',
  },
  {
    id: 'wgt',
    title: 'Wheeler Graph Ordering & Recognition (Wheelie)',
    area: 'Pangenomics & Graph Indexing',
    category: 'indexing',
    tag: 'Graph Indexing',
    summary:
      'Algorithms for recognizing and sorting Wheeler graph topologies, generalizing BWT-style index search to pangenomic reference variation graphs.',
    href: '/posts/wgt/',
    badge: 'Deep Dive & Post',
    actionText: 'Read deep dive & interactive demo',
  },
  {
    id: 'pairwise',
    title: 'Needleman-Wunsch & Smith-Waterman Alignment',
    area: 'Sequence Alignment & Dynamic Programming',
    category: 'alignment',
    tag: 'Global & Local DP',
    summary:
      'Exact 2D dynamic programming pairwise sequence alignment supporting global (Needleman-Wunsch), local (Smith-Waterman), and Gotoh affine gap penalties.',
    href: '/algorithms/pairwise/',
    badge: 'Interactive Visualizer',
    actionText: 'Launch interactive visualizer',
    cliCommand: 'align ACGTAGCTA ACGTCGCTA',
  },
  {
    id: 'wfa',
    title: 'Wavefront Alignment Algorithm (WFA)',
    area: 'Ultra-Fast Sequence Alignment',
    category: 'alignment',
    tag: 'O(s · d) Exact Alignment',
    summary:
      'Exact gap-affine pairwise alignment running in O(s · d) time. Explore diagonal wavefront frontier expansion, free Longest Common Prefix (LCP) extensions, and matrix pruning.',
    href: '/algorithms/wfa/',
    badge: 'Interactive Visualizer',
    actionText: 'Launch interactive visualizer',
    cliCommand: 'wfa ACGTAGCTA ACGTCGCTA',
  },
  {
    id: 'debruijn',
    title: 'De Bruijn Graph (Eulerian Path Genome Assembly)',
    area: 'Genome Assembly & Graph Traversals',
    category: 'assembly',
    tag: 'Hierholzer Traversal',
    summary:
      'Deconstruct sequencing reads into (k-1)-mer nodes and directed k-mer edges. Explore O(E) Eulerian path assembly, tip clipping, bubble popping, and unitig compaction.',
    href: '/algorithms/debruijn/',
    badge: 'Interactive Visualizer',
    actionText: 'Launch interactive visualizer',
    cliCommand: 'debruijn TAATGCCATGGGATGTT',
  },
  {
    id: 'string-graph',
    title: 'String Graphs & Overlap-Layout-Consensus (OLC)',
    area: 'Long-Read Genome Assembly',
    category: 'assembly',
    tag: 'Myers Transitive Reduction',
    summary:
      'Long-read exact prefix-suffix overlap graphs without k-mer chopping. Explore Myers’ O(V+E) transitive reduction, contained read pruning, and read tiling layout.',
    href: '/algorithms/string-graph/',
    badge: 'Interactive Visualizer',
    actionText: 'Launch interactive visualizer',
    cliCommand: 'stringgraph',
  },
  {
    id: 'phmm',
    title: 'Profile Hidden Markov Models (pHMMs)',
    area: 'Probabilistic Models & Gene Finding',
    category: 'probabilistic',
    tag: 'Plan 7 Architecture',
    summary:
      'Model conserved biological domains and sequence families with insertion/deletion tolerance. Explore Viterbi optimal decoding, Forward-Backward posteriors, and Plan 7 topology.',
    href: '/algorithms/phmm/',
    badge: 'Interactive Visualizer',
    actionText: 'Launch interactive visualizer',
    cliCommand: 'phmm TATAAA',
  },
  {
    id: 'ghmm',
    title: 'Generalized Hidden Markov Models (GHMMs)',
    area: 'Ab Initio Gene Finding',
    category: 'probabilistic',
    tag: 'Semi-Markov Gene Finding',
    summary:
      'Predict exon-intron structures, splice junctions, and protein-coding CDS using explicit duration distributions f(d) and semi-Markov dynamic programming (GENSCAN / AUGUSTUS).',
    href: '/algorithms/ghmm/',
    badge: 'Interactive Visualizer',
    actionText: 'Launch interactive visualizer',
    cliCommand: 'gene',
  },
  {
    id: 'splice-ai',
    title: 'Deep Learning Splice-Site Recognition (Splam / OpenSpliceAI)',
    area: 'Deep Learning & Genomics',
    category: 'deep-learning',
    tag: 'Neural Sequence Modeling',
    summary:
      'Ultra-fast residual convolutional neural networks scoring donor (GT) and acceptor (AG) pre-mRNA junctions to filter spurious spliced transcript alignments.',
    href: '/software/',
    badge: 'Research Software',
    actionText: 'Explore open-source software',
    cliCommand: 'splam -h',
  },
];
---

<PageLayout
  title="Algorithms"
  eyebrow="Interactive Visualizers & Concepts"
  lead="Interactive explorations of fundamental computational biology algorithms — from long-read minimizer chaining and FM-index exact matching to Wheeler graph pangenomics and sequence alignment."
  description="Interactive computational biology algorithm visualizers by Kuan-Hao Chao: Minimap2 minimizer chaining, FM-Index BWT backward search, Wheeler graphs, and sequence alignment."
>
  <section class="algo-section" aria-label="Bioinformatics Algorithm Catalog">
    <div class="algo-tools" data-algo-tools>
      <div class="algo-filters" role="group" aria-label="Filter algorithms by category">
        {
          categories.map((c) => (
            <button
              type="button"
              class="filter-pill"
              data-filter={c.slug}
              aria-pressed={c.slug === 'all' ? 'true' : 'false'}
            >
              {c.label}
            </button>
          ))
        }
      </div>

      <div class="algo-controls">
        <label class="search">
          <Icon name="search" size={18} />
          <input
            type="search"
            placeholder="Search algorithms, tools, CLI…"
            data-search-input
            aria-label="Search algorithms"
          />
        </label>
        <label class="sort">
          <span class="visually-hidden">Sort algorithms</span>
          <select data-sort>
            <option value="default">Curated order</option>
            <option value="az">A–Z</option>
            <option value="area">Category</option>
          </select>
          <Icon name="chevron-down" size={16} />
        </label>
      </div>
    </div>

    <div class="algo-index" data-algo-list>
      {
        algorithms.map((algo) => {
          const searchTokens = [
            algo.title,
            algo.area,
            algo.tag,
            algo.summary,
            algo.cliCommand ?? '',
            algo.category,
          ]
            .join(' ')
            .toLowerCase();

          return (
            <article
              class="algo-card"
              id={algo.id}
              data-category={algo.category}
              data-title={algo.title.toLowerCase()}
              data-area={algo.area.toLowerCase()}
              data-search={searchTokens}
            >
              <div class="algo-card-body">
                <div class="algo-card-meta">
                  <span class="eyebrow">{algo.area}</span>
                  <span class="algo-tag">{algo.tag}</span>
                </div>
                <h3 class="algo-card-title">
                  <a href={algo.href}>{algo.title}</a>
                </h3>
                <p class="algo-card-summary muted">{algo.summary}</p>
                {algo.cliCommand && (
                  <div class="algo-cli-hint">
                    <span>CLI Command:</span>
                    <code>{algo.cliCommand}</code>
                  </div>
                )}
              </div>

              <div class="algo-card-action">
                <a href={algo.href} class="algo-link">
                  <span>{algo.actionText}</span>
                  <Icon name="arrow-right" size={15} />
                </a>
              </div>
            </article>
          );
        })
      }
    </div>

    <p class="algo-empty" data-algo-empty hidden>No algorithms match your filter or search query.</p>
  </section>
</PageLayout>

<style>
  .algo-section {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-8);
  }

  /* Toolbar: Category Pills & Search / Sort Controls */
  .algo-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: var(--space-6);
  }

  .algo-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .filter-pill {
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    padding: 0.4em 0.9em;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition: all var(--transition);
  }

  .filter-pill:hover {
    border-color: var(--color-ink);
    color: var(--color-ink);
  }

  .filter-pill[aria-pressed='true'] {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-bg);
  }

  .algo-controls {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .search {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45em 0.8em;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-muted);
  }

  .search:focus-within {
    border-color: var(--color-accent);
    color: var(--color-ink);
  }

  .search input {
    border: none;
    outline: none;
    background: transparent;
    font-size: var(--fs-small);
    width: min(16rem, 50vw);
  }

  .sort {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .sort select {
    appearance: none;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: 0.5em 2.2em 0.5em 0.8em;
    font-size: var(--fs-small);
    cursor: pointer;
  }

  .sort :global(svg) {
    position: absolute;
    right: 0.6em;
    pointer-events: none;
    color: var(--color-muted);
  }

  .algo-index {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }

  .algo-card {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-rule);
    transition: background-color 0.15s ease;
  }

  .algo-card:first-child {
    border-top: 0;
  }

  .algo-card.is-hidden {
    display: none;
  }

  .algo-empty {
    padding: var(--space-8) 0;
    color: var(--color-muted);
    font-size: var(--fs-body);
  }

  @media (pointer: coarse) {
    .filter-pill,
    .search,
    .sort select {
      padding-block: 0.6em;
    }
  }

  @media (max-width: 768px) {
    .algo-tools {
      align-items: stretch;
    }
    .algo-filters {
      gap: 0.45rem;
    }
    .algo-controls {
      width: 100%;
      flex-direction: column;
      gap: 0.5rem;
    }
    .search,
    .sort,
    .sort select {
      width: 100%;
    }
    .search input {
      width: 100%;
      min-width: 0;
    }
    .algo-card {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }

  .algo-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .algo-card-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .algo-tag {
    font-size: var(--fs-meta);
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface));
    color: var(--color-accent-dark);
    border-radius: var(--radius);
  }

  .algo-card-title {
    font-size: 1.15rem;
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    margin: 0;
  }

  .algo-card-title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .algo-card-title a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .algo-card-summary {
    font-size: var(--fs-small);
    line-height: 1.55;
    margin: 0;
    max-width: 65ch;
  }

  .algo-cli-hint {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-meta);
    color: var(--color-muted);
    margin-top: 0.25rem;
  }

  .algo-cli-hint code {
    font-family: var(--font-mono);
    padding: 0.15rem 0.4rem;
    background: var(--color-bg);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    color: var(--color-ink);
  }

  .algo-card-action {
    display: flex;
    align-items: center;
  }

  .algo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    background: var(--color-surface);
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .algo-link:hover {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
    color: var(--color-accent-dark);
  }
</style>

<script>
  function init() {
    const root = document.querySelector<HTMLElement>('[data-algo-tools]');
    const list = document.querySelector<HTMLElement>('[data-algo-list]');
    const empty = document.querySelector<HTMLElement>('[data-algo-empty]');
    if (!root || !list) return;
    if (root.dataset.filterReady) return;
    root.dataset.filterReady = 'true';

    const cards = Array.from(list.querySelectorAll<HTMLElement>('.algo-card'));
    const pills = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const searchInput = root.querySelector<HTMLInputElement>('[data-search-input]');
    const sortSelect = root.querySelector<HTMLSelectElement>('[data-sort]');

    const order = new Map(cards.map((c, i) => [c, i]));

    let activeCategory = 'all';
    let query = '';

    const apply = () => {
      let visible = 0;
      for (const card of cards) {
        const cat = card.dataset.category ?? '';
        const search = card.dataset.search ?? '';
        const ok =
          (activeCategory === 'all' || cat === activeCategory) &&
          (query === '' || search.includes(query));
        card.classList.toggle('is-hidden', !ok);
        if (ok) visible++;
      }
      if (empty) empty.hidden = visible !== 0;

      const mode = sortSelect?.value ?? 'default';
      const sorted = [...cards].sort((a, b) => {
        const titleA = a.dataset.title ?? '';
        const titleB = b.dataset.title ?? '';
        const areaA = a.dataset.area ?? '';
        const areaB = b.dataset.area ?? '';
        if (mode === 'az') return titleA.localeCompare(titleB);
        if (mode === 'area') return areaA.localeCompare(areaB) || titleA.localeCompare(titleB);
        return order.get(a)! - order.get(b)!;
      });
      sorted.forEach((card) => list.appendChild(card));
    };

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        activeCategory = pill.dataset.filter ?? 'all';
        pills.forEach((p) => p.setAttribute('aria-pressed', String(p === pill)));
        apply();
      });
    });

    searchInput?.addEventListener('input', () => {
      query = searchInput.value.trim().toLowerCase();
      apply();
    });

    sortSelect?.addEventListener('change', apply);
    apply();
  }

  document.addEventListener('astro:page-load', init);
  init();
</script>
