</style>

<script>
  import { getLivingCellsEngine, type CellSimParams, type LabTool, type StainingMode } from '../lib/livingCellsEngine';

  function initLabPage() {
    const canvas = document.getElementById('lab-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const engine = getLivingCellsEngine();
    engine.setMode('lab');
    engine.attach(canvas);

    // Initial simulation parameters for lab mode: start at 24 cells for lively playground
    const currentPopulation = engine.getTelemetry().total || 24;
    const initialParams: CellSimParams = {
      targetPopulation: currentPopulation,
      growthMultiplier: 1.0,
      mitosisMultiplier: 1.0,
      apoptosisMultiplier: 1.0,
      timeScale: 1.0,
      isPaused: false,
      visualAlpha: 1.0,
      darkContrast: true,
      viscosity: 1.0,
      temperature: 1.0,
      stainingMode: 'phase',
    };
    engine.setParams(initialParams);

    // Theme Switcher Wiring
    const themeBtn = document.getElementById('lab-theme-btn');
    const themePopover = document.getElementById('lab-theme-popover');
    const themeName = document.getElementById('lab-theme-name');
    const currentTheme =
      document.documentElement.dataset.theme ||
      (typeof localStorage !== 'undefined' ? localStorage.getItem('khc-theme') : null) ||
      'dark';
    if (themeName) {
      themeName.textContent = currentTheme.charAt(0).toUpperCase() + currentTheme.slice(1);
    }

    if (themeBtn && themePopover) {
      themeBtn.onclick = (e) => {
        e.stopPropagation();
        const isHidden = themePopover.hasAttribute('hidden');
        if (isHidden) {
          themePopover.removeAttribute('hidden');
          themeBtn.setAttribute('aria-expanded', 'true');
        } else {
          themePopover.setAttribute('hidden', '');
          themeBtn.setAttribute('aria-expanded', 'false');
        }
      };

      document.querySelectorAll<HTMLButtonElement>('.lab-theme-option').forEach((opt) => {
        opt.onclick = (e) => {
          e.stopPropagation();
          const chosen = opt.getAttribute('data-theme');
          if (chosen) {
            document.documentElement.dataset.theme = chosen;
            try {
              localStorage.setItem('khc-theme', chosen);
            } catch {}
            if (themeName) {
              themeName.textContent = chosen.charAt(0).toUpperCase() + chosen.slice(1);
            }
            document.dispatchEvent(new CustomEvent('khc:theme-change', { detail: { theme: chosen } }));
            engine.refreshEnvironment();
            themePopover.setAttribute('hidden', '');
            themeBtn.setAttribute('aria-expanded', 'false');
          }
        };
      });

      const closeThemeMenu = () => {
        themePopover.setAttribute('hidden', '');
        themeBtn.setAttribute('aria-expanded', 'false');
      };
      document.addEventListener('click', closeThemeMenu);
    }

    // Tool Dock Wiring
    const dockButtons = document.querySelectorAll<HTMLButtonElement>('.dock-btn');
    dockButtons.forEach((btn) => {
      btn.onclick = () => {
        const tool = btn.getAttribute('data-tool') as LabTool | null;
        if (!tool) return;
        dockButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        engine.setLabTool(tool);
      };
    });

    // Staining Channels Wiring
    const stainButtons = document.querySelectorAll<HTMLButtonElement>('.stain-btn');
    stainButtons.forEach((btn) => {
      btn.onclick = () => {
        const stain = btn.getAttribute('data-stain') as StainingMode | null;
        if (!stain) return;
        stainButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        engine.setStainingMode(stain);
      };
    });

    // Microscope scale + objective
    const scaleRule = document.querySelector<HTMLElement>('[data-scale-rule]');
    const scaleText = document.querySelector<HTMLElement>('[data-scale-text]');
    const objButtons = document.querySelectorAll<HTMLButtonElement>('[data-objective]');
    const syncScale = () => {
      const bar = engine.getScaleBar();
      if (scaleRule) scaleRule.style.width = `${Math.round(bar.pixels)}px`;
      if (scaleText) scaleText.textContent = `${bar.microns} µm`;
      objButtons.forEach((btn) => {
        const on = Number(btn.dataset.objective) === engine.getObjective();
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-checked', String(on));
      });
    };
    objButtons.forEach((btn) => {
      btn.onclick = () => {
        engine.setObjective(Number(btn.dataset.objective));
        syncScale();
      };
    });
    syncScale();

    // Inspector + clonal tree.
    //
    // The read-out follows one cell and empties when that cell divides or dies rather
    // than freezing on a corpse. The tree is drawn from the lineage ledger, which
    // outlives the cells in it — a parent is spliced out of the simulation the instant
    // it divides, so live cells alone cannot describe their own ancestry.
    const inspectBody = document.querySelector<HTMLElement>('[data-inspect-body]');
    const treeCanvas = document.getElementById('lineage-tree') as HTMLCanvasElement | null;

    const drawTree = (founderId: string | null) => {
      if (!treeCanvas) return;
      const ctx = treeCanvas.getContext('2d');
      if (!ctx) return;
      const w = treeCanvas.width;
      const h = treeCanvas.height;
      ctx.clearRect(0, 0, w, h);
      if (!founderId) return;
      const clone = engine.getLineage().filter((entry) => entry.founderId === founderId);
      if (!clone.length) return;
      const maxGen = Math.max(...clone.map((entry) => entry.generation));
      const byGen = new Map<number, typeof clone>();
      for (const entry of clone) {
        const list = byGen.get(entry.generation) ?? [];
        list.push(entry);
        byGen.set(entry.generation, list);
      }
      const pos = new Map<string, { x: number; y: number; alive: boolean }>();
      const rowH = h / (maxGen + 1);
      byGen.forEach((list, gen) => {
        list.forEach((entry, index) => {
          pos.set(entry.id, {
            x: ((index + 0.5) / list.length) * w,
            y: rowH * (gen + 0.5),
            alive: entry.diedAt === undefined,
          });
        });
      });
      ctx.strokeStyle = 'rgba(148,163,184,0.4)';
      ctx.lineWidth = 1;
      for (const entry of clone) {
        if (!entry.parentId) continue;
        const a = pos.get(entry.parentId);
        const c = pos.get(entry.id);
        if (!a || !c) continue;
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(c.x, c.y);
        ctx.stroke();
      }
      const selected = engine.getSelectedCellId();
      pos.forEach((point, id) => {
        ctx.beginPath();
        ctx.arc(point.x, point.y, id === selected ? 5 : 3.2, 0, Math.PI * 2);
        ctx.fillStyle =
          id === selected ? '#f8fafc' : point.alive ? 'rgba(96,165,250,0.95)' : 'rgba(248,113,113,0.5)';
        ctx.fill();
      });
    };

    const syncInspector = () => {
      if (!inspectBody) return;
      const view = engine.getInspection();
      inspectBody.textContent = '';
      if (!view) {
        const empty = document.createElement('p');
        empty.className = 'hud-inspect-empty';
        empty.textContent = engine.getSelectedCellId()
          ? 'That cell has divided or died.'
          : 'Pick the Inspect tool, then click a cell to follow it.';
        inspectBody.appendChild(empty);
        drawTree(null);
        return;
      }
      const organelles = Object.entries(view.organelles)
        .map(([type, count]) => `${count}× ${type}`)
        .join(', ');
      const rows: [string, string][] = [
        ['Phase', view.phase],
        ['Generation', String(view.generation)],
        ['Age', `${view.ageSeconds.toFixed(0)} s`],
        ['Diameter', `${view.diameterMicrons.toFixed(1)} µm`],
        ['Nuclei', String(view.nucleusCount)],
        ['Contacts', String(view.contacts)],
        ['Clone-mates', String(view.livingRelatives)],
        ['Organelles', organelles || '—'],
      ];
      for (const [label, value] of rows) {
        const row = document.createElement('div');
        row.className = 'hud-inspect-row';
        const key = document.createElement('span');
        key.textContent = label;
        const val = document.createElement('strong');
        val.textContent = value;
        row.append(key, val);
        inspectBody.appendChild(row);
      }
      drawTree(view.founderId);
    };

    const inspectTimer = window.setInterval(syncInspector, 400);
    document.addEventListener('khc:cell-inspect', syncInspector as EventListener);
    syncInspector();

    // Perturbation Wiring
    const drugButtons = document.querySelectorAll<HTMLButtonElement>('.drug-btn');
    const drugNote = document.querySelector<HTMLElement>('[data-drug-note]');
    const drugNotes: Record<string, string> = {
      none: 'Add a drug to the medium to stop the cycle at one specific step.',
      nocodazole: 'No spindle: dividing cells arrest with chromosomes at the plate. Wash out to resume.',
      cytochalasin: 'The ring cannot close: nuclei divide, cells do not — watch binucleate cells appear.',
      staurosporine: 'Programmed death spreads through the dish. Wash out to stop inducing it.',
    };
    drugButtons.forEach((btn) => {
      btn.onclick = () => {
        const drug = btn.getAttribute('data-drug');
        if (!drug) return;
        drugButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        engine.setPerturbation(drug as Parameters<typeof engine.setPerturbation>[0]);
        if (drugNote) drugNote.textContent = drugNotes[drug] ?? drugNotes.none;
      };
    });

    // Population chart. Samples once a second and keeps two minutes of history, so
    // equilibrium is something you can see holding rather than have to take on trust.
    const chart = document.getElementById('pop-chart') as HTMLCanvasElement | null;
    const history: { total: number; births: number; deaths: number }[] = [];
    let lastBirths = 0;
    let lastDeaths = 0;
    let chartTimer = 0;
    const HISTORY = 120;
    const drawChart = () => {
      if (!chart) return;
      const ctx = chart.getContext('2d');
      if (!ctx || !history.length) return;
      const w = chart.width;
      const h = chart.height;
      ctx.clearRect(0, 0, w, h);
      const maxTotal = Math.max(8, ...history.map((p) => p.total));
      const maxRate = Math.max(4, ...history.map((p) => Math.max(p.births, p.deaths)));
      // Newest sample pinned to the right edge, so the trace scrolls in like a real
      // chart recorder instead of filling the panel left-to-right over two minutes.
      const x = (i: number) => w - ((history.length - 1 - i) / Math.max(1, HISTORY - 1)) * w;
      const line = (key: 'total' | 'births' | 'deaths', color: string, scale: number) => {
        ctx.beginPath();
        history.forEach((point, i) => {
          const y = h - (point[key] / scale) * (h - 8) - 4;
          if (i === 0) ctx.moveTo(x(i), y);
          else ctx.lineTo(x(i), y);
        });
        ctx.strokeStyle = color;
        ctx.lineWidth = key === 'total' ? 2 : 1.25;
        ctx.stroke();
      };
      ctx.strokeStyle = 'rgba(148,163,184,0.18)';
      ctx.lineWidth = 1;
      for (let g = 1; g < 4; g++) {
        ctx.beginPath();
        ctx.moveTo(0, (h / 4) * g);
        ctx.lineTo(w, (h / 4) * g);
        ctx.stroke();
      }
      line('births', 'rgba(52,211,153,0.85)', maxRate);
      line('deaths', 'rgba(248,113,113,0.85)', maxRate);
      line('total', 'rgba(96,165,250,0.95)', maxTotal);
    };
    const sampleChart = () => {
      const t = engine.getTelemetry();
      history.push({
        total: t.total,
        births: Math.max(0, t.births - lastBirths) * 60,
        deaths: Math.max(0, t.deaths - lastDeaths) * 60,
      });
      lastBirths = t.births;
      lastDeaths = t.deaths;
      if (history.length > HISTORY) history.shift();
      drawChart();
    };
    if (chart) {
      const t0 = engine.getTelemetry();
      lastBirths = t0.births;
      lastDeaths = t0.deaths;
      chartTimer = window.setInterval(sampleChart, 1000);
    }

    // Bottom-sheet snap points (narrow screens only).
    //
    // A fixed slab left barely a third of a 390px screen showing the dish, so the
    // sheet now has three heights and opens at `peek`. Dragging the handle picks the
    // neighbouring snap; tapping the header cycles, which keeps it reachable by
    // keyboard and for anyone who cannot drag precisely.
    const sheet = document.getElementById('lab-hud');
    const sheetHeader = document.querySelector<HTMLElement>('[data-hud-header]');
    const SNAPS = ['peek', 'half', 'full'] as const;
    const narrow = window.matchMedia('(max-width: 768px)');
    let snapIndex = 0;
    const applySnap = () => {
      if (!sheet) return;
      if (narrow.matches) {
        sheet.dataset.snap = SNAPS[snapIndex];
        sheet.setAttribute('aria-expanded', String(snapIndex > 0));
      } else {
        delete sheet.dataset.snap;
        sheet.removeAttribute('aria-expanded');
      }
    };
    const setSnap = (next: number) => {
      snapIndex = Math.max(0, Math.min(SNAPS.length - 1, next));
      applySnap();
    };
    applySnap();
    narrow.addEventListener('change', applySnap);

    if (sheetHeader) {
      let dragFrom: number | null = null;
      let dragged = false;
      sheetHeader.addEventListener('pointerdown', (event) => {
        if (!narrow.matches) return;
        if ((event.target as HTMLElement).closest('button')) return;
        dragFrom = event.clientY;
        dragged = false;
        sheetHeader.setPointerCapture(event.pointerId);
      });
      sheetHeader.addEventListener('pointermove', (event) => {
        if (dragFrom === null) return;
        const delta = dragFrom - event.clientY;
        if (Math.abs(delta) < 46) return;
        setSnap(snapIndex + (delta > 0 ? 1 : -1));
        dragFrom = event.clientY;
        dragged = true;
      });
      const endDrag = (event: PointerEvent) => {
        if (dragFrom === null) return;
        const wasDrag = dragged;
        dragFrom = null;
        dragged = false;
        if (sheetHeader.hasPointerCapture(event.pointerId)) {
          sheetHeader.releasePointerCapture(event.pointerId);
        }
        // A tap that never became a drag cycles instead, so the sheet is usable
        // without a precise gesture.
        if (!wasDrag && !(event.target as HTMLElement).closest('button')) {
          setSnap((snapIndex + 1) % SNAPS.length);
        }
      };
      sheetHeader.addEventListener('pointerup', endDrag);
      sheetHeader.addEventListener('pointercancel', endDrag);
    }

    // Wire HUD Elements
    const hud = document.getElementById('lab-hud');
    const collapseBtn = document.getElementById('hud-collapse-btn');
    if (collapseBtn && hud) {
      collapseBtn.onclick = () => {
        const isCollapsed = hud.classList.toggle('is-collapsed');
        collapseBtn.setAttribute('aria-expanded', String(!isCollapsed));
      };
    }

    // Playback Controls
    const btnPause = document.getElementById('btn-pause');
    const pauseIcon = document.getElementById('pause-icon');
    const pauseLabel = document.getElementById('pause-label');
    const btnStep = document.getElementById('btn-step');
    const btnReset = document.getElementById('btn-reset');

    if (btnPause && pauseIcon && pauseLabel) {
      btnPause.onclick = () => {
        const current = engine.getParams();
        const nextPaused = !current.isPaused;
        engine.setParams({ isPaused: nextPaused });
        pauseIcon.textContent = nextPaused ? '▶' : '⏸';
        pauseLabel.textContent = nextPaused ? 'Resume' : 'Pause';
        btnPause.classList.toggle('hud-btn--accent', !nextPaused);
      };
    }

    if (btnStep) {
      btnStep.onclick = () => {
        engine.stepSingleFrame();
      };
    }

    if (btnReset) {
      btnReset.onclick = () => {
        const p = engine.getParams();
        engine.resetPopulation(p.targetPopulation || 24);
      };
    }

    // Sliders & Chips
    const sliderPop = document.getElementById('slider-pop') as HTMLInputElement | null;
    const valPop = document.getElementById('val-pop');
    const sliderGrowth = document.getElementById('slider-growth') as HTMLInputElement | null;
    const valGrowth = document.getElementById('val-growth');
    const sliderMitosis = document.getElementById('slider-mitosis') as HTMLInputElement | null;
    const valMitosis = document.getElementById('val-mitosis');
    const sliderApoptosis = document.getElementById('slider-apoptosis') as HTMLInputElement | null;
    const valApoptosis = document.getElementById('val-apoptosis');
    const sliderViscosity = document.getElementById('slider-viscosity') as HTMLInputElement | null;
    const valViscosity = document.getElementById('val-viscosity');
    const sliderTemperature = document.getElementById('slider-temperature') as HTMLInputElement | null;
    const valTemperature = document.getElementById('val-temperature');
    const sliderSpeed = document.getElementById('slider-speed') as HTMLInputElement | null;
    const valSpeed = document.getElementById('val-speed');
    const sliderContrast = document.getElementById('slider-contrast') as HTMLInputElement | null;
    const valContrast = document.getElementById('val-contrast');

    function syncSlidersFromParams(params: CellSimParams) {
      if (sliderPop && valPop) {
        sliderPop.value = String(params.targetPopulation || 24);
        valPop.textContent = String(params.targetPopulation || 24);
      }
      if (sliderGrowth && valGrowth) {
        sliderGrowth.value = String(params.growthMultiplier);
        valGrowth.textContent = `${params.growthMultiplier.toFixed(1)}×`;
      }
      if (sliderMitosis && valMitosis) {
        sliderMitosis.value = String(params.mitosisMultiplier);
        valMitosis.textContent = `${params.mitosisMultiplier.toFixed(1)}×`;
      }
      if (sliderApoptosis && valApoptosis) {
        sliderApoptosis.value = String(params.apoptosisMultiplier);
        valApoptosis.textContent = `${params.apoptosisMultiplier.toFixed(1)}×`;
      }
      if (sliderViscosity && valViscosity) {
        sliderViscosity.value = String(params.viscosity ?? 1.0);
        valViscosity.textContent = `${(params.viscosity ?? 1.0).toFixed(1)}×`;
      }
      if (sliderTemperature && valTemperature) {
        sliderTemperature.value = String(params.temperature ?? 1.0);
        valTemperature.textContent = `${(params.temperature ?? 1.0).toFixed(1)}×`;
      }
      if (sliderSpeed && valSpeed) {
        sliderSpeed.value = String(params.timeScale);
        valSpeed.textContent = `${params.timeScale.toFixed(1)}×`;
      }
      if (sliderContrast && valContrast) {
        sliderContrast.value = String(params.visualAlpha);
        valContrast.textContent = params.visualAlpha.toFixed(2);
      }
    }

    syncSlidersFromParams(initialParams);

    if (sliderPop && valPop) {
      sliderPop.oninput = () => {
        const val = parseInt(sliderPop.value, 10);
        valPop.textContent = String(val);
        engine.setParams({ targetPopulation: val });
      };
    }

    document.querySelectorAll<HTMLButtonElement>('.chip-btn').forEach((chip) => {
      chip.onclick = () => {
        const pop = parseInt(chip.getAttribute('data-pop') || '24', 10);
        if (sliderPop && valPop) {
          sliderPop.value = String(pop);
          valPop.textContent = String(pop);
        }
        engine.setParams({ targetPopulation: pop });
      };
    });

    if (sliderGrowth && valGrowth) {
      sliderGrowth.oninput = () => {
        const val = parseFloat(sliderGrowth.value);
        valGrowth.textContent = `${val.toFixed(1)}×`;
        engine.setParams({ growthMultiplier: val });
      };
    }
    if (sliderMitosis && valMitosis) {
      sliderMitosis.oninput = () => {
        const val = parseFloat(sliderMitosis.value);
        valMitosis.textContent = `${val.toFixed(1)}×`;
        engine.setParams({ mitosisMultiplier: val });
      };
    }
    if (sliderApoptosis && valApoptosis) {
      sliderApoptosis.oninput = () => {
        const val = parseFloat(sliderApoptosis.value);
        valApoptosis.textContent = `${val.toFixed(1)}×`;
        engine.setParams({ apoptosisMultiplier: val });
      };
    }
    if (sliderViscosity && valViscosity) {
      sliderViscosity.oninput = () => {
        const val = parseFloat(sliderViscosity.value);
        valViscosity.textContent = `${val.toFixed(1)}×`;
        engine.setParams({ viscosity: val });
      };
    }
    if (sliderTemperature && valTemperature) {
      sliderTemperature.oninput = () => {
        const val = parseFloat(sliderTemperature.value);
        valTemperature.textContent = `${val.toFixed(1)}×`;
        engine.setParams({ temperature: val });
      };
    }
    if (sliderSpeed && valSpeed) {
      sliderSpeed.oninput = () => {
        const val = parseFloat(sliderSpeed.value);
        valSpeed.textContent = `${val.toFixed(1)}×`;
        engine.setParams({ timeScale: val });
      };
    }
    if (sliderContrast && valContrast) {
      sliderContrast.oninput = () => {
        const val = parseFloat(sliderContrast.value);
        valContrast.textContent = val.toFixed(2);
        engine.setParams({ visualAlpha: val });
      };
    }

    // Preset Configurations
    const presets: Record<string, Partial<CellSimParams>> = {
      homeostasis: {
        targetPopulation: 24,
        growthMultiplier: 1.2,
        mitosisMultiplier: 1.0,
        apoptosisMultiplier: 1.0,
        viscosity: 1.0,
        temperature: 1.0,
        timeScale: 1.0,
      },
      proliferation: {
        targetPopulation: 120,
        growthMultiplier: 2.8,
        mitosisMultiplier: 3.2,
        apoptosisMultiplier: 0.2,
        viscosity: 0.9,
        temperature: 1.2,
        timeScale: 1.2,
      },
      superbloom: {
        targetPopulation: 300,
        growthMultiplier: 3.5,
        mitosisMultiplier: 4.0,
        apoptosisMultiplier: 0.1,
        viscosity: 0.8,
        temperature: 1.4,
        timeScale: 1.4,
      },
      turnover: {
        targetPopulation: 48,
        growthMultiplier: 2.4,
        mitosisMultiplier: 2.5,
        apoptosisMultiplier: 2.8,
        viscosity: 1.0,
        temperature: 1.1,
        timeScale: 1.3,
      },
      quiescence: {
        targetPopulation: 12,
        growthMultiplier: 0.4,
        mitosisMultiplier: 0.3,
        apoptosisMultiplier: 0.1,
        viscosity: 1.4,
        temperature: 0.6,
        timeScale: 0.7,
      },
    };

    document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((btn) => {
      btn.onclick = () => {
        const key = btn.dataset.preset;
        if (!key || !presets[key]) return;
        document.querySelectorAll('[data-preset]').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const next = { ...presets[key], isPaused: false, visualAlpha: 1.0, darkContrast: true };
        engine.setParams(next as Partial<CellSimParams>);
        syncSlidersFromParams(engine.getParams());
      };
    });

    // Mass Actions
    const actSpawn10 = document.getElementById('act-spawn-10');
    const actMutagenAll = document.getElementById('act-mutagen-all');
    const actMitosis = document.getElementById('act-mitosis');
    const actClear = document.getElementById('act-clear');

    if (actSpawn10) {
      actSpawn10.onclick = () => {
        for (let i = 0; i < 10; i++) engine.spawnRandomCell();
      };
    }
    if (actMutagenAll) {
      actMutagenAll.onclick = () => {
        engine.triggerMutagenPulse(window.innerWidth * 0.5, window.innerHeight * 0.5);
      };
    }
    if (actMitosis) actMitosis.onclick = () => engine.triggerRandomMitosis();
    // Not `clearAllCells()`: emptying the dish on the spot reads as a glitch. The
    // surplus actually undergoes apoptosis, staggered so it sweeps, and the method
    // resets the population target so homeostasis does not immediately regrow it.
    if (actClear) actClear.onclick = () => engine.cullToBaseline(12, 7);

    // Live Telemetry Sync
    const tTotal = document.querySelector('[data-t-total]');
    const tInterphase = document.querySelector('[data-t-interphase]');
    const tMitosis = document.querySelector('[data-t-mitosis]');
    const tApoptosis = document.querySelector('[data-t-apoptosis]');
    const tNutrients = document.querySelector('[data-t-nutrients]');
    const tFps = document.querySelector('[data-t-fps]');

    const telemetryTimer = setInterval(() => {
      const t = engine.getTelemetry();
      if (tTotal) tTotal.textContent = String(t.total);
      if (tInterphase) tInterphase.textContent = String(t.interphase);
      if (tMitosis) tMitosis.textContent = String(t.mitosis + t.postmitotic);
      if (tApoptosis) tApoptosis.textContent = String(t.apoptosis);
      if (tNutrients) tNutrients.textContent = String(t.nutrients);
      if (tFps) tFps.textContent = String(t.fps);
    }, 120);

    // Cleanup on navigation away
    const cleanup = () => {
      clearInterval(telemetryTimer);
      if (chartTimer) clearInterval(chartTimer);
      clearInterval(inspectTimer);
      document.removeEventListener('khc:cell-inspect', syncInspector as EventListener);
    };
    window.addEventListener('pagehide', cleanup, { once: true });
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  }

  // Bind on Astro page loads
  document.addEventListener('astro:page-load', initLabPage);
  if (document.readyState !== 'loading') initLabPage();
  else document.addEventListener('DOMContentLoaded', initLabPage);
</script>
