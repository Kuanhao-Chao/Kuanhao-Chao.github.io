---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Cell Lab — Interactive Cellular Automata & Biology Playground"
  description="A full-screen interactive biological simulation playground. Control cellular homeostasis, proliferation rates, apoptosis, growth speed, chemotaxis, laser tweezers, and epifluorescent staining in real time."
  bare={true}
>
  <main class="lab-viewport" id="lab-root">
    <!-- Full-screen simulation canvas -->
    <canvas id="lab-canvas" class="lab-canvas" role="img" aria-label="Cell Lab biological simulation canvas"></canvas>

    <!-- Top floating navigation bar -->
    <header class="lab-topbar">
      <div class="lab-brand">
        <span class="lab-pulse" aria-hidden="true"></span>
        <h1 class="lab-title">CELL LAB 🔬</h1>
        <span class="lab-badge">In Silico Microcosm</span>
      </div>

      <!-- Quick telemetry strip -->
      <div class="lab-telemetry-strip" aria-label="Live cell telemetry" role="status">
        <span class="t-pill" title="Total active cells">Total: <strong data-t-total>--</strong></span>
        <span class="t-pill" title="Cells in growth / mature interphase">Interphase: <strong data-t-interphase>--</strong></span>
        <span class="t-pill t-pill--mitosis" title="Active bipolar divisions">Mitosis: <strong data-t-mitosis>--</strong></span>
        <span class="t-pill t-pill--apoptosis" title="Apoptotic clearances">Apoptosis: <strong data-t-apoptosis>--</strong></span>
        <span class="t-pill t-pill--nutrient" title="Nutrient droplets in dish">Nutrients: <strong data-t-nutrients>0</strong></span>
        <span class="t-pill t-pill--fps" title="Render frame rate"><strong data-t-fps>60</strong> FPS</span>
      </div>

      <div class="lab-top-actions">
        <!-- Theme Switcher -->
        <div class="lab-theme-menu">
          <button
            type="button"
            class="lab-theme-btn"
            id="lab-theme-btn"
            aria-expanded="false"
            aria-haspopup="true"
            title="Switch Theme"
          >
            <span class="theme-icon" aria-hidden="true">🎨</span>
            <span class="theme-name" id="lab-theme-name">Theme</span>
            <span class="theme-caret" aria-hidden="true">▾</span>
          </button>
          <div class="lab-theme-popover" id="lab-theme-popover" role="menu" hidden>
            <button type="button" class="lab-theme-option" data-theme="dark">
              <span class="theme-dot theme-dot--dark"></span> Dark
            </button>
            <button type="button" class="lab-theme-option" data-theme="light">
              <span class="theme-dot theme-dot--light"></span> Light
            </button>
            <button type="button" class="lab-theme-option" data-theme="parchment">
              <span class="theme-dot theme-dot--parchment"></span> Parchment
            </button>
            <button type="button" class="lab-theme-option" data-theme="nord">
              <span class="theme-dot theme-dot--nord"></span> Nord
            </button>
            <button type="button" class="lab-theme-option" data-theme="monokai">
              <span class="theme-dot theme-dot--monokai"></span> Monokai
            </button>
            <button type="button" class="lab-theme-option" data-theme="cyberdeck">
              <span class="theme-dot theme-dot--cyberdeck"></span> Cyberdeck
            </button>
          </div>
        </div>

        <a href="/chromatin/" class="lab-exit-btn" title="Chromatin 3D Compaction">
          <span aria-hidden="true">🧬</span>
          <span>Chromatin</span>
        </a>

        <a href="/sonic-genome/" class="lab-exit-btn" title="Sonic Genome: DNA Audio Synthesizer">
          <span aria-hidden="true">🎵</span>
          <span>Sonic Synth</span>
        </a>

        <a href="/" class="lab-exit-btn" title="Return to main site">
          <span aria-hidden="true">←</span>
          <span>Exit to Site</span>
        </a>
      </div>
    </header>

    <!-- Floating Bottom Biological Tool Dock -->
    <!-- Microscope scale. Anchored to biology: a cultured animal cell is ~20 µm, so
         the median cell on screen fixes microns per pixel and the bar stays honest
         when the objective changes. -->
    <div class="lab-scale" aria-label="Microscope scale and objective">
      <div class="lab-objective" role="radiogroup" aria-label="Objective">
        <button type="button" class="obj-btn" data-objective="10" role="radio" aria-checked="false">10×</button>
        <button type="button" class="obj-btn is-active" data-objective="20" role="radio" aria-checked="true">20×</button>
        <button type="button" class="obj-btn" data-objective="40" role="radio" aria-checked="false">40×</button>
      </div>
      <div class="lab-scale-bar">
        <span class="lab-scale-rule" data-scale-rule></span>
        <span class="lab-scale-text" data-scale-text>20 µm</span>
      </div>
    </div>

    <nav class="lab-dock" id="lab-dock" aria-label="Interactive Biological Tools">
      <div class="dock-tools">
        <button type="button" class="dock-btn is-active" data-tool="pointer" title="Pointer & Fling: Drag cells with momentum or click to trigger division">
          <span class="dock-icon">👆</span>
          <span class="dock-label">Grab/Fling</span>
        </button>
        <button type="button" class="dock-btn" data-tool="feed" title="Nutrient Dropper: Click/drag to drop nutrient droplets (cells swim toward food via chemotaxis)">
          <span class="dock-icon">🧪</span>
          <span class="dock-label">Feed</span>
        </button>
        <button type="button" class="dock-btn" data-tool="laser" title="Optical Tweezers: Hold/drag laser beam to push and herd cells">
          <span class="dock-icon">⚡</span>
          <span class="dock-label">Laser Repel</span>
        </button>
        <button type="button" class="dock-btn" data-tool="mutagen" title="Mutagen Pulse: Click to send radiation shockwave triggering mitosis">
          <span class="dock-icon">🧬</span>
          <span class="dock-label">Mutagen</span>
        </button>
        <button type="button" class="dock-btn" data-tool="vortex" title="Microfluidic Vortex: Click/drag to swirl fluid with hydrodynamic momentum">
          <span class="dock-icon">🌊</span>
          <span class="dock-label">Vortex</span>
        </button>
        <button type="button" class="dock-btn" data-tool="spawn" title="Spawn: Click anywhere to create a new viable budding cell">
          <span class="dock-icon">➕</span>
          <span class="dock-label">Spawn</span>
        </button>
        <button type="button" class="dock-btn" data-tool="mitosis" title="Force Mitosis: Click any cell to initiate 12-chromosome bipolar division">
          <span class="dock-icon">✂️</span>
          <span class="dock-label">Mitosis</span>
        </button>
        <button type="button" class="dock-btn" data-tool="apoptosis" title="Force Apoptosis: Click any cell to trigger programmed death & blebbing">
          <span class="dock-icon">💀</span>
          <span class="dock-label">Apoptosis</span>
        </button>
        <button type="button" class="dock-btn" data-tool="inspect" title="Inspect: Click any cell to follow it — generation, phase, size in microns, organelles and clone-mates">
          <span class="dock-icon">🔍</span>
          <span class="dock-label">Inspect</span>
        </button>
      </div>
    </nav>

    <!-- Floating Glassmorphic Control Panel -->
    <aside class="lab-hud" id="lab-hud" aria-label="Simulation Control Panel">
      <div class="hud-header" data-hud-header>
        <span class="hud-grab" aria-hidden="true"></span>
        <div class="hud-title-group">
          <span class="hud-icon" aria-hidden="true">⚙️</span>
          <h2 class="hud-title">HYPERPARAMETERS</h2>
        </div>
        <button type="button" class="hud-toggle" id="hud-collapse-btn" aria-expanded="true" aria-controls="hud-body" title="Collapse / Expand Controls">
          <span class="hud-chevron" aria-hidden="true">▼</span>
        </button>
      </div>

      <div class="hud-body" id="hud-body">
        <!-- Playback & Speed Bar -->
        <section class="hud-section hud-section--playback">
          <div class="hud-playback-row">
            <button type="button" class="hud-btn hud-btn--accent" id="btn-pause" title="Pause or Resume Simulation">
              <span id="pause-icon" aria-hidden="true">⏸</span>
              <span id="pause-label">Pause</span>
            </button>
            <button type="button" class="hud-btn" id="btn-step" title="Step exactly 1 simulation frame">
              <span aria-hidden="true">⏭</span>
              <span>Step</span>
            </button>
            <button type="button" class="hud-btn hud-btn--danger" id="btn-reset" title="Reset cell population to initial dish state">
              <span aria-hidden="true">🔄</span>
              <span>Reset</span>
            </button>
          </div>
        </section>

        <!-- Epifluorescence Staining Channels -->
        <section class="hud-section">
          <span class="hud-label">Epifluorescence Staining</span>
          <div class="hud-staining-grid">
            <button type="button" class="stain-btn is-active" data-stain="phase" title="Phase contrast microscopy">🔬 Phase</button>
            <button type="button" class="stain-btn" data-stain="gfp" title="Green Fluorescent Protein (GFP)">🟢 GFP</button>
            <button type="button" class="stain-btn" data-stain="dapi" title="DAPI Blue DNA Staining">🔵 DAPI</button>
            <button type="button" class="stain-btn" data-stain="mcherry" title="mCherry Fluorescent Protein">🔴 mCherry</button>
            <button type="button" class="stain-btn" data-stain="lineage" title="Clonal Lineage Rainbow Tracking">🌈 Lineage</button>
          </div>
        </section>

        <!-- Pharmacology -->
        <section class="hud-section">
          <span class="hud-label">Perturbations</span>
          <div class="hud-staining-grid">
            <button type="button" class="stain-btn drug-btn is-active" data-drug="none" title="No drug in the medium">💧 None</button>
            <button type="button" class="stain-btn drug-btn" data-drug="nocodazole" title="Nocodazole: depolymerises microtubules, so no spindle forms and dividing cells arrest with their chromosomes at the metaphase plate">🧷 Nocodazole</button>
            <button type="button" class="stain-btn drug-btn" data-drug="cytochalasin" title="Cytochalasin: blocks actin, so the contractile ring never closes — the nucleus divides but the cell does not, leaving binucleate cells">🔗 Cytochalasin</button>
            <button type="button" class="stain-btn drug-btn" data-drug="staurosporine" title="Staurosporine: a classic apoptosis inducer — programmed death spreads steadily through the dish">☠️ Staurosporine</button>
          </div>
          <p class="hud-drug-note" data-drug-note>Add a drug to the medium to stop the cycle at one specific step.</p>
        </section>

        <!-- Inspector -->
        <section class="hud-section">
          <span class="hud-label">Cell Inspector</span>
          <div class="hud-inspect" data-inspect-body>
            <p class="hud-inspect-empty">Pick the 🔍 Inspect tool, then click a cell to follow it.</p>
          </div>
          <canvas class="hud-tree" id="lineage-tree" width="520" height="150" role="img"
            aria-label="Clonal tree of the selected cell's lineage"></canvas>
        </section>

        <!-- Population dynamics -->
        <section class="hud-section">
          <span class="hud-label">Population Dynamics</span>
          <canvas class="hud-chart" id="pop-chart" width="520" height="132" role="img"
            aria-label="Live chart of total cell count, births and deaths over the last two minutes"></canvas>
          <div class="hud-chart-legend">
            <span class="chart-key chart-key--total">Total</span>
            <span class="chart-key chart-key--births">Births/min</span>
            <span class="chart-key chart-key--deaths">Deaths/min</span>
          </div>
        </section>

        <!-- Presets -->
        <section class="hud-section">
          <span class="hud-label">Biological Presets</span>
          <div class="hud-preset-grid">
            <button type="button" class="preset-btn is-active" data-preset="homeostasis">Homeostasis (24)</button>
            <button type="button" class="preset-btn" data-preset="proliferation">Proliferation (120)</button>
            <button type="button" class="preset-btn" data-preset="superbloom">Superbloom (300)</button>
            <button type="button" class="preset-btn" data-preset="turnover">Turnover (48)</button>
            <button type="button" class="preset-btn" data-preset="quiescence">Quiescence (12)</button>
          </div>
        </section>

        <!-- Sliders -->
        <section class="hud-section hud-section--sliders">
          <span class="hud-label">Population & Kinetic Parameters</span>

          <div class="slider-item">
            <div class="slider-meta">
              <label for="slider-pop">Target Population (Up to 300)</label>
              <span class="slider-val" id="val-pop">24</span>
            </div>
            <input type="range" id="slider-pop" min="4" max="300" step="1" value="24" />
            <div class="quick-chips">
              <button type="button" class="chip-btn" data-pop="12">12</button>
              <button type="button" class="chip-btn" data-pop="24">24</button>
              <button type="button" class="chip-btn" data-pop="48">48</button>
              <button type="button" class="chip-btn" data-pop="120">120</button>
              <button type="button" class="chip-btn" data-pop="200">200</button>
              <button type="button" class="chip-btn" data-pop="300">300</button>
            </div>
          </div>

          <div class="slider-item">
            <div class="slider-meta">
              <label for="slider-growth">Growth Rate</label>
              <span class="slider-val" id="val-growth">1.0×</span>
            </div>
            <input type="range" id="slider-growth" min="0.2" max="5.0" step="0.1" value="1.0" />
          </div>

          <div class="slider-item">
            <div class="slider-meta">
              <label for="slider-mitosis">Mitosis Rate</label>
              <span class="slider-val" id="val-mitosis">1.0×</span>
            </div>
            <input type="range" id="slider-mitosis" min="0.2" max="5.0" step="0.1" value="1.0" />
          </div>

          <div class="slider-item">
            <div class="slider-meta">
              <label for="slider-apoptosis">Apoptosis Rate</label>
              <span class="slider-val" id="val-apoptosis">1.0×</span>
            </div>
            <input type="range" id="slider-apoptosis" min="0.0" max="5.0" step="0.1" value="1.0" />
          </div>

          <div class="slider-item">
            <div class="slider-meta">
              <label for="slider-viscosity">Medium Viscosity</label>
              <span class="slider-val" id="val-viscosity">1.0×</span>
            </div>
            <input type="range" id="slider-viscosity" min="0.2" max="3.0" step="0.1" value="1.0" />
          </div>

          <div class="slider-item">
            <div class="slider-meta">
              <label for="slider-temperature">Temperature / Kinetics</label>
              <span class="slider-val" id="val-temperature">1.0×</span>
            </div>
            <input type="range" id="slider-temperature" min="0.2" max="3.0" step="0.1" value="1.0" />
          </div>

          <div class="slider-item">
            <div class="slider-meta">
              <label for="slider-speed">Simulation Speed</label>
              <span class="slider-val" id="val-speed">1.0×</span>
            </div>
            <input type="range" id="slider-speed" min="0.2" max="3.0" step="0.1" value="1.0" />
          </div>

          <div class="slider-item">
            <div class="slider-meta">
              <label for="slider-contrast">Membrane Contrast</label>
              <span class="slider-val" id="val-contrast">1.0</span>
            </div>
            <input type="range" id="slider-contrast" min="0.4" max="1.0" step="0.05" value="1.0" />
          </div>
        </section>

        <!-- Direct Actions -->
        <section class="hud-section">
          <span class="hud-label">Mass Interventions</span>
          <div class="hud-actions-grid">
            <button type="button" class="action-btn" id="act-spawn-10" title="Spawn 10 viable cells">
              <span>➕10</span> Spawn ×10
            </button>
            <button type="button" class="action-btn" id="act-mutagen-all" title="Emit mutagen pulse">
              <span>🧬</span> Mutagen Wave
            </button>
            <button type="button" class="action-btn" id="act-mitosis" title="Force division on mature cells">
              <span>✂️</span> Divide Cell
            </button>
            <button type="button" class="action-btn" id="act-clear" title="Thin the dish back to the 12-cell baseline as a staggered apoptosis wave (~7s) rather than deleting every cell at once">
              <span>🧹</span> Clear Dish
            </button>
          </div>
        </section>

        <!-- Micro-Guide Footer -->
        <footer class="hud-footer">
          <p>🧪 <strong>Select tools from bottom dock</strong>: feed nutrients, herd with laser, pulse mutagen, or fling cells.</p>
        </footer>
      </div>
    </aside>
  </main>
</BaseLayout>

<style>
  :global(body) {
    overflow: hidden;
    margin: 0;
    padding: 0;
    background: var(--color-bg, #0f172a);
    color: var(--color-text, #f1f5f9);
    user-select: none;
    -webkit-user-select: none;
  }

  .lab-viewport {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
  }

  .lab-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: crosshair;
  }

  /* Top Navigation Bar */
  .lab-topbar {
    position: absolute;
    top: 1rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    z-index: 20;
    pointer-events: none;
  }

  .lab-topbar > * {
    pointer-events: auto;
  }

  .lab-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.45rem 0.9rem;
    border-radius: 9999px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  .lab-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 10px #10b981;
    animation: pulseGlow 2s infinite;
  }

  @keyframes pulseGlow {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.6; }
  }

  .lab-title {
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--color-text, #f1f5f9);
    margin: 0;
  }

  .lab-badge {
    font-size: 0.72rem;
    color: var(--color-text-muted, #94a3b8);
    border-left: 1px solid rgba(255, 255, 255, 0.15);
    padding-left: 0.65rem;
  }

  .lab-telemetry-strip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  .t-pill {
    font-size: 0.75rem;
    color: var(--color-text-muted, #94a3b8);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0 0.35rem;
  }

  .t-pill strong {
    color: var(--color-text, #f1f5f9);
    font-weight: 600;
  }

  .t-pill--mitosis strong {
    color: #38bdf8;
  }

  .t-pill--apoptosis strong {
    color: #f43f5e;
  }

  .t-pill--nutrient strong {
    color: #fbbf24;
  }

  .t-pill--fps strong {
    color: #10b981;
  }

  .lab-exit-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--color-text, #f1f5f9);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.45rem 0.95rem;
    border-radius: 9999px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    transition: all 0.18s ease;
  }

  .lab-exit-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-1px);
    border-color: rgba(255, 255, 255, 0.25);
  }

  /* Floating Bottom Biological Tool Dock */
  .lab-dock {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 25;
    background: rgba(15, 23, 42, 0.84);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 9999px;
    padding: 0.35rem 0.5rem;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
  }

  .dock-tools {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  /* The dock was centred on the viewport while the control panel is anchored right,
     so at 1440px the dock ran 38px underneath it and clipped its last tool. Centre it
     in the space actually available instead. */
  @media (min-width: 769px) {
    .lab-dock {
      left: 1.25rem;
      right: calc(330px + 2.5rem);
      transform: none;
      margin-inline: auto;
      width: max-content;
      max-width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .lab-dock::-webkit-scrollbar {
      display: none;
    }
  }

  .dock-btn {
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-text-muted, #94a3b8);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.4rem 0.65rem;
    border-radius: 9999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .dock-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    color: var(--color-text, #f1f5f9);
  }

  .dock-btn.is-active {
    background: rgba(56, 189, 248, 0.2);
    border-color: rgba(56, 189, 248, 0.5);
    color: #38bdf8;
    box-shadow: 0 0 12px rgba(56, 189, 248, 0.25);
  }

  .dock-icon {
    font-size: 0.9rem;
  }

  /* Floating HUD Control Panel */
  .lab-hud {
    position: absolute;
    bottom: 1.25rem;
    right: 1.25rem;
    width: 330px;
    max-width: calc(100vw - 2.5rem);
    background: rgba(15, 23, 42, 0.84);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
    z-index: 30;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: max-height 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hud-grab {
    display: none;
    width: 2.25rem;
    height: 0.25rem;
    margin: 0 auto 0.35rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.28);
  }

  .hud-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.04);
