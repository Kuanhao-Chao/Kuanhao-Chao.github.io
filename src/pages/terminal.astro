---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site, identity } from '../data/site';
import { software, honors, reviewing } from '../data/cv';
import TerminalKeybar from '../components/TerminalKeybar.astro';
import '../styles/terminal.css';

// The banner's identity and counts are inlined into the page so it paints on the
// first frame; the full knowledge index (`/terminal.json`) loads lazily behind it.
const [publications, research, talks, posts, news] = await Promise.all([
  getCollection('publications'),
  getCollection('research'),
  getCollection('presentations'),
  getCollection('posts'),
  getCollection('news'),
]);

const boot = {
  identity: {
    name: site.name,
    nameZh: site.nameZh,
    role: site.role,
    jobTitle: identity.jobTitle,
    worksFor: identity.worksFor.name,
    alumniOf: identity.alumniOf.map((a) => a.name),
    knowsAbout: identity.knowsAbout,
    tagline: site.tagline,
    bio: site.bio,
  },
  stats: {
    publications: publications.length,
    research: research.length,
    talks: talks.length,
    posts: posts.filter((p) => !p.data.draft).length,
    news: news.filter((n) => !n.data.draft).length,
    software: software.length,
    honors: honors.length,
    reviewing: reviewing.length,
  },
};
---
<BaseLayout
  bare
  title="Terminal"
  description="An interactive UNIX terminal for khchao.com — browse Kuan-Hao Chao's publications, software, research, and talks from a command line, or ask the built-in bot a question."
>
  {/*
    The page *is* the terminal, so there is no site chrome and no visible heading.
    The h1 stays for screen readers and for audit-indexing.mjs, which asserts every
    sitemap page has one.
  */}
  <h1 class="visually-hidden">Terminal — a UNIX shell for khchao.com</h1>

  <section class="term" data-terminal data-terminal-boot={JSON.stringify(boot)}>
    {/*
      Real window controls. Close is genuinely navigation here — the page *is* the
      window, so closing it means leaving — and so stays an anchor with no data
      attribute; the controller wires only what carries one.
    */}
    <div class="term-bar" data-terminal-bar>
      <a class="term-dot term-dot--close" href="/" aria-label="Close the shell and return to khchao.com" title="Back to khchao.com"></a>
      <button
        class="term-dot term-dot--min"
        type="button"
        data-terminal-min
        aria-expanded="true"
        aria-label="Minimise the terminal"
        title="Minimise the terminal"></button>
      <button
        class="term-dot term-dot--zoom"
        type="button"
        data-terminal-zoom
        aria-label="Fill the screen"
        title="Fill the screen"></button>
      <span class="term-bar-title" aria-hidden="true">khc@genome: ~ — ksh</span>
      <span class="term-bar-hint" aria-hidden="true">tab · ↑↓ · ctrl-l · `exit`</span>
      {/*
        This page renders through BaseLayout's `bare` mode, which drops the header
        and with it the site theme toggle. Without this control (and the `theme`
        command behind it) the full-screen shell would be the only page on the site
        you cannot change the lights from.
      */}
      <button
        class="term-theme"
        type="button"
        data-terminal-theme
        aria-label="Switch theme"
        title="Switch theme">☾</button>
    </div>

    <div class="term-screen-wrap">
      <div
        class="term-screen"
        data-terminal-screen
        role="log"
        aria-live="off"
        aria-busy="false"
        aria-label="Terminal output"
        aria-describedby="term-help"
        tabindex="0"
      ></div>
      <button
        class="term-scroll-latest"
        type="button"
        data-terminal-scroll-end
        aria-label="Jump to the latest terminal output"
        hidden
      >↓ latest</button>
    </div>

    <TerminalKeybar />

    <form class="term-form" data-terminal-form>
      <label class="visually-hidden" for="term-input">Terminal command</label>
      <span class="term-prompt" data-terminal-prompt>khc@genome:~$</span>
      <div class="term-input-wrap">
        <input
          class="term-input"
          id="term-input"
          data-terminal-input
          type="text"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          placeholder="type `help` to begin"
          aria-describedby="term-help"
          enterkeyhint="go"
        />
        <button
          class="term-input-clear"
          type="button"
          data-terminal-input-clear
          aria-label="Clear input text"
          title="Clear input"
          hidden
        >✕</button>
      </div>
      <button
        class="term-submit-btn"
        type="submit"
        data-terminal-submit
        aria-label="Run command"
        title="Run command"
      >↵</button>
      <span id="term-help" class="visually-hidden">
        Scroll the output with a mouse wheel, trackpad, or swipe. Press Shift-PageUp or Shift-PageDown to move through history. Press Tab for completion, use the arrow keys for command history, and press Control-L to clear the screen.
      </span>
    </form>
  </section>
</BaseLayout>

<script>
  import { initTerminal, type TerminalController } from '../scripts/terminal';

  let controller: TerminalController | null = null;

  // Idempotent mount: initTerminal also guards per-element, so double calls are safe.
  function mount() {
    if (controller) return;
    controller = initTerminal(document);
  }
  function unmount() {
    controller?.destroy();
    controller = null;
  }

  // Re-init on every view-transition arrival; tear down before leaving so the
  // key handlers never leak a second copy.
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', unmount);
  // Also mount now: a bundled module can finish loading *after* astro:page-load
  // has already fired on the first view-transition visit (the filter-island race).
  mount();
</script>
