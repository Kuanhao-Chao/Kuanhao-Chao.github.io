---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ResearchCard from '../components/ResearchCard.astro';
import PublicationItem from '../components/PublicationItem.astro';
import NewsEntry from '../components/NewsEntry.astro';
import Icon from '../components/Icon.astro';
import SequenceTrack from '../components/SequenceTrack.astro';
import HomeTerminal from '../components/HomeTerminal.astro';
import PostItem from '../components/PostItem.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';
import { experience, education, software, type SoftwareTool } from '../data/cv';
import { ALGORITHMS } from '../data/algorithms';
import { readingTime } from '../lib/format';
import AlgorithmLogo from '../components/AlgorithmLogo.astro';
import HomeGenomeBrowser from '../components/genomic/HomeGenomeBrowser.astro';

// Flagship tools for the homepage strip: those with a logo, newest first, each
// linked to its interactive explainer post. Logos resolve like software.astro.
const logoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/logos/software/*.png',
  { eager: true }
);
const featuredTools = [...software]
  .filter((t) => t.logo && t.posts?.[0])
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 4);
const toolLogo = (t: SoftwareTool) =>
  t.logo ? logoFiles[`../assets/logos/software/${t.logo}.png`]?.default : undefined;

// The logos are a mixed set: pure wordmarks (OpenSpliceAI 6.1:1, LiftOn 3.2:1) plus
// marks whose lettering is stacked with art (Splam 2.4:1) or picture icons (Shorkie
// 1:1, WGT 0.7:1). Only the very wide ones stay readable when drawn short; anything
// squarer packs its lettering into a fraction of the height and needs the taller box.
// Measured off the files themselves, so replacing a logo needs no CSS change.
const logoShape = (logo: ImageMetadata) => (logo.width / logo.height >= 3 ? 'wide' : 'compact');

const research = (await getCollection('research'))
  .filter((r) => r.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const allPublications = await getCollection('publications');
const pubs = allPublications
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.selectedOrder ?? 99) - (b.data.selectedOrder ?? 99))
  .slice(0, 7);

const latestNews = (await getCollection('news'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
const news = await Promise.all(
  latestNews.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);

const allPosts = await getCollection('posts');
const posts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const featuredAlgos = ALGORITHMS.filter((a) => a.featured);
---
<BaseLayout type="profile">
  <Hero />

  <section class="section home-section container" data-reveal>
    <SectionHeading eyebrow="What I work on" title="Research" href="/research/" more="All research" />
    <div class="home-research">
      {research.map((entry) => <ResearchCard entry={entry} variant="home" />)}
    </div>
  </section>

  {/*
    The terminal stands alone — no heading, no blurb. It explains itself, and it takes
    the plain container so it spans the same width as research, publications and
    software rather than sitting in a narrower column of its own.
  */}
  <section class="section home-section container" data-reveal>
    <HomeTerminal />
  </section>

  <section class="section home-section container" data-reveal>
    <SectionHeading
      eyebrow="Selected work"
      title="Publications"
      href="/publications/"
      more="All publications"
    />
    <ol class="home-pubs">
      {pubs.map((pub) => <li><PublicationItem pub={pub} compact /></li>)}
    </ol>
  </section>

  {featuredTools.length > 0 && (
    <section class="section home-section container" data-reveal>
      <SectionHeading eyebrow="Open source" title="Featured software" href="/software/" more="All software" />
      <ul class="home-tools">
        {featuredTools.map((t) => {
          const logo = toolLogo(t);
          return (
            <li>
              <a class="home-tool" href={`/posts/${t.posts![0]}/`}>
                {logo && (
                  <span class="home-tool-logo" data-shape={logoShape(logo)}>
                    <Image src={logo} alt="" height={80} />
                  </span>
                )}
                <span class="home-tool-text">
                  <span class="home-tool-name">{t.name}</span>
                  <span class="home-tool-blurb">{t.blurb}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <section class="section home-section container" data-reveal>
    <SectionHeading eyebrow="Background" title="Experience & education" />
    <div class="home-bg">
      <div>
        <p class="bg-label eyebrow">Experience</p>
        <ul class="bg-list">
          {
            experience.map((p) => (
              <li>
                <span class="bg-period">{p.period}</span>
                <span class="bg-role">{p.role}</span>
                <span class="bg-org muted">
                  {p.url ? <a href={p.url} target="_blank" rel="noopener noreferrer">{p.org}</a> : p.org}
                  {p.unit ? `, ${p.unit}` : ''}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="bg-label eyebrow">Education</p>
        <ul class="bg-list">
          {
            education.map((p) => (
              <li>
                <span class="bg-period">{p.period}</span>
                <span class="bg-role">{p.role}</span>
                <span class="bg-org muted">
                  {p.url ? <a href={p.url} target="_blank" rel="noopener noreferrer">{p.org}</a> : p.org}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section home-section container" data-reveal>
      <SectionHeading eyebrow="Writing" title="Posts" href="/posts/" more="All posts" />
      <div class="home-posts">
        {posts.map((entry) => (
          <PostItem entry={entry} minutes={readingTime(entry.body ?? '')} compact />
        ))}
      </div>
    </section>
  )}

  {featuredAlgos.length > 0 && (
    <section class="section home-section container" data-reveal>
      <SectionHeading
        eyebrow="Interactive tools"
        title="Algorithms & Visualizers"
        href="/algorithms/"
        more="All algorithms"
      />
      <ul class="home-algos">
        {featuredAlgos.map((a) => (
          <li>
            <a class="home-algo" href={a.href}>
              <div class="home-algo-header">
                <AlgorithmLogo id={a.id} size={40} compact />
                <span class="home-algo-tag">{a.tag}</span>
              </div>
              <span class="home-algo-title">{a.shortTitle || a.title}</span>
              <span class="home-algo-blurb">{a.blurb || a.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="section home-section container" data-reveal>
    <SectionHeading eyebrow="Updates" title="Recent news" href="/news/" more="All news" />
    <div class="home-news">
      {news.map(({ entry, Content }) => (
        <NewsEntry entry={entry} variant="card">
          <Content />
        </NewsEntry>
      ))}
    </div>
  </section>

  <section class="section home-section container" data-reveal>
    <SectionHeading
      eyebrow="Interactive Genome Browser"
      title="The yeast genome under Shorkie_LM"
      href="/shorkie-lab/genome/"
      more="Open full browser"
    />
    <HomeGenomeBrowser />
  </section>

  <div class="home-seq"><SequenceTrack /></div>

  <section class="cta" data-reveal>
    <div class="container cta-inner">
      <h2 class="cta-title">Let's work together</h2>
      <p class="cta-text">
        I'm always glad to talk about computational genomics, machine learning, or
        mentoring research projects. Reach out anytime.
      </p>
      <div class="cta-actions">
        <a class="btn btn--accent" href="https://calendly.com/kuanhao-chao/30min" target="_blank" rel="noopener noreferrer">
          <Icon name="coffee" size={18} /> Book a coffee chat
        </a>
        <a class="btn" href={`mailto:${site.email}`}>
          <Icon name="mail" size={18} /> Email me
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-research {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    border-block: 1px solid var(--color-rule);
    background: var(--color-rule);
  }
  /* ------------------------------------------------------------------------------------- */
  /* Phone: a shorter index.                                                                 */
  /*                                                                                         */
  /* Measured on an iPhone 13 (664px viewport): the page ran 11,680px = 17.6 screens, of      */
  /* which Publications alone was 3.1 and Recent news 1.7. Desktop keeps the full lists --    */
  /* the frontmatter still renders all of them and this only hides the tail, so the "All      */
  /* publications" / "All news" links carry the rest.                                        */
  /*                                                                                         */
  /* NOTE: the counts live in TWO places once this exists -- the `.slice()` in the            */
  /* frontmatter and the `n + 4` here. If the slice is ever cut below 4 these rules silently  */
  /* do nothing, which looks like they were never needed.                                    */
  /* ------------------------------------------------------------------------------------- */
  @media (max-width: 639px) {
    /* `> li` works for publications because the <li> is written in this file and carries this
       file's scope hash. Desktop keeps the full publications list; mobile displays the top 3. */
    .home-pubs > li:nth-child(n + 4) {
      display: none;
    }
  }

  .home-pubs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-rule);
  }
  .home-posts {
    border-top: 1px solid var(--color-rule);
  }
  .home-tools,
  .home-algos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    border-block: 1px solid var(--color-rule);
    background: var(--color-rule);
  }
  .home-tool,
  .home-algo {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    align-items: flex-start;
    height: 100%;
    padding: var(--space-5);
    background: var(--color-bg);
    color: inherit;
    text-decoration: none;
    transition: background var(--transition);
  }
  .home-tool:hover,
  .home-algo:hover {
    background: var(--color-surface);
  }
  .home-algo-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 0.5rem;
  }
  .home-algo-tag {
    font-size: var(--fs-meta);
    font-weight: 600;
    padding: 0.12rem 0.45rem;
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface));
    color: var(--color-accent-dark);
    border-radius: var(--radius);
  }
  .home-algo-title {
    font-weight: var(--fw-semibold);
    font-size: 1.02rem;
    line-height: 1.35;
    color: var(--color-ink);
  }
  .home-algo:hover .home-algo-title {
    color: var(--color-accent);
  }
  .home-algo-blurb {
    font-size: var(--fs-small);
    color: var(--color-muted);
    line-height: var(--lh-snug);
    flex: 1;
  }
  /* The frame shrinks to each logo's real aspect rather than forcing a square: given
     a square, Astro center-crops the wide wordmarks down to a couple of letters. The
     two `data-shape` buckets (see logoShape above) then keep the shapes optically even. */
  .home-tool-logo {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
    max-width: 100%;
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  /* `:global(html[...])` is required: Astro scopes both halves of a descendant
     selector, so a bare `[data-theme='dark'] .home-tool-logo` compiles to a rule
     that also demands the scope attribute on <html> — and never matches. Without
     this the black-on-transparent wordmarks disappear on the dark page. */
  :global(html[data-theme='dark']) .home-tool-logo {
    background: var(--color-figure-mat);
  }
  .home-tool-logo :global(img) {
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }
  .home-tool-logo[data-shape='wide'] :global(img) {
    height: 1.375rem;
  }
  .home-tool-logo[data-shape='compact'] :global(img) {
    height: 2.125rem;
  }
  .home-tool-text {
    display: grid;
    gap: 0.2rem;
  }
  .home-tool-name {
    font-weight: var(--fw-semibold);
    color: var(--color-accent);
  }
  .home-tool-blurb {
    font-size: var(--fs-small);
    color: var(--color-muted);
    line-height: var(--lh-snug);
  }
  .home-bg {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .bg-label {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: var(--space-4);
  }
  .bg-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .bg-list li {
    display: grid;
    gap: 0.15rem;
  }
  .bg-period {
    font-size: var(--fs-meta);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  .bg-role {
    font-weight: var(--fw-semibold);
  }
  .bg-org {
    font-size: var(--fs-small);
  }
  .home-news {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .cta {
    padding-block: var(--section-y);
    border-top: 1px solid var(--color-rule);
    text-align: center;
  }
  .cta-title {
    font-size: var(--fs-h1);
  }
  .cta-text {
    max-width: 36rem;
    margin: 1rem auto 2rem;
    color: var(--color-muted);
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
  .home-seq {
    margin-block: clamp(2rem, 4.5vw, 3rem);
    padding-block: 0.9rem;
    border-block: 1px solid var(--color-rule);
  }

  @media (min-width: 881px) {
    .home-section,
    .cta {
      padding-block: clamp(2.25rem, 3.25vw, 2.75rem);
    }
    .home-seq {
      margin-block: var(--space-8);
      padding-block: 0.5rem;
    }
  }

  @media (max-width: 1023px) and (min-width: 640px) {
    .home-research {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .home-research :global(.rcard--home) {
      grid-column: span 2;
    }
    .home-research :global(.rcard--home:nth-child(n + 4)) {
      grid-column: span 3;
    }
    .home-news {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 860px) {
    .home-news,
    .home-tools,
    .home-algos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 639px) {
    .home-research,
    .home-bg {
      grid-template-columns: 1fr;
    }
    /* Experience & education was 1,056px -- 1.6 screens -- on a phone: eight entries at 77px each
       plus a 14.4px gap between them. The content is three short lines an entry, so most of that
       height is space between things rather than the things. */
    .bg-list {
      gap: var(--space-3);
    }
    .bg-list li {
      gap: 0.05rem;
    }
    /* Section padding is the other half. At 2.25-2.75rem top AND bottom, twelve sections spend
       roughly a screen and a half on padding alone. */
    .home-section,
    .cta {
      padding-block: clamp(1.5rem, 5vw, 2rem);
    }
    /* Two per row on mobile.
       .home-news uses separate card containers with padding/gap.
       .home-tools and .home-algos keep gap: 1px so the background rule color
       forms the exact same crisp 1px boundary line between cards as on desktop. */
    .home-news {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(0.6rem, 2.5vw, 1rem);
    }
    .home-tools,
    .home-algos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1px;
    }
    .home-tool,
    .home-algo {
      padding: clamp(0.75rem, 3vw, 1.25rem);
      gap: 0.5rem;
    }
    .home-algo-header {
      flex-wrap: wrap;
    }
    .home-tool-name,
    .home-algo-title {
      font-size: 0.95rem;
    }
    .home-research {
      gap: 1px;
    }
    .home-bg {
      gap: var(--space-8);
    }
    .bg-role {
      font-size: 1rem;
    }
    .bg-list {
      gap: 0.9rem;
    }
  }
</style>
