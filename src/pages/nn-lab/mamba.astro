---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Katex from '../../components/Katex.astro';
import 'katex/dist/katex.min.css';
import { site } from '../../data/site';
import { buildBreadcrumbLd } from '../../lib/breadcrumbs';

const title = 'Mamba Studio — Foundational Deep Learning & State Space Model Laboratory';
const description =
  'Interactive Mamba and State Space Model (SSM) laboratory with dual-mode recurrent inference, ' +
  'hardware-aware parallel associative prefix scan tree, dynamic Delta gating meter, ' +
  'X-Ray state space arithmetic inspector, ZOH discretization explorer, and linear memory scaling benchmark.';

const webAppLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'NN Lab — Mamba & State Space Model Studio',
  applicationCategory: 'EducationalApplication, DeveloperApplication, ScienceApplication',
  operatingSystem: 'Web Browser',
  description,
  url: `${site.url}/nn-lab/mamba/`,
  author: { '@id': `${site.url}/#person` },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbLd = buildBreadcrumbLd([
  { name: 'NN Lab', path: '/nn-lab/' },
  { name: 'Mamba Studio', path: '/nn-lab/mamba/' },
]);
---

<BaseLayout title={title} description={description} bare={true}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />

  <main class="nn-page-wrapper" data-mamba-studio id="mamba-studio-root">
    <!-- Top Navigation Bar -->
    <header class="nn-topbar">
      <div class="nn-brand-group">
        <div class="nn-brand-title">
          <span class="nn-pulse-dot" aria-hidden="true"></span>
          <h1>NN LAB 🧠</h1>
        </div>
        <span class="nn-brand-sub">Foundational Deep Learning Laboratory</span>
      </div>

      <!-- Model Studio Navigation Tabs -->
      <nav class="nn-model-nav" aria-label="NN Lab Studios">
        <a
          href="/nn-lab/"
          class="nn-model-link"
          title="Convolutional Neural Network Studio"
        >
          <span class="nn-model-icon" aria-hidden="true">🖼️</span>
          <span>CNN Studio (2D & 1D)</span>
        </a>
        <a
          href="/nn-lab/transformer/"
          class="nn-model-link"
          title="Transformer Attention & Layer Studio"
        >
          <span class="nn-model-icon" aria-hidden="true">✨</span>
          <span>Transformer Studio (Attention & Layer)</span>
        </a>
        <a
          href="/nn-lab/mamba/"
          class="nn-model-link active"
          aria-current="page"
          title="Mamba & State Space Model Studio"
        >
          <span class="nn-model-icon" aria-hidden="true">🐍</span>
          <span>Mamba Studio (SSM & Selective Scan)</span>
        </a>
      </nav>

      <nav class="nn-nav-links" aria-label="Site Navigation">
        <a href="/" class="nn-nav-link" title="Return to Homepage">
          <span aria-hidden="true">←</span> Home
        </a>
        <a href="/shorkie-lab/" class="nn-nav-link" title="Shorkie Lab: Genomic Deep Learning">
          <span aria-hidden="true">🧬</span> Shorkie Lab
        </a>
        <a href="/lab" class="nn-nav-link" title="Cell Lab: Cellular Automata">
          <span aria-hidden="true">🔬</span> Cell Lab
        </a>
        <a href="/deep_dives/" class="nn-nav-link" title="Technical Deep Dives">
          <span aria-hidden="true">📚</span> Deep Dives
        </a>
        <a href="/algorithms/" class="nn-nav-link" title="Interactive Algorithms & Data Structures">
          <span aria-hidden="true">⚡</span> Algorithms
        </a>
      </nav>
    </header>

    <!-- Main Studio Content -->
    <div class="nn-main-content">
      <!-- ==================================================================== -->
      <!-- STUDIO HEADER & EQUATION BANNER                                      -->
      <!-- ==================================================================== -->
      <section class="nn-panel">
        <header class="nn-panel-header">
          <div>
            <h2>Mamba & State Space Model (SSM) Studio</h2>
            <p class="nn-panel-desc">
              Explore the continuous-to-discrete mathematical foundations and hardware-aware mechanics of Mamba (Gu & Dao, 2023).
              Switch between recurrent <Katex tex="O(1)" /> inference and parallel <Katex tex="O(\log T)" /> associative scan,
              observe selective filtering via input-dependent <Katex tex="\Delta_t" /> gating, inspect exact state space arithmetic,
              and benchmark linear memory scaling against quadratic Transformer KV caches.
            </p>
          </div>
          <div class="nn-math-chip">
            <Katex
              tex="h_t = \bar{A}_t h_{t-1} + \bar{B}_t x_t, \quad y_t = C_t h_t + D x_t, \quad \bar{A}_t = \exp(\Delta_t A)"
              display={true}
            />
          </div>
        </header>

        <!-- Mode Switcher Tabs -->
        <div class="nn-tabs-bar">
          <div class="nn-tabs-container" role="tablist" aria-label="Execution Modes">
            <button
              type="button"
              class="nn-mode-tab active"
              data-mamba-mode-tab="recurrent"
              role="tab"
              aria-selected="true"
            >
              <span class="nn-tab-icon" aria-hidden="true">🔄</span>
              <span>Recurrent Inference Mode (<Katex tex="O(1)" /> Step Playback)</span>
            </button>
            <button
              type="button"
              class="nn-mode-tab"
              data-mamba-mode-tab="parallel"
              role="tab"
              aria-selected="false"
            >
              <span class="nn-tab-icon" aria-hidden="true">⚡</span>
              <span>Parallel Scan Mode (<Katex tex="O(\log T)" /> Associative Tree)</span>
            </button>
          </div>
        </div>

        <!-- Presets & Sequence Input Toolbar -->
        <div class="nn-card nn-preset-card">
          <div class="nn-preset-row">
            <span class="nn-preset-title">Domain Presets:</span>
            <div class="nn-preset-buttons">
              <button
                type="button"
                class="nn-preset-btn active"
                data-mamba-preset="nlpFilter"
              >
                <span aria-hidden="true">💬</span> Selective Filtering (NLP)
              </button>
              <button
                type="button"
                class="nn-preset-btn"
                data-mamba-preset="nlpRecall"
              >
                <span aria-hidden="true">🧠</span> Induction Recall (NLP)
              </button>
              <button
                type="button"
                class="nn-preset-btn"
                data-mamba-preset="dnaDistal"
              >
                <span aria-hidden="true">🧬</span> Distal Regulation (Genomics)
              </button>
              <button
                type="button"
                class="nn-preset-btn"
                data-mamba-preset="dnaSplice"
              >
                <span aria-hidden="true">✂️</span> Splice Site GT/AG (Genomics)
              </button>
            </div>
          </div>

          <div class="nn-custom-row">
            <label for="mamba-custom-input" class="nn-preset-title">Custom Sequence:</label>
            <div class="nn-custom-input-group">
              <input
                id="mamba-custom-input"
                type="text"
                class="nn-input"
                data-mamba-custom-input
                placeholder="Type words or DNA tokens separated by spaces..."
                value="The movie was not terrible at all, actually quite fantastic"
              />
            </div>
          </div>

          <div class="nn-token-bar">
            <span class="nn-token-bar-label">Active Sequence Tokens (Click token to jump):</span>
            <div class="nn-token-list" data-mamba-token-list>
              <!-- Populated dynamically by mambaStudio.ts -->
            </div>
          </div>
        </div>
      </section>

      <!-- ==================================================================== -->
      <!-- PANEL 1: RECURRENT INFERENCE MODE                                    -->
      <!-- ==================================================================== -->
      <section class="nn-panel" data-mamba-panel="recurrent">
        <div class="nn-card nn-playback-card">
          <div class="nn-playback-header">
            <div class="nn-step-badge-wrap">
              <span class="nn-badge-dot" aria-hidden="true"></span>
              <span class="nn-step-badge" data-mamba-step-badge>Step 1 of 10: token "The"</span>
            </div>
            <div class="nn-speed-group">
              <label for="mamba-speed-select" class="nn-speed-label">Playback Speed:</label>
              <select id="mamba-speed-select" class="nn-select" data-mamba-speed>
                <option value="1500">Slow (1.5s)</option>
                <option value="1000" selected>Normal (1.0s)</option>
                <option value="500">Fast (0.5s)</option>
                <option value="250">Rapid (0.25s)</option>
              </select>
            </div>
          </div>

          <div class="nn-playback-bar">
            <div class="nn-playback-btns">
              <button
                type="button"
                class="nn-btn nn-btn-primary"
                data-mamba-play
                aria-label="Play recurrence playback"
              >
                ▶ Play
              </button>
              <button
                type="button"
                class="nn-btn"
                data-mamba-prev
                aria-label="Previous step"
              >
                ◀ Prev
              </button>
              <button
                type="button"
                class="nn-btn"
                data-mamba-next
                aria-label="Next step"
              >
                Next ▶
              </button>
              <button
                type="button"
                class="nn-btn"
                data-mamba-reset
                aria-label="Reset to step 0"
              >
                ↺ Reset
              </button>
            </div>
          </div>
        </div>

        <!-- Animated Delta Gate Meter & Latent State Heatmap -->
        <div class="nn-grid-2col">
          <div class="nn-card">
            <h3 class="nn-card-title">
              <span aria-hidden="true">🎚️</span> Dynamic Selection Gate (<Katex tex="\Delta_t" />)
            </h3>
            <p class="nn-card-desc">
              When <Katex tex="\Delta_t" /> is large, the gate latches new input <Katex tex="x_t" /> into state while clearing ancient history (<Katex tex="\bar{A} \to 0" />).
              When small, the gate ignores irrelevant tokens (stopwords/spacers) and retains past latent state indefinitely.
            </p>
            <div class="mamba-meter-wrapper" data-mamba-delta-meter>
              <!-- Rendered dynamically by mambaStudio.ts -->
            </div>
          </div>

          <div class="nn-card">
            <h3 class="nn-card-title">
              <span aria-hidden="true">📊</span> Latent Hidden State Vector (<Katex tex="h_t \in \mathbb{R}^N" />)
            </h3>
            <p class="nn-card-desc">
              State vector evolution across <Katex tex="N = d_{\text{state}}" /> channels. Green indicates positive memory accumulation, red indicates negative inhibition.
            </p>
            <div class="mamba-state-wrapper" data-mamba-state-vector>
              <!-- Rendered dynamically by mambaStudio.ts -->
            </div>
          </div>
        </div>

        <!-- Output Trajectory Track -->
        <div class="nn-card">
          <h3 class="nn-card-title">
            <span aria-hidden="true">📈</span> Projected Output Trajectory (<Katex tex="y_t = C_t h_t + D x_t" />)
          </h3>
          <p class="nn-card-desc">
            The scalar output produced at each sequence step. Click any step column below to jump directly to its execution context.
          </p>
          <div class="mamba-output-wrapper" data-mamba-output-track>
            <!-- Rendered dynamically by mambaStudio.ts -->
          </div>
        </div>

        <!-- X-Ray State Space Arithmetic Inspector -->
        <div class="nn-card" data-mamba-xray>
          <!-- Rendered dynamically by mambaStudio.ts -->
        </div>
      </section>

      <!-- ==================================================================== -->
      <!-- PANEL 2: PARALLEL ASSOCIATIVE SCAN MODE                              -->
      <!-- ==================================================================== -->
      <section class="nn-panel hidden" data-mamba-panel="parallel" hidden style="display: none;">
        <div class="nn-card" data-mamba-assoc-math>
          <!-- Rendered dynamically by mambaStudio.ts -->
        </div>

        <div class="nn-card">
          <h3 class="nn-card-title">
            <span aria-hidden="true">🌲</span> Blelloch Parallel Prefix Scan Tree
          </h3>
          <p class="nn-card-desc">
            Recursive prefix reduction combining associative pairs <Katex tex="(h_j, \bar{A}_j) \circ (h_i, \bar{A}_i)" />.
            On modern GPU streaming multiprocessors, this collapses an <Katex tex="O(T)" /> sequential loop into <Katex tex="O(\log T)" /> parallel steps across fast shared SRAM.
          </p>
          <div class="mamba-tree-wrapper" data-mamba-tree-diagram>
            <!-- Rendered dynamically by mambaStudio.ts -->
          </div>
        </div>
      </section>

      <!-- ==================================================================== -->
      <!-- ZERO-ORDER HOLD (ZOH) DISCRETIZATION EXPLORER                        -->
      <!-- ==================================================================== -->
      <section class="nn-panel">
        <header class="nn-panel-header">
          <div>
            <h3>Zero-Order Hold (ZOH) Discretization Explorer</h3>
            <p class="nn-panel-desc">
              Continuously parameterized state equations are discretized over sample step <Katex tex="\Delta" />.
              Because continuous poles <Katex tex="A_n < 0" />, discrete eigenvalues satisfy <Katex tex="\bar{A}_n = \exp(\Delta A_n) \in (0, 1)" />,
              guaranteeing spectral contraction and numerical stability.
            </p>
          </div>
        </header>

        <div class="nn-card">
          <div class="nn-slider-group">
            <div class="nn-slider-label-row">
              <label for="zoh-delta-slider" class="nn-param-label">
                Discretization Step Size (<Katex tex="\Delta" />):
              </label>
              <span class="nn-param-val" data-mamba-delta-val>0.25</span>
            </div>
            <input
              id="zoh-delta-slider"
              type="range"
              class="nn-slider"
              data-mamba-delta-slider
              min="0.01"
              max="2.0"
              step="0.01"
              value="0.25"
            />
          </div>

          <div class="mamba-matrix-wrapper" data-mamba-a-bar-matrix>
            <!-- Rendered dynamically by mambaStudio.ts -->
          </div>
        </div>
      </section>

      <!-- ==================================================================== -->
      <!-- TRANSFORMER KV CACHE VS MAMBA MEMORY BENCHMARK                       -->
      <!-- ==================================================================== -->
      <section class="nn-panel">
        <header class="nn-panel-header">
          <div>
            <h3>Transformer KV Cache vs Mamba Constant Memory Benchmark</h3>
            <p class="nn-panel-desc">
              During autoregressive inference, Transformers require caching all past Keys and Values, consuming <Katex tex="O(N)" /> memory that explodes with context length.
              Mamba compresses all past context into a fixed-size latent state vector <Katex tex="h_t \in \mathbb{R}^{d_{\text{model}} \times d_{\text{state}}}" />, maintaining strict <Katex tex="O(1)" /> memory consumption.
            </p>
          </div>
        </header>

        <div class="nn-card">
          <div class="nn-slider-group">
            <div class="nn-slider-label-row">
              <label for="mamba-benchmark-slider" class="nn-param-label">
                Sequence Context Length (<Katex tex="N" /> tokens):
              </label>
              <span class="nn-param-val" data-mamba-benchmark-val>32,768 tokens (32k)</span>
            </div>
            <input
              id="mamba-benchmark-slider"
              type="range"
              class="nn-slider"
              data-mamba-benchmark-slider
              min="1024"
              max="131072"
              step="1024"
              value="32768"
            />
          </div>

          <div data-mamba-benchmark-readout>
            <!-- Rendered dynamically by mambaStudio.ts -->
          </div>

          <div class="mamba-chart-wrapper" data-mamba-kv-vs-ssm-chart>
            <!-- Rendered dynamically by mambaStudio.ts -->
          </div>
        </div>
      </section>

      <!-- ==================================================================== -->
      <!-- ARCHITECTURE HYPERPARAMETERS & STAT CARDS                            -->
      <!-- ==================================================================== -->
      <section class="nn-panel">
        <header class="nn-panel-header">
          <div>
            <h3>Architecture Dimensions & Computational Complexity</h3>
            <p class="nn-panel-desc">
              Tune Mamba block hyperparameters to inspect parameter counts, FLOPs per token, and layer memory footprints in real time.
            </p>
          </div>
        </header>

        <div class="nn-card">
          <div class="nn-params-grid">
            <div class="nn-slider-group">
              <div class="nn-slider-label-row">
                <label for="param-d-model" class="nn-param-label">
                  Model Dim (<Katex tex="d_{\text{model}}" />):
                </label>
                <span class="nn-param-val" data-mamba-d-model-val>16</span>
              </div>
              <input
                id="param-d-model"
                type="range"
                class="nn-slider"
                data-mamba-d-model
                min="4"
                max="64"
                step="4"
                value="16"
              />
            </div>

            <div class="nn-slider-group">
              <div class="nn-slider-label-row">
                <label for="param-d-state" class="nn-param-label">
                  SSM State Dim (<Katex tex="d_{\text{state}}" />):
                </label>
                <span class="nn-param-val" data-mamba-d-state-val>8</span>
              </div>
              <input
                id="param-d-state"
                type="range"
                class="nn-slider"
                data-mamba-d-state
                min="2"
                max="32"
                step="2"
                value="8"
              />
            </div>

            <div class="nn-slider-group">
              <div class="nn-slider-label-row">
                <label for="param-d-conv" class="nn-param-label">
                  Conv Width (<Katex tex="d_{\text{conv}}" />):
                </label>
                <span class="nn-param-val" data-mamba-d-conv-val>4</span>
              </div>
              <input
                id="param-d-conv"
                type="range"
                class="nn-slider"
                data-mamba-d-conv
                min="1"
                max="8"
                step="1"
                value="4"
              />
            </div>

            <div class="nn-slider-group">
              <div class="nn-slider-label-row">
                <label for="param-expand" class="nn-param-label">
                  Expansion Factor (<Katex tex="E" />):
                </label>
                <span class="nn-param-val" data-mamba-expand-val>2</span>
              </div>
              <input
                id="param-expand"
                type="range"
                class="nn-slider"
                data-mamba-expand
                min="1"
                max="4"
                step="1"
                value="2"
              />
            </div>
          </div>

          <!-- Live Stats Row -->
          <div class="nn-stats-row">
            <div class="nn-stat-card">
              <span class="nn-stat-label">Model Parameters (24 Layers)</span>
              <span class="nn-stat-val" data-mamba-params-total>--</span>
              <span class="nn-stat-sub">Linear scaling with <Katex tex="d_{\text{model}}" /></span>
            </div>
            <div class="nn-stat-card">
              <span class="nn-stat-label">Computational FLOPs</span>
              <span class="nn-stat-val" data-mamba-flops-total>--</span>
              <span class="nn-stat-sub"><Katex tex="O(T)" /> linear sequence FLOPs</span>
            </div>
            <div class="nn-stat-card">
              <span class="nn-stat-label">Recurrent State Memory</span>
              <span class="nn-stat-val" data-mamba-memory-total>--</span>
              <span class="nn-stat-sub"><Katex tex="O(1)" /> constant inference memory</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ==================================================================== -->
      <!-- LIVE PYTORCH CODE GENERATOR                                          -->
      <!-- ==================================================================== -->
      <section class="nn-panel">
        <header class="nn-panel-header">
          <div>
            <h3>Production PyTorch Implementation</h3>
            <p class="nn-panel-desc">
              Drop-in PyTorch module matching your exact active configuration with input-dependent projection heads, 1D causal convolution, and discretized recurrence.
            </p>
          </div>
          <button
            type="button"
            class="nn-btn nn-btn-primary"
            data-mamba-copy-pytorch
            data-original-text="Copy PyTorch Code"
          >
            Copy PyTorch Code
          </button>
        </header>

        <div class="nn-code-box">
          <pre><code class="language-python" data-mamba-pytorch-code># Generating PyTorch snippet...</code></pre>
        </div>
      </section>

      <!-- ==================================================================== -->
      <!-- EDUCATIONAL DEEP-DIVE ACCORDIONS (4 CARDS)                           -->
      <!-- ==================================================================== -->
      <section class="nn-panel">
        <header class="nn-panel-header">
          <div>
            <h3>Mathematical Foundations & Hardware Engineering</h3>
            <p class="nn-panel-desc">
              Rigorous mathematical proofs, continuous ODE derivations, and hardware acceleration principles behind modern State Space Models.
            </p>
          </div>
        </header>

        <div class="nn-accordions-group">
          <!-- Card 1: The HiPPO Matrix & Optimal Polynomial Memory -->
          <details class="nn-accordion" open>
            <summary class="nn-accordion-trigger">
              <span class="nn-accordion-title">
                <span class="nn-acc-icon">🏛️</span>
                The HiPPO Matrix & Optimal Polynomial Memory
              </span>
              <span class="nn-accordion-chevron" aria-hidden="true">▾</span>
            </summary>
            <div class="nn-accordion-content">
              <p>
                Recurrent neural networks (RNNs) historically suffered from either vanishing gradients (fading ancient memory) or exploding gradients.
                The <strong>HiPPO</strong> (High-order Polynomial Projection Operators; Gu et al., NeurIPS 2020) framework solved this fundamental challenge
                by casting online memory as optimal continuous function approximation.
              </p>

              <h4>1. Continuous History Projection onto Legendre Polynomials</h4>
              <p>
                Consider a continuous 1D input signal <Katex tex="u(t)" /> observed up to current time <Katex tex="t" />. We seek to maintain a degree-<Katex tex="N" /> polynomial
                approximation <Katex tex="g^{(t)}(\tau)" /> of the history <Katex tex="u(\tau)" /> for <Katex tex="\tau \in [0, t]" /> with respect to a time-varying probability measure <Katex tex="\mu^{(t)}(\tau) = \frac{1}{t} \mathbb{I}_{[0, t]}(\tau)" />:
              </p>
              <div class="nn-equation-box">
                <Katex
                  tex="g^{(t)} = \arg\min_{g \in \mathcal{P}_N} \int_0^t \left( u(\tau) - g(\tau) \right)^2 \frac{1}{t} \, d\tau"
                  display={true}
                />
              </div>
              <p>
                Expressing <Katex tex="g^{(t)}" /> in the orthogonal basis of shifted Legendre polynomials <Katex tex="\{P_n\}_{n=0}^{N-1}" />, the projection coefficients
                <Katex tex="c(t) \in \mathbb{R}^N" /> satisfy a differential equation that guarantees optimal online coefficient updates without storing past values:
              </p>
              <div class="nn-equation-box">
                <Katex
                  tex="\frac{d}{dt} c(t) = -\frac{1}{t} A_{\text{HiPPO}} \, c(t) + \frac{1}{t} B_{\text{HiPPO}} \, u(t)"
                  display={true}
                />
              </div>

              <h4>2. Canonical HiPPO Transition Matrix</h4>
              <p>
                Converting this time-varying system into a time-invariant state-space representation yields the canonical continuous HiPPO-LegS matrix:
              </p>
              <div class="nn-equation-box">
                <Katex
                  tex="A_{nk} = -\begin{cases} \sqrt{2n+1}\sqrt{2k+1} & \text{if } n > k \\ n+1 & \text{if } n = k \\ 0 & \text{if } n < k \end{cases}, \qquad B_n = \sqrt{2n+1}"
                  display={true}
                />
              </div>
              <p>
                <strong>Why this prevents memory fading:</strong> Standard RNN transition matrices <Katex tex="W_h" /> compress history through repeated unconstrained matrix multiplications,
                causing geometric decay <Katex tex="\sim \lambda^t" />. In contrast, HiPPO projects continuous history onto orthogonal Legendre bases,
                ensuring that ancient signals retain non-zero projection coefficients over unbounded sequence horizons. In Mamba, the continuous transition matrix is initialized via structured diagonal decomposition with negative real poles (<Katex tex="A_n = -n - 1" />) derived from the HiPPO spectrum.
              </p>
            </div>
          </details>

          <!-- Card 2: Zero-Order Hold (ZOH) Discretization & Spectral Stability -->
          <details class="nn-accordion">
            <summary class="nn-accordion-trigger">
              <span class="nn-accordion-title">
                <span class="nn-acc-icon">⚙️</span>
                Zero-Order Hold (ZOH) Discretization & Spectral Stability
              </span>
              <span class="nn-accordion-chevron" aria-hidden="true">▾</span>
            </summary>
            <div class="nn-accordion-content">
              <p>
                State Space Models describe continuous dynamical systems governed by ordinary differential equations (ODEs):
              </p>
              <div class="nn-equation-box">
                <Katex
                  tex="\dot{h}(t) = A h(t) + B x(t), \qquad y(t) = C h(t) + D x(t)"
                  display={true}
                />
              </div>
              <p>
                Digital computing architectures operate on discrete sequences <Katex tex="\{x_0, x_1, \dots, x_{T-1}\}" /> sampled at intervals parameterized by step size <Katex tex="\Delta" />.
                The <strong>Zero-Order Hold (ZOH)</strong> assumption postulates that the input <Katex tex="x(t)" /> remains piecewise-constant over each sampling interval <Katex tex="[t\Delta, (t+1)\Delta)" />.
              </p>

              <h4>1. Derivation of the Discrete Transition Matrices</h4>
              <p>
                Solving the linear continuous ODE over <Katex tex="\tau \in [0, \Delta]" /> using the matrix exponential integrating factor:
              </p>
              <div class="nn-equation-box">
                <Katex
                  tex="h(t+\Delta) = \exp(\Delta A) h(t) + \int_0^\Delta \exp((\Delta - \tau) A) B x(t) \, d\tau"
                  display={true}
                />
              </div>
              <p>
                Because <Katex tex="x(t)" /> is constant over the interval, we factor it out of the integral:
              </p>
              <div class="nn-equation-box">
                <Katex
                  tex="\int_0^\Delta \exp((\Delta - \tau) A) B \, d\tau = (\Delta A)^{-1} (\exp(\Delta A) - I) \cdot (\Delta B)"
                  display={true}
                />
              </div>
              <p>
                Defining discrete transition matrices <Katex tex="\bar{A}" /> and <Katex tex="\bar{B}" />:
              </p>
              <div class="nn-equation-box">
                <Katex
                  tex="\bar{A} = \exp(\Delta A), \qquad \bar{B} = (\Delta A)^{-1} (\bar{A} - I) \cdot (\Delta B)"
                  display={true}
                />
              </div>
              <p>
                For diagonal <Katex tex="A = \text{diag}(a_1, \dots, a_N)" />, each dimension evaluates independently as:
              </p>
              <div class="nn-equation-box">
                <Katex
                  tex="\bar{A}_{nn} = \exp(\Delta a_n), \qquad \bar{B}_{nn} = \frac{\exp(\Delta a_n) - 1}{a_n} \cdot B_n"
                  display={true}
                />
              </div>

              <h4>2. Proof of Spectral Stability & Contraction Mapping</h4>
              <p>
                Let <Katex tex="\lambda_i(A)" /> denote the continuous eigenvalues of <Katex tex="A" />. By HiPPO construction, continuous poles lie strictly in the open left half-plane:
                <Katex tex="\text{Re}(\lambda_i(A)) < 0" />.
              </p>
              <p>
                Under the exponential mapping, the eigenvalues of discrete operator <Katex tex="\bar{A}" /> are:
              </p>
              <div class="nn-equation-box">
                <Katex
                  tex="|\lambda_i(\bar{A})| = |\exp(\Delta \lambda_i(A))| = \exp(\Delta \cdot \text{Re}(\lambda_i(A))) < \exp(0) = 1 \quad \forall \Delta > 0"
                  display={true}
                />
              </div>
              <p>
                Because all discrete eigenvalues have magnitude strictly less than 1, <Katex tex="\bar{A}" /> is a strict contraction mapping on <Katex tex="\mathbb{R}^N" />.
                Consequently, the latent state remains strictly bounded for arbitrarily long sequence lengths (<Katex tex="\|h_t\| < \infty" /> as <Katex tex="t \to \infty" />),
                preventing gradient explosions during training and unbounded state drift during autoregressive inference.
              </p>
            </div>
          </details>

          <!-- Card 3: Hardware-Aware Parallel Associative Scan vs Attention -->
          <details class="nn-accordion">
            <summary class="nn-accordion-trigger">
              <span class="nn-accordion-title">
                <span class="nn-acc-icon">🚀</span>
                Hardware-Aware Parallel Associative Scan vs Attention
              </span>
              <span class="nn-accordion-chevron" aria-hidden="true">▾</span>
            </summary>
            <div class="nn-accordion-content">
              <p>
                While Transformers revolutionized deep learning by parallelizing training over time, their quadratic attention matrix <Katex tex="O(T^2)" /> creates severe memory and computational bottlenecks for long sequences.
                Conversely, standard RNNs have linear complexity <Katex tex="O(T)" /> but failed because sequential recurrent steps cannot parallelize across modern GPU architectures.
              </p>

              <h4>1. The Modern GPU Memory Hierarchy Dilemma</h4>
              <p>
                Modern accelerators (e.g. Nvidia H100 SXM) have two primary memory tiers:
              </p>
              <ul>
                <li><strong>High-Bandwidth Memory (HBM):</strong> Massive capacity (80–96 GB) but comparatively limited bandwidth (~3.35 TB/s).</li>
                <li><strong>On-Chip Static RAM (SRAM):</strong> Ultra-fast bandwidth (~33 TB/s, <Katex tex="10\times" /> faster) but minimal capacity (~228 KB per SM, ~50 MB total).</li>
              </ul>
              <p>
                Standard RNNs require reading and writing state vectors <Katex tex="h_t" /> between HBM and SRAM at every sequential token step <Katex tex="t" />.
                The arithmetic intensity is negligible (<Katex tex="< 1" /> FLOP/byte), stalling tensor execution units while waiting on HBM memory transfers.
              </p>

              <h4>2. The Associative Property of Linear Recurrence</h4>
              <p>
                Mamba makes the critical realization that linear state space recurrence is an <strong>associative operator</strong>.
                Consider adjacent state transitions:
              </p>
              <div class="nn-equation-box">
                <Katex
                  tex="h_t = \bar{A}_t h_{t-1} + \bar{B}_t x_t = \bar{A}_t (\bar{A}_{t-1} h_{t-2} + \bar{B}_{t-1} x_{t-1}) + \bar{B}_t x_t = (\bar{A}_t \bar{A}_{t-1}) h_{t-2} + (\bar{A}_t \bar{B}_{t-1} x_{t-1} + \bar{B}_t x_t)"
                  display={true}
                />
              </div>
              <p>
                Defining the binary tuple operator <Katex tex="\circ" /> on elements <Katex tex="(p_i, q_i) = (\bar{A}_i, \bar{B}_i x_i)" />:
              </p>
              <div class="nn-equation-box">
                <Katex
                  tex="(a_j, b_j) \circ (a_i, b_i) = (a_j a_i, \, a_j b_i + b_j)"
                  display={true}
                />
              </div>
              <p>
                Because matrix multiplication and addition are associative, <Katex tex="((a \circ b) \circ c) = (a \circ (b \circ c))" />.
                This enables computing the entire sequence recurrence using the <strong>Blelloch Parallel Prefix Scan</strong> in <Katex tex="O(\log T)" /> parallel time steps across GPU threads.
              </p>

              <h4>3. Kernel Fusion in On-Chip SRAM</h4>
              <p>
                Mamba implements an optimized Triton/CUDA kernel that fuses discretization, causal 1D convolution, and parallel scan directly in on-chip SRAM:
              </p>
              <div class="nn-callout-text">
                <strong>Memory-Bandwidth Optimization:</strong>
                Input parameters <Katex tex="x, \Delta, B, C" /> are loaded once from HBM into SRAM.
                Discretization <Katex tex="\bar{A}_t = \exp(\Delta_t A)" /> and the parallel scan are executed entirely in SRAM and registers.
                Intermediate hidden states <Katex tex="h_t \in \mathbb{R}^{B \times L \times D \times N}" /> are never written to HBM; only final outputs <Katex tex="y \in \mathbb{R}^{B \times L \times D}" /> are written back,
                reducing HBM memory traffic by over <Katex tex="10\times" />.
              </div>
            </div>
          </details>

          <!-- Card 4: Mamba-2 & State Space Duality (SSD) -->
          <details class="nn-accordion">
            <summary class="nn-accordion-trigger">
              <span class="nn-accordion-title">
                <span class="nn-acc-icon">🔮</span>
                Mamba-2 & State Space Duality (SSD)
              </span>
              <span class="nn-accordion-chevron" aria-hidden="true">▾</span>
            </summary>
            <div class="nn-accordion-content">
              <p>
                In <em>Transformers are SSMs: Generalized Models and Efficient Algorithms Through Structured State Space Duality</em> (Dao & Gu, 2024),
                the authors establish an exact theoretical equivalence between linear attention and structured state space models.
              </p>

              <h4>1. The 1-Semiseparable Matrix Connection</h4>
              <p>
                Unrolling an unforced SSM over sequence length <Katex tex="T" /> reveals that the transformation from input sequence <Katex tex="X \in \mathbb{R}^{T \times 1}" /> to output sequence <Katex tex="Y \in \mathbb{R}^{T \times 1}" /> can be expressed as multiplication by a lower-triangular structured matrix <Katex tex="M \in \mathbb{R}^{T \times T}" />:
              </p>
              <div class="nn-equation-box">
                <Katex
                  tex="M_{ij} = \begin{cases} C_i^T \left( \prod_{k=j+1}^i \bar{A}_k \right) \bar{B}_j & \text{if } i > j \\ C_i^T \bar{B}_i & \text{if } i = j \\ 0 & \text{if } i < j \end{cases}"
                  display={true}
                />
              </div>
              <p>
                This matrix is <strong>1-semiseparable</strong>: every submatrix below the main diagonal has rank at most 1 (or rank <Katex tex="N" /> in multi-channel SSMs).
                Linear attention computes a special case of this transformation where <Katex tex="\bar{A}_k = I" /> (no decay):
              </p>
              <div class="nn-equation-box">
                <Katex
                  tex="Y = \text{tril}(Q K^T) V"
                  display={true}
                />
              </div>

              <h4>2. Bridging Tensor Cores and Recurrence</h4>
              <p>
                In Mamba-1, general diagonal <Katex tex="A" /> required custom associative scan kernels that underutilized GPU Tensor Cores (specialized matrix multiply units).
                Mamba-2 restricts <Katex tex="A" /> to scalar-times-identity structure (<Katex tex="A = \alpha I" />). This enables decomposing the semiseparable matrix into <strong>block matrix multiplications</strong>:
              </p>
              <ul>
                <li><strong>Intra-chunk computation (e.g. 64 tokens):</strong> Evaluated using dense matrix multiplications (<Katex tex="Q K^T V" /> style) on Tensor Cores with peak compute efficiency.</li>
                <li><strong>Inter-chunk computation:</strong> Carried across chunk boundaries via recurrent state propagation in linear time.</li>
              </ul>
              <p>
                <strong>The Result:</strong> Mamba-2 matches the expressive capacity of selective SSMs while training up to <Katex tex="8\times" /> faster than Mamba-1 by computing the core recurrence directly on Tensor Cores, unifying Attention and SSM architectures into a single foundational framework.
              </p>
            </div>
          </details>
        </div>
      </section>
