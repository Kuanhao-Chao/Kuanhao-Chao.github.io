    border: 1px solid var(--color-rule, #e5e4df);
    background-color: var(--color-surface, #ffffff);
    color: var(--color-ink, #141414);
    cursor: pointer;
    transition: all 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nn-btn:hover {
    border-color: #10b981;
    color: #059669;
  }

  .nn-btn-primary {
    background-color: #10b981;
    color: #ffffff;
    border-color: #10b981;
  }

  .nn-btn-primary:hover {
    background-color: #059669;
    border-color: #059669;
    color: #ffffff;
  }

  /* 2-Column Grid Layout */
  .nn-grid-2col {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 900px) {
    .nn-grid-2col {
      grid-template-columns: 1fr;
    }
  }

  /* -------------------------------------------------------------------------- */
  /* Delta Gate Meter Styles (Rendered by Controller)                           */
  /* -------------------------------------------------------------------------- */
  :global(.mamba-delta-meter-inner) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.5rem 0;
  }

  :global(.meter-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  :global(.meter-label) {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-ink, #141414);
  }

  :global(.meter-val) {
    font-family: var(--font-mono, monospace);
    font-size: 1.15rem;
    font-weight: 800;
    color: #10b981;
  }

  :global(.meter-badge) {
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  :global(.badge-latch) {
    background-color: rgba(16, 185, 129, 0.15);
    color: #059669;
    border: 1px solid rgba(16, 185, 129, 0.4);
  }

  :global(.badge-filter) {
    background-color: rgba(59, 130, 246, 0.12);
    color: #2563eb;
    border: 1px solid rgba(59, 130, 246, 0.35);
  }

  :global(.meter-track) {
    height: 14px;
    border-radius: 7px;
    background-color: var(--color-bg, #fafaf8);
    border: 1px solid var(--color-rule, #e5e4df);
    overflow: hidden;
    position: relative;
  }

  :global(.meter-bar) {
    height: 100%;
    background: linear-gradient(90deg, #3b82f6 0%, #10b981 60%, #f59e0b 100%);
    border-radius: 7px;
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.meter-meta) {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    color: var(--color-muted, #6b6b6b);
    font-family: var(--font-mono, monospace);
  }

  /* -------------------------------------------------------------------------- */
  /* State Vector Heatmap                                                       */
  /* -------------------------------------------------------------------------- */
  :global(.mamba-state-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: 0.5rem;
    padding: 0.5rem 0;
  }

  :global(.state-cell) {
    border: 1px solid var(--color-rule, #e5e4df);
    border-radius: 6px;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    background-color: var(--color-bg, #fafaf8);
    position: relative;
    overflow: hidden;
  }

  :global(.state-cell.positive) {
    border-color: rgba(16, 185, 129, 0.4);
    background-color: rgba(16, 185, 129, 0.08);
  }

  :global(.state-cell.negative) {
    border-color: rgba(239, 68, 68, 0.4);
    background-color: rgba(239, 68, 68, 0.08);
  }

  :global(.cell-label) {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    color: var(--color-muted, #6b6b6b);
  }

  :global(.cell-val) {
    font-family: var(--font-mono, monospace);
    font-size: 0.88rem;
    font-weight: 700;
  }

  :global(.state-cell.positive .cell-val) {
    color: #059669;
  }

  :global(.state-cell.negative .cell-val) {
    color: #dc2626;
  }

  :global(.cell-bar) {
    height: 3px;
    border-radius: 2px;
    transition: width 0.3s ease;
  }

  :global(.state-cell.positive .cell-bar) {
    background-color: #10b981;
  }

  :global(.state-cell.negative .cell-bar) {
    background-color: #ef4444;
  }

  /* -------------------------------------------------------------------------- */
  /* Output Track Styles                                                        */
  /* -------------------------------------------------------------------------- */
  :global(.output-track-scroll) {
    display: flex;
    gap: 0.6rem;
    overflow-x: auto;
    padding: 0.5rem 0.2rem;
    -webkit-overflow-scrolling: touch;
  }

  :global(.output-track-step) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    padding: 0.6rem 0.8rem;
    border-radius: 8px;
    border: 1px solid var(--color-rule, #e5e4df);
    background-color: var(--color-bg, #fafaf8);
    cursor: pointer;
    min-width: 90px;
    flex-shrink: 0;
    transition: all 0.15s ease;
  }

  :global(.output-track-step:hover) {
    border-color: #10b981;
    background-color: var(--color-surface, #ffffff);
  }

  :global(.output-track-step.active) {
    border-color: #10b981;
    background-color: rgba(16, 185, 129, 0.1);
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);
    transform: translateY(-2px);
  }

  :global(.track-token) {
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--color-ink, #141414);
  }

  :global(.track-y) {
    font-family: var(--font-mono, monospace);
    font-size: 0.78rem;
    color: #059669;
    font-weight: 600;
  }

  :global(.track-delta) {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    color: var(--color-muted, #6b6b6b);
  }

  /* -------------------------------------------------------------------------- */
  /* X-Ray Inspector Styles                                                     */
  /* -------------------------------------------------------------------------- */
  :global(.xray-container) {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  :global(.xray-header) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-rule, #e5e4df);
  }

  :global(.xray-header h4) {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-ink, #141414);
  }

  :global(.xray-pill) {
    font-family: var(--font-mono, monospace);
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    background-color: var(--color-bg, #fafaf8);
    border: 1px solid var(--color-rule, #e5e4df);
  }

  :global(.xray-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  :global(.xray-card) {
    border: 1px solid var(--color-rule, #e5e4df);
    border-radius: 8px;
    padding: 0.85rem;
    background-color: var(--color-bg, #fafaf8);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  :global(.xray-card h5) {
    margin: 0 0 0.35rem;
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--color-ink, #141414);
    border-bottom: 1px solid var(--color-rule, #e5e4df);
    padding-bottom: 0.35rem;
  }

  :global(.xray-item) {
    font-family: var(--font-mono, monospace);
    font-size: 0.76rem;
    line-height: 1.45;
    word-break: break-all;
    color: var(--color-ink, #141414);
  }

  :global(.xray-item .lbl) {
    color: var(--color-muted, #6b6b6b);
    font-weight: 600;
    margin-right: 0.25rem;
  }

  /* -------------------------------------------------------------------------- */
  /* Parallel Scan Tree & Associative Math                                      */
  /* -------------------------------------------------------------------------- */
  :global(.assoc-math-box) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  :global(.assoc-math-box h4) {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
  }

  :global(.assoc-formula) {
    padding: 0.85rem 1rem;
    border-radius: 8px;
    background-color: var(--color-bg, #fafaf8);
    border: 1px solid var(--color-rule, #e5e4df);
    overflow-x: auto;
  }

  :global(.assoc-formula code) {
    font-family: var(--font-mono, monospace);
    font-size: 0.92rem;
    font-weight: 700;
    color: #059669;
  }

  :global(.assoc-desc) {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-muted, #6b6b6b);
  }

  :global(.parallel-tree-container) {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 0.5rem 0;
    overflow-x: auto;
  }

  :global(.tree-level-row) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.85rem;
    border-radius: 8px;
    background-color: var(--color-bg, #fafaf8);
    border: 1px solid var(--color-rule, #e5e4df);
  }

  :global(.tree-level-label) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-muted, #6b6b6b);
  }

  :global(.tree-nodes-row) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  :global(.tree-node) {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    border: 1px solid var(--color-rule, #e5e4df);
    background-color: var(--color-surface, #ffffff);
    font-family: var(--font-mono, monospace);
    font-size: 0.76rem;
    min-width: 80px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
  }

  :global(.tree-node.node-combined) {
    border-color: #10b981;
    background-color: rgba(16, 185, 129, 0.06);
  }

  :global(.node-span) {
    font-weight: 700;
    color: var(--color-ink, #141414);
  }

  :global(.node-idx) {
    color: var(--color-muted, #6b6b6b);
  }

  :global(.node-val) {
    color: #059669;
    font-weight: 600;
  }

  /* -------------------------------------------------------------------------- */
  /* ZOH Matrix Explorer Styles                                                 */
  /* -------------------------------------------------------------------------- */
  :global(.a-bar-matrix-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.85rem;
    margin-top: 1rem;
  }

  :global(.a-bar-card) {
    border: 1px solid var(--color-rule, #e5e4df);
    border-radius: 8px;
    padding: 0.85rem;
    background-color: var(--color-bg, #fafaf8);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  :global(.a-bar-title) {
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--color-ink, #141414);
  }

  :global(.a-bar-continuous),
  :global(.a-bar-discrete) {
    font-family: var(--font-mono, monospace);
    font-size: 0.76rem;
    color: var(--color-muted, #6b6b6b);
  }

  :global(.a-bar-discrete) {
    color: #059669;
    font-weight: 700;
  }

  :global(.a-bar-progress) {
    height: 8px;
    border-radius: 4px;
    background-color: var(--color-rule, #e5e4df);
    overflow: hidden;
    margin: 0.25rem 0;
  }

  :global(.a-bar-fill) {
    height: 100%;
    background-color: #10b981;
    border-radius: 4px;
    transition: width 0.2s ease;
  }

  :global(.a-bar-meta) {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    font-family: var(--font-mono, monospace);
    color: var(--color-muted, #6b6b6b);
  }

  /* -------------------------------------------------------------------------- */
  /* Benchmark Readout & Chart Styles                                           */
  /* -------------------------------------------------------------------------- */
  :global(.benchmark-readout-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin: 1.25rem 0 1rem;
  }

  :global(.bench-stat) {
    padding: 1rem;
    border-radius: 8px;
    border: 1px solid var(--color-rule, #e5e4df);
    background-color: var(--color-bg, #fafaf8);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  :global(.bench-stat.ssm) {
    border-color: rgba(16, 185, 129, 0.4);
    background-color: rgba(16, 185, 129, 0.05);
  }

  :global(.bench-stat.transformer) {
    border-color: rgba(59, 130, 246, 0.4);
    background-color: rgba(59, 130, 246, 0.05);
  }

  :global(.bench-stat.advantage) {
    border-color: rgba(245, 158, 11, 0.4);
    background-color: rgba(245, 158, 11, 0.05);
  }

  :global(.bench-lbl) {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-muted, #6b6b6b);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  :global(.bench-val) {
    font-family: var(--font-mono, monospace);
    font-size: 1.35rem;
    font-weight: 800;
  }

  :global(.bench-stat.ssm .bench-val) {
    color: #059669;
  }

  :global(.bench-stat.transformer .bench-val) {
    color: #2563eb;
  }

  :global(.bench-stat.advantage .bench-val) {
    color: #d97706;
  }

  :global(.bench-badge) {
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--color-muted, #6b6b6b);
  }

  :global(.bench-chart-container) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 0.5rem;
  }

  :global(.bench-bar-group) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  :global(.bench-bar-label) {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-ink, #141414);
    font-family: var(--font-mono, monospace);
  }

  :global(.bench-track) {
    height: 12px;
    border-radius: 6px;
    background-color: var(--color-bg, #fafaf8);
    border: 1px solid var(--color-rule, #e5e4df);
    overflow: hidden;
  }

  :global(.bench-fill) {
    height: 100%;
    border-radius: 6px;
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.ssm-fill) {
    background-color: #10b981;
  }

  :global(.kv-fill) {
    background-color: #3b82f6;
  }

  /* -------------------------------------------------------------------------- */
  /* Hyperparameters & Stat Cards                                              */
  /* -------------------------------------------------------------------------- */
  .nn-params-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .nn-slider-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .nn-slider-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nn-param-label {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--color-ink, #141414);
  }

  .nn-param-val {
    font-family: var(--font-mono, monospace);
    font-size: 0.86rem;
    font-weight: 700;
    color: #10b981;
  }

  .nn-slider {
    width: 100%;
    accent-color: #10b981;
    cursor: pointer;
  }

  .nn-stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-rule, #e5e4df);
  }

  .nn-stat-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.85rem;
    border-radius: 8px;
    background-color: var(--color-bg, #fafaf8);
    border: 1px solid var(--color-rule, #e5e4df);
  }

  .nn-stat-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-muted, #6b6b6b);
  }

  .nn-stat-val {
    font-family: var(--font-mono, monospace);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-ink, #141414);
  }

  .nn-stat-sub {
    font-size: 0.76rem;
    color: var(--color-muted, #6b6b6b);
  }

  /* -------------------------------------------------------------------------- */
  /* PyTorch Code Box                                                           */
  /* -------------------------------------------------------------------------- */
  .nn-code-box {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 10px;
    padding: 1.25rem;
    overflow-x: auto;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.4);
  }

  .nn-code-box pre {
    margin: 0;
  }

  .nn-code-box code {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.85rem;
    line-height: 1.6;
    color: #e2e8f0;
    display: block;
    white-space: pre;
  }

  /* -------------------------------------------------------------------------- */
  /* Educational Accordions                                                     */
  /* -------------------------------------------------------------------------- */
  .nn-accordions-group {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .nn-accordion {
    border: 1px solid var(--color-rule, #e5e4df);
    border-radius: 8px;
    background-color: var(--color-surface, #ffffff);
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .nn-accordion:hover {
    border-color: rgba(16, 185, 129, 0.4);
  }

  .nn-accordion-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    gap: 1rem;
    box-sizing: border-box;
    list-style: none;
  }

  .nn-accordion-trigger::-webkit-details-marker {
    display: none;
  }

  .nn-accordion-title {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--color-ink, #141414);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .nn-acc-icon {
    font-size: 1.1rem;
  }

  .nn-accordion-chevron {
    font-size: 0.85rem;
    color: var(--color-muted, #6b6b6b);
    transition: transform 0.2s ease;
  }

  .nn-accordion[open] .nn-accordion-chevron {
    transform: rotate(180deg);
  }

  .nn-accordion-content {
    padding: 1.25rem;
    border-top: 1px solid var(--color-rule, #e5e4df);
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-ink, #141414);
  }

  .nn-accordion-content h4 {
    margin: 1.25rem 0 0.5rem;
    font-size: 0.96rem;
    font-weight: 700;
  }

  .nn-accordion-content ul {
    margin: 0.5rem 0 1rem;
    padding-left: 1.5rem;
  }

  .nn-accordion-content li {
    margin-bottom: 0.35rem;
  }

  .nn-equation-box {
    margin: 1rem 0;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    background-color: var(--color-bg, #fafaf8);
    border: 1px solid var(--color-rule, #e5e4df);
    overflow-x: auto;
    box-sizing: border-box;
  }

  .nn-callout-text {
    padding: 0.75rem 1rem;
    border-left: 3px solid #10b981;
    background-color: rgba(16, 185, 129, 0.08);
    border-radius: 4px;
    margin: 1rem 0 0.5rem;
  }

  /* -------------------------------------------------------------------------- */
  /* Dark Theme Support                                                         */
  /* -------------------------------------------------------------------------- */
  :root[data-theme='dark'] .nn-page-wrapper {
    background-color: #0b0f19;
    color: #f1f5f9;
  }

  :root[data-theme='dark'] .nn-topbar,
  :root[data-theme='dark'] .nn-card,
  :root[data-theme='dark'] .nn-tabs-container,
  :root[data-theme='dark'] .nn-math-chip,
  :root[data-theme='dark'] .nn-accordion {
    background-color: #111827;
    border-color: #1f2937;
  }

  :root[data-theme='dark'] .nn-brand-title h1,
  :root[data-theme='dark'] .nn-panel-header h2,
  :root[data-theme='dark'] .nn-panel-header h3,
  :root[data-theme='dark'] .nn-card-title,
  :root[data-theme='dark'] .nn-preset-title,
  :root[data-theme='dark'] .nn-step-badge,
  :root[data-theme='dark'] .nn-param-label,
  :root[data-theme='dark'] .nn-accordion-title,
  :root[data-theme='dark'] .nn-accordion-content {
    color: #f3f4f6;
  }

  :root[data-theme='dark'] .nn-panel-desc,
  :root[data-theme='dark'] .nn-card-desc,
  :root[data-theme='dark'] .nn-token-bar-label,
  :root[data-theme='dark'] .nn-speed-label,
  :root[data-theme='dark'] .nn-stat-sub,
  :root[data-theme='dark'] :global(.assoc-desc) {
    color: #9ca3af;
  }

  :root[data-theme='dark'] .nn-model-nav,
  :root[data-theme='dark'] .nn-nav-link,
  :root[data-theme='dark'] .nn-preset-btn,
