---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Katex from '../../components/Katex.astro';
import 'katex/dist/katex.min.css';
import { site } from '../../data/site';
import { buildBreadcrumbLd } from '../../lib/breadcrumbs';

const title = 'NN Lab — Foundational Deep Learning & Convolution Laboratory';
const description =
  'Interactive convolutional neural network studio with real-time 2D spatial convolution visualizer, ' +
  'X-Ray dot product breakdown, 1D biological sequence motif scanner, FLOPs/MACs calculator, ' +
  'receptive field expansion ladder, and live PyTorch generator.';

const webAppLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'NN Lab — Convolutional Neural Network Studio',
  applicationCategory: 'EducationalApplication, DeveloperApplication, ScienceApplication',
  operatingSystem: 'Web Browser',
  description,
  url: `${site.url}/nn-lab/`,
  author: { '@id': `${site.url}/#person` },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbLd = buildBreadcrumbLd([
  { name: 'NN Lab', path: '/nn-lab/' },
]);
---

<BaseLayout title={title} description={description} bare={true}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />

  <div class="nn-page-wrapper" data-cnn-studio id="cnn-studio-root">
    <!-- Top Navigation Bar -->
    <header class="nn-topbar">
      <div class="nn-brand-group">
        <div class="nn-brand-title">
          <span class="nn-pulse-dot" aria-hidden="true"></span>
          <h1>NN LAB 🧠</h1>
        </div>
        <span class="nn-brand-sub">Foundational Deep Learning Laboratory</span>
      </div>

      <!-- Model Studio Navigation Tabs -->
      <nav class="nn-model-nav" aria-label="NN Lab Studios">
        <a
          href="/nn-lab/"
          class="nn-model-link active"
          aria-current="page"
          title="Convolutional Neural Network Studio"
        >
          <span class="nn-model-icon" aria-hidden="true">🖼️</span>
          <span>CNN Studio (2D & 1D)</span>
        </a>
        <a
          href="/nn-lab/transformer/"
          class="nn-model-link"
          title="Transformer Attention & Layer Studio"
        >
          <span class="nn-model-icon" aria-hidden="true">✨</span>
          <span>Transformer Studio (Attention & Layer)</span>
        </a>
        <a
          href="/nn-lab/mamba/"
          class="nn-model-link"
          title="Mamba & State Space Model Studio"
        >
          <span class="nn-model-icon" aria-hidden="true">🐍</span>
          <span>Mamba Studio (SSM & Selective Scan)</span>
        </a>
      </nav>

      <nav class="nn-nav-links" aria-label="Site Navigation">
        <a href="/" class="nn-nav-link" title="Return to Homepage">
          <span aria-hidden="true">←</span> Home
        </a>
        <a href="/shorkie-lab/" class="nn-nav-link" title="Shorkie Lab: Genomic Deep Learning">
          <span aria-hidden="true">🧬</span> Shorkie Lab
        </a>
        <a href="/lab" class="nn-nav-link" title="Cell Lab: Cellular Automata">
          <span aria-hidden="true">🔬</span> Cell Lab
        </a>
        <a href="/deep_dives/" class="nn-nav-link" title="Technical Deep Dives">
          <span aria-hidden="true">📚</span> Deep Dives
        </a>
        <a href="/algorithms/" class="nn-nav-link" title="Interactive Algorithms & Data Structures">
          <span aria-hidden="true">⚡</span> Algorithms
        </a>
      </nav>
    </header>

    <!-- Mode Switcher Tabs -->
    <div class="nn-tabs-bar">
      <div class="nn-tabs-container" role="tablist" aria-label="Convolution Modes">
        <button
          type="button"
          class="nn-mode-tab active"
          data-cnn-tab="2d"
          role="tab"
          aria-selected="true"
        >
          <span class="nn-tab-icon" aria-hidden="true">🖼️</span>
          <span>2D Vision Mode</span>
        </button>
        <button
          type="button"
          class="nn-mode-tab"
          data-cnn-tab="1d"
          role="tab"
          aria-selected="false"
        >
          <span class="nn-tab-icon" aria-hidden="true">🧬</span>
          <span>1D Sequence Mode</span>
        </button>
      </div>
    </div>

    <!-- Main CNN Studio Content -->
    <main class="nn-main-content">

      <!-- ==================================================================== -->
      <!-- 2D SPATIAL VISION PANEL                                             -->
      <!-- ==================================================================== -->
      <section class="nn-panel" data-cnn-panel="2d">
        <header class="nn-panel-header">
          <div>
            <h2>2D Spatial Convolution & Feature Extraction</h2>
            <p class="nn-panel-desc">
              Interact with the discrete 2D cross-correlation kernel sliding across an input feature map.
              Click any input cell to cycle activation values (<Katex tex="0 \to 4" />), or select weight presets below to inspect edge detection, sharpening, and smoothing.
            </p>
          </div>
          <div class="nn-math-chip">
            <Katex
              tex="(I * K)(i, j) = \sum_{m} \sum_{n} I(i \cdot s + m \cdot d, \; j \cdot s + n \cdot d) \cdot K(m, n) + b"
              display={true}
            />
          </div>
        </header>

        <!-- Presets Bar -->
        <div class="nn-card nn-preset-card">
          <div class="nn-preset-row">
            <span class="nn-preset-title">Kernel Presets:</span>
            <div class="nn-preset-buttons">
              <button type="button" class="nn-preset-btn active" data-cnn-preset-kernel="sobelHorizontal">
                Sobel Horizontal
              </button>
              <button type="button" class="nn-preset-btn" data-cnn-preset-kernel="sobelVertical">
                Sobel Vertical
              </button>
              <button type="button" class="nn-preset-btn" data-cnn-preset-kernel="laplacian">
                Laplacian
              </button>
              <button type="button" class="nn-preset-btn" data-cnn-preset-kernel="sharpen">
                Sharpen
              </button>
              <button type="button" class="nn-preset-btn" data-cnn-preset-kernel="gaussianBlur">
                Gaussian Blur
              </button>
              <button type="button" class="nn-preset-btn" data-cnn-preset-kernel="identity">
                Identity
              </button>
            </div>
            <!-- Optional select fallback for complete controller query coverage -->
            <select data-cnn-kernel-preset class="nn-select nn-preset-select" aria-label="Kernel Preset Dropdown">
              <option value="sobelHorizontal" selected>Sobel Horizontal</option>
              <option value="sobelVertical">Sobel Vertical</option>
              <option value="laplacian">Laplacian</option>
              <option value="sharpen">Sharpen</option>
              <option value="gaussianBlur">Gaussian Blur</option>
              <option value="identity">Identity</option>
            </select>
          </div>
        </div>

        <!-- Hyperparameters Control Bar -->
        <div class="nn-card nn-params-card">
          <div class="nn-params-grid">
            <!-- Input Dimension -->
            <div class="nn-param-item">
              <label for="param-in-size" class="nn-param-label">
                Input Shape: <span data-cnn-in-size-val class="nn-param-val">5 × 5</span>
              </label>
              <input
                id="param-in-size"
                type="range"
                min="3"
                max="9"
                value="5"
                step="1"
                data-cnn-in-size
                class="nn-range"
              />
            </div>

            <!-- Kernel Size -->
            <div class="nn-param-item">
              <label for="param-kernel-size" class="nn-param-label">Kernel (<Katex tex="K \times K" />)</label>
              <select id="param-kernel-size" class="nn-select" data-cnn-kernel-size>
                <option value="1">1 × 1</option>
                <option value="3" selected>3 × 3</option>
                <option value="5">5 × 5</option>
              </select>
            </div>

            <!-- Stride -->
            <div class="nn-param-item">
              <label for="param-stride" class="nn-param-label">Stride (<Katex tex="S" />)</label>
              <select id="param-stride" class="nn-select" data-cnn-stride>
                <option value="1" selected>Stride: 1</option>
                <option value="2">Stride: 2</option>
                <option value="3">Stride: 3</option>
              </select>
            </div>

            <!-- Padding -->
            <div class="nn-param-item">
              <label for="param-padding" class="nn-param-label">Padding (<Katex tex="P" />)</label>
              <div class="nn-input-with-pills">
                <select id="param-padding" class="nn-select" data-cnn-padding>
                  <option value="0">0 (Valid)</option>
                  <option value="1" selected>1 (Same)</option>
                  <option value="2">2</option>
                  <option value="3">3</option>
                </select>
                <div class="nn-pad-pills">
                  <button type="button" class="nn-pill-btn" data-cnn-pad-mode="valid">Valid</button>
                  <button type="button" class="nn-pill-btn" data-cnn-pad-mode="same">Same</button>
                </div>
              </div>
            </div>

            <!-- Dilation -->
            <div class="nn-param-item">
              <label for="param-dilation" class="nn-param-label">Dilation (<Katex tex="d" />)</label>
              <select id="param-dilation" class="nn-select" data-cnn-dilation>
                <option value="1" selected>1 (Standard)</option>
                <option value="2">2 (Atrous)</option>
                <option value="3">3</option>
              </select>
            </div>

            <!-- Channels (C_in / C_out) -->
            <div class="nn-param-item">
              <label class="nn-param-label">Channels (<Katex tex="C_{\text{in}} \to C_{\text{out}}" />)</label>
              <div class="nn-dual-inputs">
                <input
                  type="number"
                  min="1"
                  max="512"
                  value="3"
                  data-cnn-in-channels
                  class="nn-input-num"
                  title="Input Channels (C_in)"
                  aria-label="Input Channels"
                />
                <span class="nn-input-arrow">→</span>
                <input
                  type="number"
                  min="1"
                  max="512"
                  value="16"
                  data-cnn-out-channels
                  class="nn-input-num"
                  title="Output Channels (C_out)"
                  aria-label="Output Channels"
                />
              </div>
            </div>

            <!-- Groups & Depthwise -->
            <div class="nn-param-item">
              <label class="nn-param-label">Groups / Topology</label>
              <div class="nn-groups-row">
                <input
                  type="number"
                  min="1"
                  max="3"
                  value="1"
                  data-cnn-groups
                  class="nn-input-num"
                  title="Groups"
                  aria-label="Convolution Groups"
                />
                <label class="nn-toggle-label">
                  <input type="checkbox" data-cnn-depthwise />
                  <span>Depthwise</span>
                </label>
              </div>
            </div>

            <!-- Bias Parameter -->
            <div class="nn-param-item">
              <label class="nn-param-label">Learnable Bias (<Katex tex="b" />)</label>
              <div class="nn-bias-row">
                <label class="nn-toggle-label">
                  <input type="checkbox" data-cnn-bias-toggle checked />
                  <span>Enabled</span>
                </label>
                <input
                  type="number"
                  step="0.5"
                  value="0"
                  data-cnn-bias-val
                  class="nn-input-num"
                  title="Bias Value"
                  aria-label="Bias Value"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- 3-Stage Visualizer Stage -->
        <div class="nn-card nn-stage-card">
          <div class="nn-grids-layout">
            <!-- Stage 1: Input Feature Map -->
            <div class="nn-grid-box">
              <div class="nn-grid-header">
                <div class="nn-grid-heading">
                  <span class="nn-dot nn-dot--indigo"></span>
                  <span class="nn-grid-title">Padded Input Matrix <Katex tex="X" /></span>
                </div>
                <span class="nn-grid-hint">Click cell to cycle 0..4</span>
              </div>
              <div class="nn-grid-viewport">
                <div class="nn-grid-container" data-cnn-input-grid></div>
              </div>
            </div>

            <!-- Operator Symbol -->
            <div class="nn-operator-col" aria-hidden="true">
              <span class="nn-operator-sym">∗</span>
            </div>

            <!-- Stage 2: Weight Kernel Matrix -->
            <div class="nn-grid-box">
              <div class="nn-grid-header">
                <div class="nn-grid-heading">
                  <span class="nn-dot nn-dot--blue"></span>
                  <span class="nn-grid-title">Kernel Filter <Katex tex="W" /></span>
                </div>
                <span class="nn-grid-hint">Click to edit weight</span>
              </div>
              <div class="nn-grid-viewport">
                <div class="nn-grid-container" data-cnn-kernel-grid></div>
              </div>
            </div>

            <!-- Operator Symbol -->
            <div class="nn-operator-col" aria-hidden="true">
              <span class="nn-operator-sym">=</span>
            </div>

            <!-- Stage 3: Output Feature Map -->
            <div class="nn-grid-box">
              <div class="nn-grid-header">
                <div class="nn-grid-heading">
                  <span class="nn-dot nn-dot--emerald"></span>
                  <span class="nn-grid-title">Output Feature Map <Katex tex="Y" /></span>
                </div>
                <span class="nn-grid-hint">Click cell to jump</span>
              </div>
              <div class="nn-grid-viewport">
                <div class="nn-grid-container" data-cnn-output-grid></div>
              </div>
            </div>
          </div>

          <!-- Playback Controls Toolbar -->
          <div class="nn-playback-bar">
            <div class="nn-playback-btns">
              <button type="button" class="nn-btn" data-cnn-step-prev title="Previous step (← or j)">
                <span aria-hidden="true">⏮</span> Prev
              </button>
              <button type="button" class="nn-btn nn-btn--primary" data-cnn-play title="Play/Pause (Space)">
                <span aria-hidden="true">▶</span> Play
              </button>
              <button type="button" class="nn-btn" data-cnn-step-next title="Next step (→ or l)">
                Next <span aria-hidden="true">⏭</span>
              </button>
              <button type="button" class="nn-btn" data-cnn-reset title="Reset convolution to origin (r)">
                <span aria-hidden="true">↺</span> Reset
              </button>
            </div>

            <div class="nn-playback-speed">
              <label for="playback-speed-select" class="nn-label-speed">Speed:</label>
              <select id="playback-speed-select" class="nn-select nn-select--sm" data-cnn-speed>
                <option value="1000">1.0s (Slow)</option>
                <option value="500" selected>0.5s (Normal)</option>
                <option value="250">0.25s (Fast)</option>
                <option value="100">0.1s (Turbo)</option>
              </select>
            </div>

            <div class="nn-step-pill" data-cnn-step-info role="status" aria-live="polite">
              Step 1 / 25
            </div>

            <div class="nn-kbd-shortcuts" aria-hidden="true">
              <kbd>Space</kbd> Play · <kbd>←</kbd><kbd>→</kbd> Step · <kbd>R</kbd> Reset
            </div>
          </div>
        </div>

        <!-- Real-time X-Ray Dot Product Inspector -->
        <div class="nn-card nn-xray-card">
          <div class="nn-card-title-bar">
            <span class="nn-card-icon">🔬</span>
            <h3>Real-Time X-Ray Dot Product & Accumulation Inspector</h3>
          </div>
          <div class="nn-inspector-body" data-cnn-inspector>
            <!-- Rendered dynamically by cnnStudio.ts -->
          </div>
        </div>

        <!-- Live Mathematical Telemetry Cards -->
        <div class="nn-stats-grid">
          <div class="nn-stat-card">
            <div class="nn-stat-head">
              <span class="nn-stat-title">Output Spatial Shape</span>
              <span class="nn-stat-badge">Dimension</span>
            </div>
            <div class="nn-stat-val" data-cnn-out-dim>5 × 5</div>
            <div class="nn-stat-formula">
              <Katex tex="O = \left\lfloor \frac{W - K + 2P - (K-1)(d-1)}{S} \right\rfloor + 1" />
            </div>
          </div>

          <div class="nn-stat-card">
            <div class="nn-stat-head">
              <span class="nn-stat-title">Learnable Parameters</span>
              <span class="nn-stat-badge">Weights + Bias</span>
            </div>
            <div class="nn-stat-val" data-cnn-param-count>--</div>
            <div class="nn-stat-formula">
              <Katex tex="\text{Params} = \frac{C_{\text{out}}}{G} \cdot C_{\text{in}} \cdot K^2 + C_{\text{out}}" />
            </div>
          </div>

          <div class="nn-stat-card">
            <div class="nn-stat-head">
              <span class="nn-stat-title">Computational Cost</span>
              <span class="nn-stat-badge">Complexity</span>
            </div>
            <div class="nn-stat-val" data-cnn-flops>--</div>
            <div class="nn-stat-formula">
              <Katex tex="\text{MACs} = H_{\text{out}} W_{\text{out}} \cdot \frac{C_{\text{in}} C_{\text{out}} K^2}{G}" />
            </div>
          </div>

          <div class="nn-stat-card">
            <div class="nn-stat-head">
              <span class="nn-stat-title">Activation Memory</span>
              <span class="nn-stat-badge">FP32 Tensor</span>
            </div>
            <div class="nn-stat-val" data-cnn-memory>--</div>
            <div class="nn-stat-formula">
              <Katex tex="\text{VRAM} = H_{\text{out}} \cdot W_{\text{out}} \cdot C_{\text{out}} \times 4\text{ B}" />
            </div>
          </div>
        </div>
      </section>

      <!-- ==================================================================== -->
      <!-- 1D GENOMIC SEQUENCE MOTIF SCANNER PANEL                              -->
      <!-- ==================================================================== -->
      <section class="nn-panel" data-cnn-panel="1d" style="display: none;">
        <header class="nn-panel-header">
          <div>
            <h2>1D Genomic Sequence Scanner & Transcription Factor Motif Convolutions</h2>
            <p class="nn-panel-desc">
              In genomic deep learning architectures (e.g., DeepBind, SpliceAI, Borzoi, Enformer), 1D convolutional layers scan one-hot encoded DNA sequences.
              Each 1D filter represents a learned <strong>Position Weight Matrix (PWM)</strong> calculating log-odds affinities for transcription factor binding sites (TFBS), splice junctions, or core promoter elements.
            </p>
          </div>
          <div class="nn-math-chip">
            <Katex
              tex="S_t = \sum_{j=0}^{k-1} \sum_{c \in \{A,C,G,T\}} X_{t + j, c} \cdot W_{c, j}"
              display={true}
            />
          </div>
        </header>

        <!-- 1D Motif & Sequence Toolbar -->
        <div class="nn-card nn-seq-toolbar-card">
          <div class="nn-seq-toolbar-grid">
            <div class="nn-param-item">
              <label for="motif-select-input" class="nn-param-label">Biological Motif Preset</label>
              <select id="motif-select-input" class="nn-select" data-cnn-motif-select>
                <option value="tataBox" selected>TATA Box Promoter (TATAAA)</option>
                <option value="kozak">Kozak Initiation (GCCACCATGG)</option>
                <option value="spliceDonor">Splice Donor 5' Junction (MAGGTRAGT)</option>
                <option value="ctcf">CTCF Insulator Core (CCACTAGGTGGCAG)</option>
              </select>
            </div>

            <div class="nn-param-item nn-param-item--grow">
              <label for="seq-text-input" class="nn-param-label">Target DNA Sequence (<Katex tex="5' \to 3'" />)</label>
              <input
                id="seq-text-input"
                type="text"
                data-cnn-seq-input
                value="CCGCTATAAAAGGAGCGGCTA"
                class="nn-seq-input"
                spellcheck="false"
              />
            </div>

            <div class="nn-param-item">
              <label for="seq-stride-input" class="nn-param-label">Stride (<Katex tex="S" />)</label>
              <select id="seq-stride-input" class="nn-select" data-cnn-seq-stride>
                <option value="1" selected>Stride: 1 bp</option>
                <option value="2">Stride: 2 bp</option>
              </select>
            </div>

            <div class="nn-param-item">
              <label class="nn-param-label">Playback Controls</label>
              <div class="nn-playback-btns">
                <button type="button" class="nn-btn" data-cnn-seq-prev title="Previous scanning window">
                  <span aria-hidden="true">⏮</span>
                </button>
                <button type="button" class="nn-btn nn-btn--primary" data-cnn-seq-play title="Scan sequence">
                  <span aria-hidden="true">▶</span> Scan
                </button>
                <button type="button" class="nn-btn" data-cnn-seq-next title="Next scanning window">
                  <span aria-hidden="true">⏭</span>
                </button>
                <button type="button" class="nn-btn" data-cnn-seq-reset title="Reset scanning window">
                  <span aria-hidden="true">↺</span>
                </button>
              </div>
            </div>
          </div>

          <div class="nn-seq-status-row">
            <div class="nn-step-pill" data-cnn-seq-step-info role="status">
              Scanning Window: 1 / 16
            </div>
            <div class="nn-match-summary" data-cnn-match-summary>
              <!-- Populated dynamically -->
            </div>
          </div>
        </div>

        <!-- 1D Interactive Sequence Track Stage -->
        <div class="nn-card nn-seq-track-card">
          <div class="nn-card-title-bar">
            <span class="nn-card-icon">🧬</span>
            <h3>One-Hot Encoded Nucleotide Track & Sliding Window</h3>
          </div>
          <div class="nn-seq-track-wrapper" data-cnn-seq-track>
            <!-- Populated dynamically by cnnStudio.ts -->
          </div>
        </div>

        <!-- 1D Activation Score Chart -->
        <div class="nn-card nn-chart-card">
          <div class="nn-card-title-bar">
            <span class="nn-card-icon">📊</span>
            <h3>1D Convolution Activation Profile / Affinity Score Profile</h3>
          </div>
          <div class="nn-chart-wrapper" data-cnn-score-chart>
            <!-- Populated dynamically by cnnStudio.ts as SVG -->
          </div>
        </div>

        <!-- 1D X-Ray Breakdown -->
        <div class="nn-card nn-xray-card">
          <div class="nn-card-title-bar">
            <span class="nn-card-icon">🔬</span>
            <h3>1D Filter Window Position Weight Matrix (PWM) Dot Product</h3>
          </div>
          <div class="nn-inspector-body" data-cnn-seq-xray>
            <!-- Populated dynamically by cnnStudio.ts -->
          </div>
        </div>
      </section>

      <!-- ==================================================================== -->
      <!-- RECEPTIVE FIELD EXPANSION LADDER                                     -->
      <!-- ==================================================================== -->
      <section class="nn-section nn-rf-section">
        <header class="nn-panel-header">
          <div>
            <h2>Receptive Field (RF) Expansion Ladder</h2>
            <p class="nn-panel-desc">
              Understand how input spatial context accumulates through successive convolutional operations.
              For each layer <Katex tex="l" />, the effective receptive field expands according to the canonical recurrence relation:
            </p>
          </div>
          <div class="nn-math-chip">
            <Katex
              tex="RF_l = RF_{l-1} + (k_l - 1) \cdot S_{l-1}, \quad \text{where } S_{l-1} = \prod_{i=1}^{l-1} s_i"
              display={true}
            />
          </div>
        </header>

        <div class="nn-card nn-rf-card">
          <div class="nn-rf-toolbar">
            <div class="nn-rf-toolbar-info">
              Stack consecutive convolutional layers to witness spatial context scaling:
            </div>
            <div class="nn-rf-actions">
              <button type="button" class="nn-btn nn-btn--primary" data-cnn-rf-add-layer>
                + Add 3×3 Conv Layer
              </button>
              <button type="button" class="nn-btn" data-cnn-rf-reset>
                ↺ Reset (3 Layers)
              </button>
            </div>
          </div>

          <div class="nn-rf-ladder-container" data-cnn-rf-ladder>
            <!-- Populated dynamically by cnnStudio.ts -->
          </div>

          <div class="nn-vgg-callout" data-cnn-vgg-callout>
            <!-- Populated dynamically by cnnStudio.ts -->
          </div>
        </div>
      </section>

      <!-- ==================================================================== -->
      <!-- LIVE PYTORCH MODULE GENERATOR                                        -->
      <!-- ==================================================================== -->
      <section class="nn-section nn-pytorch-section">
        <header class="nn-panel-header">
          <div>
            <h2>Production-Ready PyTorch Module Generator</h2>
