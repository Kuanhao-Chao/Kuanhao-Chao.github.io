---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Katex from '../../components/Katex.astro';
import 'katex/dist/katex.min.css';
import { site } from '../../data/site';
import { buildBreadcrumbLd } from '../../lib/breadcrumbs';

const title = 'Transformer Studio — Foundational Deep Learning & Attention Laboratory';
const description =
  'Interactive Transformer architecture laboratory with real-time scaled dot-product attention heatmap, ' +
  'X-Ray arithmetic dot-product decomposition, Grouped-Query Attention (GQA) head visualizer, ' +
  '8-stage forward pass execution engine, and live production PyTorch generator.';

const webAppLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'NN Lab — Transformer Attention & Layer Studio',
  applicationCategory: 'EducationalApplication, DeveloperApplication, ScienceApplication',
  operatingSystem: 'Web Browser',
  description,
  url: `${site.url}/nn-lab/transformer/`,
  author: { '@id': `${site.url}/#person` },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbLd = buildBreadcrumbLd([
  { name: 'NN Lab', path: '/nn-lab/' },
  { name: 'Transformer Studio', path: '/nn-lab/transformer/' },
]);
---

<BaseLayout title={title} description={description} bare={true}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />

  <main class="nn-page-wrapper" data-transformer-studio id="transformer-studio-root">
    <!-- Top Navigation Bar -->
    <header class="nn-topbar">
      <div class="nn-brand-group">
        <div class="nn-brand-title">
          <span class="nn-pulse-dot" aria-hidden="true"></span>
          <h1>NN LAB 🧠</h1>
        </div>
        <span class="nn-brand-sub">Foundational Deep Learning Laboratory</span>
      </div>

      <!-- Model Studio Navigation Tabs -->
      <nav class="nn-model-nav" aria-label="NN Lab Studios">
        <a
          href="/nn-lab/"
          class="nn-model-link"
          title="Convolutional Neural Network Studio"
        >
          <span class="nn-model-icon" aria-hidden="true">🖼️</span>
          <span>CNN Studio (2D & 1D)</span>
        </a>
        <a
          href="/nn-lab/transformer/"
          class="nn-model-link active"
          aria-current="page"
          title="Transformer Attention & Layer Studio"
        >
          <span class="nn-model-icon" aria-hidden="true">✨</span>
          <span>Transformer Studio (Attention & Layer)</span>
        </a>
      </nav>

      <nav class="nn-nav-links" aria-label="Site Navigation">
        <a href="/" class="nn-nav-link" title="Return to Homepage">
          <span aria-hidden="true">←</span> Home
        </a>
        <a href="/shorkie-lab/" class="nn-nav-link" title="Shorkie Lab: Genomic Deep Learning">
          <span aria-hidden="true">🧬</span> Shorkie Lab
        </a>
        <a href="/lab" class="nn-nav-link" title="Cell Lab: Cellular Automata">
          <span aria-hidden="true">🔬</span> Cell Lab
        </a>
        <a href="/deep_dives/" class="nn-nav-link" title="Technical Deep Dives">
          <span aria-hidden="true">📚</span> Deep Dives
        </a>
        <a href="/algorithms/" class="nn-nav-link" title="Interactive Algorithms & Data Structures">
          <span aria-hidden="true">⚡</span> Algorithms
        </a>
      </nav>
    </header>

    <!-- Main Studio Content -->
    <div class="nn-main-content">
      <!-- ==================================================================== -->
      <!-- STUDIO HEADER & EQUATION BANNER                                      -->
      <!-- ==================================================================== -->
      <section class="nn-panel">
        <header class="nn-panel-header">
          <div>
            <h2>Transformer Self-Attention & Layer Architecture Studio</h2>
            <p class="nn-panel-desc">
              Interact with the mathematical core of modern Large Language Models and genomic foundation models.
              Explore scaled dot-product attention, multi-head projection subspaces, Grouped-Query Attention (GQA) routing,
              and Pre-LN normalization dynamics. Click any cell in the attention heatmap to inspect its exact arithmetic trace.
            </p>
          </div>
          <div class="nn-math-chip">
            <Katex
              tex="\text{Attention}(Q, K, V) = \text{softmax}\left( \frac{Q K^T}{\sqrt{d_k}} + M \right) V"
              display={true}
            />
          </div>
        </header>

        <!-- Presets & Input Toolbar -->
        <div class="nn-card nn-preset-card">
          <div class="nn-arch-row">
            <span class="nn-preset-title">Architecture Paradigm:</span>
            <div class="nn-arch-buttons">
              <button
                type="button"
                class="nn-preset-btn active"
                data-transformer-arch-btn="modern"
                aria-pressed="true"
              >
                <span aria-hidden="true">⚡</span> Modern LLM (Pre-LN · RMSNorm · RoPE · SwiGLU · GQA)
              </button>
              <button
                type="button"
                class="nn-preset-btn"
                data-transformer-arch-btn="classical"
                aria-pressed="false"
              >
                <span aria-hidden="true">📜</span> Classical (Vaswani 2017 · Post-LN · Sinusoidal · MHA)
              </button>
            </div>
          </div>

          <div class="nn-preset-row">
            <span class="nn-preset-title">Domain Presets:</span>
            <div class="nn-preset-buttons">
              <button
                type="button"
                class="nn-preset-btn active"
                data-transformer-preset="nlpWinograd"
                aria-pressed="true"
              >
                Winograd Schema (NLP)
              </button>
              <button
                type="button"
                class="nn-preset-btn"
                data-transformer-preset="nlpAttention"
                aria-pressed="false"
              >
                Attention Landmark (NLP)
              </button>
              <button
                type="button"
                class="nn-preset-btn"
                data-transformer-preset="dnaPromoter"
                aria-pressed="false"
              >
                TATA Box & Splice (Genomics)
              </button>
              <button
                type="button"
                class="nn-preset-btn"
                data-transformer-preset="dnaEnhancer"
                aria-pressed="false"
              >
                Sp1 Enhancer-TSS (Genomics)
              </button>
            </div>
          </div>

          <div class="nn-custom-row">
            <label for="transformer-custom-text" class="nn-param-label">Custom Prompt / Tokens:</label>
            <input
              id="transformer-custom-text"
              type="text"
              data-transformer-custom-input
              value="The animal didn't cross the street because it was too tired"
              class="nn-seq-input"
              placeholder="Enter text or space-separated tokens..."
              spellcheck="false"
            />
          </div>

          <!-- Token Badges Strip -->
          <div class="transformer-token-bar">
            <span class="nn-token-bar-label">Active Tokens (<Katex tex="N" />):</span>
            <div class="transformer-token-list" data-transformer-token-list>
              <!-- Filled dynamically by transformerStudio.ts -->
            </div>
          </div>
        </div>

        <!-- Hyperparameters & Topological Controls -->
        <div class="nn-card nn-params-card">
          <div class="nn-params-grid">
            <!-- Sequence Length N -->
            <div class="nn-param-item">
              <label for="param-seq-len" class="nn-param-label">
                Tokens (<Katex tex="N" />): <span data-transformer-seq-len-val class="nn-param-val">11</span>
              </label>
              <input
                id="param-seq-len"
                type="range"
                min="2"
                max="24"
                value="11"
                step="1"
                data-transformer-seq-len
                class="nn-range"
              />
            </div>

            <!-- Model Dimension d_model -->
            <div class="nn-param-item">
              <label for="param-d-model" class="nn-param-label">
                Model Dim (<Katex tex="d_{\text{model}}" />): <span data-transformer-d-model-val class="nn-param-val">64</span>
              </label>
              <input
                id="param-d-model"
                type="range"
                min="16"
                max="512"
                value="64"
                step="16"
                data-transformer-d-model
                class="nn-range"
              />
            </div>

            <!-- Query Heads H -->
            <div class="nn-param-item">
              <label for="param-num-heads" class="nn-param-label">
                Query Heads (<Katex tex="H" />): <span data-transformer-num-heads-val class="nn-param-val">4</span>
              </label>
              <input
                id="param-num-heads"
                type="range"
                min="1"
                max="16"
                value="4"
                step="1"
                data-transformer-num-heads
                class="nn-range"
              />
            </div>

            <!-- KV Heads H_KV -->
            <div class="nn-param-item">
              <label for="param-kv-heads" class="nn-param-label">
                KV Heads (<Katex tex="H_{\text{KV}}" />): <span data-transformer-kv-heads-val class="nn-param-val">2</span>
              </label>
              <input
                id="param-kv-heads"
                type="range"
                min="1"
                max="16"
                value="2"
                step="1"
                data-transformer-kv-heads
                class="nn-range"
              />
            </div>

            <!-- FFN Dimension d_ffn -->
            <div class="nn-param-item">
              <label for="param-d-ffn" class="nn-param-label">
                FFN Dim (<Katex tex="d_{\text{ffn}}" />): <span data-transformer-d-ffn-val class="nn-param-val">256</span>
              </label>
              <input
                id="param-d-ffn"
                type="range"
                min="32"
                max="2048"
                value="256"
                step="32"
                data-transformer-d-ffn
                class="nn-range"
              />
            </div>

            <!-- Head Topology Mode -->
            <div class="nn-param-item">
              <label class="nn-param-label">Attention Head Mode</label>
              <div class="nn-pad-pills">
                <button type="button" class="nn-pill-btn" data-transformer-head-mode="mha">MHA (1:1)</button>
                <button type="button" class="nn-pill-btn active" data-transformer-head-mode="gqa">GQA (Grouped)</button>
                <button type="button" class="nn-pill-btn" data-transformer-head-mode="mqa">MQA (Single KV)</button>
              </div>
            </div>

            <!-- Normalization Type -->
            <div class="nn-param-item">
              <label for="param-norm-type" class="nn-param-label">Normalization</label>
              <select id="param-norm-type" class="nn-select" data-transformer-norm-type>
                <option value="rmsnorm" selected>RMSNorm (Pre-LN Root-Mean-Square)</option>
                <option value="layernorm">LayerNorm (Standard Mean & Variance)</option>
              </select>
            </div>

            <!-- Positional Encoding -->
            <div class="nn-param-item">
              <label for="param-pos-encoding" class="nn-param-label">Positional Encoding</label>
              <select id="param-pos-encoding" class="nn-select" data-transformer-pos-encoding>
                <option value="rope" selected>RoPE (Rotary Position Embeddings)</option>
                <option value="sinusoidal">Sinusoidal (Absolute Harmonic Waves)</option>
                <option value="none">None / Relative</option>
              </select>
            </div>

            <!-- Causal Attention Mask -->
            <div class="nn-param-item">
              <label for="param-mask-type" class="nn-param-label">Attention Mask (<Katex tex="M" />)</label>
              <select id="param-mask-type" class="nn-select" data-transformer-mask-type>
                <option value="causal" selected>Causal Lower-Triangular (Decoder / Autoregressive)</option>
                <option value="none">Bidirectional / Unmasked (Encoder / BERT)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Forward Pass 8-Stage Execution Stepper & Playback Engine -->
        <div class="nn-card nn-stage-card">
          <div class="nn-stage-head">
            <div class="nn-stage-badge-wrap">
              <span class="nn-dot nn-dot--indigo"></span>
              <span class="nn-stage-badge" data-transformer-stage-badge>1/8: Input Token Embeddings</span>
            </div>
            <div class="nn-kbd-shortcuts" aria-hidden="true">
              <kbd>Space</kbd> Play · <kbd>←</kbd><kbd>→</kbd> Step · <kbd>R</kbd> Reset
            </div>
          </div>

          <!-- Step Pills Pipeline Strip -->
          <div class="transformer-pipeline-steps" data-transformer-pipeline-steps>
            <!-- 8 steps rendered dynamically -->
          </div>

          <!-- Playback Toolbar -->
          <div class="nn-playback-bar">
            <div class="nn-playback-btns">
              <button type="button" class="nn-btn" data-transformer-prev title="Previous Pipeline Stage">
                <span aria-hidden="true">⏮</span> Prev
              </button>
              <button type="button" class="nn-btn nn-btn--primary" data-transformer-play title="Play / Pause Forward Pass">
                <span aria-hidden="true">▶</span> Play
              </button>
              <button type="button" class="nn-btn" data-transformer-next title="Next Pipeline Stage">
                Next <span aria-hidden="true">⏭</span>
              </button>
              <button type="button" class="nn-btn" data-transformer-reset title="Reset Forward Pass">
                <span aria-hidden="true">↺</span> Reset
              </button>
            </div>

            <div class="nn-playback-speed">
              <label for="transformer-playback-speed" class="nn-label-speed">Speed:</label>
              <select id="transformer-playback-speed" class="nn-select nn-select--sm" data-transformer-speed>
                <option value="2000">2.0s (Slow)</option>
                <option value="1200" selected>1.2s (Normal)</option>
                <option value="600">0.6s (Fast)</option>
                <option value="300">0.3s (Turbo)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Attention Heatmap & Arithmetic X-Ray Inspection Stage -->
        <div class="nn-card nn-attention-stage-card">
          <div class="transformer-stage-grid">
            <!-- Left: Softmax Attention Heatmap -->
            <div class="transformer-heatmap-box">
              <div class="nn-grid-header">
                <div class="nn-grid-heading">
                  <span class="nn-dot nn-dot--blue"></span>
                  <span class="nn-grid-title">Softmax Attention Matrix <Katex tex="A \in \mathbb{R}^{N \times N}" /></span>
                </div>
                <span class="nn-grid-hint">Click cell to inspect dot product arithmetic</span>
              </div>
              <div class="transformer-heatmap-viewport">
                <div class="transformer-heatmap-container" data-transformer-heatmap>
                  <!-- Populated dynamically by transformerStudio.ts -->
                </div>
              </div>
              <div class="heatmap-legend">
                <span class="legend-label">Softmax Probability:</span>
                <div class="legend-bar">
                  <span class="legend-stop">0%</span>
                  <div class="legend-gradient"></div>
                  <span class="legend-stop">100%</span>
                </div>
              </div>
            </div>

            <!-- Right: Real-Time Arithmetic X-Ray Drawer -->
            <div class="transformer-xray-box">
              <div class="nn-grid-header">
                <div class="nn-grid-heading">
                  <span class="nn-dot nn-dot--emerald"></span>
                  <span class="nn-grid-title">Attention Arithmetic X-Ray & Trace</span>
                </div>
                <span class="nn-grid-hint"><Katex tex="\mathbf{q}_i \cdot \mathbf{k}_j / \sqrt{d_k}" /></span>
              </div>
              <div class="transformer-xray-container" data-transformer-xray>
                <!-- Populated dynamically by transformerStudio.ts -->
              </div>
            </div>
          </div>
        </div>

        <!-- Grouped-Query Attention (GQA) Head Topology Visualizer -->
        <div class="nn-card nn-gqa-card">
          <div class="nn-card-title-bar">
            <span class="nn-card-icon">🔀</span>
            <div>
              <h3>Grouped-Query Attention (GQA) Head Topology Visualizer</h3>
              <p class="nn-card-sub">
                Shows how <Katex tex="H" /> Query heads share <Katex tex="H_{\text{KV}}" /> Key-Value projection heads,
                reducing KV cache memory footprint by <Katex tex="H / H_{\text{KV}} \times" /> during autoregressive decoding.
              </p>
            </div>
          </div>
          <div class="transformer-gqa-container" data-transformer-gqa-diagram>
            <!-- Populated dynamically by transformerStudio.ts -->
          </div>
        </div>

        <!-- Live Mathematical Telemetry Cards -->
        <div class="nn-stats-grid">
          <div class="nn-stat-card">
            <div class="nn-stat-head">
              <span class="nn-stat-title">Learnable Parameters</span>
              <span class="nn-stat-badge">Weights + Projections</span>
            </div>
            <div class="nn-stat-val" data-transformer-params-total>--</div>
            <div class="nn-stat-formula">
              <Katex tex="\text{Params}_{\text{layer}} = W_Q + W_K + W_V + W_O + \text{FFN} + 2 \times \text{Norm}" />
            </div>
          </div>

          <div class="nn-stat-card">
            <div class="nn-stat-head">
              <span class="nn-stat-title">Computational Complexity</span>
              <span class="nn-stat-badge">Forward FLOPs</span>
            </div>
            <div class="nn-stat-val" data-transformer-flops-total>--</div>
            <div class="nn-stat-formula">
              <Katex tex="\text{FLOPs} = 2N d_{\text{model}} (d_Q + d_K + d_V + d_O) + 4N^2 d_{\text{model}} + 2N d_{\text{model}} d_{\text{ffn}}" />
            </div>
          </div>

          <div class="nn-stat-card">
            <div class="nn-stat-head">
              <span class="nn-stat-title">KV Cache Footprint</span>
              <span class="nn-stat-badge">Autoregressive Decoding</span>
            </div>
            <div class="nn-stat-val" data-transformer-kv-cache>--</div>
            <div class="nn-stat-formula">
              <Katex tex="\text{VRAM}_{\text{KV}} = 2 \times B \times L \times H_{\text{KV}} \times S \times d_{\text{head}} \times 2\text{ B}" />
            </div>
          </div>
        </div>
      </section>

      <!-- ==================================================================== -->
      <!-- PRODUCTION PYTORCH MODULE GENERATOR                                  -->
      <!-- ==================================================================== -->
      <section class="nn-section nn-pytorch-section">
        <header class="nn-panel-header">
          <div>
            <h2>Production-Ready PyTorch Transformer Layer Generator</h2>
            <p class="nn-panel-desc">
              Copy fully synchronized, production-grade PyTorch code implementing the currently configured Transformer layer,
              featuring RoPE rotary embeddings, RMSNorm Pre-LN residual paths, and SwiGLU gating with verification harness.
            </p>
          </div>
          <div>
            <button type="button" class="nn-btn nn-btn--primary" data-transformer-copy-pytorch>
              <span aria-hidden="true">📋</span> Copy PyTorch Snippet
            </button>
          </div>
        </header>

        <div class="nn-card nn-code-card">
          <pre class="nn-code-pre"><code class="nn-code-block" data-transformer-pytorch-code># Initializing PyTorch module generator...</code></pre>
        </div>
      </section>

      <!-- ==================================================================== -->
      <!-- FOUNDATIONAL EDUCATIONAL DEEP DIVES                                  -->
      <!-- ==================================================================== -->
      <section class="nn-section nn-deepdive-section">
        <header class="nn-panel-header">
          <div>
            <h2>Foundational Architectural Deep Dives</h2>
            <p class="nn-panel-desc">
              Rigorous mathematical proofs and systems engineering principles underpinning state-of-the-art Transformer architectures.
            </p>
          </div>
        </header>

        <div class="nn-accordions-group">
          <!-- Accordion 1: Mathematical Proof: Why scale by sqrt(d_k)? -->
          <details class="nn-accordion" open>
            <summary class="nn-accordion-trigger">
              <span class="nn-accordion-title">
                <span class="nn-acc-icon">📐</span>
                Mathematical Proof: Why Scale Dot-Product Attention by <Katex tex="1/\sqrt{d_k}" />?
              </span>
              <span class="nn-accordion-chevron" aria-hidden="true">▾</span>
            </summary>
            <div class="nn-accordion-content">
              <p>
                In the seminal paper <em>Attention Is All You Need</em> (Vaswani et al. 2017), the authors note that for large values of <Katex tex="d_k" />,
                the dot products grow large in magnitude, pushing the softmax function into regions where it has extremely small gradients.
                Here is the complete variance stabilization proof.
              </p>

              <h4>1. Statistical Formulation of the Raw Dot Product</h4>
              <p>
                Let <Katex tex="\mathbf{q}, \mathbf{k} \in \mathbb{R}^{d_k}" /> be independent random query and key vectors whose components are independent and identically distributed (i.i.d.) random variables with zero mean and unit variance:
              </p>
              <div class="nn-equation-box">
                <Katex
                  tex="\mathbb{E}[q_i] = 0, \quad \text{Var}(q_i) = 1, \quad \mathbb{E}[k_i] = 0, \quad \text{Var}(k_i) = 1 \quad \forall i \in \{1, \dots, d_k\}"
                  display={true}
                />
              </div>

              <p>The unscaled dot product <Katex tex="S" /> is given by the sum of pairwise products:</p>
              <div class="nn-equation-box">
                <Katex tex="S = \mathbf{q} \cdot \mathbf{k} = \sum_{i=1}^{d_k} q_i k_i" display={true} />
              </div>

              <h4>2. Expectation and Variance of Each Component Product</h4>
              <p>
                For each term <Katex tex="X_i = q_i k_i" />, using the independence of <Katex tex="q_i" /> and <Katex tex="k_i" />:
              </p>
              <div class="nn-equation-box">
                <Katex tex="\mathbb{E}[X_i] = \mathbb{E}[q_i k_i] = \mathbb{E}[q_i] \cdot \mathbb{E}[k_i] = 0 \cdot 0 = 0" display={true} />
              </div>
              <p>The variance of each individual product term is:</p>
              <div class="nn-equation-box">
                <Katex
                  tex="\text{Var}(X_i) = \mathbb{E}[X_i^2] - (\mathbb{E}[X_i])^2 = \mathbb{E}[q_i^2 k_i^2] - 0 = \mathbb{E}[q_i^2] \cdot \mathbb{E}[k_i^2] = 1 \cdot 1 = 1"
                  display={true}
                />
              </div>

              <h4>3. Variance of the Total Sum</h4>
              <p>
                Because all <Katex tex="d_k" /> terms <Katex tex="X_1, \dots, X_{d_k}" /> are mutually independent, the variance of the sum is the sum of the variances:
              </p>
              <div class="nn-equation-box">
                <Katex
                  tex="\text{Var}(S) = \text{Var}\left(\sum_{i=1}^{d_k} q_i k_i\right) = \sum_{i=1}^{d_k} \text{Var}(q_i k_i) = \sum_{i=1}^{d_k} 1 = d_k"
                  display={true}
                />
              </div>
              <p>
                Consequently, the standard deviation is <Katex tex="\sigma_S = \sqrt{d_k}" />.
                In modern models where <Katex tex="d_k = 128" />, the standard deviation of raw scores is <Katex tex="\sqrt{128} \approx 11.31" />.
              </p>

              <h4>4. Vanishing Softmax Gradients Under High Variance</h4>
              <p>
                Consider the softmax function <Katex tex="p_i = \text{softmax}(\mathbf{z})_i = \frac{e^{z_i}}{\sum_{j} e^{z_j}}" />.
                Its partial derivative with respect to any input logit <Katex tex="z_j" /> is:
              </p>
              <div class="nn-equation-box">
                <Katex tex="\frac{\partial p_i}{\partial z_j} = p_i (\delta_{ij} - p_j)" display={true} />
              </div>
              <p>
                When logits have large variance (<Katex tex="\sigma \approx 11.3" />), the maximum logit <Katex tex="z_{\max}" /> severely outstrips all others, causing the softmax probability distribution to saturate into a one-hot distribution:
                <Katex tex="p_{\max} \approx 1.0" /> and <Katex tex="p_k \approx 0.0" /> for all <Katex tex="k \neq \max" />.
                Substituting these saturated probabilities back into the derivative:
              </p>
              <div class="nn-equation-box">
                <Katex
                  tex="\frac{\partial p_{\max}}{\partial z_{\max}} = p_{\max}(1 - p_{\max}) \approx 1 \times (1 - 1) = 0, \quad \frac{\partial p_k}{\partial z_k} \approx 0 \times (1 - 0) = 0"
                  display={true}
                />
              </div>
              <p>
                Gradients vanish entirely, and backpropagation fails to update earlier layers.
              </p>

              <h4>5. Temperature Rescaling to Unit Variance</h4>
              <p>
                By dividing the raw dot product by <Katex tex="\sqrt{d_k}" />, the variance of the scaled attention scores becomes:
              </p>
              <div class="nn-equation-box">
                <Katex
                  tex="\text{Var}\left(\frac{\mathbf{q} \cdot \mathbf{k}}{\sqrt{d_k}}\right) = \frac{1}{(\sqrt{d_k})^2} \text{Var}(\mathbf{q} \cdot \mathbf{k}) = \frac{1}{d_k} \cdot d_k = 1"
                  display={true}
                />
              </div>
              <p class="nn-callout-text">
                <strong>Key Takeaway:</strong> Scaling by <Katex tex="1/\sqrt{d_k}" /> guarantees that the variance of the attention logits remains precisely <Katex tex="1.0" /> regardless of projection dimension, maintaining softmax sensitivity and preventing gradient collapse across arbitrarily deep networks.
              </p>
            </div>
          </details>

          <!-- Accordion 2: Pre-LN vs Post-LN & The Gradient Highway -->
          <details class="nn-accordion">
            <summary class="nn-accordion-trigger">
              <span class="nn-accordion-title">
                <span class="nn-acc-icon">🛣️</span>
                Pre-LN vs Post-LN & The Gradient Highway (Enabling 70B+ Scale)
              </span>
              <span class="nn-accordion-chevron" aria-hidden="true">▾</span>
            </summary>
            <div class="nn-accordion-content">
              <p>
                The placement of normalization layers represents one of the most critical architectural evolutions between the original 2017 Transformer and modern foundation LLMs (LLaMA, Mistral, Gemma, DeepSeek).
              </p>

              <div class="nn-layout-comparison">
                <div class="nn-layout-col">
                  <h4>1. Classical Post-LN (Vaswani et al. 2017)</h4>
                  <div class="nn-equation-box">
                    <Katex tex="x_l = \text{LayerNorm}(x_{l-1} + \text{SubLayer}(x_{l-1}))" display={true} />
                  </div>
                  <p>
                    The residual stream passes directly <em>through</em> the normalization operator at every single layer.
                    By the chain rule, gradients propagating backwards from layer <Katex tex="L" /> to layer <Katex tex="0" /> are iteratively multiplied by the LayerNorm Jacobian:
                  </p>
                  <div class="nn-equation-box">
                    <Katex
                      tex="\frac{\partial x_L}{\partial x_0} = \prod_{l=1}^{L} \left[ J_{\text{LN}}(z_l) \cdot \left( I + J_{\text{SubLayer}}(x_{l-1}) \right) \right]"
                      display={true}
                    />
                  </div>
                  <p>
                    Because LayerNorm rescales activations by <Katex tex="1/\sigma" />, gradient norms decay exponentially with depth as <Katex tex="O(1/\sqrt{L})" />.
                    Training Post-LN models requires an ultra-delicate learning rate warmup schedule, and training often destabilizes beyond 12 layers.
                  </p>
                </div>

                <div class="nn-layout-col">
                  <h4>2. Modern Pre-LN (Radford et al. 2019 / LLaMA)</h4>
                  <div class="nn-equation-box">
                    <Katex tex="x_l = x_{l-1} + \text{SubLayer}(\text{Norm}(x_{l-1}))" display={true} />
                  </div>
                  <p>
                    The residual connection is purely additive and completely bypasses the normalization step:
                  </p>
                  <div class="nn-equation-box">
                    <Katex
                      tex="x_L = x_0 + \sum_{l=1}^{L} \text{SubLayer}(\text{Norm}(x_{l-1}))"
                      display={true}
                    />
                  </div>
                  <p>
                    Differentiating the final state <Katex tex="x_L" /> with respect to input embeddings <Katex tex="x_0" />:
                  </p>
                  <div class="nn-equation-box">
                    <Katex
                      tex="\frac{\partial x_L}{\partial x_0} = I + \sum_{l=1}^{L} \frac{\partial \text{SubLayer}(\text{Norm}(x_{l-1}))}{\partial x_0}"
                      display={true}
                    />
                  </div>
                  <p>
                    The leading identity matrix <Katex tex="I" /> guarantees an unattenuated, clean "gradient highway" from the final loss directly to the input representations.
                  </p>
                </div>
              </div>

              <p class="nn-callout-text">
                <strong>Why Modern LLMs Use Pre-RMSNorm:</strong> Pre-LN eliminates the need for delicate warmups and enables training networks with hundreds of layers (e.g. LLaMA 70B with 80 layers). Furthermore, replacing LayerNorm with RMSNorm (<Katex tex="x / \text{RMS}(x)" />) discards mean centering, saving <Katex tex="\approx 10\%" /> to <Katex tex="15\%" /> of memory bandwidth without any degradation in perplexity.
              </p>
            </div>
          </details>

          <!-- Accordion 3: FlashAttention-2, Tiling & Online Softmax -->
          <details class="nn-accordion">
            <summary class="nn-accordion-trigger">
              <span class="nn-accordion-title">
                <span class="nn-acc-icon">⚡</span>
                FlashAttention-2, Tiling & Online Softmax (IO-Aware Exact Attention)
              </span>
              <span class="nn-accordion-chevron" aria-hidden="true">▾</span>
            </summary>
            <div class="nn-accordion-content">
              <p>
                On modern GPU hardware (NVIDIA A100, H100, B200), compute throughput (Tensor Cores) has scaled dramatically faster than memory bandwidth (HBM).
                Consequently, standard self-attention is not compute-bound—it is strictly <strong>memory bandwidth (IO) bound</strong>.
              </p>

              <h4>1. The Memory Hierarchy Bottleneck in Standard Attention</h4>
              <p>
                Modern accelerators feature a multi-tier memory hierarchy:
              </p>
              <ul class="nn-simple-list">
                <li><strong>High-Bandwidth Memory (HBM):</strong> Large capacity (80 GB), but relatively slow bandwidth (<Katex tex="\approx 3.35\text{ TB/s}" /> on H100 SXM).</li>
                <li><strong>On-Chip Static RAM (SRAM):</strong> Ultra-fast (<Katex tex="\approx 33\text{ TB/s}" />, <Katex tex="10\times" /> faster), but small capacity (<Katex tex="\approx 228\text{ KB}" /> per Streaming Multiprocessor, <Katex tex="\approx 50\text{ MB}" /> total).</li>
              </ul>

              <p>Standard attention materializes intermediate matrices in HBM at each step:</p>
              <ol class="nn-ordered-list">
                <li>Read <Katex tex="Q, K" /> from HBM <Katex tex="\to" /> compute <Katex tex="S = Q K^T \in \mathbb{R}^{N \times N}" /> in SRAM <Katex tex="\to" /> <strong>write <Katex tex="S" /> back to HBM</strong> (<Katex tex="O(N^2)" /> memory access).</li>
                <li>Read <Katex tex="S" /> from HBM <Katex tex="\to" /> compute <Katex tex="A = \text{softmax}(S)" /> in SRAM <Katex tex="\to" /> <strong>write <Katex tex="A" /> back to HBM</strong> (<Katex tex="O(N^2)" /> memory access).</li>
                <li>Read <Katex tex="A, V" /> from HBM <Katex tex="\to" /> compute <Katex tex="O = A V \in \mathbb{R}^{N \times d}" /> <Katex tex="\to" /> write <Katex tex="O" /> to HBM.</li>
              </ol>

              <div class="nn-equation-box">
                <Katex
                  tex="\text{VRAM}_{\text{Standard}}(N = 32\text{k}, H = 32) = 32 \times (32{,}768)^2 \times 2\text{ bytes} \approx 68.7\text{ GB of intermediate storage!}"
                  display={true}
                />
              </div>

              <h4>2. FlashAttention Tiling & Online Softmax Algorithm</h4>
              <p>
                FlashAttention (Dao et al. 2022, 2023) completely avoids materializing the quadratic <Katex tex="N \times N" /> attention matrix in HBM.
                It partitions inputs into blocks <Katex tex="Q_i \in \mathbb{R}^{B_r \times d}" /> and <Katex tex="K_j, V_j \in \mathbb{R}^{B_c \times d}" /> that fit entirely within fast on-chip SRAM.
                To compute softmax without seeing all tokens at once, it utilizes the <strong>Online Softmax</strong> recurrence (Milakov & Gimelshein 2018):
              </p>

              <div class="nn-equation-box">
                <Katex
                  tex="m^{\text{new}} = \max\left(m^{(old)}, \max(x_j)\right)"
                  display={true}
                />
                <Katex
                  tex="d^{\text{new}} = d^{(old)} \cdot e^{m^{(old)} - m^{\text{new}}} + \sum_{k} e^{x_{j,k} - m^{\text{new}}}"
                  display={true}
                />
                <Katex
                  tex="O^{\text{new}} = O^{(old)} \cdot \left(\frac{d^{(old)} \cdot e^{m^{(old)} - m^{\text{new}}}}{d^{\text{new}}}\right) + \frac{\sum_k e^{x_{j,k} - m^{\text{new}}} v_{j,k}}{d^{\text{new}}}"
                  display={true}
                />
              </div>

              <p class="nn-callout-text">
                <strong>Theoretical IO Complexity:</strong> FlashAttention reduces total HBM data transfers from <Katex tex="O(N^2)" /> down to <Katex tex="O(N)" /> while computing mathematically <em>exact</em> (non-approximate) attention. This yields a <Katex tex="2\times" /> to <Katex tex="4\times" /> wall-clock speedup and enables context windows of <Katex tex="128\text{k}" /> to <Katex tex="1\text{M}" /> tokens.
              </p>
            </div>
          </details>

          <!-- Accordion 4: MHA vs MQA vs GQA & The KV Cache Decoding Bottleneck -->
          <details class="nn-accordion">
            <summary class="nn-accordion-trigger">
              <span class="nn-accordion-title">
                <span class="nn-acc-icon">🧠</span>
                MHA vs MQA vs GQA & The KV Cache Decoding Bottleneck
              </span>
              <span class="nn-accordion-chevron" aria-hidden="true">▾</span>
            </summary>
            <div class="nn-accordion-content">
              <p>
                In production LLM serving, generation takes place token-by-token in an autoregressive loop.
                While the initial prompt processing (prefill) is compute-heavy, autoregressive generation (decoding) is strictly limited by memory bandwidth.
              </p>

              <h4>1. Arithmetic Intensity of Autoregressive Decoding</h4>
              <p>
                To generate token <Katex tex="t+1" />, the query is a single vector <Katex tex="\mathbf{q}_{t+1} \in \mathbb{R}^{1 \times d_{\text{model}}}" />.
                However, to attend to all preceding context tokens, the GPU must fetch all previously computed Key and Value vectors for all layers from HBM:
              </p>
              <div class="nn-equation-box">
                <Katex
                  tex="\text{Arithmetic Intensity} = \frac{\text{Floating Point Operations (FLOPs)}}{\text{Bytes Transferred (HBM)}} \approx \frac{2 \times d_{\text{model}}}{2 \times d_{\text{model}}} \approx 1\text{ FLOP / byte}"
                  display={true}
                />
              </div>
              <p>
                Modern Tensor Cores operate at hundreds of teraflops, yet memory bus speeds are orders of magnitude lower.
                During generation, GPU compute cores idle for over 95% of execution time waiting for KV cache memory loads!
              </p>

              <h4>2. Memory Scaling Comparison: MHA vs MQA vs GQA</h4>
              <p>
                Consider serving a 70B parameter model (<Katex tex="L = 80" /> layers, <Katex tex="H = 64" /> heads, <Katex tex="d_{\text{head}} = 128" />) with sequence length <Katex tex="S = 4096" /> and batch size <Katex tex="B = 16" /> in FP16 precision (2 bytes):
              </p>

              <div class="nn-layout-comparison">
                <div class="nn-layout-col">
                  <h4>Multi-Head Attention (MHA)</h4>
                  <p>Each Query head possesses its own Key and Value projection (<Katex tex="H_{\text{KV}} = H = 64" />):</p>
                  <div class="nn-equation-box">
                    <Katex
                      tex="\text{VRAM}_{\text{MHA}} = 2 \times B \times L \times H \times S \times d_{\text{head}} \times 2\text{ B}"
                      display={true}
                    />
                    <Katex
                      tex="\text{VRAM} = 2 \times 16 \times 80 \times 64 \times 4096 \times 128 \times 2 \approx \mathbf{171.8\text{ GB}}"
                      display={true}
                    />
                  </div>
                  <p>Serving a single batch of 16 sequences exceeds the total capacity of two 80 GB GPUs purely for the KV cache!</p>
                </div>

                <div class="nn-layout-col">
                  <h4>Grouped-Query Attention (GQA)</h4>
                  <p>Multiple Query heads share a single Key/Value head (<Katex tex="H_{\text{KV}} = 8" />, an 8:1 sharing ratio):</p>
                  <div class="nn-equation-box">
                    <Katex
                      tex="\text{VRAM}_{\text{GQA}} = 2 \times B \times L \times H_{\text{KV}} \times S \times d_{\text{head}} \times 2\text{ B}"
                      display={true}
                    />
                    <Katex
                      tex="\text{VRAM} = 2 \times 16 \times 80 \times 8 \times 4096 \times 128 \times 2 \approx \mathbf{21.5\text{ GB}}"
                      display={true}
                    />
                  </div>
                  <p>An <Katex tex="8\times" /> reduction in memory bandwidth and storage with near-identical modeling performance.</p>
                </div>
              </div>

              <div class="nn-table-responsive">
                <table class="nn-comparison-table">
                  <thead>
                    <tr>
                      <th>Architecture</th>
                      <th>Q Heads</th>
                      <th>KV Heads</th>
                      <th>Sharing Ratio</th>
                      <th>70B KV Cache (B=16, S=4k)</th>
                      <th>Throughput Relative</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td><strong>MHA</strong> (Vaswani 2017)</td>
                      <td>64</td>
                      <td>64</td>
                      <td>1 : 1</td>
                      <td>171.8 GB</td>
                      <td>1.0× (Baseline)</td>
                    </tr>
                    <tr>
                      <td><strong>GQA</strong> (Ainslie 2023 / LLaMA 3)</td>
                      <td>64</td>
                      <td>8</td>
                      <td>8 : 1</td>
                      <td>21.5 GB</td>
                      <td><strong>4.2×</strong></td>
                    </tr>
                    <tr>
                      <td><strong>MQA</strong> (Shazeer 2019)</td>
                      <td>64</td>
                      <td>1</td>
                      <td>64 : 1</td>
                      <td>2.7 GB</td>
                      <td>5.8× (Quality Degrades)</td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <p class="nn-callout-text">
                <strong>The Architectural Verdict:</strong> While MQA achieves maximum bandwidth reduction, empirical research demonstrates quality degradation on complex reasoning and long-context retrieval tasks. GQA strikes the optimal Pareto frontier, achieving <Katex tex="95\%" /> of MQA's speed with <Katex tex="100\%" /> of MHA's quality.
              </p>
            </div>
          </details>
        </div>
