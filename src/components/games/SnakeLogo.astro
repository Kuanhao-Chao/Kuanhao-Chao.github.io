---
interface Props {
  size?: number;
  class?: string;
}

const { size = 64, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class:list={['snake-logo', className]}
  role="img"
  aria-label="Snake Logo — Genomic nucleotide serpent striking toward a double-helix fruit"
>
  <defs>
    <!-- Background Aura -->
    <radialGradient id="snk-aura" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="var(--color-accent, #2e6e5e)" stop-opacity="0.25" />
      <stop offset="100%" stop-color="var(--color-accent, #2e6e5e)" stop-opacity="0" />
    </radialGradient>

    <!-- Serpent Head Gradient -->
    <linearGradient id="snk-head-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#10b981" />
      <stop offset="50%" stop-color="#059669" />
      <stop offset="100%" stop-color="#047857" />
    </linearGradient>

    <!-- Target Fruit Gradient -->
    <radialGradient id="snk-fruit-grad" cx="40%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="50%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#d97706" />
    </radialGradient>

    <!-- Glow Filter -->
    <filter id="snk-glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- 1. Ambient Backdrop Aura -->
  <circle cx="50" cy="50" r="46" fill="url(#snk-aura)" />
  <circle
    cx="50"
    cy="50"
    r="44"
    fill="none"
    stroke="var(--color-rule, #e5e4df)"
    stroke-width="1.2"
    stroke-dasharray="4 3"
    opacity="0.6"
  />

  <!-- 2. Phosphodiester Backbone Connecting Line -->
  <path
    d="M 22 76 C 18 64, 22 48, 36 48 C 50 48, 54 68, 68 68 C 76 68, 80 56, 76 42"
    fill="none"
    stroke="var(--color-rule, #e5e4df)"
    stroke-width="3"
    stroke-linecap="round"
  />

  <!-- 3. Segmented Nucleotide Body Badges -->
  <g class="snk-body-segments" filter="url(#snk-glow)">
    <!-- Segment 1: Base T (Purple) -->
    <g transform="translate(22, 76)">
      <circle cx="0" cy="0" r="7.5" fill="#a855f7" stroke="var(--color-surface, #ffffff)" stroke-width="1.4" />
      <text x="0" y="2.2" font-family="monospace" font-size="7.5" font-weight="bold" fill="#ffffff" text-anchor="middle">T</text>
    </g>

    <!-- Segment 2: Base G (Amber) -->
    <g transform="translate(22, 54)">
      <circle cx="0" cy="0" r="7.5" fill="#f59e0b" stroke="var(--color-surface, #ffffff)" stroke-width="1.4" />
      <text x="0" y="2.2" font-family="monospace" font-size="7.5" font-weight="bold" fill="#ffffff" text-anchor="middle">G</text>
    </g>

    <!-- Segment 3: Base C (Cyan) -->
    <g transform="translate(38, 48)">
      <circle cx="0" cy="0" r="8" fill="#0284c7" stroke="var(--color-surface, #ffffff)" stroke-width="1.4" />
      <text x="0" y="2.4" font-family="monospace" font-size="8" font-weight="bold" fill="#ffffff" text-anchor="middle">C</text>
    </g>

    <!-- Segment 4: Base A (Emerald) -->
    <g transform="translate(54, 62)">
      <circle cx="0" cy="0" r="8.5" fill="#059669" stroke="var(--color-surface, #ffffff)" stroke-width="1.4" />
      <text x="0" y="2.5" font-family="monospace" font-size="8.5" font-weight="bold" fill="#ffffff" text-anchor="middle">A</text>
    </g>

    <!-- Segment 5: Base U (Purple) -->
    <g transform="translate(70, 66)">
      <circle cx="0" cy="0" r="9" fill="#7c3aed" stroke="var(--color-surface, #ffffff)" stroke-width="1.4" />
      <text x="0" y="2.6" font-family="monospace" font-size="9" font-weight="bold" fill="#ffffff" text-anchor="middle">U</text>
    </g>

    <!-- Segment 6: Base G (Amber) -->
    <g transform="translate(77, 48)">
      <circle cx="0" cy="0" r="9.5" fill="#f59e0b" stroke="var(--color-surface, #ffffff)" stroke-width="1.4" />
      <text x="0" y="2.8" font-family="monospace" font-size="9.5" font-weight="bold" fill="#ffffff" text-anchor="middle">G</text>
    </g>
  </g>

  <!-- 4. Genomic Serpent Head -->
  <g class="snk-head" transform="translate(68, 28)">
    <!-- Head Outline -->
    <path
      d="M -6 10 C -12 2, -6 -10, 8 -8 C 18 -6, 20 4, 12 12 C 4 18, -2 16, -6 10 Z"
      fill="url(#snk-head-grad)"
      stroke="var(--color-surface, #ffffff)"
      stroke-width="1.6"
    />

    <!-- Bio-crest Ridge -->
    <path d="M 0 -7 C 5 -12, 12 -10, 14 -5" fill="none" stroke="#fef08a" stroke-width="1.4" stroke-linecap="round" />

    <!-- Eye -->
    <circle cx="6" cy="-1" r="3" fill="#ffffff" />
    <circle cx="7" cy="-1" r="1.5" fill="#047857" />

    <!-- Cute Flicking Tongue targeting the fruit -->
    <path d="M 16 8 L 24 10 L 28 8 M 24 10 L 28 13" fill="none" stroke="#f43f5e" stroke-width="1.2" stroke-linecap="round" />
  </g>

  <!-- 5. Glowing Double-Helix Target Fruit (Adenine Target) -->
  <g class="snk-fruit" transform="translate(42, 22)">
    <circle cx="0" cy="0" r="10" fill="url(#snk-fruit-grad)" stroke="#ffffff" stroke-width="1.5" />
    <!-- Leaf / Double-Helix Flag -->
    <path d="M 0 -9 C -4 -16, 2 -18, 5 -14 C 6 -11, 2 -10, 0 -9 Z" fill="#10b981" />
    <!-- Inner Base Marker -->
    <text x="0" y="3.2" font-family="monospace" font-size="9.5" font-weight="bold" fill="#ffffff" text-anchor="middle">A</text>
  </g>
</svg>

<style>
  .snake-logo {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.12));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .snake-logo:hover {
    transform: scale(1.06) translateY(-2px);
  }
</style>
