---
interface Props {
  size?: number;
  class?: string;
}

const { size = 64, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class:list={['snake-logo', className]}
  role="img"
  aria-label="Snake Logo — Cybernetic genomic nucleotide serpent striking toward a radiant double-helix golden apple"
>
  <defs>
    <!-- Background Bio-Cellular Aura -->
    <radialGradient id="snk-bg-aura" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#10b981" stop-opacity="0.32" />
      <stop offset="60%" stop-color="#064e3b" stop-opacity="0.15" />
      <stop offset="100%" stop-color="#020617" stop-opacity="0" />
    </radialGradient>

    <!-- Outer Medallion Border -->
    <linearGradient id="snk-border-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#34d399" />
      <stop offset="50%" stop-color="#10b981" />
      <stop offset="100%" stop-color="#047857" />
    </linearGradient>

    <!-- Serpent Head 3D Gradient -->
    <linearGradient id="snk-head-metal" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#6ee7b7" />
      <stop offset="35%" stop-color="#10b981" />
      <stop offset="75%" stop-color="#047857" />
      <stop offset="100%" stop-color="#022c22" />
    </linearGradient>

    <!-- Phosphodiester Backbone Ribbon -->
    <linearGradient id="snk-backbone" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#a7f3d0" />
      <stop offset="50%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#818cf8" />
    </linearGradient>

    <!-- Golden Apple 3D Fruit -->
    <radialGradient id="snk-gold-apple" cx="35%" cy="30%" r="70%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="25%" stop-color="#fef08a" />
      <stop offset="65%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#b45309" />
    </radialGradient>

    <!-- Nucleotide Jewel Gradients -->
    <!-- Base A (Emerald) -->
    <radialGradient id="snk-gem-a" cx="35%" cy="30%" r="70%">
      <stop offset="0%" stop-color="#a7f3d0" />
      <stop offset="50%" stop-color="#10b981" />
      <stop offset="100%" stop-color="#064e3b" />
    </radialGradient>
    <!-- Base T / U (Amethyst Violet) -->
    <radialGradient id="snk-gem-t" cx="35%" cy="30%" r="70%">
      <stop offset="0%" stop-color="#e9d5ff" />
      <stop offset="50%" stop-color="#a855f7" />
      <stop offset="100%" stop-color="#581c87" />
    </radialGradient>
    <!-- Base G (Topaz Amber) -->
    <radialGradient id="snk-gem-g" cx="35%" cy="30%" r="70%">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="50%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#78350f" />
    </radialGradient>
    <!-- Base C (Sapphire Cyan) -->
    <radialGradient id="snk-gem-c" cx="35%" cy="30%" r="70%">
      <stop offset="0%" stop-color="#e0f2fe" />
      <stop offset="50%" stop-color="#0284c7" />
      <stop offset="100%" stop-color="#082f49" />
    </radialGradient>

    <!-- Glow & Shadow Filters -->
    <filter id="snk-glow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <filter id="snk-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="1.5" dy="2.5" stdDeviation="2" flood-color="#000000" flood-opacity="0.45" />
    </filter>
  </defs>

  <!-- 1. Ambient Bio-Aura Backdrop -->
  <circle cx="50" cy="50" r="47" fill="url(#snk-bg-aura)" />

  <!-- 2. Circular Outer Medallion Frame -->
  <circle
    cx="50"
    cy="50"
    r="46"
    fill="#0a131c"
    stroke="url(#snk-border-grad)"
    stroke-width="2.2"
  />

  <!-- Subtle Cellular Orbitals & Cytoplasm Coordinates -->
  <g stroke="#132a26" stroke-width="0.8" opacity="0.6">
    <circle cx="50" cy="50" r="38" fill="none" stroke-dasharray="3, 4" />
    <circle cx="50" cy="50" r="26" fill="none" stroke-dasharray="2, 4" />
    <line x1="12" y1="50" x2="88" y2="50" stroke-dasharray="2, 5" />
    <line x1="50" y1="12" x2="50" y2="88" stroke-dasharray="2, 5" />
  </g>

  <!-- 3. Phosphodiester Double-Helix Spine & Ribose Rail -->
  <path
    d="M 18 80 C 12 62, 20 44, 35 44 C 48 44, 52 68, 68 68 C 76 68, 84 56, 78 38"
    fill="none"
    stroke="url(#snk-backbone)"
    stroke-width="4.5"
    stroke-linecap="round"
    filter="url(#snk-glow)"
    opacity="0.85"
  />
  <path
    d="M 18 80 C 12 62, 20 44, 35 44 C 48 44, 52 68, 68 68 C 76 68, 84 56, 78 38"
    fill="none"
    stroke="#ffffff"
    stroke-width="1.2"
    stroke-linecap="round"
  />

  <!-- 4. Segmented Nucleotide Body Scales (T -> G -> C -> A -> U -> G) -->
  <g class="snk-body-segments" filter="url(#snk-shadow)">
    <!-- Segment 1: Base T (Violet) -->
    <g transform="translate(18, 80)">
      <circle cx="0" cy="0" r="8.5" fill="url(#snk-gem-t)" stroke="#ffffff" stroke-width="1.2" />
      <circle cx="-2.5" cy="-2.5" r="2.2" fill="#ffffff" opacity="0.6" />
      <text x="0" y="2.8" font-family="monospace" font-size="8.5" font-weight="900" fill="#ffffff" text-anchor="middle">T</text>
    </g>

    <!-- Segment 2: Base G (Amber) -->
    <g transform="translate(20, 56)">
      <circle cx="0" cy="0" r="8.8" fill="url(#snk-gem-g)" stroke="#ffffff" stroke-width="1.2" />
      <circle cx="-2.5" cy="-2.5" r="2.2" fill="#ffffff" opacity="0.6" />
      <text x="0" y="2.8" font-family="monospace" font-size="8.8" font-weight="900" fill="#ffffff" text-anchor="middle">G</text>
    </g>

    <!-- Segment 3: Base C (Sapphire Cyan) -->
    <g transform="translate(36, 45)">
      <circle cx="0" cy="0" r="9.2" fill="url(#snk-gem-c)" stroke="#ffffff" stroke-width="1.2" />
      <circle cx="-2.8" cy="-2.8" r="2.4" fill="#ffffff" opacity="0.6" />
      <text x="0" y="3" font-family="monospace" font-size="9.2" font-weight="900" fill="#ffffff" text-anchor="middle">C</text>
    </g>

    <!-- Segment 4: Base A (Emerald) -->
    <g transform="translate(54, 60)">
      <circle cx="0" cy="0" r="9.5" fill="url(#snk-gem-a)" stroke="#ffffff" stroke-width="1.2" />
      <circle cx="-3" cy="-3" r="2.5" fill="#ffffff" opacity="0.6" />
      <text x="0" y="3.2" font-family="monospace" font-size="9.5" font-weight="900" fill="#ffffff" text-anchor="middle">A</text>
    </g>

    <!-- Segment 5: Base U (Purple) -->
    <g transform="translate(69, 66)">
      <circle cx="0" cy="0" r="10" fill="url(#snk-gem-t)" stroke="#ffffff" stroke-width="1.3" />
      <circle cx="-3.2" cy="-3.2" r="2.6" fill="#ffffff" opacity="0.6" />
      <text x="0" y="3.4" font-family="monospace" font-size="10" font-weight="900" fill="#ffffff" text-anchor="middle">U</text>
    </g>

    <!-- Segment 6: Base G (Amber Neck) -->
    <g transform="translate(78, 48)">
      <circle cx="0" cy="0" r="10.5" fill="url(#snk-gem-g)" stroke="#ffffff" stroke-width="1.4" />
      <circle cx="-3.5" cy="-3.5" r="2.8" fill="#ffffff" opacity="0.6" />
      <text x="0" y="3.5" font-family="monospace" font-size="10.5" font-weight="900" fill="#ffffff" text-anchor="middle">G</text>
    </g>
  </g>

  <!-- 5. Fierce & Expressive Cybernetic Serpent Head -->
  <g class="snk-head" transform="translate(72, 26)" filter="url(#snk-glow)">
    <!-- Aerodynamic Skull Head Shape -->
    <path
      d="M -9 14 C -16 4, -10 -12, 8 -10 C 20 -8, 24 4, 15 16 C 6 22, -4 20, -9 14 Z"
      fill="url(#snk-head-metal)"
      stroke="#ffffff"
      stroke-width="1.6"
      stroke-linejoin="round"
    />

    <!-- Golden Horned Crest Ridge -->
    <path
      d="M -2 -9 C 5 -16, 15 -14, 17 -7"
      fill="none"
      stroke="#fef08a"
      stroke-width="2"
      stroke-linecap="round"
    />
    <circle cx="17" cy="-7" r="1.4" fill="#fbbf24" />

    <!-- Specular Head Highlight -->
    <path
      d="M -5 -2 C -2 -7, 6 -6, 9 -3"
      fill="none"
      stroke="#ffffff"
      stroke-width="1.2"
      stroke-linecap="round"
      opacity="0.75"
    />

    <!-- Predatory Cyber Visor / Eye -->
    <circle cx="8" cy="-2" r="3.6" fill="#022c22" stroke="#ffffff" stroke-width="0.9" />
    <circle cx="8" cy="-2" r="2.2" fill="#38bdf8" />
    <circle cx="7" cy="-3" r="0.9" fill="#ffffff" />

    <!-- Flickering Sensor Forked Tongue (Poised to devour target) -->
    <path
      d="M 18 12 L 27 14 L 33 10 M 27 14 L 33 18"
      fill="none"
      stroke="#f43f5e"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </g>

  <!-- 6. Glowing Double-Helix Golden Apple Target Fruit -->
  <g class="snk-fruit" transform="translate(38, 20)" filter="url(#snk-glow)">
    <!-- Radiant Pulse Aura Ring -->
    <circle cx="0" cy="0" r="15" fill="none" stroke="#fbbf24" stroke-width="1.2" stroke-dasharray="3, 3" opacity="0.8">
      <animate attributeName="r" values="13;17;13" dur="2.4s" repeatCount="indefinite" />
      <animate attributeName="opacity" values="0.8;0.3;0.8" dur="2.4s" repeatCount="indefinite" />
    </circle>

    <!-- 3D Golden Apple Sphere -->
    <circle cx="0" cy="0" r="11" fill="url(#snk-gold-apple)" stroke="#ffffff" stroke-width="1.8" />

    <!-- Orbiting Double Helix DNA Rings -->
    <ellipse cx="0" cy="0" rx="14" ry="5.5" fill="none" stroke="#38bdf8" stroke-width="1.1" transform="rotate(-25)" opacity="0.85" />
    <ellipse cx="0" cy="0" rx="14" ry="5.5" fill="none" stroke="#f43f5e" stroke-width="1.1" transform="rotate(25)" opacity="0.85" />

    <!-- Chloroplast Green Leaf Stem -->
    <path
      d="M 0 -11 C -4 -18, 4 -20, 7 -15 C 8 -12, 2 -11, 0 -11 Z"
      fill="#10b981"
      stroke="#ffffff"
      stroke-width="0.8"
    />

    <!-- Specular Reflection Gleam -->
    <circle cx="-3.5" cy="-4" r="2.5" fill="#ffffff" opacity="0.8" />

    <!-- Core Target Symbol A (Adenine) -->
    <text
      x="0"
      y="3.8"
      font-family="monospace"
      font-size="10.5"
      font-weight="900"
      fill="#ffffff"
      text-anchor="middle"
    >A</text>
  </g>
</svg>

<style>
  .snake-logo {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
    filter: drop-shadow(0 4px 12px rgba(16, 185, 129, 0.25));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.25s ease;
  }

  :global(.tool:hover) .snake-logo,
  .snake-logo:hover {
    transform: translateY(-2px) scale(1.06);
    filter: drop-shadow(0 6px 20px rgba(52, 211, 153, 0.45));
  }
</style>
