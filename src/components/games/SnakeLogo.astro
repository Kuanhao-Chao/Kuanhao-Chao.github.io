---
import GameIconFrame from './GameIconFrame.astro';
interface Props {
  size?: number;
  class?: string;
}
const { size = 64, class: className = '' } = Astro.props;
---

<GameIconFrame
  size={size}
  class={`snake-logo ${className}`}
  label="Snake — a curled nucleotide-colored serpent"
  accent="#3e8b76"
>
  <path
    d="M25 76 H56 Q77 76 77 59 Q77 44 61 44 H36 Q23 44 23 32 Q23 21 37 21 H48"
    fill="none"
    stroke="var(--gi-deep)"
    stroke-width="18"></path>
  <path
    d="M25 76 H56 Q77 76 77 59 Q77 44 61 44 H36 Q23 44 23 32 Q23 21 37 21 H48"
    fill="none"
    stroke="var(--gi-accent)"
    stroke-width="13"></path>
  <path
    d="M29 74 H47 M68 66 Q74 57 66 49 M27 30 Q27 24 36 24"
    fill="none"
    stroke="var(--gi-light)"
    stroke-width="3"
    opacity=".6"></path>
  <path d="M31 69 V82" stroke="#c7b06a" stroke-width="5"></path>
  <path d="M47 69 V82" stroke="#87abc0" stroke-width="5"></path>
  <path d="M63 47 V41" stroke="#c7867d" stroke-width="5"></path>
  <path d="M40 47 V41" stroke="#9cb67b" stroke-width="5"></path>
  <rect
    x="43"
    y="13"
    width="28"
    height="20"
    rx="9"
    fill="var(--gi-mid)"
    stroke="var(--gi-deep)"
    stroke-width="2.5"></rect>
  <circle cx="62" cy="19" r="2" fill="var(--gi-deep)"></circle>
  <path d="M64 28 H72 L77 25 M72 28 L77 31" fill="none" stroke="#b56c69" stroke-width="2"></path>
  <circle cx="81" cy="24" r="4" fill="#c7a74f" stroke="#8b742f" stroke-width="2"></circle>
</GameIconFrame>
