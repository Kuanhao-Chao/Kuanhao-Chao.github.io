---
import GameIconFrame from './GameIconFrame.astro';
interface Props {
  size?: number;
  class?: string;
}
const { size = 64, class: className = '' } = Astro.props;
---

<GameIconFrame
  size={size}
  class={`snake-logo ${className}`}
  label="Snake — a pixel-art nucleotide serpent and golden bonus chip"
  accent="#498f77"
>
  <g shape-rendering="crispEdges">
    <path d="M24 24H58V42H38V50H70V78H24V62H54V66H58V62H24V36H24Z" fill="var(--gi-deep)"></path>
    <path d="M28 28H54V38H32V54H66V74H28V66H58V58H28Z" fill="var(--gi-accent)"></path>
    <path d="M46 20H68V40H46Z" fill="var(--gi-deep)"></path>
    <path d="M50 24H64V36H50Z" fill="var(--gi-mid)"></path>
    <path d="M60 26H64V30H60ZM60 32H64V36H60Z" fill="var(--gi-deep)"></path>
    <path d="M30 32H36V38H30Z" fill="#e7bc69"></path>
    <path d="M30 52H36V58H30Z" fill="#a5c8df"></path>
    <path d="M58 66H64V72H58Z" fill="#c69ace"></path>
    <path d="M76 24H80V42H76ZM70 30H86V36H70Z" fill="#d8b164"></path>
    <path d="M30 28H44V30H30ZM34 68H46V70H34Z" fill="var(--gi-light)"></path>
  </g>
</GameIconFrame>
