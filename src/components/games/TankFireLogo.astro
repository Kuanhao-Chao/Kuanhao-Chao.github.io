---
import GameIconFrame from './GameIconFrame.astro';
interface Props {
  size?: number;
  class?: string;
}
const { size = 64, class: className = '' } = Astro.props;
---

<GameIconFrame
  size={size}
  class={`tank-fire-logo ${className}`}
  label="Tank Fire — an illustrated battle tank"
  accent="#6a7854"
>
  <path
    d="M18 65 L26 44 H62 L76 64Z"
    fill="var(--gi-accent)"
    stroke="var(--gi-deep)"
    stroke-width="3"></path>
  <path d="M26 44 H62 L69 54 H23Z" fill="var(--gi-mid)"></path>
  <rect x="16" y="60" width="65" height="20" rx="10" fill="var(--gi-deep)"></rect>
  <rect x="21" y="65" width="55" height="10" rx="5" fill="#a7ae91"></rect>
  <g fill="var(--gi-deep)">
    <circle cx="28" cy="70" r="3.5"></circle><circle cx="41" cy="70" r="3.5"></circle>
    <circle cx="54" cy="70" r="3.5"></circle><circle cx="67" cy="70" r="3.5"></circle>
  </g>
  <path
    d="M31 43 V33 Q31 28 36 28 H51 Q57 28 60 34 L63 43Z"
    fill="var(--gi-accent)"
    stroke="var(--gi-deep)"
    stroke-width="3"></path>
  <path d="M34 32 H50 L54 36 H34Z" fill="var(--gi-light)" opacity=".7"></path>
  <path d="M58 33 H82 V41 H58" fill="var(--gi-mid)" stroke="var(--gi-deep)" stroke-width="3"></path>
  <path d="M79 32 V42" stroke="var(--gi-deep)" stroke-width="4"></path>
  <path d="M37 27 V22 H50" fill="none" stroke="var(--gi-deep)" stroke-width="3"></path>
  <path d="M31 54 H51" stroke="var(--gi-light)" stroke-width="3" opacity=".6"></path>
  <circle cx="66" cy="55" r="3" fill="#e6cf91"></circle>
</GameIconFrame>
