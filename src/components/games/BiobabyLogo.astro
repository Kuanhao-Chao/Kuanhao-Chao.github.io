---
interface Props {
  size?: number;
  class?: string;
}

const { size = 64, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class:list={['biobaby-logo', className]}
  role="img"
  aria-label="Biobaby Logo — Superhero cape-wearing baby with pacifier and finger-gun molecular blast"
>
  <defs>
    <!-- Background aura radial gradient -->
    <radialGradient id="bb-aura" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.25" />
      <stop offset="70%" stop-color="#0284c7" stop-opacity="0.08" />
      <stop offset="100%" stop-color="#0284c7" stop-opacity="0" />
    </radialGradient>

    <!-- Baby skin gradient -->
    <linearGradient id="bb-skin" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fff1e6" />
      <stop offset="50%" stop-color="#fed7aa" />
      <stop offset="100%" stop-color="#fdba74" />
    </linearGradient>

    <!-- Baby hair gradient -->
    <linearGradient id="bb-hair" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#94a3b8" />
      <stop offset="100%" stop-color="#64748b" />
    </linearGradient>

    <!-- Shorts / Diaper gradient -->
    <linearGradient id="bb-shorts" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="60%" stop-color="#0284c7" />
      <stop offset="100%" stop-color="#0369a1" />
    </linearGradient>

    <!-- Cape gradient -->
    <linearGradient id="bb-cape" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#475569" />
      <stop offset="50%" stop-color="#334155" />
      <stop offset="100%" stop-color="#1e293b" />
    </linearGradient>

    <!-- Energy blast laser gradient -->
    <linearGradient id="bb-laser" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="50%" stop-color="#fbbf24" />
      <stop offset="100%" stop-color="#f43f5e" />
    </linearGradient>

    <!-- Glow filter -->
    <filter id="bb-glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="1.5" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- 1. Ambient Superhero Bio-Aura -->
  <circle cx="50" cy="50" r="46" fill="url(#bb-aura)" />
  <circle
    cx="50"
    cy="50"
    r="44"
    fill="none"
    stroke="var(--color-rule, #e5e4df)"
    stroke-width="1.2"
    stroke-dasharray="4 3"
    opacity="0.65"
  />

  <!-- 2. Trailing Superhero Cape -->
  <g class="bb-cape" filter="url(#bb-glow)">
    <!-- Main billowing cape body -->
    <path
      d="M 46 56 C 42 66, 36 76, 24 86 C 20 89, 14 91, 16 93 C 24 90, 32 86, 42 78 C 48 72, 50 64, 48 58 Z"
      fill="url(#bb-cape)"
      stroke="#0f172a"
      stroke-width="1.4"
      stroke-linejoin="round"
    />
    <!-- Cape inner fold shadow -->
    <path
      d="M 44 60 C 38 70, 30 80, 18 89 C 24 87, 34 82, 42 74 Z"
      fill="#0f172a"
      opacity="0.35"
    />
  </g>

  <!-- 3. Legs & Feet -->
  <g class="bb-legs">
    <!-- Left Leg -->
    <path
      d="M 52 74 L 53 88 C 53 90, 54 90, 55 88 L 57 74 Z"
      fill="url(#bb-skin)"
      stroke="#0f172a"
      stroke-width="1.3"
      stroke-linejoin="round"
    />
    <!-- Right Leg -->
    <path
      d="M 58 74 L 60 86 C 60 88, 61 88, 62 86 L 63 74 Z"
      fill="url(#bb-skin)"
      stroke="#0f172a"
      stroke-width="1.3"
      stroke-linejoin="round"
    />
  </g>

  <!-- 4. Superhero Blue Shorts / Diaper -->
  <g class="bb-shorts">
    <!-- Main diaper body -->
    <path
      d="M 42 58 C 42 68, 48 76, 62 76 C 68 76, 68 68, 66 58 C 58 56, 50 56, 42 58 Z"
      fill="url(#bb-shorts)"
      stroke="#0f172a"
      stroke-width="1.5"
      stroke-linejoin="round"
    />
    <!-- Waistband ribbed border -->
    <path
      d="M 42 58 C 50 56, 58 56, 66 58"
      fill="none"
      stroke="#0f172a"
      stroke-width="1.4"
    />
    <path
      d="M 42 61 C 50 59, 58 59, 66 61"
      fill="none"
      stroke="#0f172a"
      stroke-width="1.1"
      stroke-dasharray="2 1.5"
    />
    <!-- Leg hem cuffs -->
    <line x1="48" y1="74" x2="56" y2="74" stroke="#0f172a" stroke-width="1.3" />
    <line x1="57" y1="74" x2="64" y2="74" stroke="#0f172a" stroke-width="1.3" />
  </g>

  <!-- 5. Torso & Arms -->
  <g class="bb-torso">
    <!-- Upper body torso -->
    <path
      d="M 46 44 C 44 48, 43 54, 43 58 C 50 56, 58 56, 64 58 C 63 52, 62 46, 60 44 Z"
      fill="url(#bb-skin)"
      stroke="#0f172a"
      stroke-width="1.4"
    />

    <!-- Left hand resting on cape back -->
    <path
      d="M 48 48 C 47 54, 46 62, 45 68 C 46 70, 48 70, 49 66 L 51 52 Z"
      fill="url(#bb-skin)"
      stroke="#0f172a"
      stroke-width="1.3"
      stroke-linejoin="round"
    />

    <!-- Right Arm pointing finger-gun (👉) -->
    <g class="bb-arm">
      <!-- Arm extending forward -->
      <path
        d="M 59 47 L 72 46 C 75 46, 75 48, 72 49 L 61 52 Z"
        fill="url(#bb-skin)"
        stroke="#0f172a"
        stroke-width="1.3"
      />
      <!-- Hand & Thumb pointing up -->
      <path
        d="M 72 46 L 73 43 C 73 42, 74 42, 74 44 L 74 46"
        fill="url(#bb-skin)"
        stroke="#0f172a"
        stroke-width="1.3"
      />
      <!-- Outstretched index finger -->
      <path
        d="M 72 46 L 80 46 C 81 46, 81 48, 80 48 L 73 49"
        fill="url(#bb-skin)"
        stroke="#0f172a"
        stroke-width="1.3"
        stroke-linejoin="round"
      />
      <!-- Curled fingers knuckles -->
      <path
        d="M 74 49 C 75 51, 74 52, 72 52"
        fill="none"
        stroke="#0f172a"
        stroke-width="1.2"
      />
    </g>
  </g>

  <!-- 6. Baby Head & Face -->
  <g class="bb-head">
    <!-- Big cute round head -->
    <path
      d="M 38 27 C 38 14, 52 7, 65 11 C 77 15, 80 28, 77 39 C 74 48, 64 51, 52 49 C 42 47, 38 38, 38 27 Z"
      fill="url(#bb-skin)"
      stroke="#0f172a"
      stroke-width="1.6"
      stroke-linejoin="round"
    />

    <!-- Cute hair tuft / curl at forehead -->
    <path
      d="M 56 10 C 58 14, 62 16, 70 17 C 66 18, 60 17, 57 14 C 55 12, 54 11, 56 10 Z"
      fill="url(#bb-hair)"
      stroke="#0f172a"
      stroke-width="1.2"
    />
    <path
      d="M 61 14 C 64 16, 68 18, 71 19"
      fill="none"
      stroke="#0f172a"
      stroke-width="1"
    />

    <!-- Ear -->
    <path
      d="M 53 28 C 50 28, 50 33, 54 34 C 56 34, 56 30, 54 28"
      fill="url(#bb-skin)"
      stroke="#0f172a"
      stroke-width="1.3"
    />

    <!-- Determined round baby eye with highlight -->
    <circle cx="68" cy="25" r="2.8" fill="#0f172a" />
    <circle cx="67" cy="24" r="0.9" fill="#ffffff" />

    <!-- Cute eyebrow arch -->
    <path
      d="M 65 20 C 67 19, 70 20, 72 22"
      fill="none"
      stroke="#0f172a"
      stroke-width="1.1"
      stroke-linecap="round"
    />

    <!-- Rosy Cheek Blush -->
    <ellipse cx="64" cy="31" rx="4.5" ry="3" fill="#f43f5e" opacity="0.65" />
    <line x1="62" y1="30" x2="63" y2="32" stroke="#e11d48" stroke-width="0.8" opacity="0.8" />
    <line x1="65" y1="30" x2="66" y2="32" stroke="#e11d48" stroke-width="0.8" opacity="0.8" />

    <!-- Cute nose protrusion -->
    <path
      d="M 76 31 C 78 32, 78 34, 76 35"
      fill="none"
      stroke="#0f172a"
      stroke-width="1.3"
      stroke-linecap="round"
    />

    <!-- Pacifier in mouth -->
    <g class="bb-pacifier">
      <!-- Pacifier shield/base -->
      <ellipse cx="75" cy="37" rx="2.5" ry="3.5" fill="#38bdf8" stroke="#0f172a" stroke-width="1.2" />
      <!-- Pacifier bulb/nipple base -->
      <path
        d="M 77 35 C 80 34, 82 36, 81 38 C 80 40, 77 39, 76 38"
        fill="#ffffff"
        stroke="#0f172a"
        stroke-width="1.2"
      />
      <!-- Pacifier ring handle -->
      <circle cx="79" cy="37" r="2.2" fill="none" stroke="#ffffff" stroke-width="1.2" />
    </g>
  </g>

  <!-- 7. Finger-Gun Laser Blast & Molecular Energy Sparks -->
  <g class="bb-effects" filter="url(#bb-glow)">
    <!-- Aim trajectory dashed arc -->
    <path
      d="M 81 47 C 84 45, 87 41, 88 36"
      fill="none"
      stroke="#0284c7"
      stroke-width="1.2"
      stroke-dasharray="1.5 2"
      opacity="0.85"
    />

    <!-- Spark blast starburst at fingertip -->
    <path
      d="M 86 46 L 89 44 L 88 47 L 91 48 L 88 49 L 89 52 L 86 50 L 83 52 L 84 49 L 81 48 L 84 47 L 83 44 Z"
      fill="url(#bb-laser)"
      stroke="#ffffff"
      stroke-width="0.6"
    />

    <!-- Floating bio-energy sparks -->
    <circle cx="89" cy="40" r="1.4" fill="#fbbf24" stroke="#ffffff" stroke-width="0.5" />
    <circle cx="93" cy="46" r="1" fill="#f43f5e" />
    <circle cx="85" cy="54" r="0.8" fill="#38bdf8" />
  </g>
</svg>

<style>
  .biobaby-logo {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.12));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .biobaby-logo:hover {
    transform: scale(1.06) translateY(-2px);
  }
</style>
