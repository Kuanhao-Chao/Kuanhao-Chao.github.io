---
import GameIconFrame from './GameIconFrame.astro';
interface Props {
  size?: number;
  class?: string;
}
const { size = 64, class: className = '' } = Astro.props;
---

<GameIconFrame
  size={size}
  class={`biobaby-logo ${className}`}
  label="Biobaby — a smiling baby superhero"
  accent="#bf6658"
>
  <path d="M41 45 Q22 44 15 72 L36 67 43 82 62 65Z" fill="var(--gi-deep)"></path>
  <path d="M39 47 Q25 48 19 66 L36 61 43 74 56 63Z" fill="var(--gi-accent)"></path>
  <path
    d="M42 48 L61 48 Q70 54 66 69 L60 80 H49 L44 69 34 65Z"
    fill="var(--gi-mid)"
    stroke="var(--gi-deep)"
    stroke-width="2.5"></path>
  <path d="M46 66 H65 L60 78 H51Z" fill="var(--gi-light)"></path>
  <path d="M62 54 L72 48 78 51 M42 55 L32 58" fill="none" stroke="#e9b291" stroke-width="7"></path>
  <path d="M54 77 L49 83 M61 77 L68 82" stroke="var(--gi-deep)" stroke-width="5"></path>
  <circle cx="52" cy="35" r="20" fill="#f3c7a9" stroke="#9e6c57" stroke-width="2.5"></circle>
  <path
    d="M35 29 Q39 18 50 17 Q47 11 55 14 Q60 18 56 22"
    fill="none"
    stroke="#83604b"
    stroke-width="3"></path>
  <circle cx="45" cy="34" r="2.3" fill="#493b36"></circle>
  <circle cx="59" cy="34" r="2.3" fill="#493b36"></circle>
  <ellipse cx="40" cy="40" rx="4" ry="2.5" fill="#dc8b7e" opacity=".7"></ellipse>
  <ellipse cx="64" cy="40" rx="4" ry="2.5" fill="#dc8b7e" opacity=".7"></ellipse>
  <path d="M47 42 Q52 47 57 42" fill="none" stroke="#925648" stroke-width="2.5"></path>
  <path d="M54 52 L56 57 61 58 57 61 58 66 54 63 50 66 51 61 47 58 52 57Z" fill="#f8e5a9"></path>
</GameIconFrame>
