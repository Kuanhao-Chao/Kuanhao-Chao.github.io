---
interface Props {
  size?: number;
  class?: string;
}

const { size = 64, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class:list={['tetris-logo', className]}
  role="img"
  aria-label="Tetris Logo — Molecular genomic tetrominoes docking into base-pairing matrix grid"
>
  <defs>
    <!-- Background Aura -->
    <radialGradient id="tet-aura" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="var(--color-accent, #2e6e5e)" stop-opacity="0.25" />
      <stop offset="100%" stop-color="var(--color-accent, #2e6e5e)" stop-opacity="0" />
    </radialGradient>

    <!-- T-Piece (Purple) -->
    <linearGradient id="tet-t-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#c084fc" />
      <stop offset="100%" stop-color="#9333ea" />
    </linearGradient>

    <!-- I-Piece (Cyan) -->
    <linearGradient id="tet-i-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#0284c7" />
    </linearGradient>

    <!-- S-Piece (Emerald) -->
    <linearGradient id="tet-s-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#34d399" />
      <stop offset="100%" stop-color="#059669" />
    </linearGradient>

    <!-- O-Piece (Amber) -->
    <linearGradient id="tet-o-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fbbf24" />
      <stop offset="100%" stop-color="#d97706" />
    </linearGradient>

    <!-- Glow Filter -->
    <filter id="tet-glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- 1. Ambient Backdrop Aura -->
  <circle cx="50" cy="50" r="46" fill="url(#tet-aura)" />
  <circle
    cx="50"
    cy="50"
    r="44"
    fill="none"
    stroke="var(--color-rule, #e5e4df)"
    stroke-width="1.2"
    stroke-dasharray="4 3"
    opacity="0.6"
  />

  <!-- 2. Matrix Grid Base & Hydrogen Bonding Rails -->
  <g class="tet-grid">
    <rect
      x="16"
      y="76"
      width="68"
      height="12"
      rx="2"
      fill="var(--color-surface, #ffffff)"
      stroke="var(--color-rule, #e5e4df)"
      stroke-width="1.2"
    />
    <!-- Grid Column Lines -->
    <line x1="28" y1="76" x2="28" y2="88" stroke="var(--color-rule, #e5e4df)" stroke-width="1" />
    <line x1="40" y1="76" x2="40" y2="88" stroke="var(--color-rule, #e5e4df)" stroke-width="1" />
    <line x1="52" y1="76" x2="52" y2="88" stroke="var(--color-rule, #e5e4df)" stroke-width="1" />
    <line x1="64" y1="76" x2="64" y2="88" stroke="var(--color-rule, #e5e4df)" stroke-width="1" />
    <line x1="76" y1="76" x2="76" y2="88" stroke="var(--color-rule, #e5e4df)" stroke-width="1" />
  </g>

  <!-- 3. Settled Foundation Minos -->
  <g class="tet-settled">
    <!-- Block 1 -->
    <rect x="18" y="78" width="8" height="8" rx="1.5" fill="#38bdf8" stroke="#ffffff" stroke-width="0.8" />
    <!-- Block 2 -->
    <rect x="30" y="78" width="8" height="8" rx="1.5" fill="#34d399" stroke="#ffffff" stroke-width="0.8" />
    <!-- Block 3 -->
    <rect x="42" y="78" width="8" height="8" rx="1.5" fill="#fbbf24" stroke="#ffffff" stroke-width="0.8" />
    <!-- Block 4 -->
    <rect x="54" y="78" width="8" height="8" rx="1.5" fill="#c084fc" stroke="#ffffff" stroke-width="0.8" />
    <!-- Block 5 -->
    <rect x="66" y="78" width="8" height="8" rx="1.5" fill="#f43f5e" stroke="#ffffff" stroke-width="0.8" />
  </g>

  <!-- 4. Cascading Molecular Tetrominoes -->
  <g class="tet-tetrominoes" filter="url(#tet-glow)">
    <!-- T-Piece (Center Dropping) -->
    <g transform="translate(38, 38)">
      <rect x="0" y="0" width="11" height="11" rx="2" fill="url(#tet-t-grad)" stroke="#ffffff" stroke-width="1" />
      <rect x="12" y="0" width="11" height="11" rx="2" fill="url(#tet-t-grad)" stroke="#ffffff" stroke-width="1" />
      <rect x="24" y="0" width="11" height="11" rx="2" fill="url(#tet-t-grad)" stroke="#ffffff" stroke-width="1" />
      <rect x="12" y="12" width="11" height="11" rx="2" fill="url(#tet-t-grad)" stroke="#ffffff" stroke-width="1" />
      <!-- Base Markers -->
      <text x="5.5" y="7.5" font-family="monospace" font-size="6.5" font-weight="bold" fill="#ffffff" text-anchor="middle">A</text>
      <text x="17.5" y="7.5" font-family="monospace" font-size="6.5" font-weight="bold" fill="#ffffff" text-anchor="middle">U</text>
      <text x="29.5" y="7.5" font-family="monospace" font-size="6.5" font-weight="bold" fill="#ffffff" text-anchor="middle">G</text>
      <text x="17.5" y="19.5" font-family="monospace" font-size="6.5" font-weight="bold" fill="#ffffff" text-anchor="middle">C</text>
    </g>

    <!-- S-Piece (Left Angled) -->
    <g transform="translate(18, 20)">
      <rect x="11" y="0" width="10" height="10" rx="2" fill="url(#tet-s-grad)" stroke="#ffffff" stroke-width="0.9" />
      <rect x="22" y="0" width="10" height="10" rx="2" fill="url(#tet-s-grad)" stroke="#ffffff" stroke-width="0.9" />
      <rect x="0" y="11" width="10" height="10" rx="2" fill="url(#tet-s-grad)" stroke="#ffffff" stroke-width="0.9" />
      <rect x="11" y="11" width="10" height="10" rx="2" fill="url(#tet-s-grad)" stroke="#ffffff" stroke-width="0.9" />
    </g>

    <!-- O-Piece (Top Right) -->
    <g transform="translate(56, 14)">
      <rect x="0" y="0" width="10" height="10" rx="2" fill="url(#tet-o-grad)" stroke="#ffffff" stroke-width="0.9" />
      <rect x="11" y="0" width="10" height="10" rx="2" fill="url(#tet-o-grad)" stroke="#ffffff" stroke-width="0.9" />
      <rect x="0" y="11" width="10" height="10" rx="2" fill="url(#tet-o-grad)" stroke="#ffffff" stroke-width="0.9" />
      <rect x="11" y="11" width="10" height="10" rx="2" fill="url(#tet-o-grad)" stroke="#ffffff" stroke-width="0.9" />
    </g>
  </g>

  <!-- 5. Laser Projection & Clear Particle Sparks -->
  <g class="tet-fx">
    <!-- Laser Alignment Guideline -->
    <line x1="50" y1="52" x2="50" y2="76" stroke="#38bdf8" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.75" />
    <!-- Sparks -->
    <circle cx="34" cy="74" r="1.2" fill="#fbbf24" />
    <circle cx="68" cy="73" r="1.4" fill="#38bdf8" />
    <circle cx="50" cy="75" r="1.5" fill="#f43f5e" />
  </g>
</svg>

<style>
  .tetris-logo {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.12));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .tetris-logo:hover {
    transform: scale(1.06) translateY(-2px);
  }
</style>
