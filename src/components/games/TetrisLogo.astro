---
import GameIconFrame from './GameIconFrame.astro';
interface Props {
  size?: number;
  class?: string;
}
const { size = 64, class: className = '' } = Astro.props;
---

<GameIconFrame
  size={size}
  class={`tetris-logo ${className}`}
  label="Tetris — stacked colorful tetrominoes"
  accent="#6573a4"
>
  <g stroke-width="2.5">
    <path d="M34 18 H50 V34 H66 V50 H18 V34 H34Z" fill="var(--gi-accent)" stroke="var(--gi-deep)"
    ></path>
    <path d="M18 54 H50 V86 H18Z" fill="#c7a65c" stroke="#8b743d"></path>
    <path d="M70 38 H86 V86 H54 V70 H70Z" fill="#719c85" stroke="#426f59"></path>
  </g>
  <path
    d="M34 34 H50 M34 34 V50 M50 34 V50 M34 54 V86 M18 70 H50 M70 54 H86 M70 70 H86 M70 70 V86"
    fill="none"
    stroke="#ffffff"
    stroke-width="2"
    opacity=".6"></path>
  <path
    d="M38 22 H46 M22 38 H30 M38 38 H46 M54 38 H62 M22 58 H30 M38 58 H46 M22 74 H30 M38 74 H46 M74 42 H82 M74 58 H82 M58 74 H66 M74 74 H82"
    stroke="#ffffff"
    stroke-width="2.5"
    opacity=".7"></path>
  <path d="M20 84 H48 M56 84 H84" stroke="#17252c" stroke-width="2" opacity=".2"></path>
</GameIconFrame>
