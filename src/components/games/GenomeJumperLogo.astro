---
interface Props {
  size?: number;
  class?: string;
}

const { size = 64, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class:list={['genome-jumper-logo', className]}
  role="img"
  aria-label="Genome Jumper Logo — RNA Polymerase II enzyme aviator launching skyward on a DNA double-helix spring through chromatin platforms"
>
  <defs>
    <!-- Background Vertical Ascension Aura -->
    <radialGradient id="gj-bg-aura" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#10b981" stop-opacity="0.35" />
      <stop offset="50%" stop-color="#0284c7" stop-opacity="0.15" />
      <stop offset="100%" stop-color="#020617" stop-opacity="0" />
    </radialGradient>

    <!-- Outer Frame Gradient -->
    <linearGradient id="gj-border-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#34d399" />
      <stop offset="50%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#818cf8" />
    </linearGradient>

    <!-- Pol II Main Protein Body -->
    <linearGradient id="gj-pol-body" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#6ee7b7" />
      <stop offset="35%" stop-color="#10b981" />
      <stop offset="75%" stop-color="#047857" />
      <stop offset="100%" stop-color="#022c22" />
    </linearGradient>

    <!-- Brass Pilot Goggles & Clamp Domain -->
    <linearGradient id="gj-brass-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="40%" stop-color="#fbbf24" />
      <stop offset="100%" stop-color="#b45309" />
    </linearGradient>

    <!-- DNA Coiled Spring Gradient -->
    <linearGradient id="gj-spring-grad" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="50%" stop-color="#818cf8" />
      <stop offset="100%" stop-color="#c084fc" />
    </linearGradient>

    <!-- Nascent mRNA Transcript Ribbon -->
    <linearGradient id="gj-mrna-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="50%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#ef4444" />
    </linearGradient>

    <!-- Rocket Thruster Exhaust Flame -->
    <linearGradient id="gj-thruster-flame" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="25%" stop-color="#fef08a" />
      <stop offset="60%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#ef4444" stop-opacity="0" />
    </linearGradient>

    <!-- Glow & Shadow Filters -->
    <filter id="gj-glow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <filter id="gj-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="1.5" dy="2.5" stdDeviation="2" flood-color="#000000" flood-opacity="0.45" />
    </filter>
  </defs>

  <!-- 1. Ambient Background Aura -->
  <circle cx="50" cy="50" r="47" fill="url(#gj-bg-aura)" />

  <!-- 2. Circular Outer Medallion Frame -->
  <circle
    cx="50"
    cy="50"
    r="46"
    fill="#09121a"
    stroke="url(#gj-border-grad)"
    stroke-width="2.2"
  />

  <!-- Vertical Ascension Coordinate Lines & Floating Particles -->
  <g stroke="#162e3b" stroke-width="0.75" opacity="0.65">
    <line x1="28" y1="12" x2="28" y2="88" stroke-dasharray="2, 4" />
    <line x1="72" y1="12" x2="72" y2="88" stroke-dasharray="2, 4" />
  </g>

  <!-- 3. Lower Chromatin Foundation Platform (Histone Octamer Core) -->
  <g class="gj-platform" filter="url(#gj-shadow)">
    <!-- Histone Spool Core -->
    <rect x="22" y="83" width="56" height="8" rx="4" fill="#0f2922" stroke="#10b981" stroke-width="1.6" />
    <!-- DNA Wrapped Grooves -->
    <line x1="32" y1="83" x2="32" y2="91" stroke="#38bdf8" stroke-width="1.3" />
    <line x1="44" y1="83" x2="44" y2="91" stroke="#818cf8" stroke-width="1.3" />
    <line x1="56" y1="83" x2="56" y2="91" stroke="#34d399" stroke-width="1.3" />
    <line x1="68" y1="83" x2="68" y2="91" stroke="#fbbf24" stroke-width="1.3" />
  </g>

  <!-- 4. Coiled Double-Helix DNA Propulsion Spring -->
  <g class="gj-spring" filter="url(#gj-glow)">
    <!-- Strand 1 Coils -->
    <path
      d="M 36 83 C 22 76, 24 67, 48 63 C 72 59, 72 50, 48 44 C 28 40, 30 33, 48 30"
      fill="none"
      stroke="url(#gj-spring-grad)"
      stroke-width="3"
      stroke-linecap="round"
    />
    <!-- Strand 2 Coils -->
    <path
      d="M 64 83 C 78 76, 76 67, 52 63 C 28 59, 28 50, 52 44 C 72 40, 70 33, 52 30"
      fill="none"
      stroke="#38bdf8"
      stroke-width="2.2"
      stroke-linecap="round"
      opacity="0.8"
    />

    <!-- Base-Pair Spring Ties -->
    <line x1="31" y1="74" x2="69" y2="74" stroke="#38bdf8" stroke-width="1.4" opacity="0.75" />
    <line x1="40" y1="62" x2="60" y2="62" stroke="#818cf8" stroke-width="1.4" opacity="0.8" />
    <line x1="32" y1="49" x2="68" y2="49" stroke="#c084fc" stroke-width="1.4" opacity="0.8" />
    <line x1="41" y1="37" x2="59" y2="37" stroke="#38bdf8" stroke-width="1.4" opacity="0.75" />
  </g>

  <!-- 5. Rocket Propulsion Exhaust Flames & Sparks -->
  <g class="gj-thrusters" filter="url(#gj-glow)">
    <polygon points="44,30 56,30 50,46" fill="url(#gj-thruster-flame)" />
    <!-- High-Heat White Core -->
    <polygon points="46,30 54,30 50,40" fill="#ffffff" opacity="0.9" />
    <!-- Magnesium Ion Sparks -->
    <circle cx="42" cy="40" r="1.4" fill="#fbbf24" />
    <circle cx="58" cy="38" r="1.3" fill="#38bdf8" />
    <circle cx="50" cy="48" r="1" fill="#ffffff" />
  </g>

  <!-- 6. Charismatic RNA Polymerase II Aviator Hero -->
  <g class="gj-pol-hero" transform="translate(0, -4)" filter="url(#gj-shadow)">
    <!-- Protective Transcription Bubble Aura -->
    <ellipse cx="50" cy="24" rx="21" ry="18" fill="rgba(16, 185, 129, 0.12)" stroke="#34d399" stroke-width="1" stroke-dasharray="3, 3" />

    <!-- Pol II Main Protein Body -->
    <path
      d="M 38 14 C 47 9, 59 9, 65 15 C 70 20, 69 29, 63 35 C 57 39, 43 39, 37 33 C 33 27, 32 18, 38 14 Z"
      fill="url(#gj-pol-body)"
      stroke="#ffffff"
      stroke-width="1.6"
      stroke-linejoin="round"
    />

    <!-- Pol II Clamp Domain (Golden Head Gear) -->
    <path
      d="M 58 14 C 65 17, 67 24, 63 29 C 61 27, 61 20, 58 14 Z"
      fill="url(#gj-brass-grad)"
      stroke="#ffffff"
      stroke-width="0.8"
    />

    <!-- Brass Aviator Pilot Goggles -->
    <!-- Left Eyepiece Frame -->
    <circle cx="46" cy="18" r="4.2" fill="#022c22" stroke="url(#gj-brass-grad)" stroke-width="1.4" />
    <circle cx="46" cy="18" r="2.8" fill="#38bdf8" />
    <circle cx="45" cy="17" r="1" fill="#ffffff" />

    <!-- Right Eyepiece Frame -->
    <circle cx="55" cy="19" r="4" fill="#022c22" stroke="url(#gj-brass-grad)" stroke-width="1.4" />
    <circle cx="55" cy="19" r="2.6" fill="#38bdf8" />
    <circle cx="54" cy="18" r="0.9" fill="#ffffff" />

    <!-- Goggle Bridge Strap -->
    <line x1="50" y1="18.5" x2="51" y2="18.5" stroke="#fbbf24" stroke-width="1.4" stroke-linecap="round" />

    <!-- Catalytic Active Site Transcription Cleft Sparkle -->
    <circle cx="52" cy="27" r="1.8" fill="#ffffff" stroke="#f59e0b" stroke-width="0.8" />

    <!-- Trailing Nascent mRNA Transcript Ribbon (5' -> 3') -->
    <path
      d="M 37 28 C 26 30, 18 22, 12 26 C 8 30, 9 37, 15 39 C 22 41, 26 34, 30 38"
      fill="none"
      stroke="url(#gj-mrna-grad)"
      stroke-width="2.6"
      stroke-linecap="round"
      filter="url(#gj-glow)"
    />
    <!-- Transcribed Nucleotide Nodes along mRNA Ribbon -->
    <circle cx="12" cy="26" r="2.2" fill="#ef4444" stroke="#ffffff" stroke-width="0.8" />
    <circle cx="11" cy="36" r="2.2" fill="#38bdf8" stroke="#ffffff" stroke-width="0.8" />
    <circle cx="20" cy="39" r="2.2" fill="#10b981" stroke="#ffffff" stroke-width="0.8" />
    <circle cx="28" cy="36" r="2.2" fill="#f59e0b" stroke="#ffffff" stroke-width="0.8" />
  </g>

  <!-- 7. High-Altitude Floating Nucleotide Trampolines (A, T, C, G) -->
  <g class="gj-platforms" filter="url(#gj-glow)">
    <!-- Platform A (Top Right) -->
    <polygon points="76,18 80,14 84,18 80,22" fill="#10b981" stroke="#ffffff" stroke-width="0.9" />
    <text x="80" y="19.5" font-family="monospace" font-size="5" font-weight="900" fill="#ffffff" text-anchor="middle">A</text>

    <!-- Platform T (Mid Right) -->
    <polygon points="74,38 78,34 82,38 78,42" fill="#a855f7" stroke="#ffffff" stroke-width="0.9" />
    <text x="78" y="39.5" font-family="monospace" font-size="5" font-weight="900" fill="#ffffff" text-anchor="middle">T</text>

    <!-- Platform C (Mid Left) -->
    <polygon points="18,52 22,48 26,52 22,56" fill="#38bdf8" stroke="#ffffff" stroke-width="0.9" />
    <text x="22" y="53.5" font-family="monospace" font-size="5" font-weight="900" fill="#ffffff" text-anchor="middle">C</text>

    <!-- Platform G (Lower Right) -->
    <polygon points="80,58 84,54 88,58 84,62" fill="#f59e0b" stroke="#ffffff" stroke-width="0.9" />
    <text x="84" y="59.5" font-family="monospace" font-size="5" font-weight="900" fill="#ffffff" text-anchor="middle">G</text>
  </g>
</svg>

<style>
  .genome-jumper-logo {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
    filter: drop-shadow(0 4px 12px rgba(16, 185, 129, 0.25));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.25s ease;
  }

  :global(.tool:hover) .genome-jumper-logo,
  .genome-jumper-logo:hover {
    transform: translateY(-2px) scale(1.06);
    filter: drop-shadow(0 6px 20px rgba(56, 189, 248, 0.45));
  }
</style>
