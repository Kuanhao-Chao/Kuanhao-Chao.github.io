---
interface Props {
  size?: number;
  class?: string;
}

const { size = 64, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class:list={['genome-jumper-logo', className]}
  role="img"
  aria-label="Genome Jumper Logo — RNA Polymerase II ascending a chromatin double helix ladder"
>
  <defs>
    <!-- Background aura gradient -->
    <radialGradient id="gj-aura" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="var(--color-accent, #2e6e5e)" stop-opacity="0.25" />
      <stop offset="100%" stop-color="var(--color-accent, #2e6e5e)" stop-opacity="0.0" />
    </radialGradient>

    <!-- Polymerase Core Gradient -->
    <linearGradient id="gj-pol-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#10b981" />
      <stop offset="50%" stop-color="#059669" />
      <stop offset="100%" stop-color="#047857" />
    </linearGradient>

    <!-- DNA Helix Spring Gradient -->
    <linearGradient id="gj-helix-grad" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="50%" stop-color="#818cf8" />
      <stop offset="100%" stop-color="#a855f7" />
    </linearGradient>

    <!-- mRNA Transcript Ribbon Gradient -->
    <linearGradient id="gj-mrna-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fbbf24" />
      <stop offset="100%" stop-color="#f59e0b" />
    </linearGradient>

    <!-- Jetpack Flame Gradient -->
    <linearGradient id="gj-flame-grad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="40%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#f43f5e" stop-opacity="0" />
    </linearGradient>

    <!-- Glow Filter -->
    <filter id="gj-glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- 1. Ambient Bio-Aura Backdrop -->
  <circle cx="50" cy="50" r="46" fill="url(#gj-aura)" />
  <circle
    cx="50"
    cy="50"
    r="44"
    fill="none"
    stroke="var(--color-rule, #e5e4df)"
    stroke-width="1.2"
    stroke-dasharray="4 3"
    opacity="0.6"
  />

  <!-- 2. Euchromatin Platform Foundation Base -->
  <g class="gj-platform">
    <rect
      x="22"
      y="84"
      width="56"
      height="6"
      rx="3"
      fill="var(--color-surface, #ffffff)"
      stroke="var(--color-accent, #2e6e5e)"
      stroke-width="1.8"
    />
    <!-- Watson-Crick hydrogen bonding notches -->
    <line x1="32" y1="84" x2="32" y2="90" stroke="var(--color-accent, #2e6e5e)" stroke-width="1" />
    <line x1="42" y1="84" x2="42" y2="90" stroke="var(--color-accent, #2e6e5e)" stroke-width="1" />
    <line x1="50" y1="84" x2="50" y2="90" stroke="var(--color-accent, #2e6e5e)" stroke-width="1.4" />
    <line x1="58" y1="84" x2="58" y2="90" stroke="var(--color-accent, #2e6e5e)" stroke-width="1" />
    <line x1="68" y1="84" x2="68" y2="90" stroke="var(--color-accent, #2e6e5e)" stroke-width="1" />
  </g>

  <!-- 3. Ascending Double-Helix Coiled Spring -->
  <g class="gj-spring" filter="url(#gj-glow)">
    <!-- Helix Strand 1 -->
    <path
      d="M 36 84 C 26 78, 26 70, 48 66 C 70 62, 72 54, 46 48 C 28 44, 30 38, 48 34"
      fill="none"
      stroke="url(#gj-helix-grad)"
      stroke-width="2.6"
      stroke-linecap="round"
    />
    <!-- Helix Strand 2 -->
    <path
      d="M 64 84 C 74 78, 74 70, 52 66 C 30 62, 28 54, 54 48 C 72 44, 70 38, 52 34"
      fill="none"
      stroke="#38bdf8"
      stroke-width="2"
      stroke-linecap="round"
      opacity="0.85"
    />
    <!-- Base pair rungs between spring coils -->
    <line x1="33" y1="76" x2="67" y2="76" stroke="#38bdf8" stroke-width="1.2" opacity="0.65" />
    <line x1="40" y1="65" x2="60" y2="65" stroke="#818cf8" stroke-width="1.2" opacity="0.75" />
    <line x1="34" y1="53" x2="66" y2="53" stroke="#a855f7" stroke-width="1.2" opacity="0.75" />
    <line x1="42" y1="41" x2="58" y2="41" stroke="#38bdf8" stroke-width="1.2" opacity="0.65" />
  </g>

  <!-- 4. Propulsion Flame & Particle Sparks -->
  <g class="gj-propulsion">
    <polygon points="46,34 54,34 50,44" fill="url(#gj-flame-grad)" />
    <!-- Sparks -->
    <circle cx="43" cy="40" r="1.2" fill="#fbbf24" />
    <circle cx="57" cy="38" r="1" fill="#f43f5e" />
    <circle cx="48" cy="46" r="0.8" fill="#38bdf8" />
  </g>

  <!-- 5. RNA Polymerase II Jumping Complex -->
  <g class="gj-polymerase" transform="translate(0, -2)">
    <!-- Protective Elongation Bubble aura -->
    <ellipse cx="50" cy="24" rx="20" ry="18" fill="rgba(16, 185, 129, 0.12)" stroke="#10b981" stroke-width="1" stroke-dasharray="3 2" />

    <!-- Pol II Main Protein Body -->
    <path
      d="M 40 14 C 48 10, 58 10, 64 16 C 68 20, 68 28, 62 34 C 56 38, 44 38, 38 32 C 34 26, 34 18, 40 14 Z"
      fill="url(#gj-pol-grad)"
      stroke="var(--color-surface, #ffffff)"
      stroke-width="1.5"
    />

    <!-- Active Catalytic Transcription Cleft -->
    <path
      d="M 52 17 C 56 19, 58 24, 55 28 C 53 29, 49 28, 48 26"
      fill="none"
      stroke="#fef08a"
      stroke-width="1.8"
      stroke-linecap="round"
    />

    <!-- Pol II Eye Subunits (Friendly Arcade Expression) -->
    <circle cx="47" cy="18" r="2.2" fill="#ffffff" />
    <circle cx="48" cy="18" r="1.1" fill="#047857" />
    <circle cx="56" cy="19" r="2" fill="#ffffff" />
    <circle cx="57" cy="19" r="1" fill="#047857" />

    <!-- Trailing Nascent mRNA Transcript Ribbon (5' -> 3') -->
    <path
      d="M 38 28 C 28 30, 20 22, 14 26 C 10 29, 11 36, 16 38 C 22 40, 26 34, 30 38"
      fill="none"
      stroke="url(#gj-mrna-grad)"
      stroke-width="2.4"
      stroke-linecap="round"
    />
    <!-- mRNA Nucleotide Nodes -->
    <circle cx="14" cy="26" r="2" fill="#ef4444" stroke="#ffffff" stroke-width="0.7" />
    <circle cx="13" cy="35" r="2" fill="#3b82f6" stroke="#ffffff" stroke-width="0.7" />
    <circle cx="21" cy="38" r="2" fill="#10b981" stroke="#ffffff" stroke-width="0.7" />
    <circle cx="28" cy="36" r="2" fill="#f59e0b" stroke="#ffffff" stroke-width="0.7" />
  </g>

  <!-- 6. Floating Ascending Nucleotide Gems (A · C · G · T) -->
  <g class="gj-gems">
    <!-- Gem A (Emerald) -->
    <polygon points="76,20 80,16 84,20 80,24" fill="#10b981" stroke="#ffffff" stroke-width="0.8" />
    <text x="80" y="21.5" font-family="monospace" font-size="5" font-weight="bold" fill="#ffffff" text-anchor="middle">A</text>

    <!-- Gem T (Purple) -->
    <polygon points="74,38 78,34 82,38 78,42" fill="#a855f7" stroke="#ffffff" stroke-width="0.8" />
    <text x="78" y="39.5" font-family="monospace" font-size="5" font-weight="bold" fill="#ffffff" text-anchor="middle">T</text>

    <!-- Gem C (Cyan) -->
    <polygon points="18,52 22,48 26,52 22,56" fill="#38bdf8" stroke="#ffffff" stroke-width="0.8" />
    <text x="22" y="53.5" font-family="monospace" font-size="5" font-weight="bold" fill="#ffffff" text-anchor="middle">C</text>

    <!-- Gem G (Amber) -->
    <polygon points="80,58 84,54 88,58 84,62" fill="#f59e0b" stroke="#ffffff" stroke-width="0.8" />
    <text x="84" y="59.5" font-family="monospace" font-size="5" font-weight="bold" fill="#ffffff" text-anchor="middle">G</text>
  </g>
</svg>

<style>
  .genome-jumper-logo {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.12));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .genome-jumper-logo:hover {
    transform: scale(1.06) translateY(-2px);
  }
</style>
