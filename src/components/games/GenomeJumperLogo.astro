---
import GameIconFrame from './GameIconFrame.astro';
interface Props {
  size?: number;
  class?: string;
}
const { size = 64, class: className = '' } = Astro.props;
---

<GameIconFrame
  size={size}
  class={`genome-jumper-logo ${className}`}
  label="Genome Jumper — a polymerase and RNA trail above stepping stones"
  accent="#5c896f"
>
  <rect x="15" y="70" width="22" height="8" rx="3" fill="var(--gi-accent)"></rect>
  <rect x="40" y="78" width="23" height="8" rx="3" fill="var(--gi-mid)"></rect>
  <rect x="67" y="56" width="19" height="8" rx="3" fill="var(--gi-accent)"></rect>
  <path
    d="M34 51 Q22 42 30 29 Q34 22 43 24 Q45 14 57 18 Q63 20 63 28 Q74 27 75 37 Q76 46 67 50 L56 44 47 50Z"
    fill="var(--gi-mid)"
    stroke="var(--gi-deep)"
    stroke-width="3"></path>
  <path
    d="M35 32 Q34 27 42 28 M49 24 Q54 19 58 25"
    fill="none"
    stroke="var(--gi-light)"
    stroke-width="3"></path>
  <path d="M39 48 Q43 40 50 42 L60 48" fill="none" stroke="var(--gi-deep)" stroke-width="4"></path>
  <path d="M50 46 Q47 58 55 62 Q65 68 59 74" fill="none" stroke="#b78b50" stroke-width="3"></path>
  <g stroke="#ffffff" stroke-width="1.5">
    <circle cx="50" cy="51" r="3.5" fill="#c78965"></circle>
    <circle cx="51" cy="59" r="3.5" fill="#548da1"></circle>
    <circle cx="59" cy="64" r="3.5" fill="#b79b4b"></circle>
    <circle cx="62" cy="72" r="3.5" fill="#779b73"></circle>
  </g>
  <path d="M22 60 V47 M17 52 L22 47 27 52" fill="none" stroke="var(--gi-accent)" stroke-width="3"
  ></path>
</GameIconFrame>
