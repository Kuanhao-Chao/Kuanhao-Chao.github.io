---
interface Props {
  size?: number;
  class?: string;
}

const { size = 64, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class:list={['chinese-chess-logo', className]}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <!-- Background Board Wood Texture -->
    <radialGradient id="cc-board-grad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#fdf4e7" />
      <stop offset="70%" stop-color="#f1dfc5" />
      <stop offset="100%" stop-color="#deb887" />
    </radialGradient>

    <!-- Red Piece 3D Gradient -->
    <radialGradient id="cc-red-piece" cx="35%" cy="30%" r="65%">
      <stop offset="0%" stop-color="#fee2e2" />
      <stop offset="45%" stop-color="#ef4444" />
      <stop offset="85%" stop-color="#b91c1c" />
      <stop offset="100%" stop-color="#7f1d1d" />
    </radialGradient>

    <!-- Black Piece 3D Gradient -->
    <radialGradient id="cc-black-piece" cx="35%" cy="30%" r="65%">
      <stop offset="0%" stop-color="#475569" />
      <stop offset="40%" stop-color="#1e293b" />
      <stop offset="85%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#020617" />
    </radialGradient>

    <!-- Gold Calligraphy Inlay Gradient -->
    <linearGradient id="cc-gold-foil" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="50%" stop-color="#fbbf24" />
      <stop offset="100%" stop-color="#d97706" />
    </linearGradient>

    <!-- Jade River Water Ribbon -->
    <linearGradient id="cc-river-flow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#0284c7" stop-opacity="0.1" />
      <stop offset="50%" stop-color="#0ea5e9" stop-opacity="0.35" />
      <stop offset="100%" stop-color="#0284c7" stop-opacity="0.1" />
    </linearGradient>

    <!-- Drop Shadow Filter -->
    <filter id="cc-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="1.5" dy="3" stdDeviation="2.5" flood-color="#000000" flood-opacity="0.35" />
    </filter>

    <filter id="cc-piece-glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#b91c1c" flood-opacity="0.4" />
    </filter>
  </defs>

  <!-- 1. Outer Circular Wooden Medallion Board -->
  <circle
    cx="50"
    cy="50"
    r="47"
    fill="url(#cc-board-grad)"
    stroke="#8c6239"
    stroke-width="2.5"
  />

  <!-- Traditional Decorative Inner Board Ring -->
  <circle
    cx="50"
    cy="50"
    r="43"
    fill="none"
    stroke="#b08d57"
    stroke-width="1"
    stroke-dasharray="2, 2"
    opacity="0.75"
  />

  <!-- 2. Authentic Chinese Chess Board Grid Lines -->
  <g stroke="#9a7b56" stroke-width="0.9" opacity="0.65">
    <!-- Horizontal Ranks -->
    <line x1="14" y1="26" x2="86" y2="26" />
    <line x1="14" y1="38" x2="86" y2="38" />
    <line x1="14" y1="62" x2="86" y2="62" />
    <line x1="14" y1="74" x2="86" y2="74" />

    <!-- Vertical Files -->
    <line x1="26" y1="14" x2="26" y2="86" />
    <line x1="38" y1="14" x2="38" y2="44" />
    <line x1="38" y1="56" x2="38" y2="86" />
    <line x1="62" y1="14" x2="62" y2="44" />
    <line x1="62" y1="56" x2="62" y2="86" />
    <line x1="74" y1="14" x2="74" y2="86" />

    <!-- Red & Black Palace Diagonal Crosses (九宮斜線) -->
    <line x1="38" y1="14" x2="62" y2="38" stroke-dasharray="1.5, 1.5" />
    <line x1="62" y1="14" x2="38" y2="38" stroke-dasharray="1.5, 1.5" />
    <line x1="38" y1="62" x2="62" y2="86" stroke-dasharray="1.5, 1.5" />
    <line x1="62" y1="62" x2="38" y2="86" stroke-dasharray="1.5, 1.5" />
  </g>

  <!-- 3. Chu River / Han Border (楚河 · 漢界) River Wave Ribbon -->
  <rect x="12" y="44" width="76" height="12" fill="url(#cc-river-flow)" rx="2" />
  <path
    d="M 16 50 Q 28 47 40 50 T 64 50 T 84 50"
    fill="none"
    stroke="#0284c7"
    stroke-width="1"
    opacity="0.4"
  />

  <!-- Traditional Star Point Markers (十字星位) -->
  <g stroke="#9a7b56" stroke-width="0.8" opacity="0.8">
    <path d="M 24 36 L 24 37 L 25 37 M 28 36 L 28 37 L 27 37" />
    <path d="M 72 36 L 72 37 L 73 37 M 76 36 L 76 37 L 75 37" />
  </g>

  <!-- 4. Black General Piece (將) - Top-Left Shadowed Disc -->
  <g transform="translate(34, 35)" filter="url(#cc-shadow)">
    <!-- 3D Beveled Outer Rim -->
    <circle cx="0" cy="0" r="18" fill="#090d16" stroke="#475569" stroke-width="1.2" />
    <circle cx="0" cy="0" r="16.5" fill="url(#cc-black-piece)" />
    <!-- Inner Engraving Groove Ring -->
    <circle cx="0" cy="0" r="13" fill="none" stroke="#94a3b8" stroke-width="0.75" opacity="0.6" />
    <!-- Specular Highlight Arc -->
    <path
      d="M -11 -8 A 14 14 0 0 1 8 -11"
      fill="none"
      stroke="#ffffff"
      stroke-width="1.2"
      stroke-linecap="round"
      opacity="0.45"
    />
    <!-- Chinese Calligraphy Character 將 -->
    <text
      x="0"
      y="5.5"
      font-family="'Kaiti', 'STKaiti', 'KaiTi_GB2312', 'Songti SC', 'SimSun', serif"
      font-size="14.5"
      font-weight="900"
      fill="#f1f5f9"
      text-anchor="middle"
      letter-spacing="0"
    >將</text>
  </g>

  <!-- 5. Red General Piece (帥) - Foreground Glowing Disc -->
  <g transform="translate(62, 62)" filter="url(#cc-piece-glow)">
    <!-- Outer 3D Bevel Shadow & Rim -->
    <circle cx="0" cy="0" r="21" fill="#450a0a" stroke="#fbbf24" stroke-width="1.5" />
    <circle cx="0" cy="0" r="19.2" fill="url(#cc-red-piece)" />
    <!-- Inner Lacquer Gold Inlay Ring -->
    <circle cx="0" cy="0" r="15" fill="none" stroke="#fef08a" stroke-width="1" opacity="0.85" />
    <!-- Specular Reflection Highlight -->
    <path
      d="M -13 -10 A 16 16 0 0 1 10 -13"
      fill="none"
      stroke="#ffffff"
      stroke-width="1.5"
      stroke-linecap="round"
      opacity="0.6"
    />
    <!-- Chinese Calligraphy Character 帥 in Brilliant Gold -->
    <text
      x="0"
      y="6.5"
      font-family="'Kaiti', 'STKaiti', 'KaiTi_GB2312', 'Songti SC', 'SimSun', serif"
      font-size="17"
      font-weight="900"
      fill="url(#cc-gold-foil)"
      stroke="#7f1d1d"
      stroke-width="0.3"
      text-anchor="middle"
      letter-spacing="0"
    >帥</text>
  </g>

  <!-- Dynamic Strategic Clash Spark Sparkle -->
  <circle cx="48" cy="48" r="1.8" fill="#fbbf24" opacity="0.9" />
  <path d="M 48 43 L 48 53 M 43 48 L 53 48" stroke="#fef08a" stroke-width="0.7" opacity="0.75" />
</svg>

<style>
  .chinese-chess-logo {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
    filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.16));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.25s ease;
  }

  :global(.tool:hover) .chinese-chess-logo,
  .chinese-chess-logo:hover {
    transform: translateY(-2px) scale(1.04);
    filter: drop-shadow(0 6px 14px rgba(185, 28, 28, 0.3));
  }
</style>
