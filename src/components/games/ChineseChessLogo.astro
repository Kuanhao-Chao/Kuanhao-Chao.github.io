---
import GameIconFrame from './GameIconFrame.astro';
interface Props {
  size?: number;
  class?: string;
}
const { size = 64, class: className = '' } = Astro.props;
---

<GameIconFrame
  size={size}
  class={`chinese-chess-logo ${className}`}
  label="Chinese Chess — red and black lacquer Xiangqi pieces"
  accent="#a35048"
>
  <path
    d="M18 27 H82 M18 46 H82 M18 65 H82 M26 20 V80 M50 20 V80 M74 20 V80"
    stroke="var(--gi-mid)"
    stroke-width="1.5"
    opacity=".55"></path>
  <ellipse cx="66" cy="35" rx="19" ry="18" fill="var(--gi-deep)"></ellipse>
  <circle cx="66" cy="31" r="19" fill="var(--gi-accent)" stroke="#bda27a" stroke-width="2"></circle>
  <circle cx="66" cy="31" r="14" fill="none" stroke="#bda27a" stroke-width="1.5"></circle>
  <path d="M57 26 H75 M61 22 V40 M71 22 V40 M56 35 H76" stroke="#dcc69d" stroke-width="2.5"></path>
  <ellipse cx="41" cy="64" rx="26" ry="25" fill="#1e2e35"></ellipse>
  <circle cx="41" cy="58" r="26" fill="#34464e" stroke="#1e2e35" stroke-width="2.5"></circle>
  <circle cx="41" cy="58" r="21" fill="none" stroke="#e2bd8d" stroke-width="1.5"></circle>
  <path d="M25 44 Q30 37 40 37" stroke="#f3d9b4" stroke-width="2.5" opacity=".65" fill="none"
  ></path>
  <text
    x="41"
    y="69"
    text-anchor="middle"
    fill="#fae7c4"
    font-size="30"
    font-family="serif"
    font-weight="700">將</text
  >
</GameIconFrame>
