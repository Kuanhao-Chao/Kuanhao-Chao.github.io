---
interface Props {
  size?: number;
  class?: string;
}

const { size = 64, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class:list={['proofreader-logo', className]}
  role="img"
  aria-label="Proofreader Logo — DNA Polymerase III epsilon proofreading exonuclease HUD reticle vaporizing a mismatch mutation with a hydrolytic laser"
>
  <defs>
    <!-- Background Optics Reticle Aura -->
    <radialGradient id="pr-bg-aura" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#0284c7" stop-opacity="0.35" />
      <stop offset="60%" stop-color="#0c4a6e" stop-opacity="0.15" />
      <stop offset="100%" stop-color="#020617" stop-opacity="0" />
    </radialGradient>

    <!-- Outer Frame Gradient -->
    <linearGradient id="pr-border-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="50%" stop-color="#0284c7" />
      <stop offset="100%" stop-color="#0369a1" />
    </linearGradient>

    <!-- Exonuclease Protein Cleft Gradient -->
    <linearGradient id="pr-exo-body" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#7dd3fc" />
      <stop offset="35%" stop-color="#0284c7" />
      <stop offset="75%" stop-color="#0369a1" />
      <stop offset="100%" stop-color="#082f49" />
    </linearGradient>

    <!-- Hydrolytic Excision Laser Flare -->
    <linearGradient id="pr-laser-flare" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#f43f5e" />
      <stop offset="30%" stop-color="#fb7185" />
      <stop offset="50%" stop-color="#ffffff" />
      <stop offset="70%" stop-color="#fb7185" />
      <stop offset="100%" stop-color="#f43f5e" />
    </linearGradient>

    <!-- Mismatch Mutation Lesion Core -->
    <radialGradient id="pr-lesion-core" cx="35%" cy="30%" r="70%">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="40%" stop-color="#f59e0b" />
      <stop offset="85%" stop-color="#ef4444" />
      <stop offset="100%" stop-color="#991b1b" />
    </radialGradient>

    <!-- Glow & Shadow Filters -->
    <filter id="pr-glow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <filter id="pr-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="1.5" dy="2.5" stdDeviation="2" flood-color="#000000" flood-opacity="0.45" />
    </filter>
  </defs>

  <!-- 1. Ambient Background Optics Aura -->
  <circle cx="50" cy="50" r="47" fill="url(#pr-bg-aura)" />

  <!-- 2. Circular Outer Medallion Frame -->
  <circle
    cx="50"
    cy="50"
    r="46"
    fill="#08111e"
    stroke="url(#pr-border-grad)"
    stroke-width="2.2"
  />

  <!-- 3. Military-Grade Tactical Targeting Optics & Reticle Rings -->
  <!-- Outer Range Ring with Compass Azimuth Ticks -->
  <circle
    cx="50"
    cy="50"
    r="42"
    fill="none"
    stroke="#1e3a5f"
    stroke-width="0.9"
    stroke-dasharray="3, 3"
    opacity="0.75"
  />
  <circle
    cx="50"
    cy="50"
    r="33"
    fill="none"
    stroke="#0284c7"
    stroke-width="1.2"
    stroke-dasharray="4, 4"
    opacity="0.5"
  />
  <circle
    cx="50"
    cy="50"
    r="22"
    fill="none"
    stroke="#38bdf8"
    stroke-width="0.9"
    stroke-dasharray="2, 3"
    opacity="0.65"
  />

  <!-- Tactical Corner Targeting Brackets -->
  <path
    d="M 18 28 L 18 18 L 28 18 M 72 18 L 82 18 L 82 28 M 82 72 L 82 82 L 72 82 M 28 82 L 18 82 L 18 72"
    fill="none"
    stroke="#38bdf8"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    opacity="0.85"
  />

  <!-- Crosshair Precision Axes with Center Standoff -->
  <line x1="50" y1="8" x2="50" y2="20" stroke="#0284c7" stroke-width="1.6" stroke-linecap="round" />
  <line x1="50" y1="80" x2="50" y2="92" stroke="#0284c7" stroke-width="1.6" stroke-linecap="round" />
  <line x1="8" y1="50" x2="20" y2="50" stroke="#0284c7" stroke-width="1.6" stroke-linecap="round" />
  <line x1="80" y1="50" x2="92" y2="50" stroke="#0284c7" stroke-width="1.6" stroke-linecap="round" />

  <!-- 4. Duplex DNA Strand with Obvious Mutation Bulge -->
  <g class="pr-dna-strand">
    <!-- Template DNA Strand (Left) -->
    <path
      d="M 32 20 Q 30 35 34 50 Q 38 65 32 80"
      fill="none"
      stroke="#38bdf8"
      stroke-width="2.5"
      stroke-linecap="round"
      opacity="0.75"
    />
    <!-- Primer/Nascent Strand with Mismatch Bulge (Right) -->
    <path
      d="M 68 20 Q 70 35 66 50 Q 62 65 68 80"
      fill="none"
      stroke="#818cf8"
      stroke-width="2.5"
      stroke-linecap="round"
      opacity="0.75"
    />

    <!-- Matched Base Hydrogen Bonds (Top & Bottom) -->
    <line x1="33" y1="26" x2="67" y2="26" stroke="#94a3b8" stroke-width="1.4" opacity="0.6" />
    <line x1="32" y1="36" x2="68" y2="36" stroke="#94a3b8" stroke-width="1.4" opacity="0.6" />
    <line x1="36" y1="64" x2="64" y2="64" stroke="#94a3b8" stroke-width="1.4" opacity="0.6" />
    <line x1="33" y1="74" x2="67" y2="74" stroke="#94a3b8" stroke-width="1.4" opacity="0.6" />
  </g>

  <!-- 5. 3D Exonuclease Proofreading Complex (3'->5' Catalytic Cleft) -->
  <g class="pr-exo-complex" filter="url(#pr-shadow)">
    <!-- Main Bi-lobed Exonuclease Protein Body -->
    <path
      d="M 28 36 C 34 22, 66 22, 72 36 C 76 46, 74 62, 64 68 C 54 74, 46 74, 36 68 C 26 62, 24 46, 28 36 Z"
      fill="url(#pr-exo-body)"
      stroke="#ffffff"
      stroke-width="1.6"
    />

    <!-- Specular Highlight Curve on Protein Shell -->
    <path
      d="M 32 36 C 36 28, 64 28, 68 36"
      fill="none"
      stroke="#ffffff"
      stroke-width="1.4"
      stroke-linecap="round"
      opacity="0.65"
    />

    <!-- Active Catalytic Excision Pocket (Inner Cleft) -->
    <path
      d="M 38 42 C 45 37, 55 37, 62 42 C 65 48, 63 58, 50 62 C 37 58, 35 48, 38 42 Z"
      fill="#08111e"
      stroke="#38bdf8"
      stroke-width="1.4"
    />

    <!-- Catalytic Metal Ions (Dual Mg2+ Sparkles) -->
    <circle cx="45" cy="48" r="2.5" fill="#38bdf8" stroke="#ffffff" stroke-width="0.8" />
    <circle cx="55" cy="48" r="2.5" fill="#38bdf8" stroke="#ffffff" stroke-width="0.8" />
    <circle cx="44.2" cy="47.2" r="0.9" fill="#ffffff" />
    <circle cx="54.2" cy="47.2" r="0.9" fill="#ffffff" />
  </g>

  <!-- 6. Hydrolytic Excision Laser & Vaporizing Mismatch Mutation -->
  <g class="pr-laser-cleavage" filter="url(#pr-glow)">
    <!-- High-Energy Excision Laser Beam (Vertical Precision Strike) -->
    <line x1="50" y1="30" x2="50" y2="70" stroke="url(#pr-laser-flare)" stroke-width="3.2" stroke-linecap="round" />
    <line x1="50" y1="38" x2="50" y2="62" stroke="#ffffff" stroke-width="1.4" stroke-linecap="round" />

    <!-- Disintegrating Mismatch Lesion Diamond -->
    <g transform="translate(50, 50)">
      <polygon points="0,-7.5 7.5,0 0,7.5 -7.5,0" fill="url(#pr-lesion-core)" stroke="#ffffff" stroke-width="1" />
      <circle cx="0" cy="0" r="2" fill="#ffffff" />
    </g>

    <!-- Hydrolysis Plasma Sparks & Vaporizing Embers -->
    <circle cx="43" cy="44" r="1.4" fill="#fbbf24" />
    <circle cx="57" cy="44" r="1.4" fill="#f43f5e" />
    <circle cx="43" cy="56" r="1.2" fill="#38bdf8" />
    <circle cx="57" cy="56" r="1.2" fill="#ffffff" />
  </g>

  <!-- 7. Optical HUD Verification Readouts & Precursor Gems -->
  <g class="pr-readouts" filter="url(#pr-glow)">
    <!-- HUD Mode Indicator: 3'-5' EXO -->
    <text
      x="50"
      y="88.5"
      fill="#38bdf8"
      font-family="monospace"
      font-size="5.2"
      font-weight="900"
      letter-spacing="0.5"
      text-anchor="middle"
    >3'→5' EXO ACTIVE</text>

    <!-- Floating Correction dNTP Precursors (A · T · C · G) -->
    <!-- Gem A (Emerald) -->
    <polygon points="16,36 19.5,32 23,36 19.5,40" fill="#10b981" stroke="#ffffff" stroke-width="0.8" />
    <text x="19.5" y="37.5" font-family="monospace" font-size="4.5" font-weight="900" fill="#ffffff" text-anchor="middle">A</text>

    <!-- Gem T (Violet) -->
    <polygon points="77,36 80.5,32 84,36 80.5,40" fill="#a855f7" stroke="#ffffff" stroke-width="0.8" />
    <text x="80.5" y="37.5" font-family="monospace" font-size="4.5" font-weight="900" fill="#ffffff" text-anchor="middle">T</text>
  </g>
</svg>

<style>
  .proofreader-logo {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
    filter: drop-shadow(0 4px 12px rgba(2, 132, 199, 0.25));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.25s ease;
  }

  :global(.tool:hover) .proofreader-logo,
  .proofreader-logo:hover {
    transform: translateY(-2px) scale(1.06);
    filter: drop-shadow(0 6px 20px rgba(56, 189, 248, 0.45));
  }
</style>
