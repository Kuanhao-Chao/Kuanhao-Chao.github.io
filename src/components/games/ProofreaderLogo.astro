---
import GameIconFrame from './GameIconFrame.astro';
interface Props {
  size?: number;
  class?: string;
}
const { size = 64, class: className = '' } = Astro.props;
---

<GameIconFrame
  size={size}
  class={`proofreader-logo ${className}`}
  label="Proofreader — a DNA fork with a corrected base"
  accent="#a87b46"
>
  <path
    d="M40 82 V62 Q39 45 20 22 M53 82 V60 Q55 44 78 22"
    fill="none"
    stroke="var(--gi-deep)"
    stroke-width="4"></path>
  <path
    d="M43 76 H50 M43 65 H50 M33 46 L39 42 M25 34 L31 30 M63 44 L57 40 M73 32 L67 28"
    stroke="var(--gi-mid)"
    stroke-width="3"></path>
  <path
    d="M44 55 Q32 39 24 22 M49 55 Q62 39 73 23"
    fill="none"
    stroke="var(--gi-accent)"
    stroke-width="3"></path>
  <path d="M62 61 L78 77" stroke="var(--gi-deep)" stroke-width="9"></path>
  <path d="M65 63 L78 76" stroke="var(--gi-accent)" stroke-width="5"></path>
  <circle cx="49" cy="49" r="21" fill="var(--gi-light)" stroke="var(--gi-deep)" stroke-width="3"
  ></circle>
  <path d="M35 46 H64 M35 55 H64" stroke="var(--gi-mid)" stroke-width="3"></path>
  <path d="M41 46 V55 M50 46 V55 M59 46 V55" stroke="var(--gi-accent)" stroke-width="3"></path>
  <rect x="45" y="42" width="11" height="18" rx="4" fill="#5d8a75"></rect>
  <path d="M48 50 L50 53 54 47" fill="none" stroke="#ffffff" stroke-width="2"></path>
  <path d="M35 37 Q40 31 47 32" fill="none" stroke="#ffffff" stroke-width="3" opacity=".8"></path>
</GameIconFrame>
