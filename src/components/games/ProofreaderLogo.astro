---
interface Props {
  size?: number;
  class?: string;
}

const { size = 64, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class:list={['proofreader-logo', className]}
  role="img"
  aria-label="Proofreader Logo — DNA Polymerase III epsilon proofreading domain with targeting crosshair and nucleotide gems"
>
  <defs>
    <!-- Ambient Aura -->
    <radialGradient id="pr-aura" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="var(--color-accent, #2e6e5e)" stop-opacity="0.25" />
      <stop offset="100%" stop-color="var(--color-accent, #2e6e5e)" stop-opacity="0" />
    </radialGradient>

    <!-- Exonuclease Core Gradient -->
    <linearGradient id="pr-exo-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0284c7" />
      <stop offset="50%" stop-color="#0369a1" />
      <stop offset="100%" stop-color="#075985" />
    </linearGradient>

    <!-- Cleavage Laser Beam Gradient -->
    <linearGradient id="pr-laser-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f43f5e" />
      <stop offset="50%" stop-color="#fb7185" />
      <stop offset="100%" stop-color="#ffffff" />
    </linearGradient>

    <!-- Glow Filter -->
    <filter id="pr-glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- 1. Ambient Backdrop Aura -->
  <circle cx="50" cy="50" r="46" fill="url(#pr-aura)" />

  <!-- 2. Tactical Exonuclease Reticle / Targeting Crosshair Ring -->
  <circle
    cx="50"
    cy="50"
    r="42"
    fill="none"
    stroke="var(--color-rule, #e5e4df)"
    stroke-width="1.2"
    stroke-dasharray="4 3"
    opacity="0.65"
  />
  <circle
    cx="50"
    cy="50"
    r="33"
    fill="none"
    stroke="var(--color-accent, #2e6e5e)"
    stroke-width="1"
    stroke-dasharray="2 4"
    opacity="0.5"
  />

  <!-- Corner Targeting Brackets -->
  <path
    d="M 22 30 L 22 22 L 30 22 M 70 22 L 78 22 L 78 30 M 78 70 L 78 78 L 70 78 M 30 78 L 22 78 L 22 70"
    fill="none"
    stroke="var(--color-accent, #2e6e5e)"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  />

  <!-- Crosshair Optics Lines -->
  <line x1="50" y1="12" x2="50" y2="24" stroke="var(--color-accent, #2e6e5e)" stroke-width="1.5" />
  <line x1="50" y1="76" x2="50" y2="88" stroke="var(--color-accent, #2e6e5e)" stroke-width="1.5" />
  <line x1="12" y1="50" x2="24" y2="50" stroke="var(--color-accent, #2e6e5e)" stroke-width="1.5" />
  <line x1="76" y1="50" x2="88" y2="50" stroke="var(--color-accent, #2e6e5e)" stroke-width="1.5" />

  <!-- 3. Exonuclease Proofreading Complex (3'->5' Catalytic Cleft) -->
  <g class="pr-catalytic-body" filter="url(#pr-glow)">
    <!-- Main Protein Subunit Domain -->
    <path
      d="M 32 38 C 36 28, 64 28, 68 38 C 72 44, 70 58, 64 64 C 58 70, 42 70, 36 64 C 30 58, 28 44, 32 38 Z"
      fill="url(#pr-exo-grad)"
      stroke="var(--color-surface, #ffffff)"
      stroke-width="1.5"
    />

    <!-- Active Catalytic Excision Pocket -->
    <path
      d="M 42 44 C 47 41, 53 41, 58 44 C 61 48, 59 55, 50 58 C 41 55, 39 48, 42 44 Z"
      fill="var(--color-surface, #ffffff)"
      stroke="#38bdf8"
      stroke-width="1.2"
    />

    <!-- Active Metal Ion Catalytic Center (Mg2+ / Zn2+) -->
    <circle cx="47" cy="49" r="2.2" fill="#38bdf8" />
    <circle cx="53" cy="49" r="2.2" fill="#38bdf8" />
  </g>

  <!-- 4. Hydrolytic Cleavage Laser Beam on Mismatch Lesion -->
  <g class="pr-cleavage">
    <line x1="50" y1="36" x2="50" y2="64" stroke="url(#pr-laser-grad)" stroke-width="2.5" stroke-linecap="round" />
    <circle cx="50" cy="50" r="3.5" fill="#f43f5e" stroke="#ffffff" stroke-width="1" />
    <!-- Cleavage Spark Burst -->
    <polygon points="50,44 52,49 57,50 52,51 50,56 48,51 43,50 48,49" fill="#ffffff" />
  </g>

  <!-- 5. Surrounding dNTP Pickups (A · C · G · T) -->
  <g class="pr-pickups">
    <!-- Gem A (Emerald) -->
    <polygon points="19,40 23,36 27,40 23,44" fill="#10b981" stroke="#ffffff" stroke-width="0.8" />
    <text x="23" y="41.5" font-family="monospace" font-size="5" font-weight="bold" fill="#ffffff" text-anchor="middle">A</text>

    <!-- Gem T (Purple) -->
    <polygon points="73,40 77,36 81,40 77,44" fill="#a855f7" stroke="#ffffff" stroke-width="0.8" />
    <text x="77" y="41.5" font-family="monospace" font-size="5" font-weight="bold" fill="#ffffff" text-anchor="middle">T</text>

    <!-- Gem C (Cyan) -->
    <polygon points="34,78 38,74 42,78 38,82" fill="#38bdf8" stroke="#ffffff" stroke-width="0.8" />
    <text x="38" y="79.5" font-family="monospace" font-size="5" font-weight="bold" fill="#ffffff" text-anchor="middle">C</text>

    <!-- Gem G (Amber) -->
    <polygon points="58,78 62,74 66,78 62,82" fill="#f59e0b" stroke="#ffffff" stroke-width="0.8" />
    <text x="62" y="79.5" font-family="monospace" font-size="5" font-weight="bold" fill="#ffffff" text-anchor="middle">G</text>
  </g>
</svg>

<style>
  .proofreader-logo {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.12));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .proofreader-logo:hover {
    transform: scale(1.06) translateY(-2px);
  }
</style>
