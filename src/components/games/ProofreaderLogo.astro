---
import GameIconFrame from './GameIconFrame.astro';
interface Props {
  size?: number;
  class?: string;
}
const { size = 64, class: className = '' } = Astro.props;
---

<GameIconFrame
  size={size}
  class={`proofreader-logo ${className}`}
  label="Proofreader — a precision tool within a DNA containment ring"
  accent="#6c9b85"
>
  <g stroke-linecap="round" stroke-linejoin="round">
    <circle cx="48" cy="48" r="31" fill="none" stroke="var(--gi-mid)" stroke-width="2"></circle>
    <path
      d="M32 22C64 35 32 59 64 74M64 22C32 35 64 59 32 74"
      fill="none"
      stroke="var(--gi-accent)"
      stroke-width="4"></path>
    <path d="M37 28H59M40 40H56M40 56H56M37 68H59" stroke="var(--gi-mid)" stroke-width="2.5"></path>
    <path
      d="M23 57L48 32L64 48L39 73L25 71Z"
      fill="var(--gi-deep)"
      stroke="var(--gi-light)"
      stroke-width="2"></path>
    <path d="M36 49L47 38L58 49L47 60Z" fill="var(--gi-mid)"></path>
    <path
      d="M47 39L57 29L66 38L56 48"
      fill="var(--gi-accent)"
      stroke="var(--gi-light)"
      stroke-width="2"></path>
    <circle cx="47" cy="49" r="4" fill="var(--gi-light)"></circle>
    <path d="M23 39L23 30H32M64 66H73V57" fill="none" stroke="var(--gi-deep)" stroke-width="2.5"
    ></path>
  </g>
</GameIconFrame>
