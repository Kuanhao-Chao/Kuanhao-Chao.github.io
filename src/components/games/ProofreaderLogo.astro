---
interface Props {
  size?: number;
  class?: string;
}

const { size = 64, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class:list={['proofreader-logo', className]}
  role="img"
  aria-label="Proofreader Logo — DNA Polymerase III epsilon proofreading domain with precision optics and excision laser"
>
  <defs>
    <!-- Ambient Aura -->
    <radialGradient id="pr-aura" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#0284c7" stop-opacity="0.3" />
      <stop offset="60%" stop-color="#0369a1" stop-opacity="0.1" />
      <stop offset="100%" stop-color="#075985" stop-opacity="0" />
    </radialGradient>

    <!-- Exonuclease Core Gradient -->
    <linearGradient id="pr-exo-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="35%" stop-color="#0284c7" />
      <stop offset="75%" stop-color="#0369a1" />
      <stop offset="100%" stop-color="#0c4a6e" />
    </linearGradient>

    <!-- Cleavage Hydrolytic Laser Gradient -->
    <linearGradient id="pr-laser-grad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#f43f5e" />
      <stop offset="40%" stop-color="#fb7185" />
      <stop offset="70%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#f43f5e" />
    </linearGradient>

    <!-- Mutation Lesion Diamond Gradient -->
    <linearGradient id="pr-lesion-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fbbf24" />
      <stop offset="50%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#b45309" />
    </linearGradient>

    <!-- Glow Filter -->
    <filter id="pr-glow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- 1. Ambient Backdrop Aura -->
  <circle cx="50" cy="50" r="46" fill="url(#pr-aura)" />

  <!-- 2. Tactical Exonuclease Reticle & Optics Range Rings -->
  <circle
    cx="50"
    cy="50"
    r="44"
    fill="none"
    stroke="var(--color-rule, #e5e4df)"
    stroke-width="1.2"
    stroke-dasharray="4 3"
    opacity="0.65"
  />
  <circle
    cx="50"
    cy="50"
    r="36"
    fill="none"
    stroke="#0284c7"
    stroke-width="1.2"
    stroke-dasharray="3 3"
    opacity="0.5"
  />
  <circle
    cx="50"
    cy="50"
    r="24"
    fill="none"
    stroke="#38bdf8"
    stroke-width="0.9"
    stroke-dasharray="2 3"
    opacity="0.6"
  />

  <!-- Tactical Corner Targeting Brackets -->
  <path
    d="M 18 28 L 18 18 L 28 18 M 72 18 L 82 18 L 82 28 M 82 72 L 82 82 L 72 82 M 28 82 L 18 82 L 18 72"
    fill="none"
    stroke="#0284c7"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  />

  <!-- Optics Azimuth Crosshair Lines -->
  <line x1="50" y1="8" x2="50" y2="20" stroke="#0284c7" stroke-width="1.8" stroke-linecap="round" />
  <line x1="50" y1="80" x2="50" y2="92" stroke="#0284c7" stroke-width="1.8" stroke-linecap="round" />
  <line x1="8" y1="50" x2="20" y2="50" stroke="#0284c7" stroke-width="1.8" stroke-linecap="round" />
  <line x1="80" y1="50" x2="92" y2="50" stroke="#0284c7" stroke-width="1.8" stroke-linecap="round" />

  <!-- 3. Exonuclease Proofreading Complex (3'->5' Catalytic Cleft) -->
  <g class="pr-catalytic-body" filter="url(#pr-glow)">
    <!-- Main Protein Subunit Domain -->
    <path
      d="M 30 36 C 35 24, 65 24, 70 36 C 74 44, 72 60, 64 66 C 56 72, 44 72, 36 66 C 28 60, 26 44, 30 36 Z"
      fill="url(#pr-exo-grad)"
      stroke="var(--color-surface, #ffffff)"
      stroke-width="1.6"
    />

    <!-- Active Catalytic Excision Pocket (Cleft) -->
    <path
      d="M 40 42 C 46 38, 54 38, 60 42 C 64 48, 62 56, 50 60 C 38 56, 36 48, 40 42 Z"
      fill="var(--color-surface, #ffffff)"
      stroke="#38bdf8"
      stroke-width="1.3"
    />

    <!-- Active Metal Ion Catalytic Center (Mg2+ / Zn2+ Sparkles) -->
    <circle cx="46" cy="48" r="2.4" fill="#38bdf8" stroke="#ffffff" stroke-width="0.6" />
    <circle cx="54" cy="48" r="2.4" fill="#38bdf8" stroke="#ffffff" stroke-width="0.6" />
    <circle cx="45" cy="47" r="0.8" fill="#ffffff" />
    <circle cx="53" cy="47" r="0.8" fill="#ffffff" />
  </g>

  <!-- 4. Focused Hydrolytic Cleavage Laser Beam & Disintegrating Lesion -->
  <g class="pr-cleavage" filter="url(#pr-glow)">
    <!-- Laser Cleavage Beam -->
    <line x1="50" y1="32" x2="50" y2="68" stroke="url(#pr-laser-grad)" stroke-width="3" stroke-linecap="round" />
    <line x1="50" y1="38" x2="50" y2="62" stroke="#ffffff" stroke-width="1.4" stroke-linecap="round" />

    <!-- Disintegrating Mismatch Lesion (Diamond Δ) -->
    <g transform="translate(50, 50)">
      <polygon points="0,-7 7,0 0,7 -7,0" fill="url(#pr-lesion-grad)" stroke="#ffffff" stroke-width="1" />
      <circle cx="0" cy="0" r="2" fill="#f43f5e" />
    </g>

    <!-- Radial Plasma Sparks Burst -->
    <polygon points="50,42 52.5,48.5 58,50 52.5,51.5 50,58 47.5,51.5 42,50 47.5,48.5" fill="#ffffff" />
    <circle cx="44" cy="44" r="1" fill="#f43f5e" />
    <circle cx="56" cy="44" r="1" fill="#fbbf24" />
    <circle cx="44" cy="56" r="0.9" fill="#38bdf8" />
    <circle cx="56" cy="56" r="1.1" fill="#ffffff" />
  </g>

  <!-- 5. Surrounding dNTP Pickups (A · C · G · T) -->
  <g class="pr-pickups" filter="url(#pr-glow)">
    <!-- Gem A (Emerald) -->
    <polygon points="16,38 20,34 24,38 20,42" fill="#10b981" stroke="#ffffff" stroke-width="0.8" />
    <text x="20" y="39.5" font-family="monospace" font-size="5.2" font-weight="bold" fill="#ffffff" text-anchor="middle">A</text>

    <!-- Gem T (Purple) -->
    <polygon points="76,38 80,34 84,38 80,42" fill="#a855f7" stroke="#ffffff" stroke-width="0.8" />
    <text x="80" y="39.5" font-family="monospace" font-size="5.2" font-weight="bold" fill="#ffffff" text-anchor="middle">T</text>

    <!-- Gem C (Cyan) -->
    <polygon points="30,80 34,76 38,80 34,84" fill="#38bdf8" stroke="#ffffff" stroke-width="0.8" />
    <text x="34" y="81.5" font-family="monospace" font-size="5.2" font-weight="bold" fill="#ffffff" text-anchor="middle">C</text>

    <!-- Gem G (Amber) -->
    <polygon points="62,80 66,76 70,80 66,84" fill="#f59e0b" stroke="#ffffff" stroke-width="0.8" />
    <text x="66" y="81.5" font-family="monospace" font-size="5.2" font-weight="bold" fill="#ffffff" text-anchor="middle">G</text>
  </g>
</svg>

<style>
  .proofreader-logo {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.12));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .proofreader-logo:hover {
    transform: scale(1.08) translateY(-2px);
  }
</style>
