---
interface Props {
  size?: number;
  class?: string;
}

const { size = 72, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class:list={['crispr-logo-svg', className]}
  role="img"
  aria-label="CRISPR Commander Logo"
>
  <defs>
    <!-- Background glow gradient -->
    <radialGradient id="cc-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="var(--color-accent, #38bdf8)" stop-opacity="0.35" />
      <stop offset="100%" stop-color="var(--color-accent, #38bdf8)" stop-opacity="0" />
    </radialGradient>

    <!-- DNA Strand Gradients -->
    <linearGradient id="cc-dna-strand1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0284c7" />
      <stop offset="50%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#06b6d4" />
    </linearGradient>
    <linearGradient id="cc-dna-strand2" x1="100%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ec4899" />
      <stop offset="50%" stop-color="#a855f7" />
      <stop offset="100%" stop-color="#8b5cf6" />
    </linearGradient>

    <!-- Cas9 Blade Gradient -->
    <linearGradient id="cc-blade" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f59e0b" />
      <stop offset="50%" stop-color="#ef4444" />
      <stop offset="100%" stop-color="#dc2626" />
    </linearGradient>

    <!-- Shield Border Gradient -->
    <linearGradient id="cc-shield-border" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="var(--color-accent, #38bdf8)" />
      <stop offset="100%" stop-color="var(--color-rule, #334155)" />
    </linearGradient>
  </defs>

  <!-- Ambient Glow -->
  <circle cx="50" cy="50" r="46" fill="url(#cc-glow)" />

  <!-- Hexagonal Tech Crest Frame -->
  <polygon
    points="50,4 88,24 88,76 50,96 12,76 12,24"
    fill="var(--color-surface, #1e293b)"
    stroke="url(#cc-shield-border)"
    stroke-width="2.5"
    stroke-linejoin="round"
  />

  <!-- DNA Double Helix Waves -->
  <!-- Strand 1 -->
  <path
    d="M24,25 Q38,45 50,50 T76,75"
    stroke="url(#cc-dna-strand1)"
    stroke-width="3"
    stroke-linecap="round"
    fill="none"
  />
  <!-- Strand 2 -->
  <path
    d="M24,75 Q38,55 50,50 T76,25"
    stroke="url(#cc-dna-strand2)"
    stroke-width="3"
    stroke-linecap="round"
    fill="none"
  />

  <!-- Base-Pair Rungs (Watson-Crick hydrogen bonds) -->
  <line x1="30" y1="36" x2="30" y2="64" stroke="var(--color-muted, #94a3b8)" stroke-width="1.8" stroke-dasharray="2 2" />
  <line x1="40" y1="44" x2="40" y2="56" stroke="var(--color-muted, #94a3b8)" stroke-width="1.8" stroke-dasharray="2 2" />
  <line x1="60" y1="56" x2="60" y2="44" stroke="var(--color-muted, #94a3b8)" stroke-width="1.8" stroke-dasharray="2 2" />
  <line x1="70" y1="64" x2="70" y2="36" stroke="var(--color-muted, #94a3b8)" stroke-width="1.8" stroke-dasharray="2 2" />

  <!-- Cas9 Guide RNA Hairpin Loop (sgRNA scaffold) -->
  <path
    d="M50,18 C58,18 64,24 64,32 C64,38 58,42 50,46"
    stroke="#10b981"
    stroke-width="2"
    stroke-dasharray="3 2"
    fill="none"
  />
  <circle cx="50" cy="18" r="2.5" fill="#10b981" />

  <!-- Cas9 Molecular Catalytic Shears / Cleavage Blades -->
  <g transform="translate(50,50)">
    <!-- Blade 1 (Upper Left to Lower Right) -->
    <path
      d="M-22,-22 L22,22 L16,24 L-24,-16 Z"
      fill="url(#cc-blade)"
      stroke="#ffffff"
      stroke-width="0.8"
    />
    <!-- Blade 2 (Upper Right to Lower Left) -->
    <path
      d="M22,-22 L-22,22 L-24,16 L16,-24 Z"
      fill="url(#cc-blade)"
      stroke="#ffffff"
      stroke-width="0.8"
    />
    <!-- Center Catalytic Core / Active Lobe Pivot -->
    <circle cx="0" cy="0" r="5.5" fill="var(--color-surface, #0f172a)" stroke="#f59e0b" stroke-width="2.5" />
    <circle cx="0" cy="0" r="2" fill="#ffffff" />

    <!-- Double Strand Break Spark Particles -->
    <circle cx="-7" cy="-7" r="1.5" fill="#facc15" />
    <circle cx="7" cy="7" r="1.5" fill="#facc15" />
    <circle cx="9" cy="-4" r="1" fill="#38bdf8" />
    <circle cx="-9" cy="4" r="1" fill="#ec4899" />
  </g>

  <!-- PAM Target Site Motif Badge (5'-NGG-3') -->
  <rect x="35" y="80" width="30" height="12" rx="3" fill="var(--color-bg, #0f172a)" stroke="#f59e0b" stroke-width="1.2" />
  <text
    x="50"
    y="88.5"
    fill="#f59e0b"
    font-family="monospace"
    font-size="6.5"
    font-weight="bold"
    text-anchor="middle"
  >NGG PAM</text>
</svg>

<style>
  .crispr-logo-svg {
    display: inline-block;
    vertical-align: middle;
    filter: drop-shadow(0 4px 12px rgba(56, 189, 248, 0.2));
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  .crispr-logo-svg:hover {
    transform: scale(1.05);
    filter: drop-shadow(0 6px 18px rgba(56, 189, 248, 0.35));
  }
</style>
