---
interface Props {
  size?: number;
  class?: string;
}

const { size = 72, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class:list={['crispr-commander-logo', className]}
  role="img"
  aria-label="CRISPR Commander Logo — 3D Cas9 molecular endonuclease with R-loop DNA unwinding, catalytic shears, and PAM target clamp"
>
  <defs>
    <!-- Background Molecular Aura -->
    <radialGradient id="cc-bg-aura" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#0284c7" stop-opacity="0.35" />
      <stop offset="65%" stop-color="#0f172a" stop-opacity="0.15" />
      <stop offset="100%" stop-color="#020617" stop-opacity="0" />
    </radialGradient>

    <!-- Outer Hex Shield Crest Gradient -->
    <linearGradient id="cc-crest-border" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="40%" stop-color="#0284c7" />
      <stop offset="80%" stop-color="#1e293b" />
      <stop offset="100%" stop-color="#0ea5e9" />
    </linearGradient>

    <!-- Cas9 REC Lobe (Recognition Lobe - Cyan/Teal) -->
    <linearGradient id="cc-rec-lobe" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#7dd3fc" />
      <stop offset="35%" stop-color="#38bdf8" />
      <stop offset="75%" stop-color="#0284c7" />
      <stop offset="100%" stop-color="#075985" />
    </linearGradient>

    <!-- Cas9 NUC Lobe (Nuclease Lobe - HNH/RuvC - Ruby/Amber) -->
    <linearGradient id="cc-nuc-lobe" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fca5a5" />
      <stop offset="35%" stop-color="#ef4444" />
      <stop offset="75%" stop-color="#b91c1c" />
      <stop offset="100%" stop-color="#7f1d1d" />
    </linearGradient>

    <!-- Metallic Cleavage Blade Facets -->
    <linearGradient id="cc-blade-sheen" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="30%" stop-color="#fef08a" />
      <stop offset="65%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#d97706" />
    </linearGradient>

    <!-- Guide RNA (sgRNA Emerald Gradient) -->
    <linearGradient id="cc-sgrna-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#6ee7b7" />
      <stop offset="50%" stop-color="#10b981" />
      <stop offset="100%" stop-color="#047857" />
    </linearGradient>

    <!-- Target DNA Strand (Violet / Fuchsia) -->
    <linearGradient id="cc-dna-target" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f472b6" />
      <stop offset="50%" stop-color="#c084fc" />
      <stop offset="100%" stop-color="#7c3aed" />
    </linearGradient>

    <!-- Plasma Cleavage Fire Burst -->
    <radialGradient id="cc-plasma-burst" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="35%" stop-color="#fef08a" />
      <stop offset="70%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#ef4444" stop-opacity="0" />
    </radialGradient>

    <!-- Glow & Shadow Filters -->
    <filter id="cc-glow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="2.2" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <filter id="cc-subtle-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="1" dy="2" stdDeviation="2" flood-color="#000000" flood-opacity="0.4" />
    </filter>
  </defs>

  <!-- 1. Ambient Molecular Aura Backdrop -->
  <circle cx="50" cy="50" r="47" fill="url(#cc-bg-aura)" />

  <!-- 2. Cybernetic Hexagonal Defense Crest Frame -->
  <polygon
    points="50,4 88,23 88,77 50,96 12,77 12,23"
    fill="#0b1329"
    stroke="url(#cc-crest-border)"
    stroke-width="2.2"
    stroke-linejoin="round"
  />

  <!-- Hexagonal Tech Inlay Groove -->
  <polygon
    points="50,9 84,26 84,74 50,91 16,74 16,26"
    fill="none"
    stroke="#1e293b"
    stroke-width="1.2"
    stroke-dasharray="3, 3"
    opacity="0.85"
  />

  <!-- Cellular Targeting Reticle Grid Lines -->
  <g stroke="#1e3a8a" stroke-width="0.8" opacity="0.4">
    <line x1="50" y1="9" x2="50" y2="91" stroke-dasharray="2, 4" />
    <line x1="16" y1="50" x2="84" y2="50" stroke-dasharray="2, 4" />
    <circle cx="50" cy="50" r="28" fill="none" stroke-dasharray="3, 5" />
  </g>

  <!-- 3. Target DNA Double Helix entering from top and exiting bottom -->
  <g class="cc-dna-helix">
    <!-- Non-target Strand (Violet C-curve) -->
    <path
      d="M 28 20 Q 38 32 34 44 Q 30 56 36 68 Q 40 76 34 82"
      fill="none"
      stroke="url(#cc-dna-target)"
      stroke-width="2.8"
      stroke-linecap="round"
      filter="url(#cc-subtle-shadow)"
    />
    <!-- Target Strand unwinding into R-loop bubble -->
    <path
      d="M 38 18 Q 44 26 50 34 Q 58 40 68 44 Q 60 62 48 68 Q 42 74 46 82"
      fill="none"
      stroke="#38bdf8"
      stroke-width="2.5"
      stroke-linecap="round"
    />

    <!-- Complementary base-pairing rungs -->
    <line x1="30" y1="22" x2="37" y2="19" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" opacity="0.7" />
    <line x1="33" y1="28" x2="42" y2="24" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" opacity="0.7" />
    <line x1="36" y1="72" x2="46" y2="70" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" opacity="0.7" />
    <line x1="34" y1="79" x2="44" y2="78" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" opacity="0.7" />
  </g>

  <!-- 4. sgRNA Guide RNA Strand with Hairpin Scaffold Loop -->
  <g class="cc-sgrna" filter="url(#cc-glow)">
    <!-- sgRNA Hairpin Loop at top-right -->
    <path
      d="M 52 32 C 60 22, 74 20, 78 28 C 82 36, 74 42, 65 42"
      fill="none"
      stroke="url(#cc-sgrna-grad)"
      stroke-width="2.4"
      stroke-linecap="round"
    />
    <!-- Stem loop base-pair hydrogen bonds -->
    <line x1="63" y1="27" x2="70" y2="34" stroke="#6ee7b7" stroke-width="1.2" stroke-dasharray="1.5, 1.5" />
    <circle cx="78" cy="28" r="2.5" fill="#10b981" />
  </g>

  <!-- 5. 3D Cas9 Bi-Lobed Endonuclease Structure -->
  <!-- Recognition (REC) Lobe (Left / Upper-Left Body) -->
  <g class="cc-rec-lobe-group" filter="url(#cc-subtle-shadow)">
    <path
      d="M 28 32 C 20 40, 20 60, 30 68 C 38 72, 44 68, 46 60 C 42 54, 40 44, 42 36 C 38 32, 32 30, 28 32 Z"
      fill="url(#cc-rec-lobe)"
      stroke="#0284c7"
      stroke-width="1.4"
    />
    <!-- Specular Highlight Curve on REC Lobe -->
    <path
      d="M 26 38 C 23 46, 24 56, 30 63"
      fill="none"
      stroke="#ffffff"
      stroke-width="1.4"
      stroke-linecap="round"
      opacity="0.65"
    />
  </g>

  <!-- Nuclease (NUC) Lobe (Right Body - HNH & RuvC domains) -->
  <g class="cc-nuc-lobe-group" filter="url(#cc-subtle-shadow)">
    <path
      d="M 54 36 C 66 32, 76 44, 74 58 C 72 70, 58 74, 50 66 C 54 58, 52 46, 48 40 C 50 38, 52 36, 54 36 Z"
      fill="url(#cc-nuc-lobe)"
      stroke="#991b1b"
      stroke-width="1.4"
    />
    <!-- Specular Highlight Curve on NUC Lobe -->
    <path
      d="M 71 44 C 74 52, 72 62, 64 68"
      fill="none"
      stroke="#ffffff"
      stroke-width="1.4"
      stroke-linecap="round"
      opacity="0.55"
    />
  </g>

  <!-- 6. Catalytic Molecular Shears (Double-Strand Cleavage Blades) -->
  <g class="cc-catalytic-shears" filter="url(#cc-glow)" transform="translate(50, 50)">
    <!-- Scissor Blade 1 (Upper-Right to Lower-Left) -->
    <path
      d="M -18 -18 L 18 18 L 13 20 L -20 -14 Z"
      fill="url(#cc-blade-sheen)"
      stroke="#ffffff"
      stroke-width="0.8"
    />
    <!-- Scissor Blade 2 (Upper-Left to Lower-Right) -->
    <path
      d="M 18 -18 L -18 18 L -20 13 L 14 -20 Z"
      fill="url(#cc-blade-sheen)"
      stroke="#ffffff"
      stroke-width="0.8"
    />

    <!-- Central Catalytic Pivot / Active Site Lobe -->
    <circle cx="0" cy="0" r="6" fill="#0f172a" stroke="#fbbf24" stroke-width="2.2" />
    <circle cx="0" cy="0" r="2.8" fill="#ffffff" />

    <!-- Cleavage Flash / DSB (Double Strand Break) Starburst -->
    <circle cx="0" cy="0" r="10" fill="url(#cc-plasma-burst)" />
    <!-- Cleavage Sparks -->
    <circle cx="-12" cy="-12" r="1.6" fill="#ffffff" />
    <circle cx="12" cy="12" r="1.6" fill="#fef08a" />
    <circle cx="-14" cy="10" r="1.3" fill="#38bdf8" />
    <circle cx="13" cy="-10" r="1.3" fill="#f43f5e" />
  </g>

  <!-- 7. PAM Motif Recognition Clamp (5'-NGG-3') -->
  <g class="cc-pam-badge" transform="translate(34, 80)">
    <!-- Glowing Border Box -->
    <rect
      x="0"
      y="0"
      width="32"
      height="12"
      rx="3"
      fill="#091024"
      stroke="#f59e0b"
      stroke-width="1.4"
      filter="url(#cc-subtle-shadow)"
    />
    <!-- Lock Clamp Screws -->
    <circle cx="4" cy="6" r="1" fill="#fbbf24" />
    <circle cx="28" cy="6" r="1" fill="#fbbf24" />
    <!-- PAM Typography -->
    <text
      x="16"
      y="8.5"
      fill="#fbbf24"
      font-family="monospace"
      font-size="6.8"
      font-weight="900"
      letter-spacing="0.5"
      text-anchor="middle"
    >NGG PAM</text>
  </g>
</svg>

<style>
  .crispr-commander-logo {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
    filter: drop-shadow(0 4px 12px rgba(2, 132, 199, 0.25));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.25s ease;
  }

  :global(.tool:hover) .crispr-commander-logo,
  .crispr-commander-logo:hover {
    transform: translateY(-2px) scale(1.06);
    filter: drop-shadow(0 6px 20px rgba(56, 189, 248, 0.45));
  }
</style>
