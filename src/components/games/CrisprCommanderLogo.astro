---
import GameIconFrame from './GameIconFrame.astro';
interface Props {
  size?: number;
  class?: string;
}
const { size = 72, class: className = '' } = Astro.props;
---

<GameIconFrame
  size={size}
  class={`crispr-commander-logo ${className}`}
  label="CRISPR Commander — guided DNA cleavage"
  accent="#2e8378"
>
  <path
    d="M28 40 Q24 27 37 24 Q48 14 59 25 Q76 24 78 40 Q85 51 73 60 Q60 70 47 63 Q29 64 28 50Z"
    fill="var(--gi-light)"
    stroke="var(--gi-mid)"
    stroke-width="3"></path>
  <path
    d="M38 19 Q67 28 38 39 Q30 43 35 48 M65 19 Q36 28 65 39 Q73 43 68 48"
    fill="none"
    stroke="var(--gi-deep)"
    stroke-width="4"></path>
  <path
    d="M38 55 Q67 64 38 76 L34 82 M65 55 Q36 64 65 76 L69 82"
    fill="none"
    stroke="var(--gi-accent)"
    stroke-width="4"></path>
  <g stroke="var(--gi-mid)" stroke-width="3">
    <path d="M42 23 H61 M42 34 H61 M37 43 H66 M42 60 H61 M42 71 H61 M37 80 H66"></path>
  </g>
  <path d="M20 32 V48 Q20 55 27 55 H39" fill="none" stroke="#c08f47" stroke-width="4"></path>
  <path d="M19 33 H25 M19 41 H25" stroke="#ead4a3" stroke-width="2.5"></path>
  <path d="M42 48 L47 53 42 58 M61 48 L56 53 61 58" fill="none" stroke="#ba6658" stroke-width="3.5"
  ></path>
  <path d="M72 32 Q77 39 73 46" fill="none" stroke="#ffffff" stroke-width="2.5" opacity=".7"></path>
</GameIconFrame>
