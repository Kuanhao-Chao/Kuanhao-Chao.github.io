---
interface Props {
  size?: number;
  class?: string;
}

const { size = 64, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class:list={['flappy-penguin-logo', className]}
  role="img"
  aria-label="Flappy Penguin Logo — Arctic flying penguin navigating crystalline glacial ice pillars beneath shimmering aurora ribbons"
>
  <defs>
    <!-- Arctic Sky Aura Gradient -->
    <radialGradient id="fp-bg-aura" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.32" />
      <stop offset="60%" stop-color="#0284c7" stop-opacity="0.15" />
      <stop offset="100%" stop-color="#020617" stop-opacity="0" />
    </radialGradient>

    <!-- Outer Frame Gradient -->
    <linearGradient id="fp-border-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#bae6fd" />
      <stop offset="50%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#0284c7" />
    </linearGradient>

    <!-- Aurora Borealis Ribbon Gradient -->
    <linearGradient id="fp-aurora-ribbon" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#10b981" stop-opacity="0.45" />
      <stop offset="50%" stop-color="#06b6d4" stop-opacity="0.35" />
      <stop offset="100%" stop-color="#8b5cf6" stop-opacity="0" />
    </linearGradient>

    <!-- Penguin Plumage 3D Gradient -->
    <linearGradient id="fp-penguin-coat" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#475569" />
      <stop offset="40%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#020617" />
    </linearGradient>

    <!-- White Plump Belly Gradient -->
    <linearGradient id="fp-belly-grad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="70%" stop-color="#f8fafc" />
      <stop offset="100%" stop-color="#cbd5e1" />
    </linearGradient>

    <!-- Bright Orange Beak and Feet -->
    <linearGradient id="fp-orange-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="40%" stop-color="#fbbf24" />
      <stop offset="100%" stop-color="#d97706" />
    </linearGradient>

    <!-- Aviator Scarf Crimson Gradient -->
    <linearGradient id="fp-scarf-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fb7185" />
      <stop offset="50%" stop-color="#f43f5e" />
      <stop offset="100%" stop-color="#be123c" />
    </linearGradient>

    <!-- Glacial Crystal Ice Pillar -->
    <linearGradient id="fp-ice-pillar" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="35%" stop-color="#7dd3fc" />
      <stop offset="80%" stop-color="#0284c7" />
      <stop offset="100%" stop-color="#075985" />
    </linearGradient>

    <!-- Glow & Shadow Filters -->
    <filter id="fp-glow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <filter id="fp-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="1.5" dy="2.5" stdDeviation="2" flood-color="#000000" flood-opacity="0.45" />
    </filter>
  </defs>

  <!-- 1. Ambient Arctic Sky Aura -->
  <circle cx="50" cy="50" r="47" fill="url(#fp-bg-aura)" />

  <!-- 2. Circular Outer Medallion Frame -->
  <circle
    cx="50"
    cy="50"
    r="46"
    fill="#08101a"
    stroke="url(#fp-border-grad)"
    stroke-width="2.2"
  />

  <!-- Shimmering Aurora Borealis Curtains -->
  <path
    d="M 10 32 C 30 18, 70 16, 90 28 C 76 38, 36 40, 10 32 Z"
    fill="url(#fp-aurora-ribbon)"
  />

  <!-- 3. Glacial Ice Pillar Obstacles (Top & Bottom Flappy Spires) -->
  <g class="fp-glaciers" filter="url(#fp-shadow)">
    <!-- Top Ice Pillar Spire -->
    <path
      d="M 16 6 L 30 6 L 28 26 L 22 34 L 18 24 Z"
      fill="url(#fp-ice-pillar)"
      stroke="#ffffff"
      stroke-width="1.2"
      stroke-linejoin="round"
    />
    <!-- Top Ice Snowcap & Specular Ridge -->
    <polygon points="16,6 30,6 28,14 18,14" fill="#ffffff" opacity="0.95" />
    <line x1="22" y1="6" x2="22" y2="34" stroke="#ffffff" stroke-width="0.9" opacity="0.85" />
    <polygon points="22,14 28,14 26,24 22,26" fill="#ffffff" opacity="0.4" />

    <!-- Bottom Ice Pillar Spire -->
    <path
      d="M 74 94 L 88 94 L 86 68 L 80 58 L 76 72 Z"
      fill="url(#fp-ice-pillar)"
      stroke="#ffffff"
      stroke-width="1.2"
      stroke-linejoin="round"
    />
    <!-- Bottom Ice Snowcap -->
    <polygon points="76,72 80,58 86,68 83,76" fill="#ffffff" opacity="0.95" />
    <line x1="80" y1="58" x2="80" y2="94" stroke="#ffffff" stroke-width="0.9" opacity="0.85" />
  </g>

  <!-- 4. Aerodynamic Wing Flap Motion Wind Arcs -->
  <g class="fp-wind-trails" stroke-linecap="round" opacity="0.8">
    <path d="M 28 54 C 20 52, 16 46, 12 48" fill="none" stroke="#38bdf8" stroke-width="1.6" stroke-dasharray="3, 2" />
    <path d="M 32 64 C 24 64, 18 60, 14 62" fill="none" stroke="#7dd3fc" stroke-width="1.4" />
    <path d="M 36 72 C 30 76, 22 74, 18 78" fill="none" stroke="#bae6fd" stroke-width="1.2" stroke-dasharray="2, 2" />
  </g>

  <!-- 5. Fluttering Aviator Scarf with Gold Fringe -->
  <g class="fp-scarf" filter="url(#fp-glow)">
    <!-- Trailing Ribbon 1 -->
    <path
      d="M 44 48 C 36 46, 26 50, 20 46 C 18 45, 16 47, 18 49 C 24 54, 34 52, 42 52 Z"
      fill="url(#fp-scarf-grad)"
      stroke="#be123c"
      stroke-width="1"
    />
    <line x1="18" y1="47" x2="16" y2="48" stroke="#fbbf24" stroke-width="1.4" />
    <line x1="19" y1="48" x2="17" y2="49" stroke="#fbbf24" stroke-width="1.4" />

    <!-- Trailing Ribbon 2 -->
    <path
      d="M 40 49 C 32 52, 24 58, 16 57 C 14 56, 13 58, 15 60 C 22 64, 30 58, 38 54 Z"
      fill="url(#fp-scarf-grad)"
      stroke="#be123c"
      stroke-width="1"
    />
    <line x1="14" y1="58" x2="12" y2="59" stroke="#fbbf24" stroke-width="1.4" />
    <line x1="15" y1="59" x2="13" y2="60" stroke="#fbbf24" stroke-width="1.4" />

    <!-- Scarf Neck Wrap Knot -->
    <ellipse cx="46" cy="48" rx="4.8" ry="3.8" fill="url(#fp-scarf-grad)" stroke="#be123c" stroke-width="1.2" />
  </g>

  <!-- 6. Penguin Body Complex (In Mid-Flap Flight) -->
  <g class="fp-penguin-hero" filter="url(#fp-shadow)">
    <!-- Back Wing (Flapping Upward) -->
    <path
      d="M 46 40 C 44 26, 38 20, 36 22 C 34 24, 38 34, 42 42 Z"
      fill="url(#fp-penguin-coat)"
      stroke="#020617"
      stroke-width="1.5"
      stroke-linejoin="round"
    />

    <!-- Main Aerodynamic Body & Head -->
    <path
      d="M 36 50 C 34 36, 44 26, 56 26 C 68 26, 74 34, 73 48 C 72 62, 64 74, 49 74 C 38 74, 36 62, 36 50 Z"
      fill="url(#fp-penguin-coat)"
      stroke="#020617"
      stroke-width="1.8"
      stroke-linejoin="round"
    />

    <!-- Plump White Belly -->
    <path
      d="M 46 44 C 44 38, 52 32, 60 33 C 67 34, 70 42, 69 52 C 68 64, 61 71, 51 71 C 45 71, 44 62, 46 44 Z"
      fill="url(#fp-belly-grad)"
      stroke="#cbd5e1"
      stroke-width="0.9"
    />

    <!-- Tucked Webbed Feet (In Flight) -->
    <path d="M 44 73 C 42 76, 40 78, 43 79 C 46 80, 48 76, 47 73 Z" fill="url(#fp-orange-grad)" stroke="#b45309" stroke-width="1" />
    <path d="M 52 73 C 51 77, 50 80, 54 80 C 57 80, 57 76, 55 73 Z" fill="url(#fp-orange-grad)" stroke="#b45309" stroke-width="1" />

    <!-- Cute Chubby Cheeks Blush -->
    <ellipse cx="64" cy="46" rx="3.8" ry="2.4" fill="#f43f5e" opacity="0.7" />

    <!-- Big Expressive Determined Eye -->
    <circle cx="62" cy="38" r="4.5" fill="#ffffff" stroke="#0f172a" stroke-width="1.3" />
    <circle cx="63" cy="38" r="2.6" fill="#0f172a" />
    <circle cx="62" cy="36.5" r="1" fill="#ffffff" />
    <circle cx="64.5" cy="39" r="0.6" fill="#ffffff" />

    <!-- Bright Orange Beak (Open Cheerful Chirp) -->
    <path
      d="M 68 39 L 84 43 C 86 44, 85 46, 82 47 L 68 47 Z"
      fill="url(#fp-orange-grad)"
      stroke="#b45309"
      stroke-width="1.5"
      stroke-linejoin="round"
    />
    <line x1="68" y1="43" x2="81" y2="44" stroke="#b45309" stroke-width="1.2" />

    <!-- Front Wing (Dynamic Lift Position) -->
    <path
      d="M 44 48 C 38 42, 34 32, 36 29 C 38 27, 46 36, 52 46 C 50 51, 46 51, 44 48 Z"
      fill="url(#fp-penguin-coat)"
      stroke="#ffffff"
      stroke-width="1.5"
      stroke-linejoin="round"
    />
    <path d="M 38 34 C 41 38, 45 44, 49 48" fill="none" stroke="#38bdf8" stroke-width="1.1" opacity="0.8" />
  </g>

  <!-- 7. Floating Hexagonal Snowflakes & Frost Crystals -->
  <g class="fp-snow" filter="url(#fp-glow)">
    <!-- Snowflake 1 (Top Right) -->
    <g transform="translate(78, 22)">
      <line x1="-3.5" y1="0" x2="3.5" y2="0" stroke="#bae6fd" stroke-width="1" />
      <line x1="0" y1="-3.5" x2="0" y2="3.5" stroke="#bae6fd" stroke-width="1" />
      <line x1="-2.5" y1="-2.5" x2="2.5" y2="2.5" stroke="#bae6fd" stroke-width="0.8" />
      <line x1="2.5" y1="-2.5" x2="-2.5" y2="2.5" stroke="#bae6fd" stroke-width="0.8" />
      <circle cx="0" cy="0" r="0.9" fill="#ffffff" />
    </g>

    <!-- Snowflake 2 (Mid Left) -->
    <g transform="translate(34, 15)">
      <line x1="-2.5" y1="0" x2="2.5" y2="0" stroke="#bae6fd" stroke-width="0.9" />
      <line x1="0" y1="-2.5" x2="0" y2="2.5" stroke="#bae6fd" stroke-width="0.9" />
      <line x1="-1.8" y1="-1.8" x2="1.8" y2="1.8" stroke="#bae6fd" stroke-width="0.7" />
      <line x1="1.8" y1="-1.8" x2="-1.8" y2="1.8" stroke="#bae6fd" stroke-width="0.7" />
      <circle cx="0" cy="0" r="0.7" fill="#ffffff" />
    </g>

    <!-- Glistening Diamond Frost Glints -->
    <polygon points="68,14 70,11 72,14 70,17" fill="#38bdf8" stroke="#ffffff" stroke-width="0.7" />
    <polygon points="28,82 30,79 32,82 30,85" fill="#7dd3fc" stroke="#ffffff" stroke-width="0.7" />
  </g>
</svg>

<style>
  .flappy-penguin-logo {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
    filter: drop-shadow(0 4px 12px rgba(56, 189, 248, 0.25));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.25s ease;
  }

  :global(.tool:hover) .flappy-penguin-logo,
  .flappy-penguin-logo:hover {
    transform: translateY(-2px) scale(1.06);
    filter: drop-shadow(0 6px 20px rgba(56, 189, 248, 0.45));
  }
</style>
