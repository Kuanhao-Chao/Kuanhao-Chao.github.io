---
import GameIconFrame from './GameIconFrame.astro';
interface Props {
  size?: number;
  class?: string;
}
const { size = 64, class: className = '' } = Astro.props;
---

<GameIconFrame
  size={size}
  class={`flappy-penguin-logo ${className}`}
  label="Flappy Penguin — a penguin flying past ice"
  accent="#548aa5"
>
  <path
    d="M73 80 V39 L81 29 88 39 V80Z"
    fill="var(--gi-light)"
    stroke="var(--gi-mid)"
    stroke-width="2"></path>
  <path d="M81 29 V80 H88 V39Z" fill="var(--gi-mid)" opacity=".65"></path>
  <path d="M17 49 L29 43 M15 60 H26" stroke="var(--gi-mid)" stroke-width="3"></path>
  <path d="M34 65 L30 76 43 72 M50 69 L56 77 60 70" fill="#d99c53" stroke="#966837" stroke-width="2"
  ></path>
  <path
    d="M31 49 Q27 32 40 24 Q54 16 63 30 Q69 41 64 59 Q60 74 43 72 Q32 70 31 49Z"
    fill="#334958"
    stroke="#213440"
    stroke-width="2.5"></path>
  <ellipse cx="47" cy="51" rx="13" ry="18" fill="#f3f4e9" transform="rotate(-13 47 51)"></ellipse>
  <path d="M34 40 Q22 32 21 40 Q23 50 35 55" fill="#466476" stroke="#213440" stroke-width="2.5"
  ></path>
  <path d="M61 43 Q75 36 75 44 Q72 51 63 55" fill="#466476" stroke="#213440" stroke-width="2.5"
  ></path>
  <path d="M54 37 L67 40 55 45Z" fill="#e8ac59" stroke="#a27437" stroke-width="2"></path>
  <circle cx="53" cy="32" r="3" fill="#fafaf3"></circle>
  <circle cx="54" cy="32" r="1.5" fill="#223642"></circle>
  <path d="M41 25 Q46 22 51 24" stroke="#7796a8" stroke-width="2.5" fill="none"></path>
</GameIconFrame>
