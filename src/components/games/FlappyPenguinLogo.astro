---
interface Props {
  size?: number;
  class?: string;
}

const { size = 64, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class:list={['flappy-penguin-logo', className]}
  role="img"
  aria-label="Flappy Penguin Logo — Arctic flying penguin navigating glacial ice pillars"
>
  <defs>
    <!-- Arctic sky aura radial gradient -->
    <radialGradient id="fp-aura" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.28" />
      <stop offset="60%" stop-color="#0284c7" stop-opacity="0.10" />
      <stop offset="100%" stop-color="#0369a1" stop-opacity="0" />
    </radialGradient>

    <!-- Penguin body plumage gradient -->
    <linearGradient id="fp-body" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e293b" />
      <stop offset="60%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#020617" />
    </linearGradient>

    <!-- White belly gradient -->
    <linearGradient id="fp-belly" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="70%" stop-color="#f8fafc" />
      <stop offset="100%" stop-color="#e2e8f0" />
    </linearGradient>

    <!-- Beak and feet orange gradient -->
    <linearGradient id="fp-orange" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fbbf24" />
      <stop offset="60%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#d97706" />
    </linearGradient>

    <!-- Scarf red gradient -->
    <linearGradient id="fp-scarf" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f43f5e" />
      <stop offset="100%" stop-color="#e11d48" />
    </linearGradient>

    <!-- Glacier ice crystal gradient -->
    <linearGradient id="fp-ice" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#e0f2fe" />
      <stop offset="50%" stop-color="#7dd3fc" />
      <stop offset="100%" stop-color="#0284c7" />
    </linearGradient>

    <!-- Glacier ice cap gradient -->
    <linearGradient id="fp-ice-cap" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#bae6fd" />
    </linearGradient>

    <!-- Glow filter -->
    <filter id="fp-glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="1.5" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- 1. Ambient Arctic Bio-Aura -->
  <circle cx="50" cy="50" r="46" fill="url(#fp-aura)" />
  <circle
    cx="50"
    cy="50"
    r="44"
    fill="none"
    stroke="var(--color-rule, #e5e4df)"
    stroke-width="1.2"
    stroke-dasharray="4 3"
    opacity="0.65"
  />

  <!-- 2. Glacial Ice Pillar Obstacles (Top & Bottom Flappy Pillars) -->
  <g class="fp-glaciers">
    <!-- Top Ice Pillar Spire -->
    <path
      d="M 16 6 L 30 6 L 28 26 L 22 34 L 18 24 Z"
      fill="url(#fp-ice)"
      stroke="var(--color-surface, #ffffff)"
      stroke-width="1.2"
    />
    <!-- Top Ice Highlight Cap -->
    <polygon points="16,6 30,6 28,14 18,14" fill="url(#fp-ice-cap)" opacity="0.9" />
    <line x1="22" y1="6" x2="22" y2="34" stroke="#ffffff" stroke-width="0.8" opacity="0.75" />

    <!-- Bottom Ice Pillar Spire -->
    <path
      d="M 74 94 L 88 94 L 86 68 L 80 58 L 76 72 Z"
      fill="url(#fp-ice)"
      stroke="var(--color-surface, #ffffff)"
      stroke-width="1.2"
    />
    <!-- Bottom Ice Cap -->
    <polygon points="76,72 80,58 86,68 83,76" fill="url(#fp-ice-cap)" opacity="0.95" />
    <line x1="80" y1="58" x2="80" y2="94" stroke="#ffffff" stroke-width="0.8" opacity="0.75" />
  </g>

  <!-- 3. Aerodynamic Wing Flap Motion Wind Arcs -->
  <g class="fp-wind-trails" opacity="0.75">
    <path
      d="M 28 54 C 20 52, 16 46, 12 48"
      fill="none"
      stroke="#38bdf8"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-dasharray="3 2"
    />
    <path
      d="M 32 64 C 24 64, 18 60, 14 62"
      fill="none"
      stroke="#7dd3fc"
      stroke-width="1.2"
      stroke-linecap="round"
    />
    <path
      d="M 36 72 C 30 76, 22 74, 18 78"
      fill="none"
      stroke="#bae6fd"
      stroke-width="1"
      stroke-linecap="round"
      stroke-dasharray="2 2"
    />
  </g>

  <!-- 4. Fluttering Aviator Scarf -->
  <g class="fp-scarf">
    <!-- Trailing scarf ribbon -->
    <path
      d="M 44 48 C 36 46, 26 50, 20 46 C 18 45, 16 47, 18 49 C 24 54, 34 52, 42 52 Z"
      fill="url(#fp-scarf)"
      stroke="#be123c"
      stroke-width="1"
    />
    <path
      d="M 40 49 C 32 52, 24 58, 16 57 C 14 56, 13 58, 15 60 C 22 64, 30 58, 38 54 Z"
      fill="url(#fp-scarf)"
      stroke="#be123c"
      stroke-width="1"
    />
    <!-- Scarf neck knot wrap -->
    <ellipse cx="46" cy="48" rx="4.5" ry="3.5" fill="url(#fp-scarf)" stroke="#be123c" stroke-width="1" />
  </g>

  <!-- 5. Penguin Body Complex -->
  <g class="fp-penguin" filter="url(#fp-glow)">
    <!-- Back Wing (Flapping Upward) -->
    <path
      d="M 46 40 C 44 26, 38 20, 36 22 C 34 24, 38 34, 42 42 Z"
      fill="url(#fp-body)"
      stroke="#020617"
      stroke-width="1.4"
      stroke-linejoin="round"
    />

    <!-- Main Aerodynamic Body & Head -->
    <path
      d="M 36 50 C 34 36, 44 26, 56 26 C 68 26, 74 34, 73 48 C 72 62, 64 74, 49 74 C 38 74, 36 62, 36 50 Z"
      fill="url(#fp-body)"
      stroke="#020617"
      stroke-width="1.6"
      stroke-linejoin="round"
    />

    <!-- White Plump Belly -->
    <path
      d="M 46 44 C 44 38, 52 32, 60 33 C 67 34, 70 42, 69 52 C 68 64, 61 71, 51 71 C 45 71, 44 62, 46 44 Z"
      fill="url(#fp-belly)"
      stroke="#cbd5e1"
      stroke-width="0.8"
    />

    <!-- Tucked Webbed Feet (In Flight) -->
    <path
      d="M 44 73 C 42 76, 40 78, 43 79 C 46 80, 48 76, 47 73 Z"
      fill="url(#fp-orange)"
      stroke="#b45309"
      stroke-width="1"
    />
    <path
      d="M 52 73 C 51 77, 50 80, 54 80 C 57 80, 57 76, 55 73 Z"
      fill="url(#fp-orange)"
      stroke="#b45309"
      stroke-width="1"
    />

    <!-- Cute Chubby Cheeks Blush -->
    <ellipse cx="64" cy="46" rx="3.5" ry="2.2" fill="#f43f5e" opacity="0.65" />

    <!-- Big Expressive Eye -->
    <circle cx="62" cy="38" r="4.2" fill="#ffffff" stroke="#0f172a" stroke-width="1.2" />
    <circle cx="63" cy="38" r="2.4" fill="#0f172a" />
    <circle cx="62" cy="36.5" r="0.9" fill="#ffffff" />
    <circle cx="64.5" cy="39" r="0.5" fill="#ffffff" />

    <!-- Bright Orange Beak (Open Cheerful Chirp) -->
    <path
      d="M 68 39 L 84 43 C 86 44, 85 46, 82 47 L 68 47 Z"
      fill="url(#fp-orange)"
      stroke="#b45309"
      stroke-width="1.4"
      stroke-linejoin="round"
    />
    <line x1="68" y1="43" x2="81" y2="44" stroke="#b45309" stroke-width="1.1" />

    <!-- Front Wing (Dynamic Lift Position) -->
    <path
      d="M 44 48 C 38 42, 34 32, 36 29 C 38 27, 46 36, 52 46 C 50 51, 46 51, 44 48 Z"
      fill="url(#fp-body)"
      stroke="var(--color-surface, #ffffff)"
      stroke-width="1.4"
      stroke-linejoin="round"
    />
    <path
      d="M 38 34 C 41 38, 45 44, 49 48"
      fill="none"
      stroke="#38bdf8"
      stroke-width="1"
      opacity="0.8"
    />
  </g>

  <!-- 6. Floating Hexagonal Snowflakes & Ice Shard Sparks -->
  <g class="fp-snow">
    <!-- Snowflake 1 -->
    <g transform="translate(78, 22)">
      <line x1="-3" y1="0" x2="3" y2="0" stroke="#bae6fd" stroke-width="0.9" />
      <line x1="0" y1="-3" x2="0" y2="3" stroke="#bae6fd" stroke-width="0.9" />
      <line x1="-2" y1="-2" x2="2" y2="2" stroke="#bae6fd" stroke-width="0.7" />
      <line x1="2" y1="-2" x2="-2" y2="2" stroke="#bae6fd" stroke-width="0.7" />
      <circle cx="0" cy="0" r="0.8" fill="#ffffff" />
    </g>

    <!-- Snowflake 2 -->
    <g transform="translate(34, 15)">
      <line x1="-2.2" y1="0" x2="2.2" y2="0" stroke="#bae6fd" stroke-width="0.8" />
      <line x1="0" y1="-2.2" x2="0" y2="2.2" stroke="#bae6fd" stroke-width="0.8" />
      <line x1="-1.5" y1="-1.5" x2="1.5" y2="1.5" stroke="#bae6fd" stroke-width="0.6" />
      <line x1="1.5" y1="-1.5" x2="-1.5" y2="1.5" stroke="#bae6fd" stroke-width="0.6" />
      <circle cx="0" cy="0" r="0.6" fill="#ffffff" />
    </g>

    <!-- Ice Crystal Spark Gems -->
    <polygon points="68,14 70,11 72,14 70,17" fill="#38bdf8" stroke="#ffffff" stroke-width="0.6" />
    <polygon points="28,82 30,79 32,82 30,85" fill="#7dd3fc" stroke="#ffffff" stroke-width="0.6" />
    <circle cx="86" cy="34" r="1.1" fill="#fef08a" />
    <circle cx="22" cy="40" r="0.9" fill="#38bdf8" />
  </g>
</svg>

<style>
  .flappy-penguin-logo {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.12));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .flappy-penguin-logo:hover {
    transform: scale(1.06) translateY(-2px);
  }
</style>
