---
import GameIconFrame from './GameIconFrame.astro';
interface Props {
  size?: number;
  class?: string;
}
const { size = 72, class: className = '' } = Astro.props;
---

<GameIconFrame
  size={size}
  class={`phage-defense-logo ${className}`}
  label="Phage Defense — a tailed phage and bacterial shield"
  accent="#526faa"
>
  <rect
    x="47"
    y="63"
    width="38"
    height="19"
    rx="9.5"
    fill="#b4cab3"
    stroke="#65866b"
    stroke-width="2.5"
    transform="rotate(-12 66 72)"></rect>
  <path
    d="M23 23 L38 15 53 23 V42 L38 50 23 42Z"
    fill="var(--gi-accent)"
    stroke="var(--gi-deep)"
    stroke-width="2.5"></path>
  <path d="M23 23 L38 29 53 23 38 15Z" fill="var(--gi-light)"></path>
  <path d="M38 29 V50 L53 42 V23Z" fill="var(--gi-deep)" opacity=".45"></path>
  <path d="M23 23 L38 29 53 23 M38 29 V50" fill="none" stroke="var(--gi-deep)" stroke-width="2"
  ></path>
  <path d="M38 50 V68" stroke="var(--gi-deep)" stroke-width="7"></path>
  <path d="M35 55 H41 M35 60 H41 M35 65 H41" stroke="var(--gi-mid)" stroke-width="2"></path>
  <path
    d="M38 68 L25 73 20 83 M38 68 L49 74 52 82 M38 68 L37 81"
    fill="none"
    stroke="var(--gi-deep)"
    stroke-width="2.5"></path>
  <path
    d="M66 42 L82 48 V61 Q81 73 66 80 Q51 73 50 61 V48Z"
    fill="var(--gi-light)"
    stroke="var(--gi-deep)"
    stroke-width="3"></path>
  <path d="M66 47 L77 51 V61 Q76 68 66 74Z" fill="var(--gi-mid)"></path>
  <path d="M58 60 L64 66 74 55" fill="none" stroke="var(--gi-accent)" stroke-width="4"></path>
</GameIconFrame>
