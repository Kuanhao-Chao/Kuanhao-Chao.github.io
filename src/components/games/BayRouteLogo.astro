---
import GameIconFrame from './GameIconFrame.astro';
interface Props {
  size?: number;
  class?: string;
}
const { size = 64, class: className = '' } = Astro.props;
---

<GameIconFrame
  size={size}
  class={`bay-route-logo ${className}`}
  label="BayRoute — a highlighted path through a weighted graph"
  accent="#557fa1"
>
  <path
    d="M20 70 L28 32 53 19 79 32 79 67 51 81 20 70 47 49 28 32 M47 49 L79 32 M47 49 L79 67 M47 49 L51 81"
    fill="none"
    stroke="var(--gi-mid)"
    stroke-width="3"></path>
  <path d="M20 70 L47 49 79 32" fill="none" stroke="var(--gi-deep)" stroke-width="8"></path>
  <path d="M20 70 L47 49 79 32" fill="none" stroke="#d5ae66" stroke-width="4"></path>
  <g fill="var(--gi-light)" stroke="var(--gi-accent)" stroke-width="2.5">
    <circle cx="28" cy="32" r="5"></circle><circle cx="53" cy="19" r="5"></circle>
    <circle cx="79" cy="67" r="5"></circle><circle cx="51" cy="81" r="5"></circle>
    <circle cx="47" cy="49" r="6"></circle>
  </g>
  <circle cx="20" cy="70" r="8" fill="#7a9c79" stroke="#41674f" stroke-width="2.5"></circle>
  <circle cx="20" cy="70" r="3" fill="#f2f0da"></circle>
  <path
    d="M69 24 Q69 13 79 13 Q89 13 89 24 Q89 30 79 39 Q69 30 69 24Z"
    fill="var(--gi-accent)"
    stroke="var(--gi-deep)"
    stroke-width="2.5"></path>
  <circle cx="79" cy="23" r="4" fill="var(--gi-light)"></circle>
</GameIconFrame>
