---
interface Props {
  size?: number;
  class?: string;
}

const { size = 64, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class:list={['bay-route-logo', className]}
  role="img"
  aria-label="BayRoute Logo — San Francisco Bay Area full city road network graph with Golden Gate Bridge and illuminated search algorithms"
>
  <defs>
    <!-- Background GIS Satellite / Midnight Ocean Glow -->
    <radialGradient id="br-bg-grad" cx="50%" cy="45%" r="55%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="65%" stop-color="#090d16" />
      <stop offset="100%" stop-color="#020617" />
    </radialGradient>

    <!-- Outer Frame Gradient -->
    <linearGradient id="br-border-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="40%" stop-color="#0284c7" />
      <stop offset="80%" stop-color="#ea580c" />
      <stop offset="100%" stop-color="#fb923c" />
    </linearGradient>

    <!-- Golden Gate International Orange Gradient -->
    <linearGradient id="br-bridge-grad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#fb923c" />
      <stop offset="50%" stop-color="#ea580c" />
      <stop offset="100%" stop-color="#9a3412" />
    </linearGradient>

    <!-- Laser Highway Route Path Gradient (Red -> Gold -> Emerald -> Cyan) -->
    <linearGradient id="br-path-grad" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#f43f5e" />
      <stop offset="35%" stop-color="#fbbf24" />
      <stop offset="75%" stop-color="#10b981" />
      <stop offset="100%" stop-color="#38bdf8" />
    </linearGradient>

    <!-- Glowing Search Wavefront Pulse Gradients -->
    <radialGradient id="br-start-wave" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#f43f5e" stop-opacity="0.4" />
      <stop offset="70%" stop-color="#f43f5e" stop-opacity="0.1" />
      <stop offset="100%" stop-color="#f43f5e" stop-opacity="0" />
    </radialGradient>

    <radialGradient id="br-goal-wave" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.4" />
      <stop offset="70%" stop-color="#38bdf8" stop-opacity="0.1" />
      <stop offset="100%" stop-color="#38bdf8" stop-opacity="0" />
    </radialGradient>

    <!-- Drop Shadows & Glow Filters -->
    <filter id="br-glow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <filter id="br-laser-glow" x="-40%" y="-40%" width="180%" height="180%">
      <feDropShadow dx="0" dy="0" stdDeviation="2" flood-color="#38bdf8" flood-opacity="0.9" />
    </filter>
  </defs>

  <!-- 1. Ambient Background GIS Satellite Disc -->
  <circle
    cx="50"
    cy="50"
    r="47"
    fill="url(#br-bg-grad)"
    stroke="url(#br-border-grad)"
    stroke-width="2.2"
  />

  <!-- Radar Bearing Ring with Degree Tick Marks -->
  <circle
    cx="50"
    cy="50"
    r="44"
    fill="none"
    stroke="#334155"
    stroke-width="0.8"
    stroke-dasharray="3, 3"
    opacity="0.6"
  />

  <!-- 2. San Francisco Bay Water Polygon & Shoreline -->
  <path
    d="M 38 16 Q 48 28 45 42 Q 55 48 65 62 Q 72 75 60 86 Q 48 78 42 65 Q 38 52 32 38 Q 30 24 38 16 Z"
    fill="#0284c7"
    fill-opacity="0.32"
    stroke="#0369a1"
    stroke-width="0.8"
    opacity="0.8"
  />

  <!-- 3. City Road Network Graph Edges (Background Mesh) -->
  <g stroke="#475569" stroke-width="1" opacity="0.45">
    <line x1="28" y1="68" x2="35" y2="48" />
    <line x1="35" y1="48" x2="32" y2="30" />
    <line x1="32" y1="30" x2="48" y2="22" />
    <line x1="48" y1="22" x2="72" y2="32" />
    <line x1="72" y1="32" x2="76" y2="52" />
    <line x1="76" y1="52" x2="68" y2="74" />
    <line x1="68" y1="74" x2="52" y2="82" />
    <line x1="52" y1="82" x2="28" y2="68" />
    <!-- Bay Bridge & San Mateo Crossings -->
    <line x1="35" y1="48" x2="72" y2="32" stroke-dasharray="2, 2" />
    <line x1="42" y1="62" x2="68" y2="55" stroke-dasharray="2, 2" />
  </g>

  <!-- 4. Golden Gate Suspension Tower Silhouette -->
  <g fill="url(#br-bridge-grad)" filter="url(#br-glow)">
    <!-- Left Tower Leg -->
    <rect x="29" y="16" width="2.4" height="28" rx="0.5" />
    <!-- Right Tower Leg -->
    <rect x="35" y="16" width="2.4" height="28" rx="0.5" />
    <!-- Struts & Cross Beams -->
    <rect x="29" y="21" width="8.4" height="1.6" />
    <rect x="29" y="28" width="8.4" height="1.6" />
    <rect x="29" y="37" width="8.4" height="2.2" />
    <!-- Main Suspension Cable Sweep -->
    <path
      d="M 20 28 Q 32 40 44 42"
      fill="none"
      stroke="#ea580c"
      stroke-width="1.3"
      opacity="0.95"
    />
  </g>

  <!-- 5. Search Wavefront Frontier Waves (Bidirectional Search) -->
  <!-- Start Wavefront (Red) -->
  <circle cx="28" cy="68" r="15" fill="url(#br-start-wave)" />
  <circle cx="28" cy="68" r="24" fill="none" stroke="#f43f5e" stroke-width="0.8" stroke-dasharray="2, 4" opacity="0.4" />

  <!-- Goal Wavefront (Cyan) -->
  <circle cx="72" cy="32" r="15" fill="url(#br-goal-wave)" />
  <circle cx="72" cy="32" r="24" fill="none" stroke="#38bdf8" stroke-width="0.8" stroke-dasharray="2, 4" opacity="0.4" />

  <!-- 6. Active Explored Best Path Laser Highway (Start -> Goal) -->
  <path
    d="M 28 68 L 35 48 L 52 38 L 72 32"
    fill="none"
    stroke="url(#br-path-grad)"
    stroke-width="3.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    filter="url(#br-laser-glow)"
  />

  <!-- Inner Highway White Core Line -->
  <path
    d="M 28 68 L 35 48 L 52 38 L 72 32"
    fill="none"
    stroke="#ffffff"
    stroke-width="1.1"
    stroke-linecap="round"
    stroke-linejoin="round"
  />

  <!-- 7. Graph Intersections & Search Beacons -->
  <!-- Explored Intersections -->
  <circle cx="35" cy="48" r="2.8" fill="#fbbf24" stroke="#ffffff" stroke-width="0.6" filter="url(#br-glow)" />
  <circle cx="52" cy="38" r="2.8" fill="#10b981" stroke="#ffffff" stroke-width="0.6" filter="url(#br-glow)" />
  <circle cx="42" cy="62" r="2" fill="#64748b" />
  <circle cx="68" cy="55" r="2" fill="#64748b" />
  <circle cx="76" cy="52" r="2" fill="#64748b" />

  <!-- Start Pin Beacon (🚩 Scarlet) -->
  <g transform="translate(28, 68)" filter="url(#br-glow)">
    <circle cx="0" cy="0" r="5.2" fill="#f43f5e" stroke="#ffffff" stroke-width="1" />
    <circle cx="0" cy="0" r="2" fill="#ffffff" />
  </g>

  <!-- Destination Beacon (🏁 Emerald Target) -->
  <g transform="translate(72, 32)" filter="url(#br-glow)">
    <circle cx="0" cy="0" r="8" fill="none" stroke="#34d399" stroke-width="1.2" opacity="0.65">
      <animate attributeName="r" values="4;9;4" dur="2s" repeatCount="indefinite" />
      <animate attributeName="opacity" values="0.8;0.2;0.8" dur="2s" repeatCount="indefinite" />
    </circle>
    <circle cx="0" cy="0" r="5.5" fill="#10b981" stroke="#ffffff" stroke-width="1" />
    <circle cx="0" cy="0" r="2.2" fill="#ffffff" />
  </g>
</svg>

<style>
  .bay-route-logo {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
    filter: drop-shadow(0 4px 12px rgba(56, 189, 248, 0.25));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.25s ease;
  }

  :global(.tool:hover) .bay-route-logo,
  .bay-route-logo:hover {
    transform: translateY(-2px) scale(1.06);
    filter: drop-shadow(0 6px 20px rgba(56, 189, 248, 0.45));
  }
</style>
