---
import GameIconFrame from './GameIconFrame.astro';
interface Props {
  size?: number;
  class?: string;
}
const { size = 64, class: className = '' } = Astro.props;
---

<GameIconFrame
  size={size}
  class={`minesweeper-logo ${className}`}
  label="Minesweeper — clue tiles and a flagged covered cell"
  accent="#648290"
>
  <rect x="18" y="19" width="65" height="64" rx="9" fill="var(--gi-deep)"></rect>
  <rect
    x="18"
    y="16"
    width="65"
    height="64"
    rx="9"
    fill="var(--gi-light)"
    stroke="var(--gi-deep)"
    stroke-width="2.5"></rect>
  <path d="M49 16 V80 M18 48 H83" stroke="var(--gi-mid)" stroke-width="2.5"></path>
  <rect x="51" y="50" width="30" height="28" rx="4" fill="var(--gi-accent)"></rect>
  <path d="M55 72 V55 H76" fill="none" stroke="var(--gi-mid)" stroke-width="2.5"></path>
  <text
    x="33"
    y="40"
    text-anchor="middle"
    fill="#416c9b"
    font-size="23"
    font-family="system-ui, sans-serif"
    font-weight="700">1</text
  >
  <text
    x="33"
    y="72"
    text-anchor="middle"
    fill="#4e7a59"
    font-size="23"
    font-family="system-ui, sans-serif"
    font-weight="700">2</text
  >
  <path d="M63 43 V25 L77 30 63 35" fill="#bf6e5c" stroke="#985242" stroke-width="2"></path>
  <path d="M59 43 H69" stroke="var(--gi-deep)" stroke-width="2.5"></path>
</GameIconFrame>
