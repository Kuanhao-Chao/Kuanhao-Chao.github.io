---
interface Props {
  size?: number;
  class?: string;
}

const { size = 64, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class:list={['dino-run-logo', className]}
  role="img"
  aria-label="Dino Run Logo — Cybernetic velociraptor leaping over genomic nucleotide splice obstacles along a double-helix track"
>
  <defs>
    <!-- Background Track Aura -->
    <radialGradient id="dr-bg-aura" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#10b981" stop-opacity="0.32" />
      <stop offset="60%" stop-color="#064e3b" stop-opacity="0.15" />
      <stop offset="100%" stop-color="#020617" stop-opacity="0" />
    </radialGradient>

    <!-- Outer Frame Gradient -->
    <linearGradient id="dr-border-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#34d399" />
      <stop offset="50%" stop-color="#10b981" />
      <stop offset="100%" stop-color="#059669" />
    </linearGradient>

    <!-- Velociraptor Armor Body Gradient -->
    <linearGradient id="dr-raptor-body" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#6ee7b7" />
      <stop offset="30%" stop-color="#10b981" />
      <stop offset="70%" stop-color="#047857" />
      <stop offset="100%" stop-color="#022c22" />
    </linearGradient>

    <!-- Cybernetic Gold Dorsal Armor & Visor -->
    <linearGradient id="dr-gold-plates" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="40%" stop-color="#fbbf24" />
      <stop offset="100%" stop-color="#b45309" />
    </linearGradient>

    <!-- Genomic Track Double-Helix Rails -->
    <linearGradient id="dr-rail-grad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="50%" stop-color="#818cf8" />
      <stop offset="100%" stop-color="#c084fc" />
    </linearGradient>

    <!-- Obstacle Splice Arch Gradient -->
    <linearGradient id="dr-cactus-grad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#f43f5e" />
      <stop offset="50%" stop-color="#e11d48" />
      <stop offset="100%" stop-color="#881337" />
    </linearGradient>

    <!-- Glow & Shadow Filters -->
    <filter id="dr-glow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <filter id="dr-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="1.5" dy="2.5" stdDeviation="2" flood-color="#000000" flood-opacity="0.45" />
    </filter>
  </defs>

  <!-- 1. Ambient Background Aura -->
  <circle cx="50" cy="50" r="47" fill="url(#dr-bg-aura)" />

  <!-- 2. Circular Outer Medallion Frame -->
  <circle
    cx="50"
    cy="50"
    r="46"
    fill="#0a141c"
    stroke="url(#dr-border-grad)"
    stroke-width="2.2"
  />

  <!-- Subtle Horizon & Speed Grid -->
  <g stroke="#13262b" stroke-width="0.75" opacity="0.65">
    <line x1="12" y1="78" x2="88" y2="78" />
    <line x1="12" y1="86" x2="88" y2="86" />
    <line x1="24" y1="12" x2="16" y2="88" stroke-dasharray="2, 4" />
    <line x1="48" y1="12" x2="40" y2="88" stroke-dasharray="2, 4" />
    <line x1="72" y1="12" x2="64" y2="88" stroke-dasharray="2, 4" />
  </g>

  <!-- 3. Genomic Double-Helix Railway Track -->
  <g class="dr-track" filter="url(#dr-glow)">
    <!-- Upper Main Rail Strand -->
    <line x1="10" y1="78" x2="90" y2="78" stroke="url(#dr-rail-grad)" stroke-width="2.8" stroke-linecap="round" />
    <!-- Lower Secondary Rail Strand -->
    <line x1="10" y1="85" x2="90" y2="85" stroke="#0284c7" stroke-width="1.6" opacity="0.7" />

    <!-- Watson-Crick Base-Pair Track Ties -->
    <line x1="16" y1="78" x2="16" y2="85" stroke="#38bdf8" stroke-width="1.4" />
    <line x1="28" y1="78" x2="28" y2="85" stroke="#818cf8" stroke-width="1.4" />
    <line x1="40" y1="78" x2="40" y2="85" stroke="#38bdf8" stroke-width="1.4" />
    <line x1="52" y1="78" x2="52" y2="85" stroke="#818cf8" stroke-width="1.4" />
    <line x1="64" y1="78" x2="64" y2="85" stroke="#38bdf8" stroke-width="1.4" />
    <line x1="76" y1="78" x2="76" y2="85" stroke="#818cf8" stroke-width="1.4" />
    <line x1="88" y1="78" x2="88" y2="85" stroke="#38bdf8" stroke-width="1.4" />
  </g>

  <!-- 4. Splice-Site Intron Hurdle (Cactus Obstacle) -->
  <g class="dr-obstacle" transform="translate(68, 54)" filter="url(#dr-glow)">
    <!-- Triple-pronged nucleotide splice fork -->
    <!-- Main Center Trunk -->
    <rect x="7" y="2" width="6" height="22" rx="2" fill="url(#dr-cactus-grad)" stroke="#ffffff" stroke-width="0.8" />
    <!-- Left Arm -->
    <path d="M 0 10 L 7 10 L 7 15 L 2 15 C 1 15 0 14 0 13 Z" fill="url(#dr-cactus-grad)" stroke="#ffffff" stroke-width="0.8" />
    <rect x="0" y="6" width="4" height="8" rx="1.5" fill="url(#dr-cactus-grad)" stroke="#ffffff" stroke-width="0.8" />
    <!-- Right Arm -->
    <path d="M 13 14 L 20 14 L 20 9 C 20 8 19 7 18 7 L 16 7 L 16 11 L 13 11 Z" fill="url(#dr-cactus-grad)" stroke="#ffffff" stroke-width="0.8" />
    <rect x="16" y="5" width="4" height="9" rx="1.5" fill="url(#dr-cactus-grad)" stroke="#ffffff" stroke-width="0.8" />

    <!-- Splice Site Badges (GT Donor / AG Acceptor) -->
    <text x="10" y="16" font-family="monospace" font-size="4.2" font-weight="900" fill="#ffffff" text-anchor="middle">GT</text>

    <!-- Electric Intron Arc between prongs -->
    <path d="M 2 6 L 10 2 L 18 5" fill="none" stroke="#fef08a" stroke-width="1.1" stroke-linecap="round" />
    <circle cx="10" cy="2" r="1.2" fill="#ffffff" />
  </g>

  <!-- 5. Muscular Cybernetic Velociraptor in Mid-Stride Leap -->
  <g class="dr-raptor" transform="translate(6, -2)" filter="url(#dr-shadow)">
    <!-- Speed Velocity Wind Arcs -->
    <path d="M 14 48 C 8 50, 6 55, 12 57" fill="none" stroke="#38bdf8" stroke-width="1.6" stroke-linecap="round" opacity="0.8" />
    <path d="M 10 58 C 4 60, 3 64, 8 66" fill="none" stroke="#38bdf8" stroke-width="1.4" stroke-linecap="round" opacity="0.65" />
    <path d="M 18 64 C 12 66, 10 70, 16 71" fill="none" stroke="#38bdf8" stroke-width="1.2" stroke-linecap="round" opacity="0.5" />

    <!-- Kicked-up Nucleotide Dust Particles -->
    <circle cx="20" cy="74" r="1.5" fill="#10b981" opacity="0.7" />
    <circle cx="16" cy="76" r="1.2" fill="#38bdf8" opacity="0.7" />
    <circle cx="24" cy="77" r="1.8" fill="#fbbf24" opacity="0.7" />

    <!-- Long Counter-Balancing Tail with Aerodynamic Feathers -->
    <path
      d="M 18 58 C 24 56, 30 50, 42 48"
      fill="none"
      stroke="url(#dr-raptor-body)"
      stroke-width="5.5"
      stroke-linecap="round"
    />
    <!-- Golden Dorsal Plates along tail and spine -->
    <polygon points="32,43 35,37 38,44" fill="url(#dr-gold-plates)" stroke="#022c22" stroke-width="0.6" />
    <polygon points="40,40 43,34 46,41" fill="url(#dr-gold-plates)" stroke="#022c22" stroke-width="0.6" />
    <polygon points="48,39 51,33 54,40" fill="url(#dr-gold-plates)" stroke="#022c22" stroke-width="0.6" />

    <!-- Athletic Raptor Torso -->
    <ellipse cx="45" cy="46" rx="15" ry="11" fill="url(#dr-raptor-body)" stroke="#ffffff" stroke-width="1.4" />
    <!-- Chest Muscle Highlight Arc -->
    <path d="M 40 40 C 46 38, 52 42, 54 48" fill="none" stroke="#ffffff" stroke-width="1.2" stroke-linecap="round" opacity="0.6" />

    <!-- Muscular Neck and Sleek Head -->
    <path
      d="M 52 42 C 55 35, 59 29, 65 27 C 73 25, 78 30, 77 36 C 76 41, 68 43, 60 45 Z"
      fill="url(#dr-raptor-body)"
      stroke="#ffffff"
      stroke-width="1.4"
      stroke-linejoin="round"
    />

    <!-- Cyber Visor Eye (Gold with Cyan Focus Beam) -->
    <polygon points="65,29 74,30 71,34 64,33" fill="url(#dr-gold-plates)" stroke="#ffffff" stroke-width="0.6" />
    <circle cx="69" cy="32" r="1.4" fill="#38bdf8" />
    <circle cx="68.5" cy="31.5" r="0.6" fill="#ffffff" />

    <!-- Snout & Sharp Jaws -->
    <path d="M 68 35 L 77 36 L 70 38" fill="none" stroke="#ffffff" stroke-width="1.2" stroke-linejoin="round" />

    <!-- Forearm / Feathered Wing Claws -->
    <g class="dr-arm">
      <path d="M 54 46 L 61 48 L 59 54" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" />
      <line x1="59" y1="54" x2="63" y2="52" stroke="#fbbf24" stroke-width="1.3" stroke-linecap="round" />
      <line x1="59" y1="54" x2="62" y2="56" stroke="#fbbf24" stroke-width="1.3" stroke-linecap="round" />
    </g>

    <!-- Hind Leg 1 (Trailing back in powerful extension) -->
    <path
      d="M 37 50 L 30 60 L 22 66"
      fill="none"
      stroke="url(#dr-raptor-body)"
      stroke-width="3.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <!-- Sickle Claw on back foot -->
    <path d="M 22 66 L 16 67 M 22 66 L 18 71" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round" />

    <!-- Hind Leg 2 (Forward leading knee bent for leap) -->
    <path
      d="M 47 52 L 53 62 L 60 71"
      fill="none"
      stroke="url(#dr-raptor-body)"
      stroke-width="4"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <!-- Forward Claws poised over obstacle -->
    <path d="M 60 71 L 65 70 M 60 71 L 63 74" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" />
  </g>

  <!-- 6. Floating Genomic Bonus Diamonds (A, C, G) -->
  <g class="dr-bonuses" filter="url(#dr-glow)">
    <!-- Diamond A (Emerald) -->
    <polygon points="26,22 29,18 32,22 29,26" fill="#10b981" stroke="#ffffff" stroke-width="0.8" />
    <text x="29" y="23.4" font-family="monospace" font-size="4.5" font-weight="900" fill="#ffffff" text-anchor="middle">A</text>

    <!-- Diamond C (Cyan) -->
    <polygon points="45,16 48,12 51,16 48,20" fill="#38bdf8" stroke="#ffffff" stroke-width="0.8" />
    <text x="48" y="17.4" font-family="monospace" font-size="4.5" font-weight="900" fill="#ffffff" text-anchor="middle">C</text>

    <!-- Diamond G (Amber) -->
    <polygon points="80,22 83,18 86,22 83,26" fill="#f59e0b" stroke="#ffffff" stroke-width="0.8" />
    <text x="83" y="23.4" font-family="monospace" font-size="4.5" font-weight="900" fill="#ffffff" text-anchor="middle">G</text>
  </g>
</svg>

<style>
  .dino-run-logo {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
    filter: drop-shadow(0 4px 12px rgba(16, 185, 129, 0.25));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.25s ease;
  }

  :global(.tool:hover) .dino-run-logo,
  .dino-run-logo:hover {
    transform: translateY(-2px) scale(1.06);
    filter: drop-shadow(0 6px 20px rgba(52, 211, 153, 0.45));
  }
</style>
