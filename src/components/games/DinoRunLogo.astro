---
import GameIconFrame from './GameIconFrame.astro';
interface Props {
  size?: number;
  class?: string;
}
const { size = 64, class: className = '' } = Astro.props;
---

<GameIconFrame
  size={size}
  class={`dino-run-logo ${className}`}
  label="Dino Run — a feathered theropod leaping an obstacle"
  accent="#427b62"
>
  <path d="M74 82 V67 H81 V82 M70 75 H86" fill="none" stroke="var(--gi-mid)" stroke-width="4"
  ></path>
  <path
    d="M17 56 L27 51 20 47 34 45 Q40 32 54 37 L61 22 Q68 17 77 24 L78 35 66 37 61 53 Q53 63 37 60Z"
    fill="var(--gi-accent)"
    stroke="var(--gi-deep)"
    stroke-width="2.5"></path>
  <path d="M34 45 L29 39 39 41 35 34 46 38 45 30 55 37" fill="var(--gi-mid)"></path>
  <path d="M41 49 Q46 43 54 47 L56 55 Q47 60 39 55Z" fill="var(--gi-light)" opacity=".8"></path>
  <path d="M56 43 L65 48 71 45" fill="none" stroke="var(--gi-deep)" stroke-width="3"></path>
  <path
    d="M46 59 L44 68 34 74 H42 M55 57 L60 64 56 74 H65"
    fill="none"
    stroke="var(--gi-deep)"
    stroke-width="4"></path>
  <path d="M65 23 L69 20 M61 25 L63 19" stroke="var(--gi-mid)" stroke-width="2.5"></path>
  <circle cx="71" cy="28" r="2.2" fill="#f6e4b5"></circle>
  <circle cx="71.5" cy="28" r="1" fill="#223c30"></circle>
  <path d="M69 34 H77" stroke="var(--gi-deep)" stroke-width="2"></path>
  <path d="M17 69 H26 M21 77 H28" stroke="var(--gi-mid)" stroke-width="3"></path>
</GameIconFrame>
