---
interface Props {
  size?: number;
  class?: string;
}

const { size = 64, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class:list={['dino-run-logo', className]}
  role="img"
  aria-label="Dino Run Logo — Cybernetic velociraptor leaping along a genomic double-helix track"
>
  <defs>
    <!-- Background Aura -->
    <radialGradient id="dr-aura" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="var(--color-accent, #2e6e5e)" stop-opacity="0.25" />
      <stop offset="100%" stop-color="var(--color-accent, #2e6e5e)" stop-opacity="0" />
    </radialGradient>

    <!-- Dino Body Gradient -->
    <linearGradient id="dr-dino-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#10b981" />
      <stop offset="50%" stop-color="#059669" />
      <stop offset="100%" stop-color="#047857" />
    </linearGradient>

    <!-- Track Double Helix Gradient -->
    <linearGradient id="dr-track-grad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="50%" stop-color="#818cf8" />
      <stop offset="100%" stop-color="#38bdf8" />
    </linearGradient>

    <!-- Glow Filter -->
    <filter id="dr-glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- 1. Ambient Aura Backdrop -->
  <circle cx="50" cy="50" r="46" fill="url(#dr-aura)" />
  <circle
    cx="50"
    cy="50"
    r="44"
    fill="none"
    stroke="var(--color-rule, #e5e4df)"
    stroke-width="1.2"
    stroke-dasharray="4 3"
    opacity="0.6"
  />

  <!-- 2. Genomic Double-Helix Running Track -->
  <g class="dr-track" filter="url(#dr-glow)">
    <!-- Base Rail -->
    <line x1="12" y1="78" x2="88" y2="78" stroke="url(#dr-track-grad)" stroke-width="2.6" stroke-linecap="round" />
    <!-- Secondary Rail -->
    <line x1="12" y1="84" x2="88" y2="84" stroke="var(--color-accent, #2e6e5e)" stroke-width="1.6" opacity="0.75" />

    <!-- Base-pair rungs along track -->
    <line x1="20" y1="78" x2="20" y2="84" stroke="#38bdf8" stroke-width="1.2" />
    <line x1="32" y1="78" x2="32" y2="84" stroke="#818cf8" stroke-width="1.2" />
    <line x1="44" y1="78" x2="44" y2="84" stroke="#38bdf8" stroke-width="1.2" />
    <line x1="56" y1="78" x2="56" y2="84" stroke="#818cf8" stroke-width="1.2" />
    <line x1="68" y1="78" x2="68" y2="84" stroke="#38bdf8" stroke-width="1.2" />
    <line x1="80" y1="78" x2="80" y2="84" stroke="#818cf8" stroke-width="1.2" />
  </g>

  <!-- 3. Splice Site Junction Arch & Variant Hurdles -->
  <g class="dr-obstacles">
    <!-- Splice Arch (GT-AG Intron Arch) -->
    <path
      d="M 66 78 L 66 58 C 66 54, 76 54, 76 58 L 76 78"
      fill="none"
      stroke="#f59e0b"
      stroke-width="2"
      stroke-linecap="round"
    />
    <rect x="64" y="75" width="4" height="3" fill="#f59e0b" />
    <rect x="74" y="75" width="4" height="3" fill="#f59e0b" />
  </g>

  <!-- 4. Velociraptor Genomic Runner in Mid-Stride Leap -->
  <g class="dr-runner" transform="translate(4, -4)">
    <!-- Speed Velocity Arcs -->
    <path d="M 16 46 C 10 48, 8 52, 14 54" fill="none" stroke="#38bdf8" stroke-width="1.4" opacity="0.6" />
    <path d="M 12 56 C 6 58, 4 62, 10 64" fill="none" stroke="#38bdf8" stroke-width="1.2" opacity="0.5" />

    <!-- Trailing Tail -->
    <path
      d="M 22 56 C 28 54, 34 50, 42 48"
      fill="none"
      stroke="url(#dr-dino-grad)"
      stroke-width="5.5"
      stroke-linecap="round"
    />

    <!-- Main Torso Body -->
    <ellipse cx="44" cy="46" rx="14" ry="11" fill="url(#dr-dino-grad)" stroke="var(--color-surface, #ffffff)" stroke-width="1.4" />

    <!-- Neck and Head -->
    <path
      d="M 52 42 C 55 35, 58 30, 64 28 C 72 26, 76 30, 75 36 C 74 40, 66 42, 58 44 Z"
      fill="url(#dr-dino-grad)"
      stroke="var(--color-surface, #ffffff)"
      stroke-width="1.4"
    />

    <!-- Snout / Jaws -->
    <path d="M 68 34 L 75 35 L 68 37" fill="none" stroke="var(--color-surface, #ffffff)" stroke-width="1" />

    <!-- Eye (Alert arcade look) -->
    <circle cx="67" cy="31" r="2.2" fill="#ffffff" />
    <circle cx="68" cy="31" r="1.1" fill="#047857" />

    <!-- Forward Arm -->
    <path d="M 54 46 L 59 48 L 57 52" fill="none" stroke="var(--color-surface, #ffffff)" stroke-width="1.6" stroke-linecap="round" />

    <!-- Back Leg (Extended leaping back) -->
    <path
      d="M 36 50 L 30 60 L 22 66"
      fill="none"
      stroke="url(#dr-dino-grad)"
      stroke-width="3.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <!-- Back Foot Claws -->
    <path d="M 22 66 L 18 67 M 22 66 L 19 69" stroke="var(--color-surface, #ffffff)" stroke-width="1.2" stroke-linecap="round" />

    <!-- Front Leg (Bent leaping forward) -->
    <path
      d="M 46 52 L 52 62 L 58 72"
      fill="none"
      stroke="url(#dr-dino-grad)"
      stroke-width="3.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <!-- Front Foot Claws -->
    <path d="M 58 72 L 62 72 M 58 72 L 61 75" stroke="var(--color-surface, #ffffff)" stroke-width="1.2" stroke-linecap="round" />
  </g>

  <!-- 5. Floating Nucleotide Spurt Gems ($A, C, G, T$) -->
  <g class="dr-gems">
    <polygon points="26,22 29,19 32,22 29,25" fill="#10b981" stroke="#ffffff" stroke-width="0.7" />
    <text x="29" y="23.2" font-family="monospace" font-size="4" font-weight="bold" fill="#ffffff" text-anchor="middle">A</text>

    <polygon points="46,18 49,15 52,18 49,21" fill="#38bdf8" stroke="#ffffff" stroke-width="0.7" />
    <text x="49" y="19.2" font-family="monospace" font-size="4" font-weight="bold" fill="#ffffff" text-anchor="middle">C</text>

    <polygon points="80,24 83,21 86,24 83,27" fill="#f59e0b" stroke="#ffffff" stroke-width="0.7" />
    <text x="83" y="25.2" font-family="monospace" font-size="4" font-weight="bold" fill="#ffffff" text-anchor="middle">G</text>
  </g>
</svg>

<style>
  .dino-run-logo {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.12));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .dino-run-logo:hover {
    transform: scale(1.06) translateY(-2px);
  }
</style>
