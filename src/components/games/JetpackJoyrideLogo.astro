---
import GameIconFrame from './GameIconFrame.astro';
interface Props {
  size?: number;
  class?: string;
}
const { size = 64, class: className = '' } = Astro.props;
---

<GameIconFrame
  size={size}
  class={`jetpack-joyride-logo ${className}`}
  label="Jetpack Joyride — an original pixel-art flyer with a bright exhaust trail"
  accent="#8c9a74"
>
  <g shape-rendering="crispEdges">
    <path d="M30 58H40V78H30ZM32 78H38V86H32Z" fill="#dfa84e"></path>
    <path d="M34 60H38V76H34Z" fill="#f7e8b4"></path>
    <path d="M26 36H40V62H26Z" fill="var(--gi-deep)"></path>
    <path d="M30 40H36V56H30Z" fill="#9fc0cf"></path>
    <path d="M44 18H66V24H72V40H66V46H44V40H38V24H44Z" fill="var(--gi-deep)"></path>
    <path d="M44 24H66V38H44Z" fill="var(--gi-accent)"></path>
    <path d="M52 26H68V34H52Z" fill="#b9d9df"></path>
    <path d="M56 28H64V30H56Z" fill="#f9fcf3"></path>
    <path d="M40 44H64V62H40Z" fill="var(--gi-deep)"></path>
    <path d="M44 46H60V58H44Z" fill="var(--gi-mid)"></path>
    <path d="M42 62H50V72H58V78H42ZM58 62H66V68H74V76H62V70H58Z" fill="var(--gi-deep)"></path>
    <path d="M76 22H82V28H76ZM78 36H86V40H78Z" fill="var(--gi-accent)"></path>
  </g>
</GameIconFrame>
