---
interface Props {
  size?: number;
  class?: string;
}

const { size = 64, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class:list={['jetpack-joyride-logo', className]}
  role="img"
  aria-label="Jetpack Joyride Logo — High-speed enzyme aviator propelled by twin ATP-synthase rocket thrusters dodging high-voltage mutagen zappers"
>
  <defs>
    <!-- Background High-Velocity Aura -->
    <radialGradient id="jj-bg-aura" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.32" />
      <stop offset="60%" stop-color="#0369a1" stop-opacity="0.15" />
      <stop offset="100%" stop-color="#020617" stop-opacity="0" />
    </radialGradient>

    <!-- Outer Frame Gradient -->
    <linearGradient id="jj-border-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="50%" stop-color="#818cf8" />
      <stop offset="100%" stop-color="#f59e0b" />
    </linearGradient>

    <!-- Aviator Enzyme Body Gradient -->
    <linearGradient id="jj-hero-body" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#6ee7b7" />
      <stop offset="35%" stop-color="#10b981" />
      <stop offset="75%" stop-color="#047857" />
      <stop offset="100%" stop-color="#022c22" />
    </linearGradient>

    <!-- Flight Helmet & Iridescent Visor -->
    <linearGradient id="jj-visor-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#e0f2fe" />
      <stop offset="40%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#0284c7" />
    </linearGradient>

    <!-- ATP-Synthase Rocket Thruster Titanium Metal -->
    <linearGradient id="jj-thruster-metal" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#cbd5e1" />
      <stop offset="35%" stop-color="#94a3b8" />
      <stop offset="70%" stop-color="#475569" />
      <stop offset="100%" stop-color="#1e293b" />
    </linearGradient>

    <!-- Roaring Multi-Stage Plasma Exhaust Flame -->
    <linearGradient id="jj-plasma-flame" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="25%" stop-color="#fef08a" />
      <stop offset="60%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#ef4444" stop-opacity="0" />
    </linearGradient>

    <!-- Mutagen High-Voltage Electrical Zap -->
    <linearGradient id="jj-zap-lightning" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="25%" stop-color="#f472b6" />
      <stop offset="65%" stop-color="#ef4444" />
      <stop offset="100%" stop-color="#b91c1c" />
    </linearGradient>

    <!-- 3D Golden ATP Coin Gradient -->
    <radialGradient id="jj-atp-coin" cx="35%" cy="30%" r="70%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="30%" stop-color="#fef08a" />
      <stop offset="70%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#b45309" />
    </radialGradient>

    <!-- Glow & Shadow Filters -->
    <filter id="jj-glow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <filter id="jj-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="1.5" dy="2.5" stdDeviation="2" flood-color="#000000" flood-opacity="0.45" />
    </filter>
  </defs>

  <!-- 1. Ambient Background Aura -->
  <circle cx="50" cy="50" r="47" fill="url(#jj-bg-aura)" />

  <!-- 2. Circular Outer Medallion Frame -->
  <circle
    cx="50"
    cy="50"
    r="46"
    fill="#08101a"
    stroke="url(#jj-border-grad)"
    stroke-width="2.2"
  />

  <!-- High-Velocity Speed Lines in Background -->
  <g stroke="#172b38" stroke-width="0.8" opacity="0.65">
    <line x1="8" y1="28" x2="42" y2="28" stroke-dasharray="6, 4" />
    <line x1="12" y1="46" x2="36" y2="46" stroke-dasharray="8, 5" />
    <line x1="6" y1="74" x2="52" y2="74" stroke-dasharray="5, 4" />
  </g>

  <!-- 3. Crackling Mutagen Electrical Zapper Hazard -->
  <g class="jj-zapper" transform="translate(68, 14)" filter="url(#jj-glow)">
    <!-- Top & Bottom Metallic Electrode Insulators -->
    <circle cx="10" cy="2" r="4.8" fill="#334155" stroke="#ffffff" stroke-width="1" />
    <circle cx="10" cy="2" r="2.2" fill="#ef4444" />
    <circle cx="10" cy="38" r="4.8" fill="#334155" stroke="#ffffff" stroke-width="1" />
    <circle cx="10" cy="38" r="2.2" fill="#ef4444" />

    <!-- High-Voltage Jagged Plasma Lightning Arc -->
    <path
      d="M 10 4 L 4 12 L 16 20 L 5 28 L 13 33 L 10 38"
      fill="none"
      stroke="url(#jj-zap-lightning)"
      stroke-width="2.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <!-- Super-Hot Core Lightning Line -->
    <path
      d="M 10 4 L 4 12 L 16 20 L 5 28 L 13 33 L 10 38"
      fill="none"
      stroke="#ffffff"
      stroke-width="1.1"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <!-- Arc Sparks -->
    <circle cx="3" cy="18" r="1.1" fill="#fef08a" />
    <circle cx="17" cy="25" r="1.2" fill="#f43f5e" />
  </g>

  <!-- 4. Collectible 3D Golden ATP Energy Coins -->
  <g class="jj-coins" filter="url(#jj-shadow)">
    <!-- Top Coin -->
    <g transform="translate(24, 20)">
      <circle cx="0" cy="0" r="7" fill="url(#jj-atp-coin)" stroke="#ffffff" stroke-width="1" />
      <circle cx="0" cy="0" r="5.2" fill="none" stroke="#fef08a" stroke-width="0.8" />
      <text x="0" y="2.5" font-family="monospace" font-size="5" font-weight="900" fill="#ffffff" text-anchor="middle">ATP</text>
    </g>
    <!-- Mid Coin -->
    <g transform="translate(42, 14)">
      <circle cx="0" cy="0" r="6.5" fill="url(#jj-atp-coin)" stroke="#ffffff" stroke-width="1" />
      <circle cx="0" cy="0" r="4.8" fill="none" stroke="#fef08a" stroke-width="0.8" />
      <text x="0" y="2.4" font-family="monospace" font-size="4.8" font-weight="900" fill="#ffffff" text-anchor="middle">ATP</text>
    </g>
  </g>

  <!-- 5. High-Speed Enzyme Aviator with Dual ATP-Synthase Rocket Thrusters -->
  <g class="jj-hero-aviator" transform="translate(18, 32)" filter="url(#jj-shadow)">
    <!-- Multi-Stage Plasma Thruster Exhaust Flames -->
    <g class="jj-thruster-flames" filter="url(#jj-glow)">
      <!-- Left Thruster Flame -->
      <polygon points="10,32 17,32 13.5,55" fill="url(#jj-plasma-flame)" />
      <polygon points="11.5,32 15.5,32 13.5,45" fill="#ffffff" opacity="0.9" />
      <!-- Right Thruster Flame -->
      <polygon points="19,32 26,32 22.5,55" fill="url(#jj-plasma-flame)" />
      <polygon points="20.5,32 24.5,32 22.5,45" fill="#ffffff" opacity="0.9" />

      <!-- Thruster Spark Embers -->
      <circle cx="13.5" cy="50" r="1.4" fill="#fbbf24" />
      <circle cx="23.5" cy="48" r="1.3" fill="#f43f5e" />
      <circle cx="18" cy="57" r="1" fill="#38bdf8" />
    </g>

    <!-- Twin Titanium Rocket Thrusters -->
    <rect x="9" y="15" width="8" height="17" rx="3" fill="url(#jj-thruster-metal)" stroke="#ffffff" stroke-width="1" />
    <rect x="18" y="15" width="8" height="17" rx="3" fill="url(#jj-thruster-metal)" stroke="#ffffff" stroke-width="1" />
    <!-- Gold Intake Rings -->
    <rect x="9" y="17" width="8" height="2" fill="#fbbf24" />
    <rect x="18" y="17" width="8" height="2" fill="#fbbf24" />
    <!-- Exhaust Nozzles -->
    <rect x="10.5" y="30" width="5" height="3" fill="#0f172a" />
    <rect x="19.5" y="30" width="5" height="3" fill="#0f172a" />

    <!-- Aviator Hero Body (Forward Flight Inclination) -->
    <path
      d="M 22 9 C 30 5, 40 5, 45 11 C 49 16, 47 27, 40 31 C 33 35, 24 33, 19 26 C 17 19, 17 13, 22 9 Z"
      fill="url(#jj-hero-body)"
      stroke="#ffffff"
      stroke-width="1.6"
      stroke-linejoin="round"
    />

    <!-- Reflective Pilot Flight Helmet & Goggles -->
    <path
      d="M 32 11 C 39 11, 44 14, 43 19 C 42 22, 36 23, 30 20 Z"
      fill="url(#jj-visor-grad)"
      stroke="#ffffff"
      stroke-width="1.3"
    />
    <circle cx="38" cy="15" r="1.6" fill="#ffffff" opacity="0.85" />

    <!-- Trailing High-Speed Aerodynamic Ribbons -->
    <path d="M 20 22 C 14 25, 7 20, 1 22" fill="none" stroke="#fbbf24" stroke-width="2" stroke-linecap="round" />
    <path d="M 22 26 C 15 28, 9 26, 3 28" fill="none" stroke="#38bdf8" stroke-width="1.4" stroke-linecap="round" opacity="0.8" />
  </g>

  <!-- 6. Protective Deflector Shield Bubble (Lower Arc) -->
  <path
    d="M 24 84 C 38 89, 64 89, 78 84"
    fill="none"
    stroke="#38bdf8"
    stroke-width="2"
    stroke-dasharray="4, 4"
    filter="url(#jj-glow)"
    opacity="0.85"
  />
</svg>

<style>
  .jetpack-joyride-logo {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
    filter: drop-shadow(0 4px 12px rgba(56, 189, 248, 0.25));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.25s ease;
  }

  :global(.tool:hover) .jetpack-joyride-logo,
  .jetpack-joyride-logo:hover {
    transform: translateY(-2px) scale(1.06);
    filter: drop-shadow(0 6px 20px rgba(56, 189, 248, 0.45));
  }
</style>
