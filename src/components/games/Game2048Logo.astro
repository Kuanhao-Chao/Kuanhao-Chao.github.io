---
import GameIconFrame from './GameIconFrame.astro';
interface Props {
  size?: number;
  class?: string;
}
const { size = 64, class: className = '' } = Astro.props;
---

<GameIconFrame
  size={size}
  class={`game-2048-logo ${className}`}
  label="2048 — overlapping golden number tiles"
  accent="#b58b3f"
>
  <rect
    x="16"
    y="16"
    width="49"
    height="49"
    rx="10"
    fill="var(--gi-mid)"
    stroke="var(--gi-deep)"
    stroke-width="2.5"></rect>
  <path d="M22 33 V27 Q22 22 28 22 H48" fill="none" stroke="var(--gi-light)" stroke-width="3"
  ></path>
  <rect x="29" y="33" width="57" height="53" rx="11" fill="var(--gi-deep)"></rect>
  <rect
    x="29"
    y="29"
    width="57"
    height="53"
    rx="11"
    fill="#e7c36d"
    stroke="var(--gi-deep)"
    stroke-width="2.5"></rect>
  <path d="M36 43 V40 Q36 36 41 36 H73" fill="none" stroke="#fff1c6" stroke-width="3"></path>
  <text
    x="57.5"
    y="64"
    text-anchor="middle"
    fill="#684c23"
    font-size="21"
    font-family="system-ui, sans-serif"
    font-weight="800"
    letter-spacing="-1">2048</text
  >
  <path d="M44 74 H70" stroke="#bd9347" stroke-width="2.5"></path>
</GameIconFrame>
