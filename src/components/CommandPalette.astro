---
import Icon from './Icon.astro';
---

<dialog id="command-palette-dialog" class="palette-dialog" aria-label="Command Palette">
  <div class="palette-panel">
    <div class="palette-header">
      <div class="palette-input-wrap">
        <span class="palette-search-icon" aria-hidden="true">
          <Icon name="search" size={18} />
        </span>
        <input
          id="command-palette-input"
          class="palette-input"
          type="text"
          placeholder="Search pages, publications, algorithms, or run commands..."
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
        />
      </div>
      <button id="command-palette-close" class="palette-close-btn" type="button" aria-label="Close">
        <kbd class="palette-key">ESC</kbd>
      </button>
    </div>

    <div class="palette-body">
      <div id="command-palette-results" class="palette-results" role="listbox"></div>
      <div id="command-palette-empty" class="palette-empty" hidden>
        <p class="palette-empty-title">No matching results</p>
        <p class="palette-empty-desc muted">Try searching for papers, tools, algorithms, or actions like "theme" or "cv".</p>
      </div>
    </div>

    <div class="palette-footer">
      <div class="palette-shortcuts">
        <span class="palette-shortcut-item">
          <kbd class="palette-key">↑</kbd><kbd class="palette-key">↓</kbd>
          <span>Navigate</span>
        </span>
        <span class="palette-shortcut-item">
          <kbd class="palette-key">↵</kbd>
          <span>Select</span>
        </span>
        <span class="palette-shortcut-item">
          <kbd class="palette-key">ESC</kbd>
          <span>Close</span>
        </span>
      </div>
      <span class="palette-brand muted">khchao.com</span>
    </div>
  </div>
</dialog>

<script>
  import { initCommandPalette } from '../scripts/commandPalette';
  import { initKonamiListener } from '../scripts/dnaRain';

  let cleanupPalette: (() => void) | undefined;
  let cleanupKonami: (() => void) | undefined;

  function setup() {
    cleanupPalette?.();
    cleanupKonami?.();
    cleanupPalette = initCommandPalette();
    cleanupKonami = initKonamiListener();
  }

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => {
    cleanupPalette?.();
    cleanupKonami?.();
  });
</script>

<style>
  .palette-dialog {
    margin: auto;
    padding: 0;
    border: none;
    background: transparent;
    max-width: 40rem;
    width: calc(100vw - 2rem);
    border-radius: var(--radius-lg);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.45);
    overflow: hidden;
  }

  .palette-dialog::backdrop {
    background: rgba(0, 0, 0, 0.55);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .palette-panel {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .palette-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-rule);
    background: var(--color-bg);
  }

  .palette-input-wrap {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex: 1;
  }

  .palette-search-icon {
    color: var(--color-muted);
    display: flex;
    align-items: center;
  }

  .palette-input {
    width: 100%;
    border: none;
    background: transparent;
    font-size: 1.05rem;
    color: var(--color-ink);
    outline: none;
    font-family: inherit;
  }

  .palette-input::placeholder {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .palette-close-btn {
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
  }

  .palette-key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-family: var(--font-mono, monospace);
    font-weight: 600;
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm, 4px);
    background: color-mix(in srgb, var(--color-ink) 8%, var(--color-surface));
    border: 1px solid var(--color-rule);
    color: var(--color-muted);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }

  .palette-body {
    max-height: 24rem;
    overflow-y: auto;
    padding: 0.5rem;
  }

  :global(.palette-group-title) {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--color-muted);
    padding: 0.6rem 0.75rem 0.25rem;
  }

  :global(.palette-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius);
    cursor: pointer;
    text-decoration: none;
    color: var(--color-ink);
    transition: background 0.1s ease;
    gap: 0.75rem;
  }

  :global(.palette-item.is-selected) {
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface));
    color: var(--color-accent-dark);
  }

  :global(.palette-item-main) {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    flex: 1;
  }

  :global(.palette-item-title) {
    font-size: 0.95rem;
    font-weight: var(--fw-semibold, 600);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.palette-item-subtitle) {
    font-size: 0.8rem;
    color: var(--color-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.3;
  }

  :global(.palette-item.is-selected .palette-item-subtitle) {
    color: color-mix(in srgb, var(--color-accent-dark) 80%, var(--color-muted));
  }

  :global(.palette-item-badge) {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.12rem 0.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 8%, var(--color-surface));
    color: var(--color-muted);
    border: 1px solid var(--color-rule);
    flex-shrink: 0;
  }

  :global(.palette-item.is-selected .palette-item-badge) {
    background: color-mix(in srgb, var(--color-accent) 25%, transparent);
    color: var(--color-accent-dark);
    border-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  :global(.palette-item-arrow) {
    font-size: 0.85rem;
    color: var(--color-muted);
    opacity: 0;
    flex-shrink: 0;
  }

  :global(.palette-item.is-selected .palette-item-arrow) {
    opacity: 1;
    color: var(--color-accent-dark);
  }

  .palette-empty {
    padding: 2.5rem 1rem;
    text-align: center;
  }

  .palette-empty-title {
    font-weight: var(--fw-semibold, 600);
    font-size: 1.05rem;
    margin-bottom: 0.25rem;
  }

  .palette-empty-desc {
    font-size: var(--fs-small, 0.88rem);
  }

  .palette-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1rem;
    border-top: 1px solid var(--color-rule);
    background: var(--color-bg);
    font-size: 0.78rem;
  }

  .palette-shortcuts {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .palette-shortcut-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--color-muted);
  }

  .palette-brand {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
  }

  @media (max-width: 640px) {
    .palette-dialog {
      width: calc(100vw - 1rem);
      margin-top: 2rem;
    }
    .palette-footer {
      display: none;
    }
  }
</style>
