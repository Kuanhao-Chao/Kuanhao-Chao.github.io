---
import { DEFAULT_SCENE } from '../lib/backgroundModel';
// The default scene first. `morph` is the stored id and Sequence → Function the name a visitor reads.
const scenes = [
  ['morph', 'Sequence → Function'],
  ['cells', 'Cells'],
  ['off', 'Off'],
];
const motions = [
  ['ambient', 'Ambient'],
  ['calm', 'Calm'],
  ['paused', 'Paused'],
];
---

<section class="background-controls" aria-label="Background settings">
  <label class="background-label" for="background-scene">Background</label>
  <select id="background-scene" data-background-scene-select>
    {
      scenes.map(([value, label]) => (
        <option value={value} selected={value === DEFAULT_SCENE}>
          {label}
        </option>
      ))
    }
  </select>
  <label class="background-label" for="background-motion">Motion</label>
  <select id="background-motion" data-background-motion-select>
    {
      motions.map(([value, label]) => (
        <option value={value} selected={value === 'ambient'}>
          {label}
        </option>
      ))
    }
  </select>
</section>
<script>
  import { initBackground } from '../scripts/background';
  initBackground();
</script>
<style>
  .background-controls {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem 0.65rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--color-rule);
  }
  .background-label {
    font-size: 0.78rem;
    color: var(--color-muted);
  }
  select {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    height: 44px;
    box-sizing: border-box;
    padding: 0.4rem 0.35rem;
    font: inherit;
    font-size: 0.78rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    color: var(--color-ink);
    background: var(--color-surface);
    cursor: pointer;
  }
  select:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  select:disabled {
    opacity: 0.5;
    cursor: default;
  }
</style>
