---
/**
 * The frame every analysis panel on `/shorkie-lab/shorkie/` opens with.
 *
 * The page is a research plan, and a research plan states six things per question before it states
 * an answer: what is being asked, WHY it needs asking, how it is measured, WHY that measurement
 * answers it, what it cost, and what result would have refuted it.
 *
 * The first four rows were previously scattered — costs buried in prose, refutation conditions
 * usually absent — so a reader could not tell a claim carrying a control from one without, and the
 * page's best material is exactly the claims that survived a control.
 *
 * `why` and `intuition` were added because the page described mechanism without reasoning. A
 * reader could follow what was computed and still not know what problem it solved or why that
 * design measures it — and a panel whose motivation cannot be stated in a sentence is usually a
 * panel whose motivation was never examined. `intuition` is the harder of the two to write
 * honestly: it must say why this estimator answers this question, not restate the method.
 *
 * Plain strings, not markup. These are six short declarative lines; letting them carry `<em>` and
 * `<code>` would mean `set:html`, which this repo's security audit fails by default and allowlists
 * only where inline SVG genuinely needs it. Nothing here needs it.
 *
 * `refuted` is not optional and must not be padded. If a panel has no result that could have come
 * out the other way, say that in the field — it is a fact about the panel worth knowing.
 */
interface Props {
  /** What is being asked, as a question. */
  question: string;
  /** The problem this resolves — what goes wrong, or stays unknown, without it. Not a restatement
   *  of the question with "we need to know" in front of it. */
  why: string;
  /** How it is measured — the estimator, not the conclusion. */
  method: string;
  /** Why THIS design answers THAT question: the idea the estimator rests on, or the thing that
   *  would otherwise confound it. Never a paraphrase of `method`. */
  intuition: string;
  /** What it cost to run: passes, wall clock, or that the packs already ship it. */
  cost: string;
  /** What result would have refuted it, or the control that was run against it. */
  refuted: string;
}
const { question, why, method, intuition, cost, refuted } = Astro.props;
const rows: [string, string][] = [
  ['Question', question],
  ['Why this matters', why],
  ['Method', method],
  ['Intuition', intuition],
  ['Cost', cost],
  ['What would refute it', refuted],
];
---

<dl class="vp-frame" data-vp-frame>
  {rows.map(([term, value]) => (
    <div class="vp-frame__row">
      <dt>{term}</dt>
      <dd>{value}</dd>
    </div>
  ))}
</dl>
