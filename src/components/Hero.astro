---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Socials from './Socials.astro';
import HeroBackground from './HeroBackground.astro';
import { site } from '../data/site';
import portrait from '../assets/profile/portrait.jpg';
---
<section class="hero">
  <HeroBackground />
  <div class="container hero-inner">
    <div class="hero-text">
      <p class="eyebrow hero-eyebrow">{site.role}</p>
      <h1 class="hero-title">{site.name}</h1>
      <p class="hero-lead">
        I build machine learning for genomics — sequence-to-function models,
        genome annotation, and DNA language models.
      </p>
      <p class="hero-bio muted">{site.bio}</p>

      <details class="hero-name">
        <summary>
          <span class="hero-name-head">
            <span class="hero-name-caret" aria-hidden="true"></span>
            About my name
          </span>
          <span class="hero-name-zh" lang="zh-Hant">{site.nameZh}</span>
        </summary>
        <div class="hero-name-body">
          <p>
            {site.nameZh} is my Chinese name. My first name consists of two words, Kuan (冠) and Hao (豪),
            connected with a hyphen. Kuan (冠) means ‘crown’, and it can also be used as a verb describing
            the action of ‘putting A on top of B’, which implies ‘being a champion’. Hao (豪) means ‘big’
            and ‘grand’, signifying ‘having the characteristics of a hero’. When combined, Kuan-Hao (冠豪)
            represents the love and expectations my parents have for me. My last name is Chao (趙), and an
            interesting fact is that Chao was the surname of 18 emperors from the ancient and prosperous <a
              href="https://en.wikipedia.org/wiki/Song_dynasty"
              target="_blank"
              rel="noopener noreferrer"
            >Song Dynasty</a> in China (A.D. 960 – A.D. 1279).
          </p>
          <p>
            <span class="hero-name-tag">Also written as</span>
            Kuan-Hao Chao, Kuan Hao Chao, or Kuanhao Chao — and, family name first, Chao Kuan-Hao (趙冠豪).
          </p>
          <p class="hero-name-say">
            <span class="hero-name-tag">Pronunciation</span>
            Kuan-Hao Chao — say it like <strong>“kwan-how chow”</strong> (Kuan rhymes with “swan”; Hao and
            Chao both rhyme with “now”).
          </p>
          <div class="hero-name-audio">
            <span class="hero-name-tag">Hear me say it</span>
            <audio controls preload="none" aria-label="Kuan-Hao Chao pronouncing his name">
              <source src="/audio/my_name.mp3" type="audio/mpeg" />
              Your browser doesn’t support the audio element.
            </audio>
          </div>
        </div>
      </details>

      {/*
        Two rows: labelled actions, then one uniform strip of icon tiles.

        `$ terminal` belongs with the actions, not the icons — it is a labelled
        destination, and as an icon-row sibling its 31px chip never lined up with the
        38px tiles. Photos goes the other way, into the socials list itself, so all
        seven tiles share one wrap context, one gap and one baseline.

        The two secondary actions are wrapped so they can be made exactly equal width
        — 96px beside 106px read as a misalignment — and so they can split the row in
        half on a phone. They differ from each other only in typeface.
      */}
      <div class="hero-actions">
        <a class="btn btn--accent" href="/research/">
          Explore the research
          <Icon name="arrow-right" size={18} />
        </a>
        <span class="hero-pair">
          <a class="btn" href="/cv/">View CV</a>
          <a class="btn hero-term" href="/terminal/" title="Open the shell">
            <span aria-hidden="true">$</span> terminal
          </a>
        </span>
        <Socials
          class="hero-socials"
          keys={['scholar', 'github', 'linkedin', 'twitter', 'bluesky', 'email']}
        >
          <li>
            <a class="hero-photos" href="/photos/" aria-label="Photos" title="Photos">
              <Icon name="image" size={20} />
            </a>
          </li>
        </Socials>
      </div>
    </div>

    <div class="hero-portrait">
      <Image src={portrait} alt={site.name} widths={[384, 576]} sizes="(max-width: 880px) 12rem, 18rem" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(2.25rem, 5.5vw, 3.75rem);
    padding-bottom: var(--section-y);
    border-bottom: 1px solid var(--color-rule);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }
  .hero-text {
    max-width: 42rem;
  }
  .hero-eyebrow {
    margin-bottom: 1.25rem;
  }
  .hero-title {
    font-size: var(--fs-hero);
    margin-bottom: 1.5rem;
  }
  .hero-lead {
    font-size: clamp(1.25rem, 2.2vw, 1.7rem);
    line-height: 1.32;
    font-family: var(--font-display);
    font-weight: var(--fw-light);
    max-width: 38ch;
    margin-bottom: 1.5rem;
    text-wrap: balance;
  }
  .hero-bio {
    max-width: var(--measure);
    font-size: var(--fs-body);
    margin-bottom: 2rem;
  }
  /* Collapsible "About my name" disclosure (identity content from the old site). */
  .hero-name {
    max-width: var(--measure);
    margin-bottom: 2rem;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }
  .hero-name summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.8rem;
    color: var(--color-ink);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    cursor: pointer;
    list-style: none;
    transition: color var(--transition);
  }
  .hero-name summary::-webkit-details-marker {
    display: none;
  }
  .hero-name-head {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .hero-name-caret {
    width: 0.42rem;
    height: 0.42rem;
    border-right: 1.5px solid var(--color-muted);
    border-bottom: 1.5px solid var(--color-muted);
    transform: rotate(-45deg);
    transition: transform var(--transition), border-color var(--transition);
  }
  .hero-name[open] .hero-name-caret {
    transform: rotate(45deg);
  }
  .hero-name summary:hover {
    color: var(--color-accent);
  }
  .hero-name summary:hover .hero-name-caret {
    border-color: var(--color-accent);
  }
  .hero-name-zh {
    font-size: var(--fs-small);
    color: var(--color-muted);
    letter-spacing: 0.08em;
  }
  .hero-name-body {
    padding-bottom: var(--space-5);
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--color-muted);
  }
  .hero-name-body p {
    margin: 0 0 0.9rem;
  }
  .hero-name-body a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .hero-name-say strong {
    color: var(--color-ink);
    font-weight: var(--fw-semibold);
  }
  .hero-name-tag {
    display: block;
    font-size: var(--fs-meta);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink);
    font-weight: var(--fw-medium);
    margin-bottom: 0.25rem;
  }
  .hero-name-audio {
    margin-top: 0.2rem;
  }
  .hero-name-audio audio {
    width: 100%;
    max-width: 20rem;
    height: 2.4rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  /* The two secondary actions travel together and match each other exactly.
     Grid, not flex: this wrapper is shrink-to-fit, so a flex container would size
     itself to the sum of the children's max-content widths, leave zero free space,
     and `flex-grow` would have nothing to distribute — the two came out 2px apart.
     Two `1fr` grid tracks equalise even when the container is auto-sized, so the
     wider label sets the width and the other matches it. */
  .hero-pair {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  .hero-pair .btn {
    justify-content: center;
  }
  /* The icon strip always starts its own row, flush with the buttons above it, so the
     two rows read as one block rather than a row with icons trailing off the end. */
  .hero-actions :global(.hero-socials) {
    flex-basis: 100%;
    margin-top: 0.65rem;
  }
  /* Sized and coloured to match a socials tile exactly — it is one now. */
  .hero-photos {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: var(--radius);
    color: var(--color-muted);
    transition: color var(--transition), background var(--transition);
  }
  .hero-photos:hover {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 9%, transparent);
  }
  /* Same button as `View CV` in every respect but the typeface, which is the one
     difference asked for. It used to carry a 32%-opacity border and muted text, which
     next to a solid-ink neighbour read as disabled rather than merely quiet.
     `--fs-small` in mono sets smaller than in the body face, so it gets a nudge to
     match the cap height of the label beside it. The teal `$` stays — it is the one
     bit of personality in the row, and it survives the hover wipe legibly. */
  .hero-term {
    gap: 0.4em;
    font-family: var(--font-mono);
    font-size: calc(var(--fs-small) * 0.94);
  }
  .hero-term span {
    color: var(--color-accent);
  }
  @media (pointer: coarse) {
    .hero-photos {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
  .hero-portrait {
    flex: none;
  }
  .hero-portrait :global(img) {
    width: clamp(11rem, 20vw, 18rem);
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
    filter: grayscale(12%);
  }

  @media (min-width: 881px) {
    .hero {
      padding-top: clamp(2.5rem, 4.25vw, 3.75rem);
      padding-bottom: clamp(2.25rem, 4vw, 3.5rem);
    }
  }

  /* Phone + tablet: centered profile-card layout with a circular avatar. */
  @media (max-width: 880px) {
    .hero-inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: clamp(1.5rem, 5vw, 2.25rem);
    }
    .hero-text {
      max-width: 38rem;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .hero-portrait {
      order: -1;
    }
    .hero-portrait :global(img) {
      width: clamp(9rem, 28vw, 12rem);
      aspect-ratio: 1 / 1;
      border-radius: 50%;
    }
    .hero-eyebrow {
      margin-bottom: 0.7rem;
    }
    .hero-title {
      margin-bottom: 0.9rem;
    }
    .hero-lead {
      margin-inline: auto;
      margin-bottom: 1.25rem;
    }
    /* Long bio reads better left-aligned, but keep the block centered. */
    .hero-bio {
      order: 5;
      width: 100%;
      text-align: left;
      margin-inline: auto;
      margin-top: 1rem;
      margin-bottom: 0;
      font-size: 1rem;
    }
    /* Keep the name disclosure directly below the (reordered) bio, left-aligned. */
    .hero-name {
      order: 6;
      width: 100%;
      text-align: left;
      margin-top: 1.25rem;
      margin-bottom: 0;
    }
    .hero-actions {
      order: 4;
      justify-content: center;
    }
    .hero-actions :global(.hero-socials) {
      justify-content: center;
    }
  }

  /* Phone: a normal mobile CTA stack. The primary action takes the full width, the
     two secondary ones share the row under it, and the icon strip centres below.
     Previously the icons wrapped 4 + 2 around a hole with three different baselines. */
  @media (max-width: 560px) {
    .hero-actions .btn--accent {
      flex-basis: 100%;
      justify-content: center;
    }
    /* The pair spans the row; the two tracks then split it in exact halves. */
    .hero-pair {
      flex-basis: 100%;
    }
  }

  /* Below ~385px the strip is within a few pixels of fitting — a 375px iPhone leaves
     335px of container for 308px of tiles plus 34px of gaps. Close the gaps rather
     than the tiles: 44px is the tap-target floor and is not negotiable, but the space
     between them is. This keeps all seven on one line down to 360px. */
  @media (max-width: 385px) {
    .hero-actions :global(.hero-socials) {
      gap: 0.125rem;
    }
  }

  /* At 320px seven tap targets cannot fit however tight the gaps: 308px of tile into
     280px of container. Wrap deliberately — four, then three centred beneath — rather
     than six and an orphan. The subtracted 1.5px is the gap's share of each cell. */
  @media (max-width: 330px) {
    .hero-actions :global(.hero-socials > li) {
      flex: 0 0 calc(25% - 0.09375rem);
      display: flex;
      justify-content: center;
    }
  }
</style>
