---
/**
 * Site-Wide Multi-Mode Background System.
 *
 * Renders high-performance, scientifically authentic, hardware-accelerated
 * generative backgrounds:
 * 1. 🌌 Pangenome Haplotype Highway (default)
 * 2. 🫧 Bioluminescent Cell Colony 2.0
 * 3. 🌊 Neural Splice Waves
 * 4. 🧬 3D Chromatin Loop Conformation
 * 5. 🖥️ Minimal / Clean Canvas (Off)
 *
 * Pure HTML5 2D Canvas, 0 dependencies, auto-pausing when tab is hidden,
 * touch-calibrated DPR scaling, and persistent across Astro view transitions.
 */
---

<canvas data-cell-canvas aria-hidden="true" transition:persist="cell-bg"></canvas>

<style>
  canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>

<script>
  import { initSiteBackground, getBackgroundManager } from '../lib/backgrounds/backgroundManager';

  let canvas = document.querySelector<HTMLCanvasElement>('[data-cell-canvas]');

  if (canvas) {
    initSiteBackground(canvas);
  }

  // Handle re-attaching when navigating back from bare pages (like /terminal/)
  document.addEventListener('astro:page-load', () => {
    const nextCanvas = document.querySelector<HTMLCanvasElement>('[data-cell-canvas]');
    if (nextCanvas) {
      if (nextCanvas !== canvas) {
        canvas = nextCanvas;
        getBackgroundManager().attach(nextCanvas);
      }
      getBackgroundManager().sync();
    }
  });
</script>
