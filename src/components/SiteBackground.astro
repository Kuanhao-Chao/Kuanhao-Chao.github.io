---
/**
 * Site-wide Ambient Bioluminescent Living Cells 2.0 Background.
 *
 * Renders an authentic, non-distracting cellular biology simulation:
 * - Growth phase (budding & nutrient uptake)
 * - Mature homeostasis (multi-harmonic lipid membranes, fluorescent nuclei, organelles)
 * - Mitosis (cleavage furrow cytokinesis with chromosome spindle separation)
 * - Apoptosis (membrane blebbing, pyknosis, and nutrient micro-vesicle dispersal)
 * - ATP nutrient fireflies drifting through the intercellular matrix
 *
 * Honors prefers-reduced-motion, pauses when the tab is hidden, scales DPR <= 2,
 * and guarantees 100% typography contrast and legibility.
 */
---
<canvas data-site-bg-canvas aria-hidden="true" transition:persist="site-bg"></canvas>

<style>
  canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>

<script>
  import { initLivingCellsBackground } from '../lib/livingCellsEngine';

  initLivingCellsBackground();

  document.addEventListener('astro:page-load', () => {
    initLivingCellsBackground();
  });
</script>
