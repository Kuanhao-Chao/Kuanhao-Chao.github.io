---
/**
 * Site-wide Multi-Mode Ambient Background Component.
 *
 * Renders a high-performance, non-distracting generative background canvas
 * supporting 4 selectable visual experiences:
 * - 🌿 Classic Living Cells (Original background)
 * - 🫧 Bioluminescent Living Cells 2.0 (Organic membranes, lipid glow, ATP fireflies, mitosis)
 * - 🌌 Synteny Constellation & Graph (Chromosomal loci, synteny bezier filaments, proximity webs)
 * - 🖥️ Minimal Clean Paper (Off)
 *
 * Honors prefers-reduced-motion, pauses when tab is hidden, scales DPR <= 2,
 * and maintains 100% text readability.
 */
---
<canvas data-site-bg-canvas aria-hidden="true" transition:persist="site-bg"></canvas>

<style>
  canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>

<script>
  import { initSiteBackground, getBackgroundManager } from '../lib/backgrounds/manager';

  initSiteBackground();

  document.addEventListener('astro:page-load', () => {
    initSiteBackground();
    getBackgroundManager().sync();
  });
</script>
