---
/**
 * Decorative backgrounds on ordinary content pages: existing Cells (default),
 * Flow Field, Learning Landscape, Genome to Cell, or Off. One controller owns preferences and
 * lifecycle; the dedicated labs retain their own canvases and settings.
 */
import CellStatusChip from './CellStatusChip.astro';
import BackgroundExplorer from './BackgroundExplorer.astro';
---

<script is:inline>
  // Set before the hero mounts: a saved Off/alternate scene must never flash cells.
  try {
    let saved = null;
    try {
      saved = JSON.parse(localStorage.getItem('khc-background-v1') || 'null');
    } catch {}
    const legacy = localStorage.getItem('khc-cell-mode');
    const valid =
      saved &&
      ['cells', 'flow', 'landscape', 'morph', 'off'].includes(saved.scene) &&
      ['ambient', 'calm', 'paused'].includes(saved.motion);
    document.documentElement.dataset.backgroundScene = valid
      ? saved.scene
      : legacy === 'off'
        ? 'off'
        : 'cells';
    document.documentElement.dataset.backgroundMotion = valid
      ? saved.motion
      : legacy === 'calm'
        ? 'calm'
        : 'ambient';
  } catch {}
</script>
<canvas data-site-bg-canvas aria-hidden="true" transition:persist="site-bg" hidden></canvas>
<canvas data-art-bg-canvas aria-hidden="true" transition:persist="art-bg" hidden></canvas>
<CellStatusChip />
<BackgroundExplorer />

<style>
  canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    transition: opacity 140ms ease;
  }
  canvas[hidden] {
    display: none;
  }
  :global(html[data-background-switching='true']) canvas {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    canvas {
      transition: none;
    }
  }
  @media print {
    canvas {
      display: none;
    }
  }
</style>

<script>
  import { initBackground } from '../scripts/background';
  initBackground();
</script>
