---
/**
 * Site-wide ambient schematic animal-cell background.
 *
 * Renders a biologically grounded, non-distracting animal-cell lifecycle:
 * - Interphase growth with a size checkpoint before natural division
 * - Mature homeostasis with gently moving membranes, nuclei, and organelles
 * - Open mitosis followed by animal-cell cleavage-furrow cytokinesis
 * - Apoptotic shrinkage, pyknosis, blebbing, fragmentation, and quiet clearance
 *
 * Honors prefers-reduced-motion, pauses when the tab is hidden, scales DPR <= 2,
 * and keeps the background low contrast behind foreground content.
 */
---

<canvas data-site-bg-canvas aria-hidden="true" transition:persist="site-bg"></canvas>

<style>
  canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>

<script>
  import { getLivingCellsEngine, initLivingCellsBackground } from '../lib/livingCellsEngine';

  const lifecycleWindow = window as Window & {
    __khcLivingCellsLifecycleBound?: boolean;
  };

  // Module scripts run on the first document before Astro emits its navigation
  // lifecycle events. Attach now as well as after subsequent page transitions.
  initLivingCellsBackground();

  if (!lifecycleWindow.__khcLivingCellsLifecycleBound) {
    lifecycleWindow.__khcLivingCellsLifecycleBound = true;

    document.addEventListener('astro:page-load', () => {
      if (document.querySelector('[data-site-bg-canvas]')) {
        initLivingCellsBackground();
      }
    });

    document.addEventListener('astro:before-swap', () => {
      getLivingCellsEngine().detach();
    });
  }
</script>
