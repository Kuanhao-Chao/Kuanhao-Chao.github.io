---
/**
 * Genomic "scanner" page transition. A thin teal line sweeps top→bottom on each
 * client-side navigation (View Transitions), like a sequencer scanning in the
 * new page. The element is persisted so the sweep plays through the DOM swap.
 * Silent under reduced motion (Astro also disables transitions there).
 */
---
<div class="pagescan" data-pagescan aria-hidden="true" transition:persist="pagescan"></div>

<style>
  .pagescan {
    position: fixed;
    inset: 0;
    z-index: 300;
    pointer-events: none;
    opacity: 0;
  }
  .pagescan::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    box-shadow: 0 0 12px 2px color-mix(in srgb, var(--color-accent) 40%, transparent);
    transform: translateY(-4px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .pagescan.is-scanning {
      opacity: 1;
    }
    .pagescan.is-scanning::before {
      animation: pagescan-sweep 0.45s ease-out 1;
    }
  }
  @keyframes pagescan-sweep {
    0% {
      transform: translateY(-4px);
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      transform: translateY(100vh);
      opacity: 0;
    }
  }
</style>

<script>
  /*
   * Re-acquired per navigation, not captured once: `transition:persist` keeps this
   * node stable only across pages that render it, and `/terminal/` (`bare`) renders
   * none of the site chrome. The replacement element is a different node, so a
   * one-time capture would leave the sweep animating something detached.
   */
  const scanEl = () => document.querySelector<HTMLElement>('[data-pagescan]');

  function bind() {
    const el = scanEl();
    if (!el || el.dataset.scanBound === 'true') return;
    el.dataset.scanBound = 'true';
    el.addEventListener('animationend', () => el.classList.remove('is-scanning'));
  }

  document.addEventListener('astro:before-swap', () => {
    const el = scanEl();
    if (!el) return;
    el.classList.remove('is-scanning');
    // Force a reflow so the sweep restarts on every navigation.
    void el.offsetWidth;
    el.classList.add('is-scanning');
  });

  bind();
  document.addEventListener('astro:page-load', bind);
</script>
