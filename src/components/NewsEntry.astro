---
import { month, monthYear } from '../lib/format';
import { NEWS_LABELS } from '../lib/newsCategories';
import { newsPreview } from '../lib/readingTypography';
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'news'>;
  variant?: 'row' | 'card';
}
const { entry, variant = 'row' } = Astro.props;
const d = entry.data;
const categoryLabel = NEWS_LABELS[d.category];
// The list rows sit under year separators (injected by NewsList), so they show
// month-only; the homepage card stands alone and keeps the full month + year.
const dateLabel = variant === 'card' ? monthYear(d.date) : month(d.date);
// Hooks for the News-page filter / sort / search island.
const searchText = `${d.title} ${entry.body ?? ''} ${d.location ?? ''}`.toLowerCase();
---
<article
  id={entry.id}
  class:list={['news', `news--${variant}`]}
  data-category={d.category}
  data-year={d.date.getUTCFullYear()}
  data-ts={d.date.getTime()}
  data-search={searchText}
  data-veiled={variant === 'card' ? '' : undefined}
>
  <div class="news-meta">
    <time datetime={d.date.toISOString()}>{dateLabel}</time>
    <span class:list={['news-tag', `news-tag--${d.category}`]}>{categoryLabel}</span>
  </div>
  {variant === 'card' ? (
    <>
      <h3 class="news-title"><a href={`/news/#${entry.id}`}>{d.title}</a></h3>
      <p class="news-text">{newsPreview(entry.body ?? '')}</p>
      <a class="news-read-more" href={`/news/#${entry.id}`} aria-label={`Read update: ${d.title}`}>
        Read update <Icon name="arrow-right" size={16} />
      </a>
    </>
  ) : (
    <div class="news-text"><slot /></div>
  )}
</article>

<style>
  .news {
    min-width: 0;
    overflow-wrap: anywhere;
    border-bottom: 1px solid var(--color-rule);
    /* Offset for the fixed header when deep-linked from the RSS feed. */
    scroll-margin-top: 6rem;
  }
  .news--row {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0 1.5rem;
    padding-block: var(--space-5);
  }
  .news-meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    align-items: flex-start;
  }
  .news--row .news-meta {
    padding-top: 0.15rem;
  }
  .news-meta time {
    font-family: var(--font-display);
    color: var(--color-muted);
    font-size: 0.95rem;
  }
  .news-tag {
    max-width: 100%;
    font-size: var(--fs-meta);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: var(--fw-semibold);
    color: var(--color-muted);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    padding: 0.12em 0.55em;
  }
  .news-tag--award {
    color: var(--color-badge-warm-text);
    border-color: var(--color-badge-warm-border);
    background: var(--color-badge-warm-bg);
  }
  .news-tag--publication,
  .news-tag--release {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }
  .news-text {
    font-size: var(--fs-body);
  }
  .news-text :global(p) {
    margin: 0;
  }

  /* Card variant (homepage grid) */
  .news--card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    height: 100%;
    transition: border-color var(--transition);
  }
  .news--card:hover {
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-rule));
  }
  /* The veil: see ResearchCard.astro. Only the homepage uses this variant. */
  :global(html[data-background-scene='morph']) .news--card {
    background: color-mix(in srgb, var(--color-surface) var(--veil-fill), transparent);
  }
  .news--card .news-meta {
    flex-direction: row;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .news--card .news-text {
    font-size: var(--fs-small);
    color: var(--color-muted);
    line-height: 1.6;
  }
  .news-title {
    font-size: var(--fs-item-title);
    font-weight: var(--fw-semibold);
    line-height: 1.35;
    letter-spacing: 0;
  }
  .news-title a { color: var(--color-ink); }
  .news-title a:hover { color: var(--color-accent); }
  .news-read-more {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.4rem;
    min-height: 44px;
    margin-top: auto;
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
  }

  @media (max-width: 600px) {
    .news--row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .news--row .news-meta {
      flex-direction: row;
      align-items: center;
      gap: 0.6rem;
    }
    .news--card {
      padding: 1rem 1.1rem;
      gap: 0.5rem;
    }
    .news-meta time {
      font-size: 0.85rem;
    }
  }
</style>
