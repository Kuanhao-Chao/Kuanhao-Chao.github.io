<script>
  import { setLabel } from '../lib/domLabel';

  interface ThemeApi {
    get: () => string;
    set: (t: string) => void;
    toggle: () => void;
    sync: () => void;
  }
  interface CrtApi {
    get: () => string;
    set: (m: string) => void;
    toggle: () => void;
    sync: () => void;
  }

  const themeApi = () => (window as Window & { __khcTheme?: ThemeApi }).__khcTheme;
  const crtApi = () => (window as Window & { __khcCrt?: CrtApi }).__khcCrt;

  interface Nav {
    toggle: HTMLButtonElement;
    menu: HTMLElement;
    header: HTMLElement;
  }
  let nav: Nav | null = null;
  let popoverEl: HTMLElement | null = null;
  let topBtnEl: HTMLButtonElement | null = null;
  let labsTriggerEl: HTMLButtonElement | null = null;
  let labsPopoverEl: HTMLElement | null = null;
  let appearanceReturn: HTMLElement | null = null;
  let headerSizeObserver: ResizeObserver | null = null;
  let observedRow: HTMLElement | null = null;

  function syncHeaderSize() {
    if (!observedRow?.isConnected) return;
    const height = Math.ceil(observedRow.getBoundingClientRect().height + 1);
    document.documentElement.style.setProperty('--site-header-height', `${height}px`);
    // A font-size change may switch the container-query layout without crossing
    // a viewport breakpoint. Never leave its now-hidden disclosure open.
    if (nav && getComputedStyle(nav.toggle).display === 'none') setMenuOpen(false);
    if (labsTriggerEl && getComputedStyle(labsTriggerEl).display === 'none') setLabsOpen(false);
  }

  const headerWindow = window as Window & {
    __khcHeaderEventsBound?: boolean;
    __khcCellControlEventsBound?: boolean;
  };

  const isMenuOpen = () => nav?.toggle.getAttribute('aria-expanded') === 'true';
  const setMenuOpen = (open: boolean) => {
    if (!nav) return;
    if (open) {
      setPopoverOpen(false);
      setLabsOpen(false);
    }
    nav.toggle.setAttribute('aria-expanded', String(open));
    nav.toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    nav.menu.hidden = !open;
  };

  const isPopoverOpen = () => topBtnEl?.getAttribute('aria-expanded') === 'true';
  const setPopoverOpen = (open: boolean) => {
    if (!popoverEl || !topBtnEl) return;
    if (open) {
      setMenuOpen(false);
      setLabsOpen(false);
    }
    popoverEl.hidden = !open;
    topBtnEl.setAttribute('aria-expanded', String(open));
    document.querySelectorAll('[data-open-appearance]').forEach(button =>
      button.setAttribute('aria-expanded', String(open))
    );
    if (open) syncRadioStops();
  };

  const isLabsOpen = () => labsTriggerEl?.getAttribute('aria-expanded') === 'true';
  const setLabsOpen = (open: boolean) => {
    if (!labsPopoverEl || !labsTriggerEl) return;
    if (open) {
      setMenuOpen(false);
      setPopoverOpen(false);
    }
    labsPopoverEl.hidden = !open;
    labsTriggerEl.setAttribute('aria-expanded', String(open));
  };

  function radioOptions(group: Element): HTMLButtonElement[] {
    return [...group.querySelectorAll<HTMLButtonElement>('button[role="radio"]')].filter(
      (button) => !button.disabled && !button.closest('details:not([open]) > :not(summary)')
    );
  }

  function syncRadioStops() {
    popoverEl?.querySelectorAll('[role="radiogroup"]').forEach((group) => {
      const options = radioOptions(group);
      const entry =
        options.find((button) => button.getAttribute('aria-checked') === 'true') ?? options[0];
      group.querySelectorAll<HTMLButtonElement>('button[role="radio"]').forEach((button) => {
        button.tabIndex = button === entry ? 0 : -1;
      });
    });
  }

  function syncHeaderThemeIcons() {
    const currentTheme = themeApi()?.get() || document.documentElement.dataset.theme || 'light';
    const currentCrt = crtApi()?.get() || document.documentElement.dataset.crtMode || 'off';
    const isCrt = currentCrt === 'amber' || currentCrt === 'green' || currentCrt === 'cyan';

    const topBtn = document.querySelector<HTMLButtonElement>('[data-top-theme-btn]');
    if (topBtn) {
      topBtn.dataset.themeState = currentTheme;
      topBtn.dataset.crtActive = String(isCrt);
    }

    // Only the header owns these controls. The footer opens this same panel;
    // there is no second set of theme/CRT state or independently bound handlers.
    const owned = <T extends HTMLElement>(selector: string): T[] => {
      const roots = [popoverEl, document.getElementById('mobile-menu')].filter(Boolean);
      return roots.flatMap((root) => [...(root as HTMLElement).querySelectorAll<T>(selector)]);
    };

    owned<HTMLButtonElement>('[data-theme-choice]').forEach((btn) => {
      const choice = btn.dataset.themeChoice;
      const isActive = !isCrt && choice === currentTheme;
      btn.classList.toggle('is-active', isActive);
      btn.setAttribute('aria-checked', String(isActive));
    });

    owned<HTMLButtonElement>('[data-crt-choice]').forEach((btn) => {
      const choice = btn.dataset.crtChoice;
      const isActive = isCrt && choice === currentCrt;
      btn.classList.toggle('is-active', isActive);
      btn.setAttribute('aria-checked', String(isActive));
      // A phosphor colour means nothing while THIS UI's tube is off, and this UI has a tube
      // switch beside it.
      btn.disabled = !isCrt;
    });
    owned<HTMLButtonElement>('[data-crt-switch]').forEach((btn) => {
      btn.setAttribute('aria-checked', String(isCrt));
      btn.classList.toggle('is-on', isCrt);
      const label = btn.querySelector('[data-crt-switch-text]');
      setLabel(label, isCrt ? 'On' : 'Off');
    });
    owned<HTMLElement>('[data-crt-colors]').forEach((row) => {
      row.classList.toggle('is-disabled', !isCrt);
    });
    const titleCase = (name: string) => name.charAt(0).toUpperCase() + name.slice(1);
    setLabel(
      popoverEl?.querySelector('[data-theme-summary]'),
      ['light', 'dark'].includes(currentTheme) ? '4 options' : titleCase(currentTheme)
    );
    setLabel(
      popoverEl?.querySelector('[data-crt-summary]'),
      isCrt ? `${titleCase(currentCrt)} · On` : 'Off'
    );
    syncRadioStops();
  }

  function bind() {
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const menu = document.querySelector<HTMLElement>('#mobile-menu');
    const header = document.querySelector<HTMLElement>('.site-header');
    const row = header?.querySelector<HTMLElement>('.header-inner') ?? null;
    if (row !== observedRow) {
      headerSizeObserver?.disconnect();
      observedRow = row;
      if (row) {
        headerSizeObserver = new ResizeObserver(syncHeaderSize);
        headerSizeObserver.observe(row);
      }
    }
    if (toggle && menu && header) {
      nav = { toggle, menu, header };
      if (toggle.dataset.navBound !== 'true') {
        toggle.dataset.navBound = 'true';
        toggle.addEventListener('click', () => setMenuOpen(!isMenuOpen()));
      }
    }

    topBtnEl = document.querySelector<HTMLButtonElement>('[data-top-theme-btn]');
    popoverEl = document.querySelector<HTMLElement>('[data-top-theme-popover]');

    if (topBtnEl && topBtnEl.dataset.popoverBound !== 'true') {
      topBtnEl.dataset.popoverBound = 'true';
      topBtnEl.addEventListener('click', (e) => {
        e.stopPropagation();
        appearanceReturn = topBtnEl;
        setPopoverOpen(!isPopoverOpen());
      });
    }

    // Labs Dropdown setup
    labsTriggerEl = document.querySelector<HTMLButtonElement>('[data-nav-labs-trigger]');
    labsPopoverEl = document.querySelector<HTMLElement>('[data-nav-labs-popover]');

    if (labsTriggerEl && labsTriggerEl.dataset.labsBound !== 'true') {
      labsTriggerEl.dataset.labsBound = 'true';
      labsTriggerEl.addEventListener('click', (e) => {
        e.stopPropagation();
        setLabsOpen(!isLabsOpen());
      });
    }

    labsPopoverEl?.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
      if (link.dataset.labsLinkBound === 'true') return;
      link.dataset.labsLinkBound = 'true';
      link.addEventListener('click', () => setLabsOpen(false));
    });

    // Theme/CRT selection belongs only to BaseLayout. Settings stay open while adjusted.
    if (popoverEl && popoverEl.dataset.appearanceBound !== 'true') {
      popoverEl.dataset.appearanceBound = 'true';
      popoverEl.querySelector('[data-top-theme-close]')?.addEventListener('click', () => {
        setPopoverOpen(false);
        (appearanceReturn?.isConnected ? appearanceReturn : topBtnEl)?.focus();
      });
      popoverEl.addEventListener('toggle', syncRadioStops, true);
      popoverEl.addEventListener('keydown', (event) => {
        const button = (event.target as Element)?.closest<HTMLButtonElement>(
          'button[role="radio"]'
        );
        if (
          !button ||
          !['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End'].includes(event.key)
        )
          return;
        const group = button.closest('[role="radiogroup"]');
        if (!group) return;
        const options = radioOptions(group);
        if (!options.length) return;
        event.preventDefault();
        const index = options.indexOf(button);
        const next =
          event.key === 'Home'
            ? 0
            : event.key === 'End'
              ? options.length - 1
              : (index + (['ArrowLeft', 'ArrowUp'].includes(event.key) ? -1 : 1) + options.length) %
                options.length;
        options[next].focus();
        options[next].click();
      });
    }

    syncHeaderThemeIcons();
    syncHeaderSize();
  }

  function handleHeaderKeydown(e: KeyboardEvent) {
    if (e.key === 'Escape') {
      if (isLabsOpen()) {
        setLabsOpen(false);
        labsTriggerEl?.focus();
      }
      if (isPopoverOpen()) {
        setPopoverOpen(false);
        (appearanceReturn?.isConnected ? appearanceReturn : topBtnEl)?.focus();
      }
      if (isMenuOpen()) {
        setMenuOpen(false);
        nav?.toggle.focus();
      }
    }
  }

  function handleOutsideClick(e: MouseEvent) {
    const target = e.target as Node;
    const opener = target instanceof Element ? target.closest<HTMLElement>('[data-open-appearance]') : null;
    if (opener) {
      if (e.type === 'click') {
        appearanceReturn = opener;
        setPopoverOpen(true);
        popoverEl?.querySelector<HTMLElement>('[data-top-theme-close]')?.focus({ preventScroll: true });
      }
      return;
    }
    if (isLabsOpen() && !labsPopoverEl?.contains(target) && !labsTriggerEl?.contains(target)) {
      setLabsOpen(false);
    }
    if (isPopoverOpen() && !popoverEl?.contains(target) && !topBtnEl?.contains(target)) {
      setPopoverOpen(false);
    }
    if (isMenuOpen() && !nav?.header.contains(target)) {
      setMenuOpen(false);
    }
  }

  function handleDesktopLayout(e: MediaQueryListEvent) {
    if (e.matches) {
      setMenuOpen(false);
    } else {
      setLabsOpen(false);
    }
  }

  function closeHeaderMenus() {
    setMenuOpen(false);
    setPopoverOpen(false);
    setLabsOpen(false);
  }

  // Refresh active navigation indicators
  function updateActiveNav() {
    const currentPath = location.pathname;
    for (const a of document.querySelectorAll<HTMLAnchorElement>(
      '.nav-desktop a, .mobile-menu a'
    )) {
      const href = a.getAttribute('href') || '';
      if (!href.startsWith('/')) continue;
      const active =
        href === '/' ? currentPath === '/' : currentPath.startsWith(href.replace(/\/$/, ''));
      if (active) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    }

    const isLab = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-lab-card')).some(
      (link) => {
        const prefix = link.getAttribute('href')?.replace(/\/$/, '');
        return !!prefix && (currentPath === prefix || currentPath.startsWith(`${prefix}/`));
      }
    );

    if (labsTriggerEl) {
      if (isLab) labsTriggerEl.setAttribute('aria-current', 'page');
      else labsTriggerEl.removeAttribute('aria-current');
    }
  }

  function handleHeaderPageLoad() {
    bind();
    updateActiveNav();
  }

  // Header markup persists through ordinary Astro navigation. Keep the
  // document/window listeners singular even after a bare route removes and a
  // later page recreates the component; each handler queries the live markup.
  if (!headerWindow.__khcHeaderEventsBound) {
    headerWindow.__khcHeaderEventsBound = true;
    headerWindow.__khcCellControlEventsBound = true;
    document.addEventListener('keydown', handleHeaderKeydown);
    // Touching a non-interactive margin need not synthesize a click in WebKit.
    document.addEventListener('pointerdown', handleOutsideClick, { passive: true });
    document.addEventListener('click', handleOutsideClick);
    window.matchMedia('(min-width: 960px)').addEventListener('change', handleDesktopLayout);
    document.addEventListener('astro:before-swap', closeHeaderMenus);
    document.addEventListener('khc:theme-change', syncHeaderThemeIcons);
    document.addEventListener('khc:crt-change', syncHeaderThemeIcons);
    document.addEventListener('astro:page-load', handleHeaderPageLoad);
  }

  bind();
  updateActiveNav();
</script>
