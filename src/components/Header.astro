---
import Icon from './Icon.astro';
import BackgroundControls from './BackgroundControls.astro';
import { site, nav, labNavItems } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, ''));

const labPrefixes = labNavItems.map((item) => item.href.replace(/\/$/, ''));
const isLabActive = labPrefixes.some((prefix) => path === prefix || path.startsWith(`${prefix}/`));

// Header (desktop + mobile) shows primary items only; footer keeps the full nav.
const headerNav = nav.filter((item) => !item.footerOnly);
const colorThemes = [
  ['light', 'Light', 'sun'],
  ['dark', 'Dark', 'moon'],
  ['parchment', 'Parchment', 'parchment'],
  ['nord', 'Nord', 'nord'],
  ['monokai', 'Monokai', 'monokai'],
  ['cyberdeck', 'Cyberdeck', 'cyberdeck'],
] as const;
---

<header class="site-header" transition:persist="site-header">
  <div class="container header-inner">
    <a href="/" class="wordmark" aria-label={`${site.name} — home`}>
      <span class="wordmark-mark" aria-hidden="true">
        <img src="/favicon.svg" alt="" width="32" height="32" />
      </span>
      <span class="wordmark-name">{site.name}</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {
          headerNav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="nav-labs-item" data-nav-labs-wrapper>
          <button
            type="button"
            class="nav-labs-trigger"
            data-nav-labs-trigger
            aria-controls="nav-labs-popover"
            aria-expanded="false"
            aria-current={isLabActive ? 'page' : undefined}
            title="Interactive tools, models, and genome browsers"
          >
            <span>Labs</span>
            <span class="nav-labs-caret" aria-hidden="true">▾</span>
          </button>

          <div class="nav-labs-popover" id="nav-labs-popover" data-nav-labs-popover hidden>
            <div class="nav-labs-header">
              <span class="eyebrow">Interactive Labs & Tools</span>
              <span class="nav-labs-count">{labNavItems.length} Explorations</span>
            </div>
            <ul class="nav-labs-grid">
              {
                labNavItems.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="nav-lab-card"
                      aria-current={
                        path.startsWith(item.href.replace(/\/$/, '')) ? 'page' : undefined
                      }
                    >
                      <span class="nav-lab-icon" aria-hidden="true">
                        {item.icon}
                      </span>
                      <div class="nav-lab-info">
                        <div class="nav-lab-title-row">
                          <strong class="nav-lab-title">{item.title}</strong>
                          {item.badge && <span class="nav-lab-badge">{item.badge}</span>}
                        </div>
                        <span class="nav-lab-sub">{item.sub}</span>
                      </div>
                      <span class="nav-lab-arrow" aria-hidden="true">
                        →
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
      </ul>
    </nav>

    <div class="header-actions">
      <!-- Spotlight Search / Command Palette shortcut -->
      <a
        class="search-shortcut"
        href="/search/"
        aria-label="Search or commands (⌘K)"
        title="Search or commands (⌘K)"
        data-open-command-palette
      >
        <Icon name="search" size={19} />
      </a>

      <!-- Desktop & Tablet Top Theme Control Menu -->
      <div class="top-theme-wrapper">
        <button
          class="top-theme-btn"
          type="button"
          data-top-theme-btn
          data-theme-state="light"
          aria-haspopup="dialog"
          aria-controls="appearance-popover"
          aria-expanded="false"
          aria-label="Appearance settings"
          title="Adjust color theme, background, or 1988 CRT mode"
        >
          <span class="theme-icon-container">
            <span class="theme-toggle-icon theme-toggle-icon--light" aria-hidden="true">
              <Icon name="sun" size={19} />
            </span>
            <span class="theme-toggle-icon theme-toggle-icon--dark" aria-hidden="true">
              <Icon name="moon" size={19} />
            </span>
            <span class="theme-toggle-icon theme-toggle-icon--parchment" aria-hidden="true">
              <Icon name="parchment" size={19} />
            </span>
            <span class="theme-toggle-icon theme-toggle-icon--nord" aria-hidden="true">
              <Icon name="nord" size={19} />
            </span>
            <span class="theme-toggle-icon theme-toggle-icon--monokai" aria-hidden="true">
              <Icon name="monokai" size={19} />
            </span>
            <span class="theme-toggle-icon theme-toggle-icon--cyberdeck" aria-hidden="true">
              <Icon name="cyberdeck" size={19} />
            </span>
            <span
              class="theme-toggle-icon theme-toggle-icon--crt"
              data-top-crt-badge
              aria-hidden="true"
            >
              <Icon name="cyberdeck" size={19} />
            </span>
          </span>
          <span class="top-theme-caret" aria-hidden="true">▾</span>
        </button>

        <div
          class="top-theme-popover"
          id="appearance-popover"
          data-top-theme-popover
          role="dialog"
          aria-label="Appearance"
          hidden
        >
          <div class="appearance-heading">
            <strong>Appearance</strong>
            <button
              type="button"
              class="appearance-close"
              data-top-theme-close
              aria-label="Close appearance settings"
            >
              <Icon name="close" size={16} />
            </button>
          </div>
          <div class="popover-section" role="radiogroup" aria-label="Color theme">
            <div class="popover-grid">
              {
                colorThemes.slice(0, 2).map(([value, label, icon]) => (
                  <button
                    type="button"
                    class="popover-opt-btn"
                    data-theme-choice={value}
                    role="radio"
                    aria-checked={value === 'light' ? 'true' : 'false'}
                    tabindex={value === 'light' ? 0 : -1}
                  >
                    <span class="opt-icon-wrap" aria-hidden="true">
                      <Icon name={icon} size={16} />
                    </span>
                    <span class="opt-text">{label}</span>
                  </button>
                ))
              }
            </div>
            <details class="appearance-more" data-more-themes>
              <summary
                ><span>More themes</span><span class="appearance-value" data-theme-summary
                  >4 options</span
                ></summary
              >
              <div class="popover-grid">
                {
                  colorThemes.slice(2).map(([value, label, icon]) => (
                    <button
                      type="button"
                      class="popover-opt-btn"
                      data-theme-choice={value}
                      role="radio"
                      aria-checked="false"
                      tabindex="-1"
                    >
                      <span class="opt-icon-wrap" aria-hidden="true">
                        <Icon name={icon} size={14} />
                      </span>
                      <span class="opt-text">{label}</span>
                    </button>
                  ))
                }
              </div>
            </details>
          </div>

          <BackgroundControls />

          <details class="appearance-more" data-retro-effects>
            <summary
              ><span>Retro effects</span><span class="appearance-value" data-crt-summary>Off</span
              ></summary
            >
            <div class="popover-heading-row">
              <span class="popover-heading" id="crt-heading">CRT display</span>
              <button
                type="button"
                class="crt-switch"
                data-crt-switch
                role="switch"
                aria-checked="false"
                aria-labelledby="crt-heading"
              >
                <span class="crt-switch-track" aria-hidden="true"
                  ><span class="crt-switch-thumb"></span></span
                >
                <span class="crt-switch-text" data-crt-switch-text>Off</span>
              </button>
            </div>
            <div
              class="popover-crt-row"
              role="radiogroup"
              aria-labelledby="crt-heading"
              data-crt-colors
            >
              <button
                type="button"
                class="popover-crt-btn popover-crt-btn--amber"
                data-crt-choice="amber"
                role="radio"
                aria-checked="false"
              >
                <span class="crt-swatch" aria-hidden="true"></span>
                <span>Amber</span>
              </button>
              <button
                type="button"
                class="popover-crt-btn popover-crt-btn--green"
                data-crt-choice="green"
                role="radio"
                aria-checked="false"
              >
                <span class="crt-swatch" aria-hidden="true"></span>
                <span>Green</span>
              </button>
              <button
                type="button"
                class="popover-crt-btn popover-crt-btn--cyan"
                data-crt-choice="cyan"
                role="radio"
                aria-checked="false"
              >
                <span class="crt-swatch" aria-hidden="true"></span>
                <span>Cyan</span>
              </button>
            </div>
          </details>

          <div class="appearance-footer">
            <p class="background-hint" data-background-hint>
              Quiet motion. Your choice is remembered.
            </p>
            <button type="button" class="background-explore" data-background-explore
              >Explore background ↗</button
            >
          </div>
        </div>
      </div>

      <!-- Mobile Hamburger Menu Button -->
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu with Theme Navigation -->
  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Mobile">
      <ul>
        {
          headerNav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mobile-labs-section">
      <div class="mobile-labs-header">
        <span class="eyebrow">Interactive Labs & Tools</span>
      </div>
      <div class="mobile-labs-grid">
        {
          labNavItems.map((item) => (
            <a
              href={item.href}
              class="mobile-lab-card"
              aria-current={path.startsWith(item.href.replace(/\/$/, '')) ? 'page' : undefined}
            >
              <span class="mobile-lab-icon" aria-hidden="true">
                {item.icon}
              </span>
              <div class="mobile-lab-text">
                <div class="mobile-lab-title-row">
                  <strong class="mobile-lab-title">{item.title}</strong>
                  {item.badge && <span class="mobile-lab-badge">{item.badge}</span>}
                </div>
                <span class="mobile-lab-sub">{item.sub}</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    container: site-header / inline-size;
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--color-rule);
  }
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    min-height: 4.25rem;
    padding-block: 0.5rem;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-ink);
    font-family: var(--font-display);
    min-width: 0;
    max-width: 100%;
  }
  .wordmark:hover {
    text-decoration: none;
    color: var(--color-ink);
  }
  .wordmark-mark {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
  }
  .wordmark-mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .wordmark-name {
    font-weight: var(--fw-regular);
    font-size: 1.05rem;
    letter-spacing: var(--tracking-tight);
    overflow-wrap: anywhere;
    line-height: 1.3;
  }
  .nav-desktop {
    min-width: 0;
  }
  .nav-desktop > ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 1.4vw, 1.5rem);
    margin: 0;
    padding: 0;
  }
  .nav-desktop a {
    color: var(--color-ink);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    padding-block: 0.4rem;
    position: relative;
    white-space: nowrap;
  }
  .nav-desktop a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
  .nav-desktop a[aria-current='page'] {
    color: var(--color-accent);
  }
  /* Underline "splices" in from the left on hover/focus */
  .nav-desktop a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1.5px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms ease;
  }
  .nav-desktop a:hover::after,
  .nav-desktop a:focus-visible::after,
  .nav-desktop a[aria-current='page']::after {
    transform: scaleX(1);
  }

  /* Labs Dropdown in Desktop Nav */
  .nav-labs-item {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .nav-labs-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-ink);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    padding-block: 0.4rem;
    background: none;
    border: none;
    cursor: pointer;
    position: relative;
    white-space: nowrap;
    font-family: inherit;
    transition: color var(--transition);
  }
  .nav-labs-trigger:hover,
  .nav-labs-trigger[aria-expanded='true'] {
    color: var(--color-accent);
  }
  .nav-labs-trigger[aria-current='page'] {
    color: var(--color-accent);
  }
  .nav-labs-trigger::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1.5px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms ease;
  }
  .nav-labs-trigger:hover::after,
  .nav-labs-trigger:focus-visible::after,
  .nav-labs-trigger[aria-current='page']::after,
  .nav-labs-trigger[aria-expanded='true']::after {
    transform: scaleX(1);
  }
  .nav-labs-caret {
    font-size: 0.72rem;
    line-height: 1;
    opacity: 0.65;
    transition:
      transform 200ms ease,
      opacity var(--transition);
  }
  .nav-labs-trigger:hover .nav-labs-caret,
  .nav-labs-trigger[aria-expanded='true'] .nav-labs-caret {
    opacity: 1;
  }
  .nav-labs-trigger[aria-expanded='true'] .nav-labs-caret {
    transform: rotate(180deg);
  }

  .nav-labs-popover {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: min(560px, 92vw);
    background: color-mix(in srgb, var(--color-surface) 96%, var(--color-bg));
    -webkit-backdrop-filter: saturate(160%) blur(16px);
    backdrop-filter: saturate(160%) blur(16px);
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    box-shadow:
      0 16px 40px rgba(0, 0, 0, 0.12),
      0 2px 8px rgba(0, 0, 0, 0.05);
    padding: 1.1rem;
    z-index: 120;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    animation: labs-popover-in 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes labs-popover-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .nav-labs-popover[hidden] {
    display: none !important;
  }

  .nav-labs-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .nav-labs-count {
    font-size: 0.72rem;
    color: var(--color-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .nav-labs-grid {
    display: grid;
    list-style: none;
    padding: 0;
    margin: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .nav-lab-card {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.65rem;
    border-radius: 8px;
    border: 1px solid transparent;
    background: color-mix(in srgb, var(--color-surface) 60%, transparent);
    color: var(--color-ink);
    text-decoration: none;
    transition: all 140ms ease;
  }

  .nav-lab-card:hover {
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
    border-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .nav-lab-card[aria-current='page'] {
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface));
    border-color: var(--color-accent);
  }

  .nav-lab-icon {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    font-size: 1.15rem;
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
    flex-shrink: 0;
  }

  .nav-lab-card:hover .nav-lab-icon {
    background: color-mix(in srgb, var(--color-accent) 15%, transparent);
  }

  .nav-lab-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }

  .nav-lab-title-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-lab-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav-lab-card:hover .nav-lab-title {
    color: var(--color-accent);
  }

  .nav-lab-badge {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.1em 0.4em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 15%, transparent);
    color: var(--color-accent);
  }

  .nav-lab-sub {
    font-size: 0.72rem;
    color: var(--color-muted);
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav-lab-arrow {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-accent);
    opacity: 0;
    transform: translateX(-4px);
    transition: all 140ms ease;
    flex-shrink: 0;
  }

  .nav-lab-card:hover .nav-lab-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .search-shortcut,
  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: none;
    border: none;
    color: var(--color-ink);
    cursor: pointer;
    padding: 0.4rem;
    border-radius: 999px;
    transition: all var(--transition);
  }
  .search-shortcut {
    text-decoration: none;
  }
  .search-shortcut:hover,
  .nav-toggle:hover {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    text-decoration: none;
  }

  .nav-toggle {
    display: none;
  }

  /* Top Theme Control Wrapper & Popover */
  .top-theme-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .top-theme-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.65rem;
    height: 40px;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 75%, transparent);
    color: var(--color-ink);
    cursor: pointer;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all var(--transition);
    -webkit-tap-highlight-color: transparent;
  }

  .top-theme-btn:hover,
  .top-theme-btn[aria-expanded='true'] {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-rule));
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface));
  }

  .theme-icon-container {
    position: relative;
    width: 20px;
    height: 20px;
    display: grid;
    place-items: center;
  }

  .theme-toggle-icon {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.75);
    transition:
      opacity var(--transition),
      transform var(--transition);
  }

  .theme-toggle-icon--crt {
    font-size: 1rem;
    line-height: 1;
  }

  /* Each theme displays its own dedicated bespoke icon */
  .top-theme-btn[data-theme-state='light'] .theme-toggle-icon--light,
  .top-theme-btn[data-theme-state='dark'] .theme-toggle-icon--dark,
  .top-theme-btn[data-theme-state='parchment'] .theme-toggle-icon--parchment,
  .top-theme-btn[data-theme-state='nord'] .theme-toggle-icon--nord,
  .top-theme-btn[data-theme-state='monokai'] .theme-toggle-icon--monokai,
  .top-theme-btn[data-theme-state='cyberdeck'] .theme-toggle-icon--cyberdeck {
    opacity: 1;
    transform: none;
  }

  /* Individual active icon colors for each theme */
  .theme-toggle-icon--light {
    color: #f59e0b;
  }

  .theme-toggle-icon--dark {
    color: #75c7af;
  }

  .theme-toggle-icon--parchment {
    color: #c2410c;
  }

  .theme-toggle-icon--nord {
    color: #88c0d0;
  }

  .theme-toggle-icon--monokai {
    color: #ffd866;
  }

  .theme-toggle-icon--cyberdeck {
    color: #22d3ee;
  }

  /* When 1988 CRT mode is active, suppress modern icons and show phosphor badge */
  .top-theme-btn[data-crt-active='true'] .theme-toggle-icon--light,
  .top-theme-btn[data-crt-active='true'] .theme-toggle-icon--dark,
