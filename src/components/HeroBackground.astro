---
/**
 * Decorative DNA double-helix behind the homepage hero.
 * A slowly twisting helix ribbon trails the cursor like a snake
 * (follow-the-leader chain). A/T/C/G bases ride the rungs near the leading
 * tip, nodes glow softly, a teal "signal" pulse sweeps along the strand, and
 * the ribbon leaves a short comet trail as it moves. Pure canvas, no deps.
 * Honors prefers-reduced-motion, uses a static composition on touch devices,
 * and pauses when off-screen. Mobile keeps the site-wide cells as its single
 * ambient animation instead of running two full-canvas loops at once.
 *
 * View-Transitions safe: initialises immediately, rechecks on astro:page-load,
 * and tears the loop + observers + listeners down on astro:before-swap, so
 * navigating away and back never stacks rAF loops or leaves a blank canvas.
 */
---

<canvas data-hero-canvas aria-hidden="true"></canvas>

<style>
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script>
  interface HeroDebugSnapshot {
    running: boolean;
    visible: boolean;
    reduced: boolean;
    coarse: boolean;
    width: number;
    height: number;
    dpr: number;
    updateCount: number;
    renderCount: number;
    maxFps: number;
    timings: {
      renderP50: number;
      renderP95: number;
      renderMax: number;
    };
  }

  declare global {
    interface Window {
      __khcHeroDebug?: { snapshot: () => HeroDebugSnapshot };
    }
  }

  let instance: { teardown: () => void; snapshot: () => HeroDebugSnapshot } | null = null;

  function setup() {
    if (instance) return;
    const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    const ctx = canvas?.getContext('2d');
    const host = canvas?.parentElement;
    if (!canvas || !ctx || !host) return;

    let INK = [20, 20, 20];
    let TEAL = [46, 110, 94];

    function cssRgb(name: string, fallback: number[]) {
      const raw = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      const parts = raw.split(',').map((part) => Number(part.trim()));
      return parts.length === 3 && parts.every(Number.isFinite) ? parts : fallback;
    }

    function refreshPalette() {
      INK = cssRgb('--rgb-ink', [20, 20, 20]);
      TEAL = cssRgb('--rgb-accent', [46, 110, 94]);
      rebuildGlyphAtlas();
      if (spine.length) draw(false);
    }

    // Touch devices have no resting cursor: keep a calm drift instead of chasing.
    const coarse = window.matchMedia('(pointer: coarse)');

    const N = 60; // spine points (length of the trailing helix)
    const SEG = 9; // px between spine points
    const AMP = coarse.matches ? 10 : 14; // px — helix radius (calmer on touch)
    const WANDER = coarse.matches ? 0.22 : 0.3; // autonomous-drift excursion
    const TWIST_STEP = 0.45; // rad of twist per spine point
    const TWIST_SPEED = coarse.matches ? 0.009 : 0.012; // rad/60 Hz step — bases travel along the ribbon (slow)
    const EASE = 0.085; // how quickly the head chases the cursor (snappy)
    const EASE_IDLE = 0.02; // gentler chase while drifting alone (slower acceleration)
    const NODE_R = 2.2; // base node radius (scaled by depth)

    const TRAIL = 0.18; // comet trail — fraction of the old frame erased per 60 Hz step
    const GLOW = 4; // px — max bloom radius at the head / pulse
    const PULSE_SPEED = coarse.matches ? 0.16 : 0.22; // node-indices/60 Hz step
    const PULSE_WIDTH = 6; // nodes — half-width of the pulse window
    const DIM = 0.6; // master opacity multiplier — keeps the cursor helix subtle
    const TEXT_PAD = 26; // px — clearance kept around the hero copy
    const TEXT_FEATHER = 30; // px — soft fade band so the helix tucks under the text
    const TEXT_KEEP = 0.35; // helix opacity retained under the copy (0 = hidden, 1 = unchanged)
    const TEXT_ERASE = 1 - TEXT_KEEP; // single-pass dest-out alpha; interior keep = TEXT_KEEP
    const MAX_FPS = 24;
    const FRAME_INTERVAL = 1000 / MAX_FPS;
    const RENDER_SAMPLE_LIMIT = 180;
    const GLYPH_CELL = 18;
    const GLYPH_SCALE = 2;
    const GLYPH_SIZE_MIN = 8;
    const GLYPH_SIZE_COUNT = 5;
    const GLYPH_COLOR_STEPS = 5;
    const GLYPH_ATLAS_COLS = 10;

    const BASES = ['A', 'T', 'C', 'G'];
    const COMP: Record<string, string> = { A: 'T', T: 'A', C: 'G', G: 'C' };

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const pointer = { x: 0, y: 0, active: false };
    const textEl = host.querySelector<HTMLElement>('.hero-text');

    type Pt = { x: number; y: number };
    type ClearanceMask = {
      canvas: HTMLCanvasElement;
      x: number;
      y: number;
      width: number;
      height: number;
    };
    type GlyphSlot = { sx: number; sy: number };
    let spine: Pt[] = [];
    let bases: { a: string; b: string }[] = [];
    let protect: { x: number; y: number; w: number; h: number } | null = null;
    let clearanceMask: ClearanceMask | null = null;
    let w = 0;
    let h = 0;
    let tick = 0;
    let raf = 0;
    let running = false;
    let visible = true;
    let lastFrameTime = 0;
    let currentDpr = 1;
    let updateCount = 0;
    let renderCount = 0;
    const renderSamples: number[] = [];
    let renderSampleIndex = 0;
    const glyphAtlas = document.createElement('canvas');
    const glyphSlots = new Map<string, GlyphSlot>();

    // Blend ink → teal by m (0..1) into an "r, g, b" string.
    function mix(m: number) {
      const r = Math.round(INK[0] + (TEAL[0] - INK[0]) * m);
      const g = Math.round(INK[1] + (TEAL[1] - INK[1]) * m);
      const b = Math.round(INK[2] + (TEAL[2] - INK[2]) * m);
      return `${r}, ${g}, ${b}`;
    }

    function glyphKey(letter: string, size: number, colorStep: number) {
      return `${letter}:${size}:${colorStep}`;
    }

    function rebuildGlyphAtlas() {
      const glyphCount = BASES.length * GLYPH_SIZE_COUNT * GLYPH_COLOR_STEPS;
      const rows = Math.ceil(glyphCount / GLYPH_ATLAS_COLS);
      glyphAtlas.width = GLYPH_ATLAS_COLS * GLYPH_CELL * GLYPH_SCALE;
      glyphAtlas.height = rows * GLYPH_CELL * GLYPH_SCALE;
      const atlasCtx = glyphAtlas.getContext('2d');
      if (!atlasCtx) return;
      atlasCtx.setTransform(GLYPH_SCALE, 0, 0, GLYPH_SCALE, 0, 0);
      atlasCtx.textAlign = 'center';
      atlasCtx.textBaseline = 'middle';
      glyphSlots.clear();

      let index = 0;
      for (const letter of BASES) {
        for (let sizeOffset = 0; sizeOffset < GLYPH_SIZE_COUNT; sizeOffset++) {
          const size = GLYPH_SIZE_MIN + sizeOffset;
          atlasCtx.font = `600 ${size}px ui-monospace, SFMono-Regular, Menlo, monospace`;
          for (let colorStep = 0; colorStep < GLYPH_COLOR_STEPS; colorStep++) {
            const sx = (index % GLYPH_ATLAS_COLS) * GLYPH_CELL;
            const sy = Math.floor(index / GLYPH_ATLAS_COLS) * GLYPH_CELL;
            atlasCtx.fillStyle = `rgb(${mix(colorStep / (GLYPH_COLOR_STEPS - 1))})`;
            atlasCtx.fillText(letter, sx + GLYPH_CELL / 2, sy + GLYPH_CELL / 2);
            glyphSlots.set(glyphKey(letter, size, colorStep), { sx, sy });
            index++;
          }
        }
      }
    }

    function seed() {
      // Spine trailing left from the hero centre; one base-pair per node.
      spine = Array.from({ length: N }, (_, i) => ({
        x: w * 0.5 - i * SEG,
        y: h * 0.5,
      }));
      bases = Array.from({ length: N }, () => {
        const a = BASES[Math.floor(Math.random() * 4)];
        return { a, b: COMP[a] };
      });
    }

    function layoutStatic() {
      // A calm fixed arc for the reduced-motion frame.
      const x0 = w * 0.16;
      for (let i = 0; i < N; i++) {
        const u = i / (N - 1);
        spine[i].x = x0 + u * (w * 0.68);
        spine[i].y = h * 0.5 + Math.sin(u * Math.PI * 1.15) * h * 0.1;
      }
    }

    function resize() {
      const rect = host!.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      currentDpr = Math.min(window.devicePixelRatio || 1, 1.5);
      canvas!.width = Math.round(w * currentDpr);
      canvas!.height = Math.round(h * currentDpr);
      ctx!.setTransform(currentDpr, 0, 0, currentDpr, 0, 0);

      // Region to keep clear of the helix (the hero copy), host-relative px.
      if (textEl) {
        const t = textEl.getBoundingClientRect();
        protect = {
          x: t.left - rect.left - TEXT_PAD,
          y: t.top - rect.top - TEXT_PAD,
          w: t.width + TEXT_PAD * 2,
          h: t.height + TEXT_PAD * 2,
        };
      } else {
        protect = null;
      }
      clearanceMask = createTextClearanceMask();

      if (spine.length === 0) seed();
      if (reduce.matches || coarse.matches) layoutStatic();
      draw(false); // hard-cleared frame (covers reduced-motion + resize)
    }

    // One backbone marker: a base letter where it's bright enough, else a dot.
    function mark(
      x: number,
      y: number,
      depth: number,
      col: string,
      baseA: number,
      letter: string,
      showLetter: boolean,
      teal: number
    ) {
      const t = (depth + 1) / 2; // 0 (back) .. 1 (front)
      const a = baseA * (0.45 + 0.55 * t);
      if (showLetter && a > 0.085) {
        const size = Math.round(GLYPH_SIZE_MIN + 4 * t);
        const colorStep = Math.round(teal * (GLYPH_COLOR_STEPS - 1));
        const slot = glyphSlots.get(glyphKey(letter, size, colorStep));
        if (slot) {
          ctx!.globalAlpha = a;
          ctx!.drawImage(
            glyphAtlas,
            slot.sx * GLYPH_SCALE,
            slot.sy * GLYPH_SCALE,
            GLYPH_CELL * GLYPH_SCALE,
            GLYPH_CELL * GLYPH_SCALE,
            x - GLYPH_CELL / 2,
            y - GLYPH_CELL / 2,
            GLYPH_CELL,
            GLYPH_CELL
          );
          ctx!.globalAlpha = 1;
        } else {
          ctx!.font = `600 ${size}px ui-monospace, SFMono-Regular, Menlo, monospace`;
          ctx!.fillStyle = `rgba(${col}, ${a})`;
          ctx!.fillText(letter, x, y);
        }
      } else {
        ctx!.fillStyle = `rgba(${col}, ${a})`;
        ctx!.beginPath();
        ctx!.arc(x, y, NODE_R * (0.55 + 0.45 * t), 0, Math.PI * 2);
        ctx!.fill();
      }
    }

    function recordRenderTiming(duration: number) {
      if (renderSamples.length < RENDER_SAMPLE_LIMIT) {
        renderSamples.push(duration);
      } else {
        renderSamples[renderSampleIndex] = duration;
      }
      renderSampleIndex = (renderSampleIndex + 1) % RENDER_SAMPLE_LIMIT;
    }

    function renderTimingSummary() {
      if (renderSamples.length === 0) return { p50: 0, p95: 0, max: 0 };
      const sorted = [...renderSamples].sort((a, b) => a - b);
      const percentile = (value: number) =>
        sorted[Math.min(sorted.length - 1, Math.floor(value * sorted.length))];
      return {
        p50: percentile(0.5),
        p95: percentile(0.95),
        max: sorted[sorted.length - 1],
      };
    }

    function appendRoundedRect(
      target: CanvasRenderingContext2D,
      x: number,
      y: number,
      width: number,
      height: number,
      radius: number
    ) {
      const r = Math.max(0, Math.min(radius, width / 2, height / 2));
      target.moveTo(x + r, y);
      target.arcTo(x + width, y, x + width, y + height, r);
      target.arcTo(x + width, y + height, x, y + height, r);
      target.arcTo(x, y + height, x, y, r);
      target.arcTo(x, y, x + width, y, r);
      target.closePath();
    }

    function createTextClearanceMask(): ClearanceMask | null {
      if (!protect) return null;
      const { x, y, w: pw, h: ph } = protect;
      const radius = Math.min(14, pw / 2, ph / 2);
      const featherSteps = 6;
      const width = pw + TEXT_FEATHER * 2;
      const height = ph + TEXT_FEATHER * 2;
      const mask = document.createElement('canvas');
      mask.width = Math.ceil(width * currentDpr);
      mask.height = Math.ceil(height * currentDpr);
      const maskCtx = mask.getContext('2d');
      if (!maskCtx) return null;
      maskCtx.setTransform(currentDpr, 0, 0, currentDpr, 0, 0);

      // Cache the non-overlapping rounded feather rings. Their geometry only
      // changes on resize, so each animation frame needs one compositing blit.
      for (let band = 0; band < featherSteps; band++) {
        const inner = (band / featherSteps) * TEXT_FEATHER;
        const outer = ((band + 1) / featherSteps) * TEXT_FEATHER;
        const fade = 1 - (band + 0.5) / featherSteps;
        maskCtx.fillStyle = `rgba(0, 0, 0, ${TEXT_ERASE * fade * fade})`;
        maskCtx.beginPath();
        appendRoundedRect(
          maskCtx,
          TEXT_FEATHER - outer,
          TEXT_FEATHER - outer,
          pw + outer * 2,
          ph + outer * 2,
          radius + outer
        );
        appendRoundedRect(
          maskCtx,
          TEXT_FEATHER - inner,
          TEXT_FEATHER - inner,
          pw + inner * 2,
          ph + inner * 2,
          radius + inner
        );
        maskCtx.fill('evenodd');
      }

      maskCtx.fillStyle = `rgba(0, 0, 0, ${TEXT_ERASE})`;
      maskCtx.beginPath();
      appendRoundedRect(maskCtx, TEXT_FEATHER, TEXT_FEATHER, pw, ph, radius);
      maskCtx.fill();
      return {
        canvas: mask,
        x: x - TEXT_FEATHER,
        y: y - TEXT_FEATHER,
        width,
        height,
      };
    }

    function drawTextClearanceMask() {
      if (!clearanceMask) return;
      ctx!.save();
      ctx!.shadowBlur = 0;
      ctx!.globalCompositeOperation = 'destination-out';
      ctx!.drawImage(
        clearanceMask.canvas,
        clearanceMask.x,
        clearanceMask.y,
        clearanceMask.width,
        clearanceMask.height
      );
      ctx!.restore();
    }

    function draw(trail: boolean, frameScale = 1) {
      const renderStartedAt = performance.now();
      renderCount++;
      if (trail) {
        // Erode the previous frame (keeps canvas transparent → comet trail).
        ctx!.shadowBlur = 0;
        ctx!.globalCompositeOperation = 'destination-out';
        const trailAlpha = 1 - Math.pow(1 - TRAIL, frameScale);
        ctx!.fillStyle = `rgba(0, 0, 0, ${trailAlpha})`;
        ctx!.fillRect(0, 0, w, h);
        ctx!.globalCompositeOperation = 'source-over';
      } else {
        ctx!.clearRect(0, 0, w, h);
      }

      const boost = pointer.active ? 1.12 : 1; // brighter while tracking
      const pulsePhase = (tick * PULSE_SPEED) % N; // travelling pulse position
      ctx!.textAlign = 'center';
      ctx!.textBaseline = 'middle';

      // Draw tail → head so the leading tip sits on top.
      for (let i = N - 1; i >= 0; i--) {
        const p = spine[i];
        const prev = spine[i > 0 ? i - 1 : i];
        const next = spine[i < N - 1 ? i + 1 : i];
        let tx = next.x - prev.x;
        let ty = next.y - prev.y;
        const tl = Math.hypot(tx, ty) || 1;
        tx /= tl;
        ty /= tl;
        const nx = -ty; // unit normal to the spine
        const ny = tx;

        const phase = i * TWIST_STEP + tick * TWIST_SPEED;
        const off = Math.sin(phase) * AMP;
        const ax = p.x + nx * off;
        const ay = p.y + ny * off;
        const bx = p.x - nx * off;
        const by = p.y - ny * off;
        const depthA = Math.cos(phase);
        const depthB = -depthA;

        const hf = 1 - i / N; // 1 at the head, 0 at the tail
        let dp = Math.abs(i - pulsePhase); // wrap distance to the pulse
        dp = Math.min(dp, N - dp);
        const pulse = Math.max(0, 1 - dp / PULSE_WIDTH);

        const teal = Math.max(Math.max(0, (hf - 0.55) / 0.45), pulse);
        const fade = 0.4 + 0.6 * hf; // tail fades to faint
        const col = mix(teal);
        const tip = Math.max(0, 1 - i / 8);
        const g = Math.max(tip, pulse); // glow only at the leading tip / pulse
        const alphaScale = (1 + 0.5 * pulse) * boost * DIM;

        // Base-pair rung (crisp, no glow).
        ctx!.shadowBlur = 0;
        ctx!.strokeStyle = `rgba(${col}, ${(0.05 + 0.1 * hf) * fade * alphaScale})`;
        ctx!.lineWidth = 1;
        ctx!.beginPath();
        ctx!.moveTo(ax, ay);
        ctx!.lineTo(bx, by);
        ctx!.stroke();

        // Bloom only at the head / pulse (elsewhere flat & cheap).
        if (g > 0.2) {
          ctx!.shadowBlur = GLOW * g;
          ctx!.shadowColor = `rgba(${col}, ${0.45 * alphaScale})`;
        } else {
          ctx!.shadowBlur = 0;
        }

        // Backbone markers, drawn back-to-front for the 3D twist.
        const baseA = 0.26 * fade * alphaScale;
        const showLetter = i % 2 === 0 || tip > 0 || pulse > 0;
        if (depthA <= depthB) {
          mark(ax, ay, depthA, col, baseA, bases[i].a, showLetter, teal);
          mark(bx, by, depthB, col, baseA, bases[i].b, showLetter, teal);
        } else {
          mark(bx, by, depthB, col, baseA, bases[i].b, showLetter, teal);
          mark(ax, ay, depthA, col, baseA, bases[i].a, showLetter, teal);
        }
      }

      // Soft glow on the leading tip.
      ctx!.shadowBlur = 0;
      const head = spine[0];
      const gA = (pointer.active ? 0.16 : 0.1) * boost * DIM;
      ctx!.fillStyle = `rgba(${TEAL[0]}, ${TEAL[1]}, ${TEAL[2]}, ${gA})`;
      ctx!.beginPath();
      ctx!.arc(head.x, head.y, 9, 0, Math.PI * 2);
      ctx!.fill();
      ctx!.fillStyle = `rgba(${TEAL[0]}, ${TEAL[1]}, ${TEAL[2]}, ${gA * 1.6})`;
      ctx!.beginPath();
      ctx!.arc(head.x, head.y, 4, 0, Math.PI * 2);
      ctx!.fill();

      // Dim (not erase) the helix under the hero copy so it stays a faint texture
      // behind the text instead of competing with it. Feathered back to full
      // strength outside. Measured from the live element, so it tracks breakpoints.
      drawTextClearanceMask();

      recordRenderTiming(performance.now() - renderStartedAt);
    }

    function step(frameScale: number) {
      tick += frameScale;
      updateCount++;

      // Target: the cursor while it's over the hero, else a slow wander.
      let tgx: number;
      let tgy: number;
      if (pointer.active) {
        tgx = pointer.x;
        tgy = pointer.y;
      } else {
        tgx = w * 0.5 + Math.cos(tick * 0.002) * w * WANDER + Math.cos(tick * 0.0032) * w * 0.06;
        tgy = h * 0.5 + Math.sin(tick * 0.0028) * h * WANDER + Math.sin(tick * 0.0042) * h * 0.05;
      }

      // Ease the head toward the target, then drag the body behind it.
      // Gentler easing while idle so the self-drift accelerates slowly.
      const baseEase = pointer.active ? EASE : EASE_IDLE;
      const ease = 1 - Math.pow(1 - baseEase, frameScale);
      const head = spine[0];
      head.x += (tgx - head.x) * ease;
      head.y += (tgy - head.y) * ease;
      for (let i = 1; i < N; i++) {
        const a = spine[i - 1];
        const b = spine[i];
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const d = Math.hypot(dx, dy) || 1;
        b.x = a.x + (dx / d) * SEG;
        b.y = a.y + (dy / d) * SEG;
      }

      draw(true, frameScale);
    }

    function frame(time: number) {
      if (!running) return;
      raf = requestAnimationFrame(frame);
      if (lastFrameTime === 0) lastFrameTime = time - FRAME_INTERVAL;
      const elapsed = time - lastFrameTime;
      // Do not add an early-frame tolerance here: with modulo carry it can
      // admit a second rAF callback before a full interval has elapsed.
      if (elapsed < FRAME_INTERVAL) return;
      lastFrameTime = time - (elapsed % FRAME_INTERVAL);
      step(Math.min(4, elapsed / (1000 / 60)));
    }

    function start() {
      if (running || reduce.matches || coarse.matches || !visible || document.hidden) return;
      running = true;
      lastFrameTime = 0;
      raf = requestAnimationFrame(frame);
    }
    function stop() {
      running = false;
      cancelAnimationFrame(raf);
      raf = 0;
      lastFrameTime = 0;
    }

    const onPointerMove = (e: PointerEvent) => {
      const rect = host!.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      pointer.active = x >= 0 && y >= 0 && x <= rect.width && y <= rect.height;
      if (pointer.active) {
        pointer.x = x;
        pointer.y = y;
      }
    };
    const onBlur = () => {
      pointer.active = false;
    };
    const onVisChange = () => {
      if (document.hidden) stop();
      else start();
    };
    const onReduceChange = () => {
      if (reduce.matches || coarse.matches) {
        stop();
        layoutStatic();
        draw(false);
      } else {
        start();
      }
    };
    const onThemeChange = () => refreshPalette();

    // On touch (no resting cursor) skip pointer tracking so the helix never
    // lurches to the finger mid-scroll; it keeps its calm autonomous drift.
    if (!coarse.matches) {
      window.addEventListener('pointermove', onPointerMove, { passive: true });
      window.addEventListener('blur', onBlur);
    }
    const ro = new ResizeObserver(() => resize());
    ro.observe(host);
    if (textEl) ro.observe(textEl);
    document.addEventListener('visibilitychange', onVisChange);
    document.addEventListener('khc:theme-change', onThemeChange);
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          visible = en.isIntersecting;
          if (visible) start();
          else stop();
        }
      },
      { threshold: 0 }
    );
    io.observe(host);
    reduce.addEventListener('change', onReduceChange);

    refreshPalette();
    resize();
    if (!reduce.matches && !coarse.matches) start();

    const snapshot = (): HeroDebugSnapshot => {
      const timings = renderTimingSummary();
      return {
        running,
        visible,
        reduced: reduce.matches,
        coarse: coarse.matches,
        width: w,
        height: h,
        dpr: currentDpr,
        updateCount,
        renderCount,
        maxFps: MAX_FPS,
        timings: {
          renderP50: timings.p50,
          renderP95: timings.p95,
          renderMax: timings.max,
        },
      };
    };

    instance = {
      snapshot,
      teardown() {
        stop();
        ro.disconnect();
        io.disconnect();
        if (!coarse.matches) {
          window.removeEventListener('pointermove', onPointerMove);
          window.removeEventListener('blur', onBlur);
        }
        document.removeEventListener('visibilitychange', onVisChange);
        document.removeEventListener('khc:theme-change', onThemeChange);
        reduce.removeEventListener('change', onReduceChange);
      },
    };

    const local = ['localhost', '127.0.0.1', '[::1]'].includes(window.location.hostname);
    if (local && new URLSearchParams(window.location.search).get('cell-audit') === '1') {
      window.__khcHeroDebug = { snapshot };
    }
  }

  function cleanup() {
    instance?.teardown();
    instance = null;
    delete window.__khcHeroDebug;
  }

  setup();
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', cleanup);
</script>
