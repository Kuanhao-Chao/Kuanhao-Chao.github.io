---
import Socials from './Socials.astro';
import SequenceTrack from './SequenceTrack.astro';
import ThemeSwitcher from './ThemeSwitcher.astro';
import { site, navPages, navLabs } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-seq"><SequenceTrack /></div>
  <div class="container footer-grid">
    <div class="footer-brand">
      <p class="footer-name">{site.name}</p>
      <p class="footer-role muted">{site.role}</p>
      <Socials class="footer-socials" />
    </div>

    <nav class="footer-col footer-pages" aria-label="Pages navigation">
      <p class="eyebrow">Pages</p>
      <ul class="footer-link-grid">
        {navPages.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer-col footer-labs" aria-label="Interactive and labs">
      <p class="eyebrow">Labs & Tools</p>
      <ul class="footer-link-grid">
        {navLabs.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-col footer-connect">
      <p class="eyebrow">Connect</p>
      <ul class="footer-link-grid footer-connect-grid">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href="https://calendly.com/kuanhao-chao/30min" target="_blank" rel="noopener noreferrer">Coffee chat ☕</a></li>
        <li><a href="https://scholar.google.com/citations?user=n2AvFg0AAAAJ&hl=en" target="_blank" rel="noopener noreferrer">Google Scholar</a></li>
        <li><a href="https://github.com/Kuanhao-Chao" target="_blank" rel="noopener noreferrer">GitHub</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-base">
    <div class="footer-base-left">
      <p class="muted">© {year} {site.name}</p>
      <p class="muted footer-colophon">
        Built with Astro · {site.philosophy}
        <button
          type="button"
          class="dna-rain-trigger-btn"
          data-trigger-dna-rain
          title="Launch DNA Matrix Rain (or type 'dna' anywhere)"
          aria-label="Launch DNA Matrix Rain"
        >
          🧬
        </button>
      </p>
    </div>
    <div class="footer-base-right">
      <ThemeSwitcher />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--color-rule);
    padding-top: clamp(2rem, 3vw, 2.25rem);
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
  }
  .footer-seq {
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
    padding-block: 0.5rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.1fr;
    gap: clamp(1.75rem, 3.5vw, 3.5rem);
  }
  /* Long social rows and contact links must be allowed to wrap inside the
     responsive grid instead of expanding the page's scroll width. */
  .footer-grid > * {
    min-width: 0;
  }
  .footer-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: var(--tracking-tight);
  }
  .footer-role {
    font-size: var(--fs-small);
    margin-top: 0.2rem;
    margin-bottom: 1rem;
  }
  .footer-col {
    min-width: 0;
  }
  .footer-link-grid {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer-link-grid li {
    min-width: 0;
  }
  .footer-link-grid a {
    color: var(--color-ink);
    font-size: var(--fs-small);
    overflow-wrap: anywhere;
    display: inline-block;
    transition: color var(--trans-fast);
  }
  .footer-link-grid a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
  .footer-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-rule);
    font-size: var(--fs-small);
  }
  .footer-base-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .footer-base-right {
    display: flex;
    align-items: center;
    min-width: 0;
  }
  .footer-colophon {
    overflow-wrap: anywhere;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .dna-rain-trigger-btn {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.95rem;
    cursor: pointer;
    opacity: 0.6;
    transition: all var(--trans-fast);
    line-height: 1;
    display: inline-flex;
    align-items: center;
  }
  .dna-rain-trigger-btn:hover {
    opacity: 1;
    transform: scale(1.25) rotate(12deg);
  }

  /* Medium screens / Tablets: Brand spans full top width, 3 link columns sit side-by-side */
  @media (max-width: 880px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 2rem 1.5rem;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
    .footer-base {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
    .footer-base-right {
      width: 100%;
    }
  }

  /* Small Tablets / Large Phones: 2 columns for links */
  @media (max-width: 700px) and (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 1.5rem;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
    .footer-connect {
      grid-column: 1 / -1;
    }
    .footer-connect-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem 1rem;
    }
  }

  /* Mobile Phones: 2-column compact grid for link lists */
  @media (max-width: 639px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .footer-link-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.45rem 1rem;
    }
    .footer-link-grid a {
      display: flex;
      align-items: center;
      min-height: 2.1rem;
      padding-block: 0.15rem;
    }
    .footer-connect-grid li:first-child {
      grid-column: 1 / -1;
    }
  }

  /* Very narrow mobile devices (<= 340px) */
  @media (max-width: 340px) {
    .footer-link-grid {
      gap: 0.4rem 0.5rem;
    }
    .footer-link-grid a {
      font-size: 0.82rem;
    }
  }
</style>
