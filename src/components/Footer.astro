---
import Socials from './Socials.astro';
import Icon from './Icon.astro';
import { site, footerPages, footerLabs } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <p class="footer-name">{site.name}</p>
      <p class="footer-role muted">{site.role}</p>
      <p class="footer-email">
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <Socials class="footer-socials" />
    </div>

    <nav class="footer-col footer-pages" aria-label="Pages navigation">
      <p class="eyebrow">Explore</p>
      <ul class="footer-link-grid footer-link-grid--two">
        {footerPages.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer-col footer-labs" aria-label="Tools and feeds">
      <p class="eyebrow">Tools</p>
      <ul class="footer-link-grid">
        {footerLabs.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </nav>
  </div>

  <div class="container footer-base">
    <p class="muted footer-colophon">
      © {year} {site.name} · {site.philosophy}
    </p>
    <div class="footer-base-right">
      <button
        type="button"
        class="footer-appearance"
        data-open-appearance
        aria-haspopup="dialog"
        aria-controls="appearance-popover"
        aria-expanded="false"
      >
        <Icon name="sun" size={17} /> Appearance
      </button>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--color-rule);
    padding-top: clamp(2.25rem, 4vw, 3rem);
    padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1.15fr) minmax(0, 0.75fr);
    gap: clamp(1.75rem, 3.5vw, 3.5rem);
    align-items: start;
  }
  .footer-grid > * {
    min-width: 0;
  }
  .footer-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: var(--tracking-tight);
  }
  .footer-role {
    font-size: var(--fs-small);
    margin-top: 0.2rem;
  }
  .footer-email {
    font-size: var(--fs-small);
    margin-top: 0.35rem;
    margin-bottom: 0.9rem;
  }
  .footer-email a {
    color: var(--color-muted);
    overflow-wrap: anywhere;
    transition: color var(--trans-fast);
  }
  .footer-email a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
  .footer-col {
    min-width: 0;
  }
  .footer-link-grid {
    list-style: none;
    padding: 0;
    margin: 0.7rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .footer-link-grid--two {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem 1.25rem;
  }
  .footer-link-grid li {
    min-width: 0;
  }
  .footer-link-grid a {
    color: var(--color-ink);
    font-size: var(--fs-small);
    overflow-wrap: anywhere;
    display: inline-block;
    transition: color var(--trans-fast);
  }
  .footer-link-grid a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
  .footer-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-rule);
    font-size: var(--fs-small);
  }
  .footer-base-right {
    display: flex;
    align-items: center;
    min-width: 0;
  }
  .footer-appearance {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: var(--fs-small);
    cursor: pointer;
    transition:
      border-color var(--trans-fast),
      color var(--trans-fast);
  }
  .footer-appearance:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .footer-colophon {
    margin: 0;
    overflow-wrap: anywhere;
  }

  /* Tablets: Brand spans full top width, Explore + Tools sit cleanly side-by-side */
  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr);
      gap: 1.75rem 1.5rem;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  /* Mobile phones: clean single-column stack with compact 2-column link grids */
  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .footer-link-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.35rem 1rem;
    }
    .footer-link-grid a {
      display: flex;
      align-items: center;
      min-height: 2.1rem;
      padding-block: 0.1rem;
    }
    .footer-base {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
