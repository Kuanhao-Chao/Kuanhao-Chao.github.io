---
import Icon from './Icon.astro';
import CitationTools from './CitationTools.astro';
import { resolveRelatedPosts } from '../lib/relatedPosts';
import { publicationCitation, publicationRis } from '../lib/citationText';
import { publicationHref, publicationLinks, publicationSearchText } from '../lib/publicationMetadata';
import type { CollectionEntry } from 'astro:content';

interface Props {
  pub: CollectionEntry<'publications'>;
  compact?: boolean;
  showPosts?: boolean;
}
const { pub, compact = false, showPosts = false } = Astro.props;
const d = pub.data;
const blogLinks = showPosts ? await resolveRelatedPosts(d.relatedPosts.map((r) => r.id)) : [];
const year = d.date.getFullYear();

// Highlight the site owner's name within the author list.
const OWNER = 'Kuan-Hao Chao';
const authorParts = d.authors.split(OWNER);

const typeLabel = { journal: 'Journal', conference: 'Conference', preprint: 'Preprint', thesis: 'Thesis' }[d.type];

// Accepted-but-not-yet-published papers surface an "In press" badge; the venue shows the journal.
const inPress = d.status === 'accepted';
const tagLabel = inPress ? 'In press' : typeLabel;
const tagClass = inPress ? 'tag--accepted' : `tag--${d.type}`;

const links = publicationLinks(d);
const searchText = publicationSearchText(d);
const citation = publicationCitation(d);
---
<article
  class="pub"
  data-type={d.type}
  data-year={year}
  data-venue={d.venue.toLowerCase()}
  data-title={d.title.toLowerCase()}
  data-search={searchText}
>
  <div class="pub-year" aria-hidden="true">{year}</div>

  <div class="pub-body">
    <h3 class="pub-title">
      <a href={publicationHref(pub)}>{d.title}</a>
    </h3>

    <details
      class:list={['pub-authors-disclosure', { 'pub-authors-disclosure--long': d.authors.length > 180 }]}
      open
      data-mobile-disclosure={d.authors.length > 180 ? '' : undefined}
      data-collapse-at="560"
    >
      <summary>Full author list <Icon name="chevron-down" size={14} /></summary>
      <p class="pub-authors">
      {
        authorParts.map((part, i) => (
          <>
            {i > 0 && <span class="me">{OWNER}</span>}
            {part}
          </>
        ))
      }
      </p>
    </details>

    <p class="pub-meta">
      <span class="pub-venue">{d.venue}</span>
      <span class:list={['tag', tagClass]}>{tagLabel}</span>
    </p>

    <div class="pub-links">
      {
        links.map((l) => (
          <a class="pub-link" href={l.href} target="_blank" rel="noopener noreferrer">
            <Icon name={l.icon} size={15} />
            {l.label}
          </a>
        ))
      }
      {
        blogLinks.map((b) => (
          <a
            class="pub-link"
            href={b.href}
            title={b.title}
            aria-label={`Read the blog post: ${b.title}`}
          >
            <Icon name="pencil" size={15} />
            {b.label}
          </a>
        ))
      }
      {!compact && (
        <details class="pub-citation">
          <summary><Icon name="chevron-right" size={15} /> Cite</summary>
          <div class="pub-citation-panel">
            <CitationTools citation={citation} bibtex={d.bibtex} ris={publicationRis(d)} />
            {d.bibtex && (
              <div class="bib-source">
                <p class="bib-label">BibTeX source</p>
                <pre><code>{d.bibtex}</code></pre>
              </div>
            )}
          </div>
        </details>
      )}
    </div>
  </div>
</article>

<style>
  .pub {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0 1.5rem;
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-rule);
  }
  .pub-year {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: var(--fw-medium);
    color: var(--color-muted);
    padding-top: 0.15rem;
  }
  .pub-body { min-width: 0; }
  .pub-title {
    font-size: var(--fs-item-title);
    font-weight: var(--fw-semibold);
    line-height: 1.35;
    letter-spacing: 0;
  }
  .pub-title a {
    color: var(--color-ink);
  }
  .pub-title a:hover {
    color: var(--color-accent);
  }
  .pub-authors {
    margin-top: 0.4rem;
    font-size: var(--fs-small);
    color: var(--color-muted);
  }
  .pub-authors-disclosure > summary { display: none; }
  .pub-authors-disclosure > summary {
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    cursor: pointer;
    color: var(--color-muted);
    font-size: var(--fs-small);
    list-style: none;
  }
  .pub-authors-disclosure > summary::-webkit-details-marker { display: none; }
  .pub-authors .me {
    color: var(--color-accent);
    font-weight: var(--fw-semibold);
  }
  .pub-meta {
    margin-top: 0.35rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: var(--fs-small);
  }
  .pub-venue {
    font-style: italic;
  }
  .tag {
    font-size: var(--fs-meta);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: var(--fw-semibold);
    padding: 0.15em 0.5em;
    border-radius: 999px;
    border: 1px solid var(--color-rule);
    color: var(--color-muted);
  }
  .tag--journal {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }
  .tag--preprint {
    color: var(--color-badge-warm-text);
    border-color: var(--color-badge-warm-border);
    background: var(--color-badge-warm-bg);
  }
  .tag--accepted {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
  }
  .pub-links {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
  }
  .pub-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--fs-small);
    color: var(--color-ink);
  }
  .pub-link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
  .pub-citation {
    font-size: var(--fs-small);
    min-width: 0;
  }
  .pub-citation[open] {
    width: 100%;
    flex-basis: 100%;
  }
  .pub-citation summary {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    cursor: pointer;
    list-style: none;
    color: var(--color-ink);
    min-height: 32px;
  }
  .pub-citation summary::-webkit-details-marker {
    display: none;
  }
  .pub-citation summary :global(svg) {
    transition: transform var(--transition);
  }
  .pub-citation[open] summary :global(svg) {
    transform: rotate(90deg);
  }
  .pub-citation-panel {
    margin-top: 0.5rem;
    padding: 1rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .bib-label {
    margin-top: 1rem;
    font-size: var(--fs-caption);
    color: var(--color-muted);
  }
  .bib-source pre {
    margin-top: 0.6rem;
    padding: 0.9rem 1rem;
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    overflow-x: auto;
    max-width: 100%;
    width: 100%;
    box-sizing: border-box;
    -webkit-overflow-scrolling: touch;
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .bib-source code {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    white-space: pre;
    display: block;
  }

  @media (max-width: 560px) {
    .pub {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.3rem;
      padding-block: var(--space-4);
    }
    .pub-year {
      padding-top: 0;
      font-size: 0.95rem;
    }
    .pub-title {
      font-size: var(--fs-item-title);
      line-height: 1.4;
    }
    .pub-links {
      margin-top: 0.5rem;
    }
    .pub-authors-disclosure--long > summary { display: flex; }
    .pub-link,
    .pub-citation > summary { min-height: 44px; }
  }
  @media print {
    .pub-authors-disclosure > summary,
    .pub-citation { display: none; }
    .pub-authors-disclosure > .pub-authors { display: block; }
  }
</style>
