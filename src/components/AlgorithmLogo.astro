---
/**
 * AlgorithmLogo: Crisp, theme-aware vector SVG summarize emblem for algorithms.
 * Adapts seamlessly across light & dark themes using site CSS tokens.
 */
interface Props {
  id: string;
  size?: number | string;
  class?: string;
  compact?: boolean;
}

const { id, size = 48, class: className = '', compact = false } = Astro.props;
const dimension = typeof size === 'number' ? `${size}px` : size;
---

<div
  class={`algo-logo-badge ${compact ? 'compact' : ''} ${className}`}
  style={`--logo-dim: ${dimension};`}
  aria-hidden="true"
>
  {id === 'minimap2' && (
    <svg viewBox="0 0 64 64" class="algo-logo-svg" role="img">
      <!-- Dot-plot matrix grid -->
      <rect x="8" y="8" width="48" height="48" rx="6" fill="var(--color-surface)" stroke="var(--color-rule)" stroke-width="1.5" />
      <line x1="8" y1="24" x2="56" y2="24" stroke="var(--color-rule)" stroke-width="0.75" stroke-dasharray="2 2" />
      <line x1="8" y1="40" x2="56" y2="40" stroke="var(--color-rule)" stroke-width="0.75" stroke-dasharray="2 2" />
      <line x1="24" y1="8" x2="24" y2="56" stroke="var(--color-rule)" stroke-width="0.75" stroke-dasharray="2 2" />
      <line x1="40" y1="8" x2="40" y2="56" stroke="var(--color-rule)" stroke-width="0.75" stroke-dasharray="2 2" />
      <!-- Collinear chain line -->
      <line x1="16" y1="48" x2="48" y2="16" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" />
      <!-- Minimizer anchor seeds -->
      <circle cx="16" cy="48" r="3.5" fill="var(--color-accent)" />
      <circle cx="28" cy="36" r="3.5" fill="var(--color-accent)" />
      <circle cx="36" cy="28" r="3.5" fill="var(--color-accent)" />
      <circle cx="48" cy="16" r="3.5" fill="var(--color-accent)" />
      <!-- Off-diagonal noise seeds -->
      <circle cx="18" cy="22" r="2" fill="var(--color-muted)" opacity="0.4" />
      <circle cx="44" cy="42" r="2" fill="var(--color-muted)" opacity="0.4" />
    </svg>
  )}

  {id === 'fm-index' && (
    <svg viewBox="0 0 64 64" class="algo-logo-svg" role="img">
      <rect x="8" y="8" width="48" height="48" rx="6" fill="var(--color-surface)" stroke="var(--color-rule)" stroke-width="1.5" />
      <!-- BWT Column slices -->
      <rect x="14" y="14" width="8" height="36" rx="2" fill="var(--color-rule)" opacity="0.5" />
      <rect x="42" y="14" width="8" height="36" rx="2" fill="color-mix(in srgb, var(--color-accent) 20%, transparent)" stroke="var(--color-accent)" stroke-width="1" />
      <!-- Last-to-First (LF) circular mapping arrow -->
      <path d="M42 22 C26 12 18 22 22 34 C24 40 34 46 42 42" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" />
      <polygon points="44,40 40,46 46,46" fill="var(--color-accent)" />
      <!-- Text markers -->
      <text x="18" y="24" font-size="6" font-family="monospace" fill="var(--color-ink)" text-anchor="middle" font-weight="bold">F</text>
      <text x="46" y="24" font-size="6" font-family="monospace" fill="var(--color-accent)" text-anchor="middle" font-weight="bold">L</text>
    </svg>
  )}

  {id === 'pairwise' && (
    <svg viewBox="0 0 64 64" class="algo-logo-svg" role="img">
      <rect x="8" y="8" width="48" height="48" rx="6" fill="var(--color-surface)" stroke="var(--color-rule)" stroke-width="1.5" />
      <!-- 2D DP Matrix cells -->
      <rect x="14" y="14" width="10" height="10" rx="1.5" fill="var(--color-rule)" opacity="0.3" />
      <rect x="26" y="14" width="10" height="10" rx="1.5" fill="var(--color-rule)" opacity="0.3" />
      <rect x="38" y="14" width="10" height="10" rx="1.5" fill="var(--color-rule)" opacity="0.3" />
      <rect x="14" y="26" width="10" height="10" rx="1.5" fill="var(--color-rule)" opacity="0.3" />
      <rect x="26" y="26" width="10" height="10" rx="1.5" fill="color-mix(in srgb, var(--color-accent) 25%, transparent)" stroke="var(--color-accent)" stroke-width="1.2" />
      <rect x="38" y="26" width="10" height="10" rx="1.5" fill="var(--color-rule)" opacity="0.3" />
      <rect x="14" y="38" width="10" height="10" rx="1.5" fill="var(--color-rule)" opacity="0.3" />
      <rect x="26" y="38" width="10" height="10" rx="1.5" fill="var(--color-rule)" opacity="0.3" />
      <rect x="38" y="38" width="10" height="10" rx="1.5" fill="color-mix(in srgb, var(--color-accent) 35%, transparent)" stroke="var(--color-accent)" stroke-width="1.2" />
      <!-- Traceback path -->
      <path d="M19 19 L31 31 L43 43" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      <polygon points="45,41 41,45 46,46" fill="var(--color-accent)" />
    </svg>
  )}

  {id === 'wfa' && (
    <svg viewBox="0 0 64 64" class="algo-logo-svg" role="img">
      <rect x="8" y="8" width="48" height="48" rx="6" fill="var(--color-surface)" stroke="var(--color-rule)" stroke-width="1.5" />
      <!-- Diagonal grid axes -->
      <line x1="12" y1="12" x2="52" y2="52" stroke="var(--color-rule)" stroke-width="1" stroke-dasharray="2 2" />
      <!-- Wavefront steps (s0, s1, s2) -->
      <path d="M14 26 Q 26 26 26 14" fill="none" stroke="var(--color-muted)" stroke-width="1.5" stroke-linecap="round" opacity="0.5" />
      <path d="M18 38 Q 36 36 38 18" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" />
      <path d="M24 48 Q 46 46 48 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" />
      <!-- Diagonal extension indicator -->
      <line x1="38" y1="38" x2="48" y2="48" stroke="#10b981" stroke-width="2" stroke-linecap="round" />
      <circle cx="48" cy="48" r="2.5" fill="#10b981" />
      <text x="34" y="24" font-size="6" font-family="monospace" fill="var(--color-accent)" font-weight="bold">W(s)</text>
    </svg>
  )}

  {id === 'duel' && (
    <svg viewBox="0 0 64 64" class="algo-logo-svg" role="img">
      <rect x="8" y="8" width="48" height="48" rx="6" fill="var(--color-surface)" stroke="var(--color-rule)" stroke-width="1.5" />
      <!-- Split arena comparison: Left DP grid, Right Wavefront -->
      <line x1="32" y1="8" x2="32" y2="56" stroke="var(--color-rule)" stroke-width="1.5" stroke-dasharray="2 2" />
      <!-- Left side: NW Grid -->
      <rect x="12" y="18" width="6" height="6" rx="1" fill="var(--color-accent)" opacity="0.8" />
      <rect x="20" y="26" width="6" height="6" rx="1" fill="var(--color-accent)" opacity="0.8" />
      <rect x="20" y="34" width="6" height="6" rx="1" fill="var(--color-muted)" opacity="0.4" />
      <rect x="12" y="42" width="6" height="6" rx="1" fill="var(--color-muted)" opacity="0.4" />
      <!-- Right side: WFA Wavefront arc -->
      <path d="M38 46 Q 50 46 50 34" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" />
      <circle cx="50" cy="34" r="2.5" fill="#10b981" />
      <!-- Central Duel / VS badge -->
      <circle cx="32" cy="32" r="7" fill="var(--color-surface)" stroke="var(--color-ink)" stroke-width="1.5" />
      <text x="32" y="34.5" font-size="6" font-family="sans-serif" font-weight="900" fill="var(--color-ink)" text-anchor="middle">VS</text>
    </svg>
  )}

  {id === 'debruijn' && (
    <svg viewBox="0 0 64 64" class="algo-logo-svg" role="img">
      <rect x="8" y="8" width="48" height="48" rx="6" fill="var(--color-surface)" stroke="var(--color-rule)" stroke-width="1.5" />
      <!-- Directed Eulerian Graph Nodes -->
      <circle cx="18" cy="32" r="5" fill="var(--color-surface)" stroke="var(--color-accent)" stroke-width="2" />
      <circle cx="36" cy="20" r="5" fill="var(--color-surface)" stroke="var(--color-accent)" stroke-width="2" />
      <circle cx="36" cy="44" r="5" fill="var(--color-surface)" stroke="var(--color-accent)" stroke-width="2" />
      <circle cx="48" cy="32" r="5" fill="var(--color-accent)" />
      <!-- Eulerian arcs -->
      <path d="M22 29 L32 23" fill="none" stroke="var(--color-accent)" stroke-width="1.8" />
      <path d="M22 35 L32 41" fill="none" stroke="var(--color-accent)" stroke-width="1.8" />
      <path d="M40 23 L45 29" fill="none" stroke="var(--color-accent)" stroke-width="1.8" />
      <path d="M40 41 L45 35" fill="none" stroke="var(--color-accent)" stroke-width="1.8" />
      <polygon points="46,31 43,26 47,27" fill="var(--color-accent)" />
    </svg>
  )}

  {id === 'string-graph' && (
    <svg viewBox="0 0 64 64" class="algo-logo-svg" role="img">
      <rect x="8" y="8" width="48" height="48" rx="6" fill="var(--color-surface)" stroke="var(--color-rule)" stroke-width="1.5" />
      <!-- Reads / Sequence Segments -->
      <rect x="14" y="20" width="22" height="4" rx="2" fill="var(--color-accent)" opacity="0.8" />
      <rect x="28" y="30" width="22" height="4" rx="2" fill="#10b981" opacity="0.8" />
      <rect x="16" y="40" width="26" height="4" rx="2" fill="var(--color-ink)" opacity="0.8" />
      <!-- Transitive reduction dashed bypass arrow -->
      <path d="M20 24 C 12 30 12 36 20 40" fill="none" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="2 2" />
      <line x1="15" y1="28" x2="25" y2="36" stroke="#ef4444" stroke-width="1.5" />
      <line x1="25" y1="28" x2="15" y2="36" stroke="#ef4444" stroke-width="1.5" />
    </svg>
  )}

  {id === 'phmm' && (
    <svg viewBox="0 0 64 64" class="algo-logo-svg" role="img">
      <rect x="8" y="8" width="48" height="48" rx="6" fill="var(--color-surface)" stroke="var(--color-rule)" stroke-width="1.5" />
      <!-- Plan 7 Topology: Match (square/circle), Delete (circle), Insert (diamond) -->
      <!-- Delete state (top) -->
      <circle cx="32" cy="18" r="4.5" fill="var(--color-surface)" stroke="#ef4444" stroke-width="1.5" />
      <text x="32" y="20" font-size="5" font-family="monospace" fill="#ef4444" text-anchor="middle" font-weight="bold">D</text>
      <!-- Match state (middle) -->
      <rect x="27.5" y="28.5" width="9" height="9" rx="2" fill="color-mix(in srgb, var(--color-accent) 25%, transparent)" stroke="var(--color-accent)" stroke-width="1.8" />
      <text x="32" y="35" font-size="6" font-family="monospace" fill="var(--color-accent)" text-anchor="middle" font-weight="bold">M</text>
      <!-- Insert state (bottom diamond) -->
      <rect x="28" y="44" width="8" height="8" rx="1.5" transform="rotate(45 32 48)" fill="var(--color-surface)" stroke="#10b981" stroke-width="1.5" />
      <text x="32" y="50" font-size="5" font-family="monospace" fill="#10b981" text-anchor="middle" font-weight="bold">I</text>
      <!-- Transition lines -->
      <line x1="16" y1="33" x2="27" y2="33" stroke="var(--color-rule)" stroke-width="1.5" />
      <line x1="37" y1="33" x2="48" y2="33" stroke="var(--color-rule)" stroke-width="1.5" />
      <path d="M32 23 L32 28" fill="none" stroke="var(--color-rule)" stroke-width="1.2" />
      <path d="M32 38 L32 43" fill="none" stroke="var(--color-rule)" stroke-width="1.2" />
    </svg>
  )}

  {id === 'ghmm' && (
    <svg viewBox="0 0 64 64" class="algo-logo-svg" role="img">
      <rect x="8" y="8" width="48" height="48" rx="6" fill="var(--color-surface)" stroke="var(--color-rule)" stroke-width="1.5" />
      <!-- Gene Structure: Exon (block) - Intron (line) - Exon (block) -->
      <rect x="14" y="38" width="12" height="8" rx="2" fill="var(--color-accent)" />
      <line x1="26" y1="42" x2="38" y2="42" stroke="var(--color-rule)" stroke-width="2" />
      <rect x="38" y="38" width="12" height="8" rx="2" fill="var(--color-accent)" />
      <!-- Explicit Duration Curve f(d) on top -->
      <path d="M16 30 C 24 14 34 14 48 30" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" />
      <text x="32" y="24" font-size="6" font-family="monospace" fill="#10b981" text-anchor="middle" font-weight="bold">f(d)</text>
    </svg>
  )}

  {id === 'ism' && (
    <svg viewBox="0 0 64 64" class="algo-logo-svg" role="img">
      <rect x="8" y="8" width="48" height="48" rx="6" fill="var(--color-surface)" stroke="var(--color-rule)" stroke-width="1.5" />
      <!-- 4-row nucleotide mutation grid -->
      <circle cx="16" cy="18" r="2.5" fill="#10b981" />
      <circle cx="26" cy="18" r="2.5" fill="#3b82f6" />
      <circle cx="36" cy="18" r="2.5" fill="#f59e0b" />
      <circle cx="46" cy="18" r="2.5" fill="#ef4444" />
      <!-- Neural Delta Importance Bar Logo -->
      <rect x="14" y="36" width="6" height="12" rx="1" fill="#3b82f6" />
      <rect x="24" y="28" width="6" height="20" rx="1" fill="#f59e0b" />
      <rect x="34" y="24" width="6" height="24" rx="1" fill="#ef4444" />
      <rect x="44" y="38" width="6" height="10" rx="1" fill="#10b981" />
    </svg>
  )}

  {id === 'wgt' && (
    <svg viewBox="0 0 64 64" class="algo-logo-svg" role="img">
      <rect x="8" y="8" width="48" height="48" rx="6" fill="var(--color-surface)" stroke="var(--color-rule)" stroke-width="1.5" />
      <!-- Wheeler Graph Ordered Nodes (0, 1, 2) -->
      <circle cx="18" cy="32" r="5" fill="var(--color-surface)" stroke="var(--color-accent)" stroke-width="2" />
      <text x="18" y="34.5" font-size="6" font-family="monospace" fill="var(--color-accent)" text-anchor="middle" font-weight="bold">0</text>
      <circle cx="36" cy="20" r="5" fill="var(--color-surface)" stroke="var(--color-accent)" stroke-width="2" />
      <text x="36" y="22.5" font-size="6" font-family="monospace" fill="var(--color-accent)" text-anchor="middle" font-weight="bold">1</text>
      <circle cx="46" cy="40" r="5" fill="var(--color-surface)" stroke="var(--color-accent)" stroke-width="2" />
      <text x="46" y="42.5" font-size="6" font-family="monospace" fill="var(--color-accent)" text-anchor="middle" font-weight="bold">2</text>
      <!-- Co-lexicographic directed edge -->
      <path d="M23 30 L31 22" fill="none" stroke="var(--color-accent)" stroke-width="1.8" />
      <path d="M40 23 L44 35" fill="none" stroke="var(--color-accent)" stroke-width="1.8" />
    </svg>
  )}
</div>

<style>
  .algo-logo-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--logo-dim, 48px);
    height: var(--logo-dim, 48px);
    flex-shrink: 0;
    border-radius: var(--radius);
    background: transparent;
    transition: transform var(--transition);
  }

  .algo-logo-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .algo-logo-badge.compact {
    width: var(--logo-dim, 36px);
    height: var(--logo-dim, 36px);
  }
</style>
