---
/**
 * Minimal Embedded Shorkie_LM Genome Browser Showcase for the Homepage.
 * Displays the 6 core tracks:
 * 1. Shorkie_LM · masked (Information content 0-2 bits)
 * 2. phastCons · 7 yeasts (Evolutionary conservation 0-1)
 * 3. Genes (SGD transcripts & CDS structures)
 * 4. sequence letter (Reference nucleotides & logo)
 * 5. TFBS · ChIP-supported (Experimentally validated binding sites)
 * 6. TFBS · motif only (JASPAR position-weight matrix matches)
 */
import Icon from '../Icon.astro';

const PRESET_LOCI = [
  { name: 'TDH3', locus: 'chrVII:882,012-884,610', tag: 'Glycolysis', desc: 'High-expression glycolytic promoter' },
  { name: 'GAL1', locus: 'chrII:278,000-281,500', tag: 'Switch', desc: 'Galactose-inducible regulatory locus' },
  { name: 'ACT1', locus: 'chrVI:53,000-56,200', tag: 'Structural', desc: 'Highly conserved structural actin' },
  { name: 'HXT1', locus: 'chrVIII:64,500-68,000', tag: 'Transporter', desc: 'Glucose transporter with repressor sites' },
  { name: 'CDC28', locus: 'chrII:180,000-183,500', tag: 'Cell Cycle', desc: 'Essential cell-cycle CDK' },
  { name: 'ADH1', locus: 'chrXV:157,500-161,200', tag: 'Metabolic', desc: 'Alcohol dehydrogenase I' },
];
---

<div
  class="home-gb-card"
  data-genome-browser
  data-gb-minimal="1"
  data-gb-no-hash="1"
  data-gb-tracks="lm-masked,genes,sequence,tfbs_chip,tfbs_pwm"
  data-gb-default="chrVII:882,012-884,610"
>
  <!-- Single Unified Control Header: Preset Loci Tabs + Live Coordinates + Micro Nav -->
  <div class="home-gb-header">
    <div class="home-gb-tabs-group">
      <span class="home-gb-tabs-label">Benchmark Loci:</span>
      <div class="home-gb-tabs" role="tablist">
        {
          PRESET_LOCI.map((chip, idx) => (
            <button
              type="button"
              class={`home-gb-tab ${idx === 0 ? 'is-active' : ''}`}
              data-gb-chip={chip.locus}
              title={`${chip.name} (${chip.tag}) · ${chip.desc}`}
            >
              <span class="home-gb-tab-name">{chip.name}</span>
            </button>
          ))
        }
      </div>
    </div>

    <!-- Live Coordinate Pill & Micro Pan/Zoom Controls -->
    <div class="home-gb-controls">
      <div class="home-gb-readout-pill">
        <span class="home-gb-readout-dot"></span>
        <strong data-gb-readout>chrVII:882,012–884,610</strong>
        <span class="home-gb-readout-sub" data-gb-level-out></span>
      </div>

      <div class="home-gb-nav-btns" role="group" aria-label="Micro Navigation">
        <button type="button" class="home-gb-btn" data-gb-pan="-1" title="Pan left (‹)">‹</button>
        <button type="button" class="home-gb-btn" data-gb-pan="1" title="Pan right (›)">›</button>
        <button type="button" class="home-gb-btn" data-gb-zoom="0.5" title="Zoom in (+)">+</button>
        <button type="button" class="home-gb-btn" data-gb-zoom="2" title="Zoom out (−)">−</button>
        <button type="button" class="home-gb-btn home-gb-btn--reset" data-gb-reset title="Reset to default locus">Reset</button>
      </div>
    </div>
  </div>

  <!-- Stage: Chromosome Minimap & Multi-Track Canvas -->
  <div class="home-gb-stage">
    <canvas
      class="home-gb-canvas home-gb-mini"
      data-gb-mini
      aria-label="Chromosome overview strip"
    ></canvas>
    <canvas
      class="home-gb-canvas home-gb-track"
      tabindex="0"
      data-gb-track
      aria-label="Shorkie_LM constraint, conservation, annotation and gene models"
    ></canvas>
    <div class="gb-tooltip" data-gb-tooltip hidden></div>
    <aside class="gb-motif" data-gb-motif hidden aria-label="JASPAR Motif"></aside>
  </div>

  <!-- Launchpad Footer: Legend & Direct Deep-Link to Full Browser -->
  <div class="home-gb-footer">
    <div class="home-gb-legend">
      <span class="legend-item">
        <span class="legend-dot" style="background: #2563eb;"></span>
        <span>Shorkie_LM (0–2b)</span>
      </span>
      <span class="legend-item">
        <span class="legend-dot" style="background: #e11d48;"></span>
        <span>Genes</span>
      </span>
      <span class="legend-item">
        <span class="legend-dot" style="background: #8b5cf6;"></span>
        <span>TFBS</span>
      </span>
    </div>

    <a
      href="/shorkie-lab/genome/#chrVII:882,012-884,610"
      class="home-gb-cta-btn"
      data-gb-full-link
      title="Open full browser with all 14 tracks, full chromosome navigation, and GFF export"
    >
      <span>Explore Full Genome Browser (14 Tracks & Deep Search)</span>
      <Icon name="arrow-right" size={15} />
    </a>
  </div>
</div>

<script>
  import '../../scripts/genomeBrowser';
</script>

<style>
  .home-gb-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 12px);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    margin: 1.5rem 0 2rem;
  }

  /* Single Unified Control Header */
  .home-gb-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-ink) 2%, var(--color-surface));
  }

  .home-gb-tabs-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .home-gb-tabs-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .home-gb-tabs {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  .home-gb-tab {
    display: inline-flex;
    align-items: center;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: 0.75rem;
    font-family: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .home-gb-tab:hover {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface));
  }

  .home-gb-tab.is-active {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: #ffffff;
    box-shadow: 0 2px 6px rgba(37, 99, 235, 0.25);
  }

  .home-gb-controls {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: auto;
  }

  .home-gb-readout-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.22rem 0.65rem;
    border-radius: 999px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78125rem;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .home-gb-readout-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
  }

  .home-gb-readout-sub {
    font-size: 0.7rem;
    color: var(--color-muted);
  }

  .home-gb-nav-btns {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .home-gb-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.22rem 0.55rem;
    border-radius: var(--radius-sm, 6px);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .home-gb-btn:hover {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface));
  }

  .home-gb-btn--reset {
    font-size: 0.7rem;
    padding: 0.22rem 0.45rem;
  }

  /* Stage Canvas Layer */
  .home-gb-stage {
    position: relative;
    width: 100%;
    background: var(--color-bg);
  }

  .home-gb-mini {
    width: 100%;
    height: 28px;
    display: block;
    cursor: pointer;
    border-bottom: 1px solid var(--color-border);
  }

  .home-gb-track {
    width: 100%;
    display: block;
    cursor: grab;
    touch-action: none;
  }

  .home-gb-track:active {
    cursor: grabbing;
  }

  .home-gb-track:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  /* Launchpad Footer & Legend */
  .home-gb-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    border-top: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-ink) 2%, var(--color-surface));
  }

  .home-gb-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.72rem;
    color: var(--color-muted);
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .legend-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .home-gb-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: #ffffff !important;
    font-size: 0.78125rem;
    font-weight: 650;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.25);
    transition: all 0.15s ease;
  }

  .home-gb-cta-btn:hover {
    transform: translateX(2px);
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
  }

  /* Tooltip & Motif styles */
  :global(.gb-tooltip) {
    position: absolute;
    pointer-events: none;
    background: rgba(15, 23, 42, 0.92);
    color: #f8fafc;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    padding: 0.4rem 0.65rem;
    font-size: 0.75rem;
    line-height: 1.4;
    z-index: 100;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(6px);
  }

  :global(.gb-motif) {
    position: absolute;
    top: 36px;
    right: 12px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.75rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    z-index: 100;
    max-width: 320px;
  }
</style>
