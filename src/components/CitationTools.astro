---
import Icon from './Icon.astro';

interface Props {
  citation: string;
  bibtex?: string;
  ris?: string;
  compact?: boolean;
}

const { citation, bibtex, ris, compact = false } = Astro.props;
---
<div class:list={['citation-tools', { 'citation-tools--compact': compact }]}>
  <button type="button" class="citation-copy" data-copy-text={encodeURIComponent(citation)}>
    <Icon name="copy" size={15} />
    <span data-copy-label>Copy citation</span>
  </button>
  {
    bibtex && (
      <button type="button" class="citation-copy" data-copy-text={encodeURIComponent(bibtex)}>
        <Icon name="code" size={15} />
        <span data-copy-label>BibTeX</span>
      </button>
    )
  }
  {
    ris && (
      <button type="button" class="citation-copy" data-copy-text={encodeURIComponent(ris)}>
        <Icon name="file" size={15} />
        <span data-copy-label>RIS</span>
      </button>
    )
  }
  {bibtex && (
    <button type="button" class="citation-copy" data-download-text={encodeURIComponent(bibtex)} data-download-type="application/x-bibtex" data-download-name="citation.bib">
      <Icon name="file" size={15} /> Download BibTeX
    </button>
  )}
  {ris && (
    <button type="button" class="citation-copy" data-download-text={encodeURIComponent(ris)} data-download-type="application/x-research-info-systems" data-download-name="citation.ris">
      <Icon name="file" size={15} /> Download RIS
    </button>
  )}
</div>

<style>
  .citation-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.8rem;
    align-items: center;
  }
  .citation-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-ink);
    cursor: pointer;
    font-size: var(--fs-small);
    padding: 0.4em 0.7em;
    transition: border-color var(--transition), color var(--transition), background var(--transition);
  }
  .citation-tools--compact .citation-copy {
    border: none;
    background: transparent;
    padding: 0;
  }
  .citation-copy:hover {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-rule));
  }
  @media (pointer: coarse) {
    .citation-copy { min-height: 44px; }
  }
</style>

<script>
  function initCitationTools() {
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-download-text]')) {
      if (button.dataset.downloadBound === 'true') continue;
      button.dataset.downloadBound = 'true';
      button.addEventListener('click', () => {
        const text = decodeURIComponent(button.dataset.downloadText ?? '');
        const blob = new Blob([text], { type: `${button.dataset.downloadType};charset=utf-8` });
        const href = URL.createObjectURL(blob);
        const link = Object.assign(document.createElement('a'), {
          href,
          download: button.dataset.downloadName ?? 'citation.txt',
        });
        link.click();
        window.setTimeout(() => URL.revokeObjectURL(href), 1000);
      });
    }
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-text]')) {
      if (button.dataset.copyBound === 'true') continue;
      button.dataset.copyBound = 'true';
      const label = button.querySelector<HTMLElement>('[data-copy-label]');
      const original = label?.textContent ?? 'Copy';
      let resetTimer: ReturnType<typeof setTimeout> | undefined;
      button.addEventListener('click', async () => {
        clearTimeout(resetTimer);
        const text = decodeURIComponent(button.dataset.copyText ?? '');
        try {
          if (!navigator.clipboard?.writeText) throw new Error('Clipboard API unavailable');
          await navigator.clipboard.writeText(text);
          if (label) label.textContent = 'Copied';
          resetTimer = setTimeout(() => {
            if (label) label.textContent = original;
          }, 1400);
        } catch {
          if (label) label.textContent = 'Copy unavailable';
          resetTimer = setTimeout(() => {
            if (label) label.textContent = original;
          }, 1400);
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initCitationTools);
  initCitationTools();
</script>
