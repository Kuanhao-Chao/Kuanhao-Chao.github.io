<div class="term-keybar" data-terminal-keybar aria-label="Terminal shortcuts">
  <button type="button" data-terminal-action="command" data-terminal-command="recent">Recent</button>
  <button type="button" data-terminal-action="command" data-terminal-command="about">Bio</button>
  <button type="button" data-terminal-action="command" data-terminal-command="pubs">Pubs</button>
  <button type="button" data-terminal-action="command" data-terminal-command="software">Software</button>
  <button type="button" data-terminal-action="command" data-terminal-command="labs">Labs</button>
  <button type="button" data-terminal-action="ask">Ask AI</button>
  <button type="button" data-terminal-action="command" data-terminal-command="neofetch">Neofetch</button>
  <button type="button" data-terminal-action="command" data-terminal-command="git log">Git</button>
  <button type="button" data-terminal-action="command" data-terminal-command="help">Help</button>
  <button type="button" data-terminal-action="tab" aria-label="Complete command">Tab ⇥</button>
  <button type="button" data-terminal-action="history-up" aria-label="Previous command">↑</button>
  <button type="button" data-terminal-action="history-down" aria-label="Next command">↓</button>
  <button type="button" data-terminal-action="clear">Clear</button>
</div>
