<div class="term-keybar" data-terminal-keybar aria-label="Terminal shortcuts">
  <button type="button" data-terminal-action="command" data-terminal-command="help">Help</button>
  <button type="button" data-terminal-action="command" data-terminal-command="ls">Files</button>
  <button type="button" data-terminal-action="ask">Ask AI</button>
  <button type="button" data-terminal-action="command" data-terminal-command="about">Bio</button>
  <button type="button" data-terminal-action="command" data-terminal-command="pubs">Pubs</button>
  <button type="button" data-terminal-action="command" data-terminal-command="software">Software</button>
  <button type="button" data-terminal-action="command" data-terminal-command="talks">Talks</button>
