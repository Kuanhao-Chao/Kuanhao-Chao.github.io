---
import '../styles/global.css';
import '../styles/retroCrt.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteBackground from '../components/SiteBackground.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import PageScan from '../components/PageScan.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { ClientRouter } from 'astro:transitions';
import type { ScholarMeta } from '../lib/scholar';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  scholarMeta?: ScholarMeta;
  /**
   * Drop every piece of site chrome — header, footer, fixed overlays, skip link —
   * and let `<main>` fill the viewport. For pages that *are* the interface rather
   * than a document inside the site, currently just `/terminal/`.
   *
   * A prop rather than a sibling layout on purpose: the head guard and the
   * `window.__khcTheme` installer below are ~100 lines that must not fork.
   */
  bare?: boolean;
}
const { title, description, image, type, noindex, scholarMeta, bare = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (() => {
        const key = 'khc-theme';
        const root = document.documentElement;
        let theme = null;
        try {
          const saved = localStorage.getItem(key);
          if (['light', 'dark', 'nord', 'monokai', 'cyberdeck', 'parchment'].includes(saved)) theme = saved;
        } catch {}
        if (!theme) {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.dataset.theme = theme;
        root.style.colorScheme = (theme === 'parchment' || theme === 'light') ? 'light' : 'dark';
      })();
    </script>
    <BaseHead
      title={title}
      description={description}
      image={image}
      type={type}
      noindex={noindex}
      scholarMeta={scholarMeta}
    />
    <ClientRouter />
  </head>
  <body>
    <script is:inline>
      // Set before paint so [data-reveal] elements never flash visible→hidden.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reveal-ready');
      }
    </script>
    {!bare && <SiteBackground />}
    {!bare && <ReadingProgress />}
    {!bare && <PageScan />}
    {!bare && <CommandPalette />}
    {!bare && <a href="#main" class="skip-link">Skip to content</a>}
    {!bare && <Header />}
    <script is:inline>
      (() => {
        const themeKey = 'khc-theme';
        const crtKey = 'khc-crt-mode';
        const colors = {
          light: '#fafaf8',
          dark: '#0f1413',
          nord: '#242933',
          monokai: '#1e1e24',
          cyberdeck: '#070d14',
          parchment: '#fbf5e6',
        };
        const getRoot = () => document.documentElement;
        const media = window.matchMedia('(prefers-color-scheme: dark)');

        const validTheme = (value) =>
          value === 'light' ||
          value === 'dark' ||
          value === 'nord' ||
          value === 'monokai' ||
          value === 'cyberdeck' ||
          value === 'parchment';
        const validCrt = (value) => value === 'off' || value === 'amber' || value === 'green' || value === 'cyan';

        const storedTheme = () => {
          try {
            const value = localStorage.getItem(themeKey);
            return validTheme(value) ? value : null;
          } catch {
            return null;
          }
        };

        const storedCrt = () => {
          try {
            const value = localStorage.getItem(crtKey);
            return validCrt(value) ? value : null;
          } catch {
            return null;
          }
        };

        const systemTheme = () => (media.matches ? 'dark' : 'light');
        const resolvedTheme = () => storedTheme() || systemTheme();
        const resolvedCrt = () => storedCrt() || 'off';

        const syncControls = (theme, crt) => {
          const isCrtActive = crt === 'amber' || crt === 'green' || crt === 'cyan';
          const nextLabel = theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
          for (const button of document.querySelectorAll('[data-theme-toggle]')) {
            button.dataset.themeState = theme;
            button.setAttribute('aria-label', nextLabel);
            button.setAttribute('title', nextLabel);
            button.setAttribute('aria-pressed', String(theme === 'dark'));
          }

          document.querySelectorAll('[data-theme-choice]').forEach((btn) => {
            const choice = btn.dataset.themeChoice;
            const isActive = !isCrtActive && choice === theme;
            btn.setAttribute('aria-checked', String(isActive));
            btn.classList.toggle('is-active', isActive);
          });

          document.querySelectorAll('[data-crt-choice]').forEach((btn) => {
            const choice = btn.dataset.crtChoice;
            const isActive = isCrtActive && choice === crt;
            btn.setAttribute('aria-checked', String(isActive));
            btn.classList.toggle('is-active', isActive);
          });
        };

        const syncMeta = (theme, doc = document) => {
          const meta = doc.querySelector('[data-theme-color]');
          if (meta) meta.setAttribute('content', colors[theme] || colors.light);
        };

        const syncCrtOverlay = (crt) => {
          let overlay = document.getElementById('crt-screen-overlay');
          if (crt === 'amber' || crt === 'green' || crt === 'cyan') {
            if (!overlay) {
              overlay = document.createElement('div');
              overlay.id = 'crt-screen-overlay';
              document.body.appendChild(overlay);
            }
          } else {
            if (overlay) {
              overlay.remove();
            }
          }
        };

        const applyTheme = (theme, persist = false) => {
          const next = validTheme(theme) ? theme : systemTheme();
          const root = getRoot();
          if (persist) {
            try {
              localStorage.setItem(themeKey, next);
              localStorage.removeItem(crtKey);
            } catch {}
          }
          root.dataset.theme = next;
          root.style.colorScheme = (next === 'parchment' || next === 'light') ? 'light' : 'dark';
          delete root.dataset.crtMode;
          syncCrtOverlay('off');
          syncMeta(next);
          syncControls(next, 'off');
          document.dispatchEvent(new CustomEvent('khc:theme-change', { detail: { theme: next } }));
          document.dispatchEvent(new CustomEvent('khc:crt-change', { detail: { mode: 'off' } }));
          return next;
        };

        const applyCrt = (mode, persist = false) => {
          const next = validCrt(mode) ? mode : 'off';
          const root = getRoot();
          if (persist) {
            try {
              localStorage.setItem(crtKey, next);
            } catch {}
          }
          if (next === 'amber' || next === 'green' || next === 'cyan') {
            root.dataset.crtMode = next;
          } else {
            delete root.dataset.crtMode;
          }
          syncCrtOverlay(next);
          syncControls(root.dataset.theme || resolvedTheme(), next);
          document.dispatchEvent(new CustomEvent('khc:crt-change', { detail: { mode: next } }));
          return next;
        };

        if (!window.__khcTheme) {
          window.__khcTheme = {
            get: () => getRoot().dataset.theme || resolvedTheme(),
            apply: (theme) => applyTheme(theme, false),
            set: (theme) => applyTheme(theme, true),
            toggle: () => applyTheme((getRoot().dataset.theme || resolvedTheme()) === 'dark' ? 'light' : 'dark', true),
            sync: () => applyTheme(resolvedTheme(), false),
          };

          window.__khcCrt = {
            get: () => getRoot().dataset.crtMode || resolvedCrt(),
            apply: (mode) => applyCrt(mode, false),
            set: (mode) => applyCrt(mode, true),
            toggle: () => applyCrt((getRoot().dataset.crtMode || resolvedCrt()) === 'off' ? 'amber' : 'off', true),
            cycle: () => {
              const current = getRoot().dataset.crtMode || resolvedCrt();
              const next = current === 'off' ? 'amber' : current === 'amber' ? 'green' : current === 'green' ? 'cyan' : 'off';
              return applyCrt(next, true);
            },
            sync: () => applyCrt(resolvedCrt(), false),
          };

          media.addEventListener('change', () => {
            if (!storedTheme()) applyTheme(systemTheme(), false);
          });

          document.addEventListener('astro:before-swap', (event) => {
            const theme = getRoot().dataset.theme || resolvedTheme();
            const crt = getRoot().dataset.crtMode || resolvedCrt();
            const nextDocument = event.newDocument;
            if (!nextDocument) return;
            nextDocument.documentElement.dataset.theme = theme;
            nextDocument.documentElement.style.colorScheme = (theme === 'parchment' || theme === 'light') ? 'light' : 'dark';
            if (crt === 'amber' || crt === 'green' || crt === 'cyan') {
              nextDocument.documentElement.dataset.crtMode = crt;
            } else {
              delete nextDocument.documentElement.dataset.crtMode;
            }
            syncMeta(theme, nextDocument);
          });

          document.addEventListener('astro:page-load', () => {
            window.__khcTheme.sync();
            window.__khcCrt.sync();
          });
        }

        // ---------------------------------------------------------------------------------
        // ONE owner for every theme and CRT button on the page.
        //
        // These buttons are rendered in three places -- the header popover, the mobile drawer and
        // the footer switcher -- and two separate scripts each used to bind them with
        // `querySelectorAll(...).forEach(btn => btn.onclick = ...)`. Property assignment means the
        // second binder silently replaces the first, so which handler survived depended on script
        // order, and the CRT buttons ended up doing nothing at all: measured on the live site,
        // tapping Amber from Monokai left `data-crt-mode` unset and `khc-crt-mode` null, while
        // calling `__khcCrt.set('amber')` directly worked.
        //
        // Delegation fixes it at the root: one listener, no binding order to get wrong, and it
        // covers markup added later -- which is what both binders were separately trying to do.
        if (!window.__khcThemeDelegated) {
          window.__khcThemeDelegated = true;
          document.addEventListener('click', (event) => {
            const target = event.target;
            if (!target || typeof target.closest !== 'function') return;

            const themeBtn = target.closest('[data-theme-choice]');
            if (themeBtn) {
              const choice = themeBtn.dataset.themeChoice;
              // Picking a base theme turns the CRT off. That is deliberate and already what
              // applyTheme does -- a CRT phosphor is a whole-screen treatment, not a palette that
              // can sit alongside one.
              if (choice) window.__khcTheme.set(choice);
              return;
            }

            const crtBtn = target.closest('[data-crt-choice]');
            if (crtBtn) {
              const choice = crtBtn.dataset.crtChoice;
              if (choice) window.__khcCrt.set(choice);
              return;
            }

            const crtSwitch = target.closest('[data-crt-switch]');
            // Turning it on restores the last phosphor rather than forcing amber.
            if (crtSwitch) window.__khcCrt.toggle();
          });
        }

        window.__khcTheme.sync();
        window.__khcCrt.sync();
      })();
    </script>
    <main id="main" class:list={[bare && 'main--bare']}>
      <slot />
    </main>
    {!bare && <Footer />}
    <script>
      import { prefersReducedMotion, onVisible } from '../scripts/motion';
      // Scroll-reveal + section-divider pulses. Runs on the initial load and after
      // every client-side navigation; pending observers are dropped before a swap.
      let stoppers: Array<() => void> = [];
      function reveal() {
        if (prefersReducedMotion()) return;
        const observe = (selector: string, cls: string) => {
          for (const el of document.querySelectorAll(selector)) {
            let stop = () => {};
            stop = onVisible(el, () => {
              el.classList.add(cls);
              stop();
            });
            stoppers.push(stop);
          }
        };
        observe('[data-reveal]', 'is-visible');
        observe('[data-pulse]', 'is-pulsed');
      }
      function teardown() {
        for (const stop of stoppers) stop();
        stoppers = [];
      }
      document.addEventListener('astro:page-load', reveal);
      document.addEventListener('astro:before-swap', teardown);
    </script>
  </body>
</html>
