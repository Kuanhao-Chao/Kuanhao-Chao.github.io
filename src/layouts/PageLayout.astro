---
import BaseLayout from './BaseLayout.astro';
import GenomeAxis from '../components/genomic/GenomeAxis.astro';
import { buildBreadcrumbLd } from '../lib/breadcrumbs';

interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  description?: string;
  width?: 'wide' | 'narrow';
  noindex?: boolean;
  compact?: boolean;
}
const { title, eyebrow, lead, description, width = 'wide', noindex = false, compact = false } = Astro.props;

const breadcrumbLd =
  !noindex && Astro.url.pathname !== '/'
    ? buildBreadcrumbLd([{ name: title, path: Astro.url.pathname }])
    : null;
---
<BaseLayout title={title} description={description ?? lead} noindex={noindex}>
  {breadcrumbLd && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
  )}
  <header class:list={['page-head', compact && 'page-head--compact']}>
    <div class:list={['container', width === 'narrow' && 'container--narrow']}>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lead && <p class="lead page-lead">{lead}</p>}
      <div class="page-axis"><GenomeAxis /></div>
    </div>
  </header>
  <div class:list={['container', width === 'narrow' && 'container--narrow', 'page-body', compact && 'page-body--compact']} data-reveal>
    <slot />
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }
  .page-head h1 {
    margin-top: 0.75rem;
  }
  /* The genome axis is the header divider; it sits where the old rule did. */
  .page-axis {
    margin-top: var(--space-10);
  }
  .page-lead {
    margin-top: 1.25rem;
    max-width: var(--measure);
    color: var(--color-muted);
  }
  .container--narrow {
    max-width: var(--container-narrow);
  }
  .page-body {
    padding-top: var(--space-12);
    padding-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }
  .page-head--compact { padding-top: 1.5rem; }
  .page-head--compact .page-axis { margin-top: 1rem; }
  .page-head--compact .page-lead { margin-top: .6rem; font-size: 1rem; max-width: 52rem; }
  .page-body--compact { padding-top: 1.25rem; }
</style>
